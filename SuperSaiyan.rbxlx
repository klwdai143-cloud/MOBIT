<Item class="ServerScriptService" referent="RBX8"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX7"><Properties><string name="Name">SSJServer</string><ProtectedString name="Source">local remote = game:GetService("ReplicatedStorage"):WaitForChild("SSJToggle")
local CHARGE_TIME, BURST_TIME = 3.2, 1.4

remote.OnServerEvent:Connect(function(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health &lt;= 0 or char:GetAttribute("SSJBusy") then return end
	char:SetAttribute("SSJBusy", true)
	if char:GetAttribute("SSJState") == 2 then
		char:SetAttribute("SSJState", 0)
		task.wait(1)
	else
		local ws, jp, jh = hum.WalkSpeed, hum.JumpPower, hum.JumpHeight
		hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = 0, 0, 0
		char:SetAttribute("SSJState", 1)
		task.wait(CHARGE_TIME)
		if hum.Health &gt; 0 then
			char:SetAttribute("SSJState", 2)
			task.wait(BURST_TIME)
		end
		hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = ws, jp, jh
	end
	char:SetAttribute("SSJBusy", false)
end)
</ProtectedString></Properties></Item>
</Item>
<Item class="StarterGui" referent="RBX11"><Properties><string name="Name">StarterGui</string></Properties><Item class="ScreenGui" referent="RBX10"><Properties><string name="Name">SSJGui</string><bool name="ResetOnSpawn">false</bool></Properties><Item class="LocalScript" referent="RBX9"><Properties><string name="Name">SSJButton</string><ProtectedString name="Source">local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local remote = game:GetService("ReplicatedStorage"):WaitForChild("SSJToggle")
local player = Players.LocalPlayer

local btn = Instance.new("TextButton")
btn.AnchorPoint = Vector2.new(1, 0.5)
btn.Position = UDim2.new(1, -18, 0.5, 0)
btn.Size = UDim2.fromOffset(86, 86)
btn.BackgroundColor3 = Color3.new(1, 1, 1)
btn.AutoButtonColor = false
btn.Font = Enum.Font.Bangers
btn.TextSize = 34
btn.TextColor3 = Color3.new(1, 1, 1)
btn.TextStrokeTransparency = 0
btn.Text = "SSJ"
btn.Parent = script.Parent
Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
local grad = Instance.new("UIGradient", btn)
grad.Rotation = 90
local stroke = Instance.new("UIStroke", btn)
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Color = Color3.fromRGB(255, 245, 170)
local scale = Instance.new("UIScale", btn)
TweenService:Create(stroke, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Thickness = 6}):Play()

local function refresh()
	local c = player.Character
	local on = c and c:GetAttribute("SSJState") == 2
	local busy = c and c:GetAttribute("SSJBusy")
	btn.Text = busy and "..." or (on and "OFF" or "SSJ")
	grad.Color = ColorSequence.new(
		on and Color3.fromRGB(120, 120, 140) or Color3.fromRGB(255, 220, 40),
		on and Color3.fromRGB(40, 40, 55) or Color3.fromRGB(255, 100, 0))
end

local function hook(c)
	c:GetAttributeChangedSignal("SSJState"):Connect(refresh)
	c:GetAttributeChangedSignal("SSJBusy"):Connect(refresh)
	refresh()
end
player.CharacterAdded:Connect(hook)
if player.Character then hook(player.Character) end
refresh()

local function press()
	scale.Scale = 0.8
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), {Scale = 1}):Play()
	remote:FireServer()
end
btn.Activated:Connect(press)
UIS.InputBegan:Connect(function(i, typing)
	if not typing and i.KeyCode == Enum.KeyCode.G then press() end
end)
</ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX14"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX13"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX12"><Properties><string name="Name">SSJEffects</string><ProtectedString name="Source">local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local player = Players.LocalPlayer

-- بدل الأصوات هنا بأي "rbxassetid://ID" من الـ Toolbox
local SOUNDS = {
	charge = "rbxasset://sounds/action_falling.ogg",
	zap = "rbxasset://sounds/swordslash.wav",
	boom = "rbxasset://sounds/impact_water.mp3",
	whoosh = "rbxasset://sounds/swordlunge.wav",
	aura = "rbxasset://sounds/action_falling.ogg",
}
local CHARGE_TIME, BURST_TIME = 3.2, 1.4
local GOLD = Color3.fromRGB(255, 213, 40)
local LIGHT = Color3.fromRGB(255, 248, 180)
local rng = Random.new()
local active = {}
local shake = 0

local root3 = Instance.new("Folder")
root3.Name = "SSJ_FX"
root3.Parent = workspace

local function tween(obj, t, props, style)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad), props)
	tw:Play()
	return tw
end

local function part(parent, size, cf, color, transparency)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	p.Size, p.CFrame, p.Color, p.Transparency = size, cf, color, transparency or 0
	p.Parent = parent
	return p
end

local function sound(parent, id, volume, speed, loop)
	local s = Instance.new("Sound")
	s.SoundId, s.Volume, s.PlaybackSpeed, s.Looped = id, volume, speed, loop or false
	s.RollOffMaxDistance = 150
	s.Parent = parent
	s:Play()
	if not loop then Debris:AddItem(s, 6) end
	return s
end

local function nearness(pos)
	return math.clamp(1 - (workspace.CurrentCamera.CFrame.Position - pos).Magnitude / 90, 0, 1)
end

local function ground(fx, pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {fx.char, root3}
	local hit = workspace:Raycast(pos, Vector3.new(0, -12, 0), params)
	return hit and hit.Position or pos - Vector3.new(0, 3, 0)
end

local function ring(pos, radius, time, color)
	local a = Instance.new("CylinderHandleAdornment")
	a.Adornee = workspace.Terrain
	a.CFrame = CFrame.new(pos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(math.pi / 2, 0, 0)
	a.Height, a.Radius, a.InnerRadius, a.Color3, a.Transparency = 0.2, 2, 1, color, 0.1
	a.Parent = root3
	tween(a, time, {Radius = radius, InnerRadius = radius - 0.3, Transparency = 1})
	Debris:AddItem(a, time)
end

local function bolt(fx, center, spread)
	local last = center + rng:NextUnitVector() * spread
	for _ = 1, 4 do
		local nxt = last + rng:NextUnitVector() * 1.1
		local p = part(fx.folder, Vector3.new(0.09, 0.09, (nxt - last).Magnitude), CFrame.lookAt((last + nxt) / 2, nxt), fx.state == 2 and Color3.fromRGB(140, 220, 255) or LIGHT)
		Debris:AddItem(p, 0.09)
		last = nxt
	end
end

local function rock(fx, base)
	local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(3, 9)
	local s = rng:NextNumber(0.25, 0.9)
	local start = base + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
	local p = part(fx.folder, Vector3.new(s, s, s), CFrame.new(start), Color3.fromRGB(95, 80, 65))
	p.Material = Enum.Material.Slate
	tween(p, 1.6, {CFrame = CFrame.new(start + Vector3.new(0, rng:NextNumber(4, 9), 0)) * CFrame.Angles(a, r, s * 5), Transparency = 1}, Enum.EasingStyle.Sine)
	Debris:AddItem(p, 1.6)
end

local function emitter(parent, texture, size, speed, rate, life)
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = ColorSequence.new(LIGHT, GOLD)
	e.LightEmission = 1
	e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0)})
	e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1)})
	e.Speed = NumberRange.new(speed * 0.6, speed)
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Rate = rate
	e.EmissionDirection = Enum.NormalId.Top
	e.SpreadAngle = Vector2.new(8, 8)
	e.LockedToPart = true
	e.Parent = parent
	return e
end

local function buildHair(fx)
	local s = math.clamp(fx.head.Size.Y / 1.2, 0.85, 1.6)
	local function add(p, offset)
		p.Material = Enum.Material.Neon
		table.insert(fx.hair, {p, offset})
	end
	local cap = part(fx.folder, Vector3.new(1.3, 0.7, 1.3) * s, CFrame.new(), GOLD)
	local mesh = Instance.new("SpecialMesh", cap)
	mesh.MeshType = Enum.MeshType.Sphere
	add(cap, CFrame.new(0, 0.45 * s, 0.1 * s))
	local V = Vector3.new
	local spikes = {
		{V(0,.45,0), V(0,1,.15), 1.5}, {V(.3,.42,0), V(.55,1,.1), 1.2}, {V(-.3,.42,0), V(-.55,1,.1), 1.2},
		{V(.5,.2,.1), V(1,.45,.25), .9}, {V(-.5,.2,.1), V(-1,.45,.25), .9}, {V(0,.4,.35), V(0,.7,.8), 1.3},
		{V(.3,.25,.45), V(.45,.35,1), 1}, {V(-.3,.25,.45), V(-.45,.35,1), 1}, {V(0,.05,.5), V(0,-.1,1), .9},
		{V(.15,.5,-.35), V(.3,.9,-.35), .8}, {V(-.25,.5,-.35), V(-.25,.9,-.4), .65},
	}
	for _, d in spikes do
		local base, h = d[1] * s, d[3] * s
		local cf = CFrame.lookAt(base, base + d[2]) * CFrame.Angles(-math.pi / 2, 0, 0)
		for _, side in {-1, 1} do
			local w = Instance.new("WedgePart")
			w.Anchored, w.CanCollide, w.CanQuery, w.CanTouch, w.CastShadow = true, false, false, false, false
			w.Color, w.Size = GOLD, Vector3.new(0.25 * s, h, 0.25 * s)
			w.Parent = fx.folder
			add(w, cf * CFrame.new(0, h / 2, side * 0.125 * s) * CFrame.Angles(0, side == 1 and math.pi or 0, 0))
		end
	end
	for _, acc in fx.char:GetChildren() do
		if acc:IsA("Accessory") and acc.AccessoryType == Enum.AccessoryType.Hair then
			local h = acc:FindFirstChild("Handle")
			if h then fx.hidden[h] = h.Transparency; h.Transparency = 1 end
		end
	end
end

local function screenFlash()
	local gui = Instance.new("ScreenGui")
	gui.IgnoreGuiInset, gui.DisplayOrder = true, 50
	local f = Instance.new("Frame", gui)
	f.Size, f.BackgroundColor3, f.BackgroundTransparency = UDim2.fromScale(1, 1), LIGHT, 0.05
	gui.Parent = player.PlayerGui
	tween(f, 0.7, {BackgroundTransparency = 1})
	Debris:AddItem(gui, 0.8)
	local cam = workspace.CurrentCamera
	cam.FieldOfView = 95
	tween(cam, 1.2, {FieldOfView = 70})
	local cc = Instance.new("ColorCorrectionEffect", Lighting)
	cc.Brightness, cc.Saturation, cc.TintColor = 0.3, 0.4, LIGHT
	tween(cc, 1.5, {Brightness = 0, Saturation = 0, TintColor = Color3.new(1, 1, 1)})
	Debris:AddItem(cc, 1.6)
end

local function burst(fx)
	local pos = fx.hrp.Position
	local base = ground(fx, pos)
	local ball = part(fx.folder, Vector3.one * 3, CFrame.new(pos), LIGHT, 0.1)
	ball.Shape = Enum.PartType.Ball
	tween(ball, 0.8, {Size = Vector3.one * 32, Transparency = 1})
	Debris:AddItem(ball, 0.8)
	local beam = part(fx.folder, Vector3.new(80, 5, 5), CFrame.new(base + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.pi / 2), GOLD, 0.2)
	beam.Shape = Enum.PartType.Cylinder
	tween(beam, 1.2, {Size = Vector3.new(80, 14, 14), Transparency = 1})
	Debris:AddItem(beam, 1.2)
	for i = 0, 2 do
		task.delay(i * 0.15, ring, base, 28 - i * 5, 0.8, i == 1 and Color3.new(1, 1, 1) or GOLD)
	end
	for _ = 1, 30 do rock(fx, base) end
	for _ = 1, 14 do bolt(fx, pos, 4) end
	fx.sparks:Emit(150)
	sound(fx.hrp, SOUNDS.boom, 3, 0.4)
	sound(fx.hrp, SOUNDS.boom, 2, 0.65)
	sound(fx.hrp, SOUNDS.whoosh, 2, 0.35)
	shake = math.max(shake, 1.4 * nearness(pos))
	if fx.char == player.Character then screenFlash() end
end

local function stop(char)
	local fx = active[char]
	if not fx then return end
	active[char] = nil
	for h, t in fx.hidden do h.Transparency = t end
	for _, j in fx.joints do j.Transform = CFrame.identity end
	fx.loop:Destroy()
	fx.folder:Destroy()
end

local function start(char)
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	local head = char:WaitForChild("Head", 5)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not (hrp and head and hum) then return end
	local fx = {char = char, hrp = hrp, head = head, hum = hum, state = 1, t0 = os.clock(), nextBolt = 0, nextRock = 0, nextRing = 0, hair = {}, hidden = {}, joints = {}}
	fx.folder = Instance.new("Folder", root3)
	for _, j in char:GetDescendants() do
		if j:IsA("Motor6D") or j:IsA("AnimationConstraint") then fx.joints[j.Name] = j end
	end
	fx.base = part(fx.folder, Vector3.new(3, 0.2, 2.2), hrp.CFrame, GOLD, 1)
	fx.flame = emitter(fx.base, "rbxasset://textures/particles/fire_main.dds", 2.5, 8, 20, 0.8)
	fx.sparks = emitter(fx.base, "rbxasset://textures/particles/sparkles_main.dds", 0.7, 16, 15, 0.9)
	fx.light = Instance.new("PointLight", fx.base)
	fx.light.Color, fx.light.Range, fx.light.Brightness = GOLD, 18, 1
	fx.glow = Instance.new("Highlight", fx.folder)
	fx.glow.Adornee, fx.glow.DepthMode = char, Enum.HighlightDepthMode.Occluded
	fx.glow.FillColor, fx.glow.OutlineColor, fx.glow.FillTransparency = GOLD, LIGHT, 1
	fx.loop = sound(hrp, SOUNDS.charge, 1, 0.4, true)
	active[char] = fx
	return fx
end

local function setState(char, state)
	if state == 0 then
		local fx = active[char]
		if fx then
			sound(fx.hrp, SOUNDS.whoosh, 1, 0.6)
			ring(ground(fx, fx.hrp.Position), 12, 0.6, LIGHT)
			stop(char)
		end
		return
	end
	local fx = active[char] or start(char)
	if not fx then return end
	fx.state, fx.t0 = state, os.clock()
	if state == 2 then
		buildHair(fx)
		burst(fx)
		fx.glow.FillTransparency, fx.flame.Rate, fx.sparks.Rate = 0.75, 55, 20
		fx.loop.SoundId, fx.loop.Volume, fx.loop.PlaybackSpeed = SOUNDS.aura, 0.35, 0.7
	end
end

local A, rad = CFrame.Angles, math.rad
local function R(x, y, z) return A(rad(x), rad(y), rad(z)) end
local POSES = {
	[Enum.HumanoidRigType.R15] = {
		{Root = CFrame.new(0,-.35,0), Waist = R(-15,0,0), Neck = R(-8,0,0),
		RightShoulder = R(15,0,35), LeftShoulder = R(15,0,-35), RightElbow = R(95,0,0), LeftElbow = R(95,0,0),
		RightHip = R(35,0,18), LeftHip = R(35,0,-18), RightKnee = R(-60,0,0), LeftKnee = R(-60,0,0),
		RightAnkle = R(25,0,-18), LeftAnkle = R(25,0,18)},
		{Root = CFrame.new(0,-.1,0), Waist = R(18,0,0), Neck = R(30,0,0),
		RightShoulder = R(-20,0,55), LeftShoulder = R(-20,0,-55), RightElbow = R(45,0,0), LeftElbow = R(45,0,0),
		RightHip = R(5,0,18), LeftHip = R(5,0,-18), RightKnee = R(-10,0,0), LeftKnee = R(-10,0,0),
		RightAnkle = R(5,0,-18), LeftAnkle = R(5,0,18)},
	},
	[Enum.HumanoidRigType.R6] = {
		{RootJoint = CFrame.new(0,0,-.15) * R(15,0,0), Neck = R(10,0,0),
		["Right Shoulder"] = R(-35,0,25), ["Left Shoulder"] = R(-35,0,-25),
		["Right Hip"] = R(-18,0,15), ["Left Hip"] = R(-18,0,-15)},
		{RootJoint = R(-15,0,0), Neck = R(-30,0,0),
		["Right Shoulder"] = R(-60,0,-15), ["Left Shoulder"] = R(-60,0,15),
		["Right Hip"] = R(-15,0,-15), ["Left Hip"] = R(-15,0,15)},
	},
}

RunService.PreSimulation:Connect(function()
	for _, fx in active do
		local t = os.clock() - fx.t0
		if fx.state == 2 and t &gt; BURST_TIME then continue end
		local poses = POSES[fx.hum.RigType]
		local weight = fx.state == 1 and math.min(t / 0.5, 1) or math.clamp((BURST_TIME - t) / 0.5, 0, 1)
		local trembling = fx.state == 1 and rad(0.5 + 3.5 * math.min(t / CHARGE_TIME, 1)) or rad(2)
		for name, goal in poses[1] do
			local j = fx.joints[name]
			if not j then continue end
			if fx.state == 2 then goal = goal:Lerp(poses[2][name], math.min(t / 0.15, 1)) end
			local n = A(rng:NextNumber(-1, 1) * trembling, 0, rng:NextNumber(-1, 1) * trembling)
			j.Transform = j.Transform:Lerp(goal * n, weight)
		end
	end
end)

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	for char, fx in active do
		if not char.Parent or not fx.hrp.Parent or fx.hum.Health &lt;= 0 then stop(char) continue end
		local pos = fx.hrp.Position
		fx.base.CFrame = CFrame.new(pos - Vector3.new(0, 2.3, 0))
		for _, h in fx.hair do h[1].CFrame = fx.head.CFrame * h[2] end
		if fx.state == 1 then
			local p = math.min((now - fx.t0) / CHARGE_TIME, 1)
			fx.flame.Rate, fx.sparks.Rate = 15 + 80 * p, 10 + 60 * p
			fx.light.Brightness = 1 + 5 * p
			fx.glow.FillTransparency = 1 - 0.6 * p * math.abs(math.sin(now * (8 + 20 * p)))
			fx.loop.PlaybackSpeed, fx.loop.Volume = 0.4 + 1.1 * p, 0.6 + 1.4 * p
			shake = math.max(shake, (0.04 + 0.3 * p) * nearness(pos))
			if now &gt; fx.nextRock then fx.nextRock = now + 0.18 - 0.12 * p; rock(fx, ground(fx, pos)) end
			if now &gt; fx.nextRing then fx.nextRing = now + 0.8 - 0.45 * p; ring(ground(fx, pos), 8 + 8 * p, 0.6, GOLD) end
			if now &gt; fx.nextBolt then
				fx.nextBolt = now + 0.35 - 0.28 * p
				bolt(fx, pos, 3)
				sound(fx.hrp, SOUNDS.zap, 0.2 + 0.4 * p, rng:NextNumber(1.6, 2.4))
			end
		else
			fx.light.Brightness = 2.5 + math.sin(now * 12) * 0.8
			if now &gt; fx.nextBolt then
				fx.nextBolt = now + rng:NextNumber(0.25, 0.8)
				bolt(fx, pos, 2.2)
				sound(fx.hrp, SOUNDS.zap, 0.15, rng:NextNumber(2, 2.8))
			end
		end
	end
end)

RunService:BindToRenderStep("SSJShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if shake &lt; 0.01 then return end
	local cam = workspace.CurrentCamera
	cam.CFrame *= CFrame.new(rng:NextNumber(-shake, shake) * 0.5, rng:NextNumber(-shake, shake) * 0.5, 0)
	shake *= math.exp(-5 * dt)
end)

local function watchPlayer(p)
	local function watch(char)
		local function changed() setState(char, char:GetAttribute("SSJState") or 0) end
		char:GetAttributeChangedSignal("SSJState"):Connect(changed)
		task.spawn(changed)
	end
	p.CharacterAdded:Connect(watch)
	p.CharacterRemoving:Connect(stop)
	if p.Character then watch(p.Character) end
end
Players.PlayerAdded:Connect(watchPlayer)
for _, p in Players:GetPlayers() do watchPlayer(p) end
</ProtectedString></Properties></Item>
</Item>
</Item>
</roblox>
