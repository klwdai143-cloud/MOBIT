<Item class="ReplicatedStorage" referent="RBX2559"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX2557"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[local C = {}

C.START_SPEED, C.MAX_SPEED = 20, 130
C.START_SLOTS, C.MAX_SLOTS = 4, 10
C.SAFE_Z = 54
C.KING_FIRST, C.KING_EVERY = 100, 240
C.KING_POS = Vector3.new(0, 0, 360)

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

C.ZONES = {
	{key="Forest", name="غابة التنين", z0=60, guard=17, req=20, hatch=12, mult=1, color=rgb(110,220,90), tint=rgb(240,255,235), haze=rgb(180,220,170)},
	{key="Ice", name="وادي الجليد", z0=260, guard=29, req=34, hatch=25, mult=2.5, color=rgb(120,210,255), tint=rgb(220,238,255), haze=rgb(200,230,255)},
	{key="Volcano", name="أرض البركان", z0=460, guard=47, req=54, hatch=45, mult=6, color=rgb(255,110,50), tint=rgb(255,225,205), haze=rgb(120,70,60)},
	{key="Sky", name="مملكة السماء", z0=660, guard=70, req=80, hatch=70, mult=15, color=rgb(255,215,255), tint=rgb(255,240,255), haze=rgb(235,215,255)},
}

C.ELEMENTS = {
	Forest = {name="تنين الغابة", body=rgb(55,140,62), dark=rgb(30,85,42), belly=rgb(208,214,130), wing=rgb(120,190,70), horn=rgb(120,85,50), eye=rgb(255,225,40), fx=rgb(130,255,90)},
	Ice = {name="تنين الجليد", body=rgb(95,165,225), dark=rgb(50,100,175), belly=rgb(225,245,255), wing=rgb(160,225,255), horn=rgb(235,250,255), eye=rgb(60,255,255), fx=rgb(180,235,255)},
	Volcano = {name="تنين البركان", body=rgb(150,38,30), dark=rgb(45,28,30), belly=rgb(245,155,60), wing=rgb(215,70,30), horn=rgb(35,28,28), eye=rgb(255,170,0), fx=rgb(255,100,20)},
	Sky = {name="تنين السماء", body=rgb(225,215,250), dark=rgb(150,125,215), belly=rgb(255,235,180), wing=rgb(190,160,255), horn=rgb(255,205,80), eye=rgb(255,90,230), fx=rgb(255,190,255)},
	King = {name="تنين الملك", body=rgb(45,28,75), dark=rgb(20,12,38), belly=rgb(255,196,50), wing=rgb(120,45,190), horn=rgb(255,205,45), eye=rgb(255,50,50), fx=rgb(255,215,60)},
}

C.RARITY = {
	{name="عادي", income=5, color=rgb(200,205,215), scale=0.30},
	{name="نادر", income=20, color=rgb(70,165,255), scale=0.33},
	{name="ملحمي", income=75, color=rgb(190,90,255), scale=0.36},
	{name="أسطوري", income=300, color=rgb(255,185,30), scale=0.39},
	{name="خرافي", income=1500, color=rgb(255,60,110), scale=0.42},
}
C.CHANCES = {
	{70,25,5,0,0}, {45,38,14,3,0}, {20,40,28,10,2}, {0,30,40,22,8}, {0,0,0,80,20},
}
C.MUT = {
	{name="", mult=1, w=85},
	{name="ذهبي", mult=3, w=9},
	{name="لهبي", mult=5, w=4.5},
	{name="قوس قزح", mult=10, w=1.5},
}

function C.element(zone, king)
	if king then return "King" end
	return C.ZONES[zone].key
end

function C.income(p, rebirth)
	local zm = C.ZONES[p.zone].mult
	return math.floor(C.RARITY[p.rar].income * zm * C.MUT[p.mut].mult * (1 + 0.5 * rebirth))
end

C.UPGRADES = {
	tread = {name="جهاز المشي", icon="🏃", max=8, cost=function(l) return math.floor(250 * 3 ^ (l - 1)) end, desc="سرعة تدريب أكبر"},
	slots = {name="توسيع القاعدة", icon="🏗️", max=10, cost=function(l) return math.floor(500 * 2.5 ^ (l - 4)) end, desc="مكان إضافي لبيضة أو تنين"},
	bat = {name="قوة المضرب", icon="🏏", max=5, cost=function(l) return math.floor(400 * 3 ^ (l - 1)) end, desc="ضربة تطيّر الحرامي أبعد"},
	lock = {name="قفل القاعدة", icon="🔒", max=5, cost=function(l) return math.floor(600 * 3 ^ (l - 1)) end, desc="القفل يدوم مدة أطول"},
	traps = {name="فخ", icon="🪤", max=5, cost=function() return 300 end, desc="يشل الحرامي 3 ثواني"},
}
C.ORDER = {"tread", "slots", "bat", "lock", "traps"}

function C.rebirthCost(r) return 50000 * (r + 1) ^ 2 end

-- مواقع القواعد (لازم تطابق الماب)
C.PLOT_SIZE = 48
C.PLOTS = {}
for _, z in ipairs({-190, -132, -74, -16}) do
	table.insert(C.PLOTS, Vector3.new(-64, 0, z))
	table.insert(C.PLOTS, Vector3.new(64, 0, z))
end
function C.plotPoint(i, u, v, y)
	local c = C.PLOTS[i]
	local dir = c.X < 0 and 1 or -1
	return Vector3.new(c.X + dir * u, y or 0, c.Z + v), dir
end
function C.slotCF(i, s)
	local row = math.floor((s - 1) / 5)
	local col = (s - 1) % 5
	local p, dir = C.plotPoint(i, -18 + col * 9, 5 + row * 12, 0.7)
	return CFrame.lookAt(p, p + Vector3.new(dir * 0.35, 0, -1))
end
function C.inPlot(i, pos)
	local c = C.PLOTS[i]
	return math.abs(pos.X - c.X) < C.PLOT_SIZE / 2 and math.abs(pos.Z - c.Z) < C.PLOT_SIZE / 2
end

function C.nestPos(zone, n)
	local z0 = C.ZONES[zone].z0
	local t = {Vector3.new(-55, 0, z0 + 145), Vector3.new(0, 0, z0 + 162), Vector3.new(55, 0, z0 + 138)}
	return t[n]
end
function C.guardPos(zone) return Vector3.new(0, 0, C.ZONES[zone].z0 + 184) end

function C.fmt(n)
	n = math.floor(n or 0)
	local units = {{1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}}
	for _, u in ipairs(units) do
		if n >= u[1] then return string.format("%.1f%s", n / u[1], u[2]) end
	end
	return tostring(n)
end

return C
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX2558"><Properties><string name="Name">Visuals</string><ProtectedString name="Source"><![CDATA[local RS = game:GetService("ReplicatedStorage")
local C = require(RS:WaitForChild("Config"))
local V = {}

local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local rad = math.rad
local ang = CFrame.Angles
local v3 = Vector3.new

function V.emitter(parent, color, rate, size, life, speed, texture)
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture or SPARK
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0)})
	e.Transparency = NumberSequence.new(0.15, 1)
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(35, 35)
	e.LightEmission = 0.8
	e.Parent = parent
	return e
end

local Rig = {}
Rig.__index = Rig

local function newRig(scale)
	local model = Instance.new("Model")
	return setmetatable({model = model, s = scale, joints = {}, order = {}, parts = {}, cfs = {}, tinted = {}, phase = math.random() * 10}, Rig)
end
local function scaled(cf, s) return cf.Rotation + cf.Position * s end

function Rig:joint(name, parent, x, y, z)
	local j = {name = name, parent = parent, offset = CFrame.new(v3(x, y, z) * self.s), parts = {}, anim = CFrame.identity}
	self.joints[name] = j
	table.insert(self.order, j)
	return j
end
function Rig:part(joint, shape, size, cf, color, material, tint)
	local p
	if shape == "wedge" then p = Instance.new("WedgePart") else p = Instance.new("Part") end
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
	p.Size = size * self.s
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape == "ball" then
		local m = Instance.new("SpecialMesh") m.MeshType = Enum.MeshType.Sphere m.Parent = p
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = self.model
	local rec = {p, scaled(cf, self.s)}
	table.insert(self.joints[joint].parts, rec)
	table.insert(self.parts, p)
	if tint then table.insert(self.tinted, p) end
	return p
end
function Rig:bone(joint, a, b, thick, color)
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b) * ang(0, rad(90), 0)
	return self:part(joint, "cyl", v3((b - a).Magnitude, thick, thick), cf, color)
end
function Rig:solve(rootCF)
	local n = 0
	local list = {}
	for _, j in ipairs(self.order) do
		local base = j.parent and self.joints[j.parent].world or rootCF
		j.world = base * j.offset * j.anim
		for _, rec in ipairs(j.parts) do
			n = n + 1
			list[n] = rec[1]
			self.cfs[n] = j.world * rec[2]
		end
	end
	workspace:BulkMoveTo(list, self.cfs, Enum.BulkMoveMode.FireCFrameChanged)
end
function Rig:destroy() self.model:Destroy() end

---------------------------------------------------------------- التنين
function V.newDragon(element, scale, mut)
	local E = C.ELEMENTS[element]
	local r = newRig(scale)
	r.kind, r.mut = "Dragon", mut or 1
	local body, dark, belly, wing, horn, eye = E.body, E.dark, E.belly, E.wing, E.horn, E.eye
	local mat = Enum.Material.SmoothPlastic
	if element == "Ice" then mat = Enum.Material.Ice end
	if mut == 2 then
		body, dark, wing = Color3.fromRGB(255, 196, 40), Color3.fromRGB(190, 130, 15), Color3.fromRGB(255, 225, 110)
		mat = Enum.Material.Metal
	end
	local neon = Enum.Material.Neon
	local function ball(j, sx, sy, sz, x, y, z, col, m, tint) return r:part(j, "ball", v3(sx, sy, sz), CFrame.new(x, y, z), col, m or mat, tint) end
	local function spike(j, x, y, z, h, len, col)
		r:part(j, "wedge", v3(0.35, h, len * 0.5), CFrame.new(x, y, z - len * 0.25), col or horn)
		r:part(j, "wedge", v3(0.35, h, len * 0.5), CFrame.new(x, y, z + len * 0.25) * ang(0, math.pi, 0), col or horn)
	end

	r:joint("body", nil, 0, 5, 0)
	local torso = ball("body", 5, 4.6, 8, 0, 0, 0, body, mat, true)
	ball("body", 4.5, 4.5, 4.4, 0, -0.1, -2.4, body, mat, true)
	ball("body", 4.3, 4.1, 4.2, 0, 0, 2.7, body, mat, true)
	for k = 0, 5 do
		ball("body", 3.2 - math.abs(k - 2) * 0.25, 1, 1.5, 0, -1.9 + math.abs(k - 2.5) * 0.08, -3.4 + k * 1.2, belly)
	end
	for k = 0, 4 do spike("body", 0, 2.45 - math.abs(k - 2) * 0.12, -2.8 + k * 1.4, 1.5 - math.abs(k - 2) * 0.15, 1.3) end
	for side = -1, 1, 2 do
		for k = 0, 3 do ball("body", 0.5, 1.1, 1.3, side * 2.35, 0.6 - k % 2 * 0.5, -2.4 + k * 1.5, dark, mat, true) end
	end

	local prev = "body"
	local necks = {{0, 1.1, -3.5}, {0, 1.15, -1.3}, {0, 1.15, -1.1}}
	for k, o in ipairs(necks) do
		local name = "neck" .. k
		r:joint(name, prev, o[1], o[2], o[3])
		local w = 2.9 - k * 0.3
		ball(name, w, w, 3, 0, 0.45, -0.5, body, mat, true)
		ball(name, w * 0.65, w * 0.6, 2.2, 0, -0.15, -0.8, belly)
		spike(name, 0, 0.55 + w / 2, -0.4, 1, 1)
		prev = name
	end

	r:joint("head", "neck3", 0, 1, -1.2)
	local skull = ball("head", 3.1, 2.5, 3.1, 0, 0.1, -0.4, body, mat, true)
	ball("head", 2.1, 1.35, 3, 0, -0.15, -2.2, body, mat, true)
	ball("head", 1.5, 0.45, 2.2, 0, 0.48, -2.2, dark, mat, true)
	r.lids = {}
	for side = -1, 1, 2 do
		ball("head", 0.55, 0.85, 0.95, side * 1.28, 0.4, -1.15, eye, neon)
		ball("head", 0.18, 0.65, 0.22, side * 1.54, 0.4, -1.25, Color3.new(0, 0, 0))
		ball("head", 0.12, 0.18, 0.15, side * 1.6, 0.58, -1.38, Color3.new(1, 1, 1), neon)
		local lid = ball("head", 0.75, 0.98, 1.1, side * 1.34, 0.4, -1.18, dark)
		lid.Transparency = 1
		table.insert(r.lids, lid)
		r:part("head", "block", v3(0.5, 0.35, 1.7), CFrame.new(side * 1.2, 1.05, -1.15) * ang(rad(-12), 0, rad(side * -18)), dark)
		ball("head", 0.3, 0.3, 0.4, side * 0.55, 0.35, -3.55, E.fx, neon)
		local a, b, c = v3(side * 0.8, 1, 0.2), v3(side * 1.35, 2.1, 1.3), v3(side * 1.5, 2.45, 2.7)
		r:bone("head", a, b, 0.65, horn)
		r:bone("head", b, c, 0.42, horn)
		r:bone("head", c, c + v3(side * -0.05, 0.55, 0.8), 0.22, horn)
		for k = 0, 2 do
			r:part("head", "wedge", v3(0.2, 0.55, 1.4 - k * 0.25), CFrame.new(side * (1.45 + k * 0.05), -0.1 - k * 0.45, 0.8) * ang(rad(k * -18), rad(side * 22), 0), wing)
		end
		for k = 0, 3 do
			r:part("head", "wedge", v3(0.18, 0.5, 0.3), CFrame.new(side * 0.75, -0.85, -1.7 - k * 0.52) * ang(math.pi, 0, 0), Color3.new(1, 1, 1))
		end
	end
	r:joint("jaw", "head", 0, -0.85, -0.4)
	ball("jaw", 1.95, 0.75, 3.5, 0, -0.2, -1.5, belly)
	ball("jaw", 1, 0.2, 2.5, 0, 0.12, -1.7, Color3.fromRGB(225, 70, 95))
	for side = -1, 1, 2 do
		for k = 0, 2 do r:part("jaw", "wedge", v3(0.18, 0.45, 0.28), CFrame.new(side * 0.68, 0.32, -2.9 + k * 0.6), Color3.new(1, 1, 1)) end
	end

	for side = -1, 1, 2 do
		local a, b = "wingA" .. side, "wingB" .. side
		r:joint(a, "body", side * 1.9, 1.7, -1.6)
		r:bone(a, v3(0, 0, 0), v3(side * 5, 0, 0), 0.75, dark)
		ball(a, 1.5, 1.2, 1.5, 0, 0, 0, body, mat, true)
		local function tri(j, x0, len, depth, yoff)
			local right = v3(0, side, 0)
			local cf = CFrame.fromMatrix(v3(side * (x0 + len / 2), yoff, depth / 2), right, v3(side, 0, 0), v3(0, 0, -1))
			local m = r:part(j, "wedge", v3(0.12, len, depth), cf, wing, nil, true)
			m.Transparency = 0.08
		end
		r:part(a, "block", v3(5, 0.12, 3.4), CFrame.new(side * 2.5, -0.05, 1.7), wing, nil, true)
		tri(a, 0, 5, 5.4, -0.12)
		r:joint(b, a, side * 5, 0, 0)
		r:bone(b, v3(0, 0, 0), v3(side * 6.5, 0, 0.3), 0.5, dark)
		r:bone(b, v3(0, 0, 0), v3(side * 4.3, 0, 3), 0.25, dark)
		r:bone(b, v3(0, 0, 0), v3(side * 1.6, 0, 4.6), 0.25, dark)
		tri(b, 0, 6.5, 3.4, 0)
		tri(b, 0, 4.3, 4.6, -0.06)
		tri(b, 0, 2, 5.6, -0.1)
		r:part(b, "wedge", v3(0.3, 0.5, 1.3), CFrame.new(0, 0.2, -0.7), horn)
	end

	for k, o in ipairs({{-1, -2.5}, {1, -2.5}, {-1, 2.7}, {1, 2.7}}) do
		local name, side = "leg" .. k, o[1]
		r:joint(name, "body", side * 2, -0.9, o[2])
		ball(name, 1.8, 3.2, 2.3, side * 0.15, -0.8, 0.1, body, mat, true)
		ball(name, 1.15, 2.5, 1.25, side * 0.25, -2.4, -0.15, dark, mat, true)
		ball(name, 1.7, 0.9, 2.3, side * 0.25, -3.65, -0.6, body, mat, true)
		for toe = -1, 1 do
			r:part(name, "wedge", v3(0.25, 0.35, 0.8), CFrame.new(side * 0.25 + toe * 0.52, -3.85, -1.9), horn)
		end
	end

	prev = "body"
	for k = 1, 7 do
		local name = "tail" .. k
		r:joint(name, prev, 0, k == 1 and 0.2 or -0.18, k == 1 and 4.1 or 1.45)
		local w = 2.8 - k * 0.32
		ball(name, w, w, 2.4, 0, 0, 0.6, body, mat, true)
		ball(name, w * 0.65, w * 0.45, 1.8, 0, -w * 0.32, 0.6, belly)
		if k < 7 then spike(name, 0, w / 2 + 0.25, 0.6, 0.9 - k * 0.07, 0.9) end
		prev = name
	end
	spike("tail7", 0, 0.65, 2.2, 1.3, 2.4, wing)
	r:part("tail7", "wedge", v3(0.35, 1.3, 1.2), CFrame.new(0, -0.65, 1.6) * ang(0, 0, math.pi), wing)
	r:part("tail7", "wedge", v3(0.35, 1.3, 1.2), CFrame.new(0, -0.65, 2.8) * ang(math.pi, 0, 0), wing)

	if element == "Ice" then
		for k = 1, 8 do
			local cr = r:part("body", "block", v3(0.55, 2.2, 0.55), CFrame.new(((k % 2) * 2 - 1) * 1.4, 2, -3 + k * 0.75) * ang(rad(35), 0, rad(((k % 2) * 2 - 1) * -28)), Color3.fromRGB(190, 245, 255), Enum.Material.Glass)
			cr.Transparency = 0.25
		end
	elseif element == "Volcano" then
		for side = -1, 1, 2 do
			for k = 0, 4 do
				r:part("body", "block", v3(0.12, 0.18, 1.5), CFrame.new(side * 2.46, -0.3 + (k % 3) * 0.45, -2.4 + k * 1.2) * ang(rad((k % 2) * 60 - 30), 0, 0), E.fx, neon)
			end
		end
	elseif element == "Forest" then
		for k = 0, 9 do
			ball("body", 1.4, 0.18, 0.8, ((k % 2) * 2 - 1) * 1.7, 1.75, -2.8 + k * 0.6, Color3.fromRGB(100, 200, 60), Enum.Material.Grass)
		end
	elseif element == "Sky" or element == "King" then
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			if element == "Sky" then
				r:part("head", "block", v3(0.7, 0.18, 0.25), CFrame.new(math.cos(a) * 1.4, 3.1, math.sin(a) * 1.4) * ang(0, -a + math.pi / 2, 0), E.horn, neon)
			else
				r:part("head", "block", v3(0.55, k % 2 == 0 and 1.3 or 0.6, 0.25), CFrame.new(math.cos(a) * 1.1, 1.8 + (k % 2 == 0 and 0.35 or 0), math.sin(a) * 1.1) * ang(0, -a + math.pi / 2, 0), E.horn, neon)
			end
		end
	end

	local mouth = Instance.new("Attachment", skull)
	mouth.Position = v3(0, -0.6, -3.6) * scale
	r.breath = V.emitter(mouth, E.fx, 130, 3.5 * scale, 0.7, 45 * scale, element == "Ice" and SMOKE or FIRE)
	r.breath.EmissionDirection = Enum.NormalId.Front
	r.breath.SpreadAngle = Vector2.new(18, 18)
	r.breath.Enabled = false
	r.aura = V.emitter(torso, E.fx, (mut or 1) > 1 and 18 or 5, 0.9 * scale, 1.8, 3)
	r.aura.SpreadAngle = Vector2.new(180, 180)
	if mut == 3 then V.emitter(torso, Color3.fromRGB(255, 120, 20), 35, 4 * scale, 0.8, 5, FIRE) end
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Parent = E.fx, 18 * scale, 1.2, torso
	return r
end

function V.animateDragon(r, rootCF, state, t)
	t = t + r.phase
	local J = r.joints
	local s = r.s
	local sin = math.sin
	local bodyY, bodyP = sin(t * 2) * 0.15, 0
	local neck = {sin(t * 1.3) * 0.05, sin(t * 1.3 + 1) * 0.06, 0}
	local headP, headY, jaw = -0.12, sin(t * 0.7) * 0.25, -0.05
	local flap, sweep, fold = 0.35 + sin(t * 2) * 0.08, 0.7, 1.25
	local legs = {0, 0, 0, 0}
	local legSpread, tailSpeed, tailAmp = 0, 1.6, 0.14
	if state == "sleep" then
		bodyY = -2.5 + sin(t * 1.4) * 0.18
		neck = {-0.75, -0.5, -0.15}
		headP, headY, jaw = 0.75, 0.35, -0.03 - math.max(0, sin(t * 1.4)) * 0.08
		flap, sweep, fold = 0.12, 1.05, 1.5
		legs, legSpread, tailSpeed, tailAmp = {1.25, 1.25, 1.25, 1.25}, 0.35, 0.5, 0.05
	elseif state == "wake" then
		bodyP = 0.28
		neck = {0.25, 0.1, -0.15}
		headP, headY, jaw = -0.1, sin(t * 38) * 0.09, -0.75
		flap, sweep, fold = 0.75 + sin(t * 9) * 0.35, 0, 0.15
		legs, tailSpeed, tailAmp = {-0.28, -0.28, -0.28, -0.28}, 7, 0.22
	elseif state == "chase" or state == "return" then
		local f = state == "chase" and 11 or 7
		bodyY = math.abs(sin(t * f)) * 0.7
		bodyP = sin(t * f * 2) * 0.05
		neck = {-0.25, -0.1 + sin(t * f) * 0.08, 0.05}
		headP, headY, jaw = 0.18, 0, state == "chase" and -0.4 - sin(t * f) * 0.15 or -0.05
		flap, sweep, fold = 0.35 + sin(t * f) * 0.4, 0.45, 0.65
		local a = sin(t * f) * 0.75
		legs, tailSpeed, tailAmp = {a, -a, -a, a}, f * 0.7, 0.18
	elseif state == "attack" then
		bodyP = -0.12
		neck = {-0.3, -0.1, 0.1}
		headP, headY, jaw = 0.25, sin(t * 7) * 0.4, -0.85
		flap, sweep, fold = 0.9, 0.1, 0.25
	elseif state == "fly" then
		local w = sin(t * 5.5)
		bodyY = -w * 0.35
		neck = {-0.2, -0.05, 0.05}
		headP, headY = 0.12, 0
		flap, sweep, fold = w * 0.7 + 0.1, 0.1, 0.05 - sin(t * 5.5 - 1) * 0.35
		legs, tailSpeed, tailAmp = {-1, -1, -1.1, -1.1}, 3, 0.1
	end
	J.body.anim = CFrame.new(0, bodyY * s, 0) * ang(bodyP, 0, 0)
	for k = 1, 3 do J["neck" .. k].anim = ang(neck[k], headY * 0.2, 0) end
	J.head.anim = ang(headP, headY * 0.6, 0)
	J.jaw.anim = ang(jaw, 0, 0)
	for side = -1, 1, 2 do
		J["wingA" .. side].anim = ang(0, -side * sweep, side * flap)
		local bend = state == "fly" and side * flap * 0.35 or side * -0.15
		J["wingB" .. side].anim = ang(0, -side * fold, bend)
	end
	for k = 1, 4 do
		local side = (k % 2 == 1) and -1 or 1
		J["leg" .. k].anim = ang(legs[k], 0, side * legSpread)
	end
	for k = 1, 7 do
		local lift = state == "sleep" and 0 or sin(t * tailSpeed * 0.7 - k * 0.5) * 0.05
		local curl = state == "sleep" and 0.3 or 0
		J["tail" .. k].anim = ang(lift, sin(t * tailSpeed - k * 0.65) * tailAmp + curl, 0)
	end
	for _, lid in ipairs(r.lids) do lid.Transparency = state == "sleep" and 0 or 1 end
	r.breath.Enabled = state == "wake" or state == "attack" or (r.breathUntil ~= nil and os.clock() < r.breathUntil)
	if r.mut == 4 then
		local hue = (t * 0.2) % 1
		for k, p in ipairs(r.tinted) do p.Color = Color3.fromHSV((hue + k * 0.008) % 1, 0.65, 1) end
	end
	r:solve(rootCF)
end

---------------------------------------------------------------- البيضة
function V.newEgg(element, scale, isKing)
	local E = C.ELEMENTS[element]
	local r = newRig(scale)
	r.kind = "Egg"
	r:joint("egg", nil, 0, 2.1, 0)
	local shell = r:part("egg", "ball", v3(3.2, 4.3, 3.2), CFrame.new(), E.body, isKing and Enum.Material.Metal or Enum.Material.SmoothPlastic)
	local function surface(a, y, out)
		local k = math.sqrt(math.max(0, 1 - (y / 2.15) ^ 2))
		return v3(math.cos(a) * 1.6 * k * out, y, math.sin(a) * 1.6 * k * out)
	end
	for k = 1, 16 do
		local a, y = k * 2.4, -1.5 + (k % 8) * 0.45
		local pos = surface(a, y, 0.97)
		local sz = 0.45 + (k % 3) * 0.18
		r:part("egg", "ball", v3(sz, sz * 1.2, 0.22), CFrame.lookAt(pos, pos * 2 - v3(0, y, 0)), k % 2 == 0 and E.belly or E.dark)
	end
	for k = 0, 17 do
		local a = k / 18 * math.pi * 2
		local y = -0.15 + (k % 2) * 0.45
		local b = (k + 1) / 18 * math.pi * 2
		r:bone("egg", surface(a, y, 1.015), surface(b, -0.15 + ((k + 1) % 2) * 0.45, 1.015), 0.13, E.fx).Material = Enum.Material.Neon
	end
	if isKing then
		for k = 0, 9 do
			local a = k / 10 * math.pi * 2
			r:part("egg", "block", v3(0.45, k % 2 == 0 and 1.2 or 0.65, 0.2), CFrame.new(math.cos(a) * 0.8, 2.35, math.sin(a) * 0.8) * ang(0, -a + math.pi / 2, 0), E.horn, Enum.Material.Neon)
		end
		local top = Instance.new("Attachment", shell)
		local beamTop = Instance.new("Attachment", shell)
		beamTop.Position = v3(0, 90, 0)
		local beam = Instance.new("Beam", shell)
		beam.Attachment0, beam.Attachment1, beam.Width0, beam.Width1, beam.FaceCamera = top, beamTop, 3, 8, true
		beam.Color, beam.LightEmission, beam.Transparency = ColorSequence.new(E.fx), 1, NumberSequence.new(0.35, 1)
	end
	local e = V.emitter(shell, E.fx, 10, 0.7 * scale, 1.4, 4)
	e.SpreadAngle = Vector2.new(180, 180)
	r.aura = e
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Parent = E.fx, 14 * scale, 1.6, shell
	return r
end

function V.animateEgg(r, rootCF, state, t, intensity)
	t = t + r.phase
	local cf = CFrame.new(0, math.sin(t * 2) * 0.18 * r.s, 0)
	if state == "ready" then
		local burst = math.sin(t * 2.5) > 0.2 and 1 or 0.15
		cf = cf * ang(0, 0, math.sin(t * 22) * 0.16 * burst)
		r.aura.Rate = 35
	elseif state == "shake" then
		cf = ang(math.cos(t * 31) * 0.3 * intensity, 0, math.sin(t * 37) * 0.35 * intensity)
	end
	r.joints.egg.anim = cf
	r:solve(rootCF)
end

return V
]]></ProtectedString></Properties></Item>
