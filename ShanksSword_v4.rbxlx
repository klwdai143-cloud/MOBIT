<Item class="StarterGui" referent="RBX14"><Properties><string name="Name">StarterGui</string></Properties><Item class="ScreenGui" referent="RBX13"><Properties><string name="Name">HakiGui</string><bool name="ResetOnSpawn">false</bool></Properties><Item class="LocalScript" referent="RBX12"><Properties><string name="Name">HakiButton</string><ProtectedString name="Source">local player = game:GetService("Players").LocalPlayer
local b = Instance.new("TextButton")
b.AnchorPoint, b.Position, b.Size = Vector2.new(1, .5), UDim2.new(1, -18, .5, 0), UDim2.new(0, 90, 0, 90)
b.BackgroundColor3, b.TextColor3 = Color3.fromRGB(35, 0, 8), Color3.new(1, 1, 1)
b.Font, b.TextSize, b.Text, b.Visible = Enum.Font.Bangers, 30, "HAKI", false
Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
local s = Instance.new("UIStroke", b)
s.ApplyStrokeMode, s.Color, s.Thickness = Enum.ApplyStrokeMode.Border, Color3.fromRGB(220, 0, 30), 4
b.Parent = script.Parent

local function remote()
	local c = player.Character
	local t = c and c:FindFirstChild("Gryphon")
	return t and t:FindFirstChild("Action")
end
b.MouseButton1Click:Connect(function()
	local r = remote()
	if r then r:FireServer("Haki") end
end)
local last
while true do
	local r = remote()
	b.Visible = r ~= nil
	if r and r ~= last then r:FireServer("Button") end
	last = r
	task.wait(0.2)
end
