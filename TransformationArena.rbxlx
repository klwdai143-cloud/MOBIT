<roblox version="4"><Item class="Workspace" referent="RBX3"><Properties><string name="Name">Workspace</string></Properties><Item class="Part" referent="RBX1"><Properties><string name="Name">Baseplate</string><bool name="Anchored">true</bool><Vector3 name="size"><X>512</X><Y>20</Y><Z>512</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>-10</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item><Item class="SpawnLocation" referent="RBX2"><Properties><string name="Name">SpawnLocation</string><bool name="Anchored">true</bool><int name="Duration">0</int><bool name="Neutral">true</bool><Vector3 name="size"><X>8</X><Y>1</Y><Z>8</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>2.5</Y><Z>18</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX6"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="RemoteEvent" referent="RBX4"><Properties><string name="Name">TransformEvent</string></Properties></Item><Item class="RemoteEvent" referent="RBX5"><Properties><string name="Name">TransformFX</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX9"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX7"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
Lighting.ClockTime = 0
Lighting.Brightness = 0.5
Lighting.Ambient = Color3.fromRGB(45, 40, 80)
Lighting.OutdoorAmbient = Color3.fromRGB(60, 50, 110)

local function fx(class, props)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = Lighting
end
fx("BloomEffect", {Intensity = 1.2, Size = 40, Threshold = 0.8})
fx("ColorCorrectionEffect", {Contrast = 0.15, Saturation = 0.25})
fx("Atmosphere", {Density = 0.25, Color = Color3.fromRGB(120, 90, 200), Decay = Color3.fromRGB(40, 20, 80), Haze = 1})
fx("Sky", {StarCount = 3000})

local function new(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end

local base = workspace:WaitForChild("Baseplate")
base.Color = Color3.fromRGB(20, 18, 35)
base.Material = Enum.Material.Slate

local arena = new("Folder", {Name = "Arena"}, workspace)
local flat = CFrame.Angles(0, 0, math.pi / 2)

new("Part", {Name = "Platform", Shape = Enum.PartType.Cylinder, Anchored = true, Size = Vector3.new(2, 60, 60),
	CFrame = CFrame.new(0, 1, 0) * flat, Color = Color3.fromRGB(30, 26, 55), Material = Enum.Material.Marble}, arena)
new("Part", {Name = "NeonRing", Shape = Enum.PartType.Cylinder, Anchored = true, CanCollide = false, Size = Vector3.new(0.3, 61, 61),
	CFrame = CFrame.new(0, 2.05, 0) * flat, Color = Color3.fromRGB(170, 80, 255), Material = Enum.Material.Neon}, arena)
new("Part", {Name = "InnerRing", Shape = Enum.PartType.Cylinder, Anchored = true, CanCollide = false, Size = Vector3.new(0.3, 30, 30),
	CFrame = CFrame.new(0, 2.05, 0) * flat, Color = Color3.fromRGB(80, 200, 255), Material = Enum.Material.Neon}, arena)

local palette = {
	Color3.fromRGB(255, 80, 20), Color3.fromRGB(100, 210, 255), Color3.fromRGB(255, 235, 50),
	Color3.fromRGB(100, 255, 130), Color3.fromRGB(190, 80, 255),
}
for i = 1, 10 do
	local a = i / 10 * math.pi * 2
	local col = palette[(i - 1) % #palette + 1]
	local p = new("Part", {Name = "Pillar", Anchored = true, Size = Vector3.new(4, 26, 4),
		CFrame = CFrame.new(math.cos(a) * 45, 13, math.sin(a) * 45), Color = col, Material = Enum.Material.Neon}, arena)
	new("PointLight", {Color = col, Range = 40, Brightness = 3}, p)
	new("ParticleEmitter", {Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(col),
		LightEmission = 1, Rate = 8, Lifetime = NumberRange.new(2, 3), Speed = NumberRange.new(2, 5),
		Size = NumberSequence.new(1, 0), SpreadAngle = Vector2.new(180, 180)}, p)
end

local sign = new("Part", {Name = "Sign", Anchored = true, CanCollide = false, Transparency = 1, Size = Vector3.new(1, 1, 1),
	CFrame = CFrame.new(0, 22, 0)}, arena)
local bb = new("BillboardGui", {Size = UDim2.new(0, 500, 0, 90), AlwaysOnTop = false, MaxDistance = 300}, sign)
new("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "☀️ GEAR 5 ARENA ☀️",
	Font = Enum.Font.GothamBlack, TextScaled = true, TextColor3 = Color3.fromRGB(220, 160, 255),
	TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(60, 0, 120)}, bb)

local function dummy(pos)
	local m = new("Model", {Name = "Dummy"}, workspace)
	local torso = new("Part", {Name = "Torso", Size = Vector3.new(2, 2, 1), Color = Color3.fromRGB(200, 160, 90), Anchored = true, Position = pos + Vector3.new(0, 3, 0)}, m)
	new("Part", {Name = "Head", Size = Vector3.new(1.4, 1.4, 1.4), Color = Color3.fromRGB(230, 190, 120), Anchored = true, Position = pos + Vector3.new(0, 4.7, 0)}, m)
	new("Part", {Name = "Base", Size = Vector3.new(1, 3, 1), Color = Color3.fromRGB(90, 70, 50), Anchored = true, Position = pos + Vector3.new(0, 1.5, 0)}, m)
	local h = new("Humanoid", {MaxHealth = 400, Health = 400}, m)
	m.PrimaryPart = torso
	h.HealthChanged:Connect(function(hp)
		if hp <= 100 then
			local hl = new("Highlight", {FillColor = Color3.new(1, 1, 1), FillTransparency = 0.3}, m)
			game:GetService("Debris"):AddItem(hl, 0.25)
			task.wait(0.1)
			h.Health = h.MaxHealth
		end
	end)
end
for i = 1, 5 do
	local a = (i - 3) * 0.5
	dummy(Vector3.new(math.sin(a) * 28, 2, -math.cos(a) * 28 - 4))
end
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX8"><Properties><string name="Name">TransformServer</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Event = RS:WaitForChild("TransformEvent")
local FX = RS:WaitForChild("TransformFX")

local COOLDOWN, PUNCH_COOLDOWN = 4, 1.2
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 220, 120)
local BOOM = "rbxasset://sounds/impact_explosion_03.mp3"

local states, last, lastPunch = {}, {}, {}

local function new(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end
local function tf(class, props, parent)
	local i = new(class, props, nil)
	i:SetAttribute("TF", true)
	i.Parent = parent
	return i
end
local function fxPart(props)
	props.Anchored = true; props.CanCollide = false; props.CanQuery = false; props.CanTouch = false
	return new("Part", props, workspace)
end
local function sound(parent, id, vol, speed)
	local s = new("Sound", {SoundId = id, Volume = vol, PlaybackSpeed = speed or 1, RollOffMaxDistance = 200}, parent)
	s:Play()
	Debris:AddItem(s, 5)
end
local function ring(pos, color, size, dur)
	local r = fxPart({Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = color, Size = Vector3.new(0.5, 2, 2),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)})
	TweenService:Create(r, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = Vector3.new(0.5, size, size), Transparency = 1}):Play()
	Debris:AddItem(r, dur + 0.2)
end
local function sphereBurst(pos, color, size, dur)
	local p = fxPart({Shape = Enum.PartType.Ball, Material = Enum.Material.Neon, Color = color, Size = Vector3.new(2, 2, 2), Transparency = 0.2, CFrame = CFrame.new(pos)})
	TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = Vector3.new(size, size, size), Transparency = 1}):Play()
	Debris:AddItem(p, dur + 0.2)
end
local function bolt(a, b, color)
	local prev = a
	for i = 1, 5 do
		local pt = a:Lerp(b, i / 5)
		if i < 5 then pt += Vector3.new(math.random(-30, 30) / 10, math.random(-30, 30) / 10, math.random(-30, 30) / 10) end
		local len = (pt - prev).Magnitude
		if len > 0.05 then
			local seg = fxPart({Material = Enum.Material.Neon, Color = color, Size = Vector3.new(0.35, 0.35, len), CFrame = CFrame.lookAt(prev:Lerp(pt, 0.5), pt)})
			TweenService:Create(seg, TweenInfo.new(0.35), {Transparency = 1, Size = Vector3.new(0.05, 0.05, len)}):Play()
			Debris:AddItem(seg, 0.5)
		end
		prev = pt
	end
end
local function randBolts(pos, count, radius)
	for _ = 1, count do
		local d = Vector3.new(math.random() - 0.5, math.random() * 0.7, math.random() - 0.5)
		if d.Magnitude > 0.01 then bolt(pos, pos + d.Unit * radius, math.random() < 0.5 and WHITE or GOLD) end
	end
end
local function cloudBurst(pos, count)
	local p = fxPart({Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(pos)})
	local c = new("ParticleEmitter", {Texture = SMOKE, Color = ColorSequence.new(WHITE), LightEmission = 0.4,
		Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 9)}),
		Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1)}),
		Lifetime = NumberRange.new(1, 2), Speed = NumberRange.new(25, 60), SpreadAngle = Vector2.new(180, 180), Rate = 0, Drag = 4}, p)
	local s = new("ParticleEmitter", {Texture = SPARK, Color = ColorSequence.new(WHITE, GOLD), LightEmission = 1,
		Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 0)}),
		Lifetime = NumberRange.new(0.8, 1.6), Speed = NumberRange.new(30, 80), SpreadAngle = Vector2.new(180, 180), Rate = 0, Drag = 3}, p)
	c:Emit(count)
	s:Emit(count)
	Debris:AddItem(p, 3)
end
local function popText(pos, text)
	local p = fxPart({Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(pos)})
	local bb = new("BillboardGui", {Size = UDim2.new(0, 260, 0, 90), AlwaysOnTop = true, StudsOffset = Vector3.new(0, 3, 0)}, p)
	local l = new("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamBlack, TextScaled = true,
		TextColor3 = GOLD, TextStrokeColor3 = Color3.fromRGB(120, 60, 0), TextStrokeTransparency = 0}, bb)
	TweenService:Create(p, TweenInfo.new(0.8), {Position = pos + Vector3.new(0, 6, 0)}):Play()
	TweenService:Create(l, TweenInfo.new(0.8), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
	Debris:AddItem(p, 1)
end
local function damageAt(owner, char, pos, radius, dmg, dir, force)
	local seen = {}
	for _, part in ipairs(workspace:GetPartBoundsInRadius(pos, radius)) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and model ~= char and not seen[model] then
			local h = model:FindFirstChildOfClass("Humanoid")
			if h and h.Health > 0 then
				seen[model] = true
				h:TakeDamage(dmg)
				local r = model:FindFirstChild("HumanoidRootPart")
				if r and not r.Anchored then
					r.AssemblyLinearVelocity = dir * force + Vector3.new(0, force * 0.45, 0)
				end
			end
		end
	end
end

local function capture(hum)
	return {stats = {WalkSpeed = hum.WalkSpeed, JumpPower = hum.JumpPower, MaxHealth = hum.MaxHealth, UseJumpPower = hum.UseJumpPower}, hidden = {}, busy = false, form = false}
end

local function clearForm(char, s)
	for _, v in ipairs(char:GetDescendants()) do
		if v:GetAttribute("TF") then v:Destroy() end
	end
	for part, t in pairs(s.hidden) do
		if part.Parent then part.Transparency = t end
	end
	s.hidden = {}
end

local function mk(cls, props, to, c0, parent)
	props.Massless = true; props.CanCollide = false; props.CanQuery = false; props.CanTouch = false
	props.CFrame = to.CFrame * c0
	local p = tf(cls, props, parent)
	local w = new("Weld", {Part0 = to, Part1 = p, C0 = c0}, p)
	return p, w
end

local function applyForm(char, hum, s)
	clearForm(char, s)
	local hrp = char.HumanoidRootPart
	local head = char:FindFirstChild("Head")
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	for _, acc in ipairs(char:GetChildren()) do
		if acc:IsA("Accessory") then
			local h = acc:FindFirstChild("Handle")
			if h then s.hidden[h] = h.Transparency; h.Transparency = 1 end
		end
	end

	local decor = tf("Folder", {Name = "TransformDecor"}, char)

	-- white fluffy hair
	local hair = {}
	if head then
		local hy = head.Size.Y / 2
		for i = 1, 10 do
			local a = i / 10 * math.pi * 2
			local sz = 1.4 + (i % 3) * 0.3
			local off = CFrame.new(math.cos(a) * 0.9, hy + 0.1 + (i % 2) * 0.25, math.sin(a) * 0.9)
			local p, w = mk("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(sz, sz, sz), Color = WHITE, Material = Enum.Material.SmoothPlastic}, head, off, decor)
			hair[#hair + 1] = {w = w, off = off, ph = i}
		end
		for i = 1, 4 do
			local off = CFrame.new((i - 2.5) * 0.5, hy + 0.7 + (i % 2) * 0.2, 0)
			local p, w = mk("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(1.9, 1.9, 1.9), Color = WHITE, Material = Enum.Material.SmoothPlastic}, head, off, decor)
			hair[#hair + 1] = {w = w, off = off, ph = i + 10}
		end
		for _, side in ipairs({-1, 1}) do
			mk("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(0.35, 0.35, 0.2), Color = WHITE, Material = Enum.Material.Neon}, head, CFrame.new(side * 0.28, 0.1, -head.Size.Z / 2 - 0.02), decor)
		end
	end

	-- cloud puffs, sash and sun rays
	local rays = {}
	if torso then
		for _, side in ipairs({-1, 1}) do
			mk("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), Color = WHITE, Material = Enum.Material.SmoothPlastic}, torso, CFrame.new(side * 1.5, 0.9, 0), decor)
			mk("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Color = WHITE, Material = Enum.Material.SmoothPlastic}, torso, CFrame.new(side * 1.8, -0.9, 0), decor)
		end
		for i = 1, 8 do
			local a = i / 8 * math.pi * 2
			mk("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(1.3, 1.3, 1.3), Color = WHITE, Material = Enum.Material.SmoothPlastic}, torso, CFrame.new(math.cos(a) * 1.3, -1, math.sin(a) * 0.9), decor)
		end
		for i = 1, 12 do
			local _, w = mk("Part", {Size = Vector3.new(0.35, 2.2, 0.2), Color = GOLD, Material = Enum.Material.Neon}, torso, CFrame.new(), decor)
			rays[i] = w
		end
		tf("ParticleEmitter", {Texture = SMOKE, Color = ColorSequence.new(WHITE), LightEmission = 0.3,
			Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 5)}),
			Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1)}),
			Lifetime = NumberRange.new(1, 1.8), Rate = 35, Speed = NumberRange.new(3, 8), SpreadAngle = Vector2.new(180, 180),
			Acceleration = Vector3.new(0, 5, 0), Rotation = NumberRange.new(0, 360)}, torso)
		tf("ParticleEmitter", {Texture = FIRE, Color = ColorSequence.new(WHITE, GOLD), LightEmission = 1,
			Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 0)}),
			Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1)}),
			Lifetime = NumberRange.new(0.5, 1), Rate = 60, Speed = NumberRange.new(4, 10), SpreadAngle = Vector2.new(180, 180),
			Acceleration = Vector3.new(0, 12, 0)}, torso)
		tf("ParticleEmitter", {Texture = SPARK, Color = ColorSequence.new(WHITE, GOLD), LightEmission = 1,
			Size = NumberSequence.new(0.8, 0), Lifetime = NumberRange.new(0.8, 1.5), Rate = 30, Speed = NumberRange.new(5, 12),
			SpreadAngle = Vector2.new(180, 180)}, torso)
	end

	local feet = tf("Attachment", {Position = Vector3.new(0, -2.8, 0)}, hrp)
	tf("ParticleEmitter", {Texture = SMOKE, Color = ColorSequence.new(WHITE), LightEmission = 0.2,
		Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 5)}),
		Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1)}),
		Lifetime = NumberRange.new(1, 1.6), Rate = 25, Speed = NumberRange.new(2, 5), SpreadAngle = Vector2.new(60, 180),
		Rotation = NumberRange.new(0, 360)}, feet)
	tf("PointLight", {Color = Color3.fromRGB(255, 240, 200), Range = 30, Brightness = 5}, hrp)
	local a0 = tf("Attachment", {Position = Vector3.new(0, 1.5, 0)}, hrp)
	local a1 = tf("Attachment", {Position = Vector3.new(0, -1.5, 0)}, hrp)
	tf("Trail", {Attachment0 = a0, Attachment1 = a1, Lifetime = 0.8, Color = ColorSequence.new(WHITE, GOLD),
		Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1)}),
		LightEmission = 0.8, FaceCamera = true}, hrp)
	tf("Highlight", {Adornee = char, FillColor = WHITE, OutlineColor = GOLD, FillTransparency = 0.75, OutlineTransparency = 0}, char)

	hum.UseJumpPower = true
	hum.MaxHealth = 400
	hum.Health = 400
	hum.WalkSpeed = 30
	hum.JumpPower = 85

	task.spawn(function()
		local t, tick = 0, 0
		while decor.Parent do
			t += task.wait(0.03)
			for _, h in ipairs(hair) do
				if h.w.Parent then
					h.w.C0 = h.off * CFrame.new(0, math.sin(t * 5 + h.ph) * 0.12, math.cos(t * 4 + h.ph) * 0.1)
				end
			end
			for i, w in ipairs(rays) do
				if w.Parent then
					local a = i / #rays * math.pi * 2 + t * 0.7
					w.C0 = CFrame.new(0, 0.6, 1.6) * CFrame.Angles(0, 0, a) * CFrame.new(0, 4.2, 0)
				end
			end
			tick += 0.03
			if tick > 0.7 and hrp.Parent then
				tick = 0
				randBolts(hrp.Position, 2, 9)
			end
		end
	end)
end

local function doTransform(player, char, hum, hrp, s)
	local base = hrp.CFrame
	local rot = base.Rotation
	local pos0 = base.Position
	hrp.Anchored = true
	FX:FireClient(player, "charge")

	local glow = fxPart({Shape = Enum.PartType.Ball, Material = Enum.Material.Neon, Color = WHITE, Transparency = 0.7, Size = Vector3.new(4, 4, 4), CFrame = base})
	TweenService:Create(glow, TweenInfo.new(1.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = Vector3.new(14, 14, 14), Transparency = 0.35}):Play()
	for i = 1, 3 do
		task.delay((i - 1) * 0.55, function()
			if not hrp.Parent then return end
			sound(hrp, BOOM, 1.3, 0.3 + i * 0.04)
			ring(hrp.Position, i == 3 and GOLD or WHITE, 18 + i * 12, 0.6)
			sphereBurst(hrp.Position, WHITE, 8 + i * 4, 0.4)
			FX:FireClient(player, "beat", i)
		end)
	end
	local em = new("ParticleEmitter", {Texture = SPARK, Color = ColorSequence.new(WHITE, GOLD), LightEmission = 1,
		Size = NumberSequence.new(1.5, 0), Lifetime = NumberRange.new(0.6, 1), Rate = 160, Speed = NumberRange.new(8, 16), SpreadAngle = Vector2.new(180, 180)}, hrp)

	local dur = 1.7
	local t0 = os.clock()
	while hrp.Parent do
		local a = (os.clock() - t0) / dur
		if a >= 1 then break end
		local j = 0.2 * a
		hrp.CFrame = CFrame.new(pos0 + Vector3.new((math.random() - 0.5) * j, a * 4 + (math.random() - 0.5) * j, (math.random() - 0.5) * j)) * rot
		glow.CFrame = hrp.CFrame
		task.wait()
	end
	em:Destroy()
	glow:Destroy()
	if not hrp.Parent then return end

	local pos = hrp.Position
	FX:FireClient(player, "boom")
	sound(hrp, BOOM, 2, 0.8)
	sphereBurst(pos, WHITE, 70, 0.8)
	sphereBurst(pos, GOLD, 40, 0.5)
	ring(pos, WHITE, 80, 0.8)
	ring(pos, GOLD, 130, 1.2)
	ring(pos - Vector3.new(0, 2.5, 0), WHITE, 170, 1.5)
	cloudBurst(pos, 120)
	randBolts(pos, 18, 32)
	damageAt(player, char, pos, 28, 20, Vector3.yAxis, 70)
	applyForm(char, hum, s)
	s.form = true
	FX:FireClient(player, "state", true)
	task.wait(0.3)

	local target = Vector3.new(pos0.X, pos0.Y, pos0.Z)
	local startPos = hrp.Position
	local t1 = os.clock()
	while hrp.Parent do
		local a = (os.clock() - t1) / 0.4
		if a >= 1 then break end
		hrp.CFrame = CFrame.new(startPos:Lerp(target, a * a)) * rot
		task.wait()
	end
	if hrp.Parent then
		hrp.CFrame = CFrame.new(target) * rot
		ring(target - Vector3.new(0, 3, 0), GOLD, 55, 0.6)
		cloudBurst(target - Vector3.new(0, 2, 0), 40)
	end
end

local function doRevert(player, char, hum, hrp, s)
	local pos = hrp.Position
	FX:FireClient(player, "boom")
	FX:FireClient(player, "state", false)
	sphereBurst(pos, WHITE, 30, 0.5)
	ring(pos, GOLD, 60, 0.7)
	cloudBurst(pos, 60)
	clearForm(char, s)
	hum.MaxHealth = s.stats.MaxHealth
	hum.Health = math.min(hum.Health, s.stats.MaxHealth)
	hum.WalkSpeed = s.stats.WalkSpeed
	hum.JumpPower = s.stats.JumpPower
	s.form = false
end

local function doPunch(player, char, hum, hrp, target)
	local origin = hrp.Position + Vector3.new(0, 1, 0)
	local dir = hrp.CFrame.LookVector
	if typeof(target) == "Vector3" and target == target then
		local d = target - origin
		if d.Magnitude > 1 then dir = d.Unit end
	end
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude > 0.01 then
		hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat)
	end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local res = workspace:Raycast(origin, dir * 70, params)
	local dist = res and res.Distance or 70

	sound(hrp, BOOM, 1, 1.6)
	local arm = fxPart({Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 245, 220), Size = Vector3.new(1, 1.6, 1.6), CFrame = CFrame.new(origin)})
	local fist = fxPart({Shape = Enum.PartType.Ball, Material = Enum.Material.Neon, Color = WHITE, Size = Vector3.new(4.5, 4.5, 4.5), CFrame = CFrame.new(origin)})
	local steps = 8
	for i = 1, steps do
		local len = math.max(dist * i / steps, 1)
		local mid = origin + dir * len / 2
		arm.Size = Vector3.new(len, 1.6, 1.6)
		arm.CFrame = CFrame.lookAt(mid, mid + dir) * CFrame.Angles(0, math.pi / 2, 0)
		fist.Position = origin + dir * len
		task.wait(0.02)
	end
	local e = origin + dir * dist
	sphereBurst(e, WHITE, 26, 0.5)
	sphereBurst(e, GOLD, 14, 0.3)
	ring(e, GOLD, 40, 0.6)
	cloudBurst(e, 60)
	randBolts(e, 8, 14)
	sound(hrp, BOOM, 1.8, 0.9)
	popText(e + Vector3.new(0, 2, 0), "BAM!")
	damageAt(player, char, e, 11, 60, dir, 140)
	FX:FireClient(player, "impact")
	TweenService:Create(arm, TweenInfo.new(0.3), {Transparency = 1, Size = Vector3.new(arm.Size.X, 0.2, 0.2)}):Play()
	TweenService:Create(fist, TweenInfo.new(0.3), {Transparency = 1}):Play()
	Debris:AddItem(arm, 0.4)
	Debris:AddItem(fist, 0.4)
end

Event.OnServerEvent:Connect(function(player, action, arg)
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then return end
	local s = states[player]
	if not s then s = capture(hum); states[player] = s end

	if action == "toggle" then
		if s.busy or os.clock() - (last[player] or 0) < COOLDOWN then return end
		last[player] = os.clock()
		s.busy = true
		pcall(function()
			if s.form then doRevert(player, char, hum, hrp, s) else doTransform(player, char, hum, hrp, s) end
		end)
		if hrp.Parent then hrp.Anchored = false end
		s.busy = false
	elseif action == "punch" then
		if not s.form or s.busy or os.clock() - (lastPunch[player] or 0) < PUNCH_COOLDOWN then return end
		lastPunch[player] = os.clock()
		pcall(doPunch, player, char, hum, hrp, arg)
	end
end)

local function hook(pl)
	pl.CharacterAdded:Connect(function()
		states[pl] = nil
		FX:FireClient(pl, "state", false)
	end)
end
Players.PlayerAdded:Connect(hook)
for _, pl in ipairs(Players:GetPlayers()) do hook(pl) end
Players.PlayerRemoving:Connect(function(pl) states[pl] = nil; last[pl] = nil; lastPunch[pl] = nil end)
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX12"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX11"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX10"><Properties><string name="Name">TransformClient</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local Event = RS:WaitForChild("TransformEvent")
local FX = RS:WaitForChild("TransformFX")
local COOLDOWN, PUNCH_CD = 4, 1.2
local GOLD = Color3.fromRGB(255, 220, 120)

local function corner(i, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = i end
local function stroke(i, col, th) local s = Instance.new("UIStroke"); s.Color = col; s.Thickness = th; s.Parent = i end
local function gradient(i, c1, c2, rot) local g = Instance.new("UIGradient"); g.Color = ColorSequence.new(c1, c2); g.Rotation = rot; g.Parent = i end

local gui = Instance.new("ScreenGui")
gui.Name = "TransformUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local flash = Instance.new("Frame")
flash.Size = UDim2.new(1, 0, 1, 0)
flash.BackgroundColor3 = Color3.new(1, 1, 1)
flash.BackgroundTransparency = 1
flash.BorderSizePixel = 0
flash.ZIndex = 50
flash.Parent = gui

local function makeButton(text, size, pos)
	local b = Instance.new("TextButton")
	b.AnchorPoint = Vector2.new(0.5, 1)
	b.Position = pos
	b.Size = size
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.Font = Enum.Font.GothamBlack
	b.TextSize = 24
	b.TextColor3 = Color3.fromRGB(60, 30, 0)
	b.AutoButtonColor = false
	b.ClipsDescendants = true
	b.Parent = gui
	corner(b, 16)
	gradient(b, Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 205, 90), 90)
	stroke(b, Color3.fromRGB(255, 255, 255), 3)
	local bar = Instance.new("Frame")
	bar.AnchorPoint = Vector2.new(0, 1)
	bar.Position = UDim2.new(0, 0, 1, 0)
	bar.Size = UDim2.new(0, 0, 0, 6)
	bar.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
	bar.BorderSizePixel = 0
	bar.Parent = b
	return b, bar
end

local main, mainBar = makeButton("☀️ GEAR 5  [T]", UDim2.new(0, 260, 0, 64), UDim2.new(0.5, 0, 1, -24))
local pulse = Instance.new("UIScale")
pulse.Parent = main
TweenService:Create(pulse, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Scale = 1.06}):Play()

local punchBtn, punchBar = makeButton("👊 PUNCH  [F]", UDim2.new(0, 200, 0, 54), UDim2.new(0.5, 0, 1, -100))
punchBtn.TextSize = 20
punchBtn.Visible = false

local inForm, mainCd, punchCd = false, false, false

local function cooldown(bar, dur, onDone)
	bar.Size = UDim2.new(1, 0, 0, 6)
	local tw = TweenService:Create(bar, TweenInfo.new(dur, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 6)})
	tw:Play()
	tw.Completed:Connect(onDone)
end

local function updateText()
	main.Text = inForm and "↩ REVERT  [T]" or "☀️ GEAR 5  [T]"
end

local function toggle()
	if mainCd then return end
	mainCd = true
	main.Text = "..."
	Event:FireServer("toggle")
	cooldown(mainBar, COOLDOWN, function() mainCd = false; updateText() end)
end

local function punch()
	if punchCd or not inForm then return end
	punchCd = true
	local target = mouse.Hit.Position
	Event:FireServer("punch", target)
	cooldown(punchBar, PUNCH_CD, function() punchCd = false end)
end

main.Activated:Connect(toggle)
punchBtn.Activated:Connect(punch)
UIS.InputBegan:Connect(function(input, processed)
	if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if input.KeyCode == Enum.KeyCode.T then toggle()
	elseif input.KeyCode == Enum.KeyCode.F then punch() end
end)

local function shake(duration, mag)
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local a = (os.clock() - t0) / duration
		if not hum or a >= 1 then
			if hum then hum.CameraOffset = Vector3.zero end
			conn:Disconnect()
			return
		end
		local m = mag * (1 - a)
		hum.CameraOffset = Vector3.new((math.random() - 0.5) * m, (math.random() - 0.5) * m, 0)
	end)
end

local function pulseFlash(color, alpha, dur)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = alpha
	TweenService:Create(flash, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
end

FX.OnClientEvent:Connect(function(kind, arg)
	local cam = workspace.CurrentCamera
	if kind == "charge" then
		TweenService:Create(cam, TweenInfo.new(1.7, Enum.EasingStyle.Quad), {FieldOfView = 55}):Play()
	elseif kind == "beat" then
		pulseFlash(Color3.new(1, 1, 1), 0.65, 0.4)
		shake(0.45, 0.9 + (arg or 1) * 0.5)
	elseif kind == "boom" then
		pulseFlash(Color3.new(1, 1, 1), 0, 1.1)
		cam.FieldOfView = 105
		TweenService:Create(cam, TweenInfo.new(1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {FieldOfView = 70}):Play()
		shake(0.9, 2.5)
	elseif kind == "impact" then
		pulseFlash(GOLD, 0.7, 0.3)
		shake(0.4, 1.6)
	elseif kind == "state" then
		inForm = arg
		punchBtn.Visible = arg
		if not mainCd then updateText() end
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>