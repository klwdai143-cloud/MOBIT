<Item class="Part" referent="RBX727"><Properties><string name="Name">P</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="Material">272</token><token name="shape">0</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>93.4531003317431</X><Y>-58.93436716790099</Y><Z>228.51072637250024</Z><R00>1.00000</R00><R01>-0.00000</R01><R02>0.00000</R02><R10>0.00000</R10><R11>1.00000</R11><R12>0.00000</R12><R20>-0.00000</R20><R21>0.00000</R21><R22>1.00000</R22></CoordinateFrame><Vector3 name="size"><X>42.55449786772827</X><Y>42.55449786772827</Y><Z>42.55449786772827</Z></Vector3><Color3uint8 name="Color3uint8">4283123300</Color3uint8></Properties></Item>
<Item class="SpawnLocation" referent="RBX728"><Properties><string name="Name">Spawn</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="Material">800</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>0</X><Y>0.5</Y><Z>0</Z><R00>1.00000</R00><R01>-0.00000</R01><R02>0.00000</R02><R10>0.00000</R10><R11>1.00000</R11><R12>0.00000</R12><R20>-0.00000</R20><R21>0.00000</R21><R22>1.00000</R22></CoordinateFrame><Vector3 name="size"><X>8</X><Y>1</Y><Z>8</Z></Vector3><Color3uint8 name="Color3uint8">4285427325</Color3uint8></Properties></Item>
