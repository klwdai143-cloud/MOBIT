<Item class="Part" referent="RBX1510"><Properties><string name="Name">P</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><float name="Transparency">0</float><token name="Material">896</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>260.2981352825444</X><Y>62.99409539033781</Y><Z>-78.23961039688571</Z><R00>0.63337</R00><R01>-0.36568</R01><R02>0.68200</R02><R10>0.50000</R10><R11>0.86603</R11><R12>0.00000</R12><R20>-0.59063</R20><R21>0.34100</R21><R22>0.73135</R22></CoordinateFrame><Vector3 name="size"><X>21.14486129739231</X><Y>16.91588903791385</Y><Z>21.14486129739231</Z></Vector3><Color3uint8 name="Color3uint8">4282133815</Color3uint8></Properties></Item>
