<Item class="ServerScriptService" referent="RBX429"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX428"><Properties><string name="Name">OnePieceGame</string><ProtectedString name="Source">local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local DataStoreService = game:GetService("DataStoreService")
local rng = Random.new()
local rgb = Color3.fromRGB

local ISLANDS = {
	{x = -540, name = "قرية فوشا", req = 0, mult = 3, foe = "قاطع طريق", hp = 60, dmg = 5, beli = 15, boss = "Higuma", color = rgb(130, 90, 60)},
	{x = -180, name = "حديقة أرلونج", req = 500, mult = 15, foe = "رجل سمكة", hp = 600, dmg = 25, beli = 80, boss = "Arlong", color = rgb(60, 130, 190)},
	{x = 180, name = "ألاباستا", req = 5000, mult = 80, foe = "عميل باروك", hp = 5000, dmg = 90, beli = 500, boss = "Crocodile", color = rgb(190, 150, 80)},
	{x = 540, name = "مارين فورد", req = 50000, mult = 400, foe = "جندي بحرية", hp = 40000, dmg = 320, beli = 3500, boss = "Akainu", color = rgb(235, 240, 250)},
}
local FRUITS = {
	{name = "Gomu Gomu", price = 500, mult = 2, color = rgb(255, 90, 120)},
	{name = "Mera Mera", price = 8000, mult = 5, color = rgb(255, 120, 0)},
	{name = "Goro Goro", price = 80000, mult = 12, color = rgb(90, 200, 255)},
}
local RANKS = {
	{0, "مبتدئ", rgb(200, 200, 200)}, {500, "قرصان", rgb(90, 220, 90)}, {5000, "سوبر نوفا", rgb(80, 160, 255)},
	{50000, "شيشيبوكاي", rgb(180, 80, 255)}, {250000, "يونكو", rgb(255, 40, 60)}, {1000000, "ملك القراصنة", rgb(255, 205, 30)},
}
local data = {}

local function short(n)
	if n &gt;= 1e9 then return string.format("%.1fB", n / 1e9) end
	if n &gt;= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n &gt;= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end
local function tween(o, t, props) TweenService:Create(o, TweenInfo.new(t), props):Play() end
local function part(size, cf, color, transparency, life, material)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
	p.Material, p.Size, p.CFrame, p.Color, p.Transparency = material or Enum.Material.Neon, size, cf, color, transparency or 0
	p.Parent = workspace
	if life then Debris:AddItem(p, life) end
	return p
end
local function label(parent, text, color, y, w, h)
	local g = Instance.new("BillboardGui")
	g.Size, g.StudsOffset, g.MaxDistance = UDim2.fromScale(w or 10, h or 2.5), Vector3.new(0, y, 0), 220
	local t = Instance.new("TextLabel", g)
	t.Size, t.BackgroundTransparency, t.Font, t.TextScaled = UDim2.fromScale(1, 1), 1, Enum.Font.GothamBlack, true
	t.Text, t.TextColor3, t.TextStrokeTransparency = text, color, 0
	g.Parent = parent
	return t, g
end
local function popup(at, text, color)
	local p = part(Vector3.one, CFrame.new(at + rng:NextUnitVector() * 1.5), color, 1, .8)
	label(p, text, color, 1, 5, 1.4)
	tween(p, .8, {Position = p.Position + Vector3.new(0, 4, 0)})
end
local function burst(pos, color, radius)
	local b = part(Vector3.one, CFrame.new(pos), color, .2, .4, Enum.Material.ForceField)
	b.Shape = Enum.PartType.Ball
	tween(b, .4, {Size = Vector3.one * radius * 2, Transparency = 1})
	for _ = 1, 8 do
		local d = rng:NextUnitVector()
		local s = part(Vector3.new(.2, .2, 1.5), CFrame.lookAt(pos, pos + d), color, 0, .3)
		tween(s, .3, {CFrame = s.CFrame * CFrame.new(0, 0, -radius), Transparency = 1})
	end
end
local function sound(where, id, volume, speed)
	local s = Instance.new("Sound")
	s.SoundId, s.Volume, s.PlaybackSpeed, s.Parent = "rbxasset://sounds/" .. id, volume, speed, where
	s:Play()
	Debris:AddItem(s, 3)
end

-- أنميشن من السيرفر
local function R(x, y, z) return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z)) end
local MOVES = {
	[Enum.HumanoidRigType.R15] = {
		{Waist = R(0,35,0), RightShoulder = R(95,0,0), LeftShoulder = R(40,0,-20), LeftElbow = R(100,0,0)},
		{Waist = R(0,-35,0), LeftShoulder = R(95,0,0), RightShoulder = R(40,0,20), RightElbow = R(100,0,0)},
		{Waist = R(15,20,0), RightShoulder = R(165,0,0), Root = CFrame.new(0,.4,0)},
		{Waist = R(22,0,0), RightHip = R(100,0,0), LeftShoulder = R(20,0,-60), RightShoulder = R(20,0,60)},
		hurt = {Waist = R(28,12,0), Neck = R(30,0,0)},
		walkA = {RightHip = R(35,0,0), LeftHip = R(-35,0,0)}, walkB = {RightHip = R(-35,0,0), LeftHip = R(35,0,0)},
	},
	[Enum.HumanoidRigType.R6] = {
		{RootJoint = R(0,0,35), ["Right Shoulder"] = R(0,0,90)},
		{RootJoint = R(0,0,-35), ["Left Shoulder"] = R(0,0,-90)},
		{RootJoint = R(-15,0,20), ["Right Shoulder"] = R(0,0,165)},
		{RootJoint = R(-20,0,0), ["Right Hip"] = R(0,0,95)},
		hurt = {RootJoint = R(-22,0,10), Neck = R(-25,0,0)},
		walkA = {["Right Hip"] = R(0,0,35), ["Left Hip"] = R(0,0,35)}, walkB = {["Right Hip"] = R(0,0,-35), ["Left Hip"] = R(0,0,-35)},
	},
}
local rigs = setmetatable({}, {__mode = "k"})
local function pose(model, key, back)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local rig = rigs[model]
	if not rig then
		rig = {}
		for _, j in model:GetDescendants() do
			if j:IsA("Motor6D") then rig[j.Name] = {j, "C0", j.C0}
			elseif j:IsA("AnimationConstraint") and j.Attachment0 then rig[j.Name] = {j.Attachment0, "CFrame", j.Attachment0.CFrame} end
		end
		rigs[model] = rig
	end
	local p = key and MOVES[hum.RigType][key] or {}
	for name, d in rig do tween(d[1], .09, {[d[2]] = d[3] * (p[name] or CFrame.identity)}) end
	if back then
		local mark = os.clock()
		model:SetAttribute("Pose", mark)
		task.delay(back, function()
			if model:GetAttribute("Pose") == mark then pose(model) end
		end)
	end
end

local function rankOf(power)
	local r = 1
	for i, v in RANKS do if power &gt;= v[1] then r = i end end
	return r
end
local function notify(player, text)
	local hud = player.PlayerGui:FindFirstChild("HUD")
	if hud then
		hud.Msg.Text = text
		task.delay(2.5, function() if hud.Parent and hud.Msg.Text == text then hud.Msg.Text = "" end end)
	end
end
local function multiplier(d) return (d.fruit &gt; 0 and FRUITS[d.fruit].mult or 1) * (1 + d.rebirth) end

local function refresh(player)
	local d, hud = data[player], player.PlayerGui:FindFirstChild("HUD")
	if not d then return end
	local r = rankOf(d.power)
	local ls = player:FindFirstChild("leaderstats")
	if ls then ls.Power.Value, ls.Beli.Value, ls.Rebirth.Value = short(d.power), short(d.beli), tostring(d.rebirth) end
	if hud then
		local goal = "أنت الأقوى! سو ولادة جديدة"
		for _, i in ISLANDS do
			if d.power &lt; i.req then goal = "الهدف: " .. i.name .. " (" .. short(i.req) .. " قوة)" break end
		end
		hud.Stats.Text = "💪 " .. short(d.power) .. "   💰 " .. short(d.beli) .. "   ✖" .. multiplier(d) .. "\n" .. goal
	end
	local c = player.Character
	local root = c and c:FindFirstChild("HumanoidRootPart")
	local head = c and c:FindFirstChild("Head")
	if root and head and c:GetAttribute("Rank") ~= r then
		local up = c:GetAttribute("Rank") ~= nil
		c:SetAttribute("Rank", r)
		for _, n in {"RankTag", "Aura"} do
			local o = c:FindFirstChild(n, true)
			if o then o:Destroy() end
		end
		local _, g = label(head, RANKS[r][2], RANKS[r][3], 2.4, 6, 1.2)
		g.Name = "RankTag"
		if r &gt; 1 then
			local e = Instance.new("ParticleEmitter")
			e.Name, e.Texture, e.Color = "Aura", "rbxasset://textures/particles/fire_main.dds", ColorSequence.new(RANKS[r][3])
			e.Size, e.Transparency, e.LightEmission = NumberSequence.new(r * .5, 0), NumberSequence.new(.6, 1), 1
			e.Rate, e.Lifetime, e.Speed = r * 5, NumberRange.new(.5, .9), NumberRange.new(3, 6)
			e.Parent = root
		end
		if up then
			burst(root.Position, RANKS[r][3], 18)
			sound(root, "impact_water.mp3", 2, .5)
			notify(player, "🔥 رتبة جديدة: " .. RANKS[r][2])
		end
	end
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if hum then
		local max = math.floor(100 + d.power ^ .6 * 3)
		if hum.MaxHealth ~= max then
			hum.MaxHealth, hum.Health = max, max
		end
	end
end

local enemies, stations = {}, {}
local function punch(player, tool)
	local d, c = data[player], player.Character
	local root = c and c:FindFirstChild("HumanoidRootPart")
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if not (d and root and hum and hum.Health &gt; 0 and tool.Parent == c) or os.clock() &lt; d.nextHit then return end
	d.nextHit = os.clock() + .35
	d.combo = d.combo % 4 + 1
	pose(c, d.combo, .22)
	sound(root, "swordslash.wav", .5, 1.4 + d.combo * .1)
	local fruit = FRUITS[d.fruit]
	local color = fruit and fruit.color or RANKS[rankOf(d.power)][3]
	d.hits += 1
	local special = fruit and d.hits % 5 == 0
	local reach = special and 22 or 8
	local damage = math.floor((5 + d.power ^ .85 * .5) * (special and 3 or 1))
	local hit = false
	for model, e in enemies do
		local er = model:FindFirstChild("HumanoidRootPart")
		local offset = er and er.Position - root.Position
		if er and e.hum.Health &gt; 0 and offset.Magnitude &lt; reach and (special or offset.Unit:Dot(root.CFrame.LookVector) &gt; 0) then
			hit = true
			e.by = player
			e.hum:TakeDamage(damage)
			pose(model, "hurt", .25)
			burst(er.Position, color, 5)
			popup(er.Position, "-" .. short(damage), rgb(255, 70, 70))
			sound(er, "impact_water.mp3", 1, 1.5)
			er.AssemblyLinearVelocity = root.CFrame.LookVector * (d.combo == 4 and 50 or 15) + Vector3.new(0, 12, 0)
		end
	end
	if special then
		burst(root.Position, color, 24)
		popup(root.Position + Vector3.new(0, 3, 0), fruit.name .. "!", color)
		sound(root, "swordlunge.wav", 2, .5)
	end
	if not hit then
		local mult = 1
		for _, s in stations do
			if (s.part.Position - root.Position).Magnitude &lt; 13 and d.power &gt;= s.req then
				mult = s.mult
				burst(s.part.Position + rng:NextUnitVector() * 2, color, 4)
				sound(s.part, "impact_water.mp3", .8, 1.8)
			end
		end
		local gain = mult * multiplier(d)
		d.power += gain
		popup(root.Position + root.CFrame.LookVector * 3, "+" .. short(gain) .. " 💪", color)
		refresh(player)
	end
end

local function spawnEnemy(island, home, boss)
	local desc = Instance.new("HumanoidDescription")
	local skin = island.name == "حديقة أرلونج" and rgb(110, 160, 200) or rgb(230, 180, 140)
	desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = skin, skin, skin
	desc.TorsoColor = boss and rgb(120, 10, 20) or island.color
	desc.LeftLegColor, desc.RightLegColor = rgb(35, 35, 45), rgb(35, 35, 45)
	local m = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	m.Name = boss and island.boss or island.foe
	if boss then m:ScaleTo(1.8) end
	m:PivotTo(CFrame.new(home))
	m.Parent = workspace
	local hum, root = m.Humanoid, m.HumanoidRootPart
	local hp = island.hp * (boss and 7 or 1)
	hum.MaxHealth, hum.Health, hum.WalkSpeed = hp, hp, 11
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	root:SetNetworkOwner(nil)
	local text = label(m.Head, "", boss and rgb(255, 60, 60) or Color3.new(1, 1, 1), boss and 4 or 2.5, boss and 11 or 7, boss and 3 or 2)
	local function show() text.Text = (boss and "☠ " or "") .. m.Name .. "\n❤ " .. short(math.ceil(hum.Health)) end
	hum.HealthChanged:Connect(show)
	show()
	local e = {hum = hum}
	enemies[m] = e
	hum.Died:Connect(function()
		enemies[m] = nil
		local d = e.by and data[e.by]
		if d then
			local reward = island.beli * (boss and 10 or 1) * (1 + d.rebirth)
			d.beli += reward
			d.power += math.floor(reward / 3)
			notify(e.by, "💰 +" .. short(reward) .. " هزمت " .. m.Name)
			refresh(e.by)
		end
		burst(root.Position, rgb(255, 200, 40), boss and 25 or 10)
		task.wait(boss and 20 or 5)
		m:Destroy()
		spawnEnemy(island, home, boss)
	end)
	local nextAttack, step = 0, false
	while hum.Health &gt; 0 and m.Parent do
		local target, best = nil, 35
		for _, p in Players:GetPlayers() do
			local c = p.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			local dist = h and h.Health &gt; 0 and (c:GetPivot().Position - root.Position).Magnitude
			if dist and dist &lt; best then target, best = c, dist end
		end
		local goal = target and target:GetPivot().Position or home
		if (goal - root.Position).Magnitude &gt; (boss and 7 or 4.5) then
			hum:MoveTo(goal)
			step = not step
			pose(m, step and "walkA" or "walkB", .35)
		elseif target and os.clock() &gt; nextAttack then
			nextAttack = os.clock() + 1.3
			root.CFrame = CFrame.lookAt(root.Position, Vector3.new(goal.X, root.Position.Y, goal.Z))
			pose(m, boss and rng:NextInteger(3, 4) or rng:NextInteger(1, 2), .3)
			task.wait(.15)
			if hum.Health &gt; 0 and (target:GetPivot().Position - root.Position).Magnitude &lt; 10 then
				target.Humanoid:TakeDamage(island.dmg * (boss and 2 or 1))
				pose(target, "hurt", .2)
				burst(target:GetPivot().Position, rgb(255, 40, 40), boss and 6 or 3)
			end
		end
		task.wait(.25)
	end
end

local function prompt(p, action, fn)
	local q = Instance.new("ProximityPrompt")
	q.ActionText, q.RequiresLineOfSight, q.MaxActivationDistance, q.Parent = action, false, 10, p
	q.Triggered:Connect(function(plr) if data[plr] then fn(plr, data[plr]); refresh(plr) end end)
end
local function pad(pos, color, text, req, dest)
	local p = part(Vector3.new(9, .6, 9), CFrame.new(pos), color, .2)
	p.CanTouch = true
	label(p, text .. (req &gt; 0 and "\n💪 " .. short(req) or ""), color, 6, 14, 4)
	local last = {}
	p.Touched:Connect(function(hit)
		local c = hit.Parent
		local plr = Players:GetPlayerFromCharacter(c)
		local d = plr and data[plr]
		if not d or os.clock() - (last[plr] or 0) &lt; 2 then return end
		last[plr] = os.clock()
		if d.power &lt; req then notify(plr, "🔒 تحتاج " .. short(req) .. " قوة") return end
		burst(c:GetPivot().Position, color, 10)
		c:PivotTo(CFrame.new(dest))
		burst(dest, color, 10)
	end)
end

for i, island in ISLANDS do
	local x = island.x
	-- منطقة التدريب
	local post = part(Vector3.new(4, 10, 4), CFrame.new(x - 45, 7, 0), island.color, 0, nil, i &gt; 2 and Enum.Material.Rock or Enum.Material.Wood)
	post.CanCollide = true
	local zone = part(Vector3.new(.3, 26, 26), CFrame.new(x - 45, 2.2, 0) * CFrame.Angles(0, 0, math.pi / 2), RANKS[i + 1][3], .65)
	zone.Shape = Enum.PartType.Cylinder
	label(post, "🥊 تدريب ✖" .. island.mult, RANKS[i + 1][3], 9, 14, 3)
	table.insert(stations, {part = post, mult = island.mult, req = island.req})
	local sign = part(Vector3.one, CFrame.new(x, 30, 0), island.color, 1)
	label(sign, "🏝 " .. island.name, rgb(255, 220, 80), 0, 40, 9)
	if ISLANDS[i + 1] then
		local n = ISLANDS[i + 1]
		pad(Vector3.new(x + 70, 2.4, 20), rgb(60, 255, 120), "➡ " .. n.name, n.req, Vector3.new(n.x - 20, 7, 55))
	end
	if i &gt; 1 then
		pad(Vector3.new(x - 70, 2.4, 40), rgb(80, 180, 255), "⬅ " .. ISLANDS[i - 1].name, 0, Vector3.new(ISLANDS[i - 1].x + 20, 7, 55))
	end
	for k = 1, 4 do task.spawn(spawnEnemy, island, Vector3.new(x + 15 + (k % 2) * 25, 6, -50 + k * 14), false) end
	task.spawn(spawnEnemy, island, Vector3.new(x + 55, 9, -45), true)
end

for i, f in FRUITS do
	local pos = Vector3.new(-565 + i * 13, 6, 60)
	local ball = part(Vector3.one * 3, CFrame.new(pos), f.color)
	ball.Shape = Enum.PartType.Ball
	TweenService:Create(ball, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Position = pos + Vector3.new(0, 1.5, 0)}):Play()
	label(ball, "🍎 " .. f.name .. "\n✖" .. f.mult .. "  |  💰" .. short(f.price), f.color, 4, 11, 3.5)
	prompt(ball, "اشتر", function(plr, d)
		if d.fruit &gt;= i then notify(plr, "عندك فاكهة أقوى أو نفسها")
		elseif d.beli &lt; f.price then notify(plr, "💰 ما يكفي البيلي")
		else
			d.beli -= f.price
			d.fruit = i
			burst(ball.Position, f.color, 20)
			notify(plr, "أكلت " .. f.name .. "! كل خامس ضربة مهارة")
		end
	end)
end
local altar = part(Vector3.new(5, 7, 5), CFrame.new(-590, 5.5, -45), rgb(255, 205, 30), .1)
label(altar, "👑 ولادة جديدة\n💪 500K", rgb(255, 220, 60), 7, 13, 4)
prompt(altar, "ولادة", function(plr, d)
	local need = 500000 * (d.rebirth + 1)
	if d.power &lt; need then notify(plr, "تحتاج " .. short(need) .. " قوة") return end
	d.power, d.rebirth = 0, d.rebirth + 1
	burst(altar.Position, rgb(255, 220, 60), 35)
	plr:LoadCharacter()
end)

-- السقوط في البحر
local sea = workspace:WaitForChild("Sea")
sea.Touched:Connect(function(hit)
	local c = hit.Parent
	if Players:GetPlayerFromCharacter(c) then
		c:PivotTo(CFrame.new(-540, 7, 30))
	end
end)

local ok, store = pcall(function() return DataStoreService:GetDataStore("OPSim_v1") end)
local function save(player)
	local d = data[player]
	if ok and d and d.loaded then
		pcall(function() store:SetAsync(player.UserId, {power = d.power, beli = d.beli, fruit = d.fruit, rebirth = d.rebirth}) end)
	end
end

local function setup(player)
	if data[player] then return end
	local d = {power = 0, beli = 0, fruit = 0, rebirth = 0, nextHit = 0, combo = 0, hits = 0}
	data[player] = d
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, n in {"Power", "Beli", "Rebirth"} do
		local v = Instance.new("StringValue", ls)
		v.Name = n
	end
	ls.Parent = player
	local function spawned(c)
		local gui = player:WaitForChild("PlayerGui")
		if not gui:FindFirstChild("HUD") then
			local hud = Instance.new("ScreenGui")
			hud.Name, hud.ResetOnSpawn = "HUD", false
			for name, info in {Stats = {.02, .13, Color3.new(1, 1, 1)}, Msg = {.17, .07, rgb(255, 220, 60)}} do
				local t = Instance.new("TextLabel", hud)
				t.Name, t.AnchorPoint, t.Position, t.Size = name, Vector2.new(.5, 0), UDim2.fromScale(.5, info[1]), UDim2.fromScale(.42, info[2])
				t.BackgroundTransparency, t.BackgroundColor3 = name == "Stats" and .35 or 1, rgb(15, 15, 30)
				t.Font, t.TextScaled, t.TextColor3, t.TextStrokeTransparency, t.Text = Enum.Font.GothamBlack, true, info[3], 0, ""
				Instance.new("UICorner", t)
			end
			hud.Parent = gui
		end
		c:WaitForChild("HumanoidRootPart")
		local tool = Instance.new("Tool")
		tool.Name, tool.RequiresHandle, tool.CanBeDropped = "قبضة", false, false
		tool.Activated:Connect(function() punch(player, tool) end)
		tool.Parent = player:WaitForChild("Backpack")
		task.wait(.5)
		if c.Parent then
			c.Humanoid:EquipTool(tool)
			refresh(player)
			notify(player, "اضغط على الشاشة للتدريب والقتال!")
		end
	end
	player.CharacterAdded:Connect(spawned)
	if player.Character then task.spawn(spawned, player.Character) end
	if ok then
		local good, saved = pcall(function() return store:GetAsync(player.UserId) end)
		if good then
			d.loaded = true
			for k, v in saved or {} do d[k] = v end
			refresh(player)
		end
	end
end
Players.PlayerAdded:Connect(setup)
for _, p in Players:GetPlayers() do task.spawn(setup, p) end
Players.PlayerRemoving:Connect(function(p) save(p); data[p] = nil end)
game:BindToClose(function() for p in data do save(p) end end)
task.spawn(function() while true do task.wait(60) for p in data do task.spawn(save, p) end end end)
print("[OnePiece] ready")
</ProtectedString></Properties></Item>
</Item>
</roblox>
