<Item class="ServerScriptService" referent="RBX0015605"><Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Folder" referent="RBX0015606"><Properties>
<string name="Name">Modules</string>
</Properties>
<Item class="ModuleScript" referent="RBX0015607"><Properties>
<string name="Name">Core</string>
<ProtectedString name="Source"><![CDATA[-- Core: shared server state, helpers, hooks and request registry
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Data = require(ReplicatedStorage.Shared.GameData)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Core = { Profiles = {}, Handlers = {}, ToolStates = setmetatable({}, { __mode = "k" }), Data = Data }
local hooks = {}

function Core.On(name, fn) hooks[name] = hooks[name] or {}; table.insert(hooks[name], fn) end
function Core.Emit(name, ...) for _, fn in ipairs(hooks[name] or {}) do task.spawn(fn, ...) end end
function Core.Get(player) return Core.Profiles[player] end

-- ---------- derived values (d = profile table)
function Core.BoostActive(d, key) return (d.boosts[key] or 0) > os.time() end
function Core.CoinMult(d)
	local m = 1 + d.rebirths + d.rp * 0.05
	if Core.BoostActive(d, "coin") then m *= 2 end
	return m
end
function Core.GemMult(d) return 1 + 0.5 * d.rebirths end
function Core.Capacity(d) return 100 + (d.extraCap or 0) + d.rebirths * 10 end
function Core.InventoryCount(d)
	local n = 0
	for _, a in ipairs(d.animals) do if a.s == 0 then n += 1 end end
	return n
end
function Core.PlacedCount(d)
	local n = 0
	for _, a in ipairs(d.animals) do if a.s > 0 then n += 1 end end
	return n
end
function Core.Income(d)
	local total = 0
	for _, a in ipairs(d.animals) do
		if a.s > 0 then
			local def = Data.AnimalById[a.id]
			if def then total += def.income end
		end
	end
	return total * Core.CoinMult(d)
end
function Core.Stats(d, w)
	local u = d.upgrades
	local dmg = w.damage * (1 + 0.08 * (u.Damage or 0)) * (1 + 0.05 * d.rebirths)
	if Core.BoostActive(d, "dmg") then dmg *= 2 end
	return {
		damage = dmg,
		fireRate = w.rate * (1 + 0.03 * (u.FireRate or 0)),
		ammo = math.floor(w.ammo * (1 + 0.04 * (u.Ammo or 0))),
		reload = math.max(0.35, w.reload * (1 - 0.015 * (u.Reload or 0))),
		range = w.range * (1 + 0.02 * (u.Range or 0)),
		crit = (w.crit + 0.5 * (u.Crit or 0)) / 100,
	}
end
function Core.WalkSpeed(d)
	local s = 16 * (1 + 0.01 * (d.upgrades.Walk or 0))
	if Core.BoostActive(d, "speed") then s *= 1.5 end
	return s
end
function Core.SlotCost(n) return math.floor(2500 * 4 ^ (n - 5)) end
function Core.RebirthReq(d) return { coins = 1000000 * 4 ^ d.rebirths, level = 10 + 5 * d.rebirths } end

function Core.QuestValue(d, kind)
	if kind == "hunted" then return d.stats.hunted
	elseif kind == "owned" then return #d.animals
	elseif kind == "weapons" then local n = 0; for _ in pairs(d.weapons) do n += 1 end; return n
	elseif kind == "earned" then return d.stats.earned
	elseif kind == "zones" then local n = 0; for _ in pairs(d.zones) do n += 1 end; return n
	elseif kind == "upgrades" then return d.stats.upgrades
	elseif kind == "placed" then return Core.PlacedCount(d)
	elseif kind == "rareHunted" then return d.stats.rareHunted
	elseif kind == "rebirths" then return d.rebirths end
	return 0
end

-- ---------- sync / push
function Core.Push(player)
	local d = Core.Profiles[player]
	if not d then return end
	player:SetAttribute("Coins", d.coins)
	player:SetAttribute("Gems", d.gems)
	player:SetAttribute("Level", d.level)
	player:SetAttribute("XP", d.xp)
	player:SetAttribute("XPLo", Data.XPForLevel(d.level))
	player:SetAttribute("XPHi", Data.XPForLevel(d.level + 1))
	player:SetAttribute("Rebirths", d.rebirths)
	player:SetAttribute("Pending", d.pending)
	player:SetAttribute("Animals", #d.animals)
end

function Core.Snapshot(player)
	local d = Core.Profiles[player]
	local progress = {}
	for _, q in ipairs(Data.Quests) do progress[q.id] = Core.QuestValue(d, q.kind) end
	return {
		weapons = d.weapons, equipped = d.equipped, animals = d.animals, slots = d.slots, upgrades = d.upgrades,
		rebirths = d.rebirths, rp = d.rp, index = d.index, quests = { progress = progress, claimed = d.questsClaimed },
		zones = d.zones, daily = d.daily, boosts = d.boosts, settings = d.settings,
		capacity = Core.Capacity(d), invCount = Core.InventoryCount(d), nextSlotCost = (d.slots < 12) and Core.SlotCost(d.slots + 1) or 0,
		rebirthReq = Core.RebirthReq(d), income = Core.Income(d), serverTime = os.time(), level = d.level,
	}
end

local dirty = {}
function Core.Sync(player)
	if dirty[player] then return end
	dirty[player] = true
	task.defer(function()
		dirty[player] = nil
		if player.Parent and Core.Profiles[player] then Remotes.Sync:FireClient(player, Core.Snapshot(player)) end
	end)
end

function Core.Notify(player, kind, a, b, c) Remotes.Notify:FireClient(player, kind, a, b, c) end
function Core.Toast(player, text, good) Remotes.Notify:FireClient(player, "toast", text, good ~= false) end

-- ---------- economy
function Core.AddCoins(player, amt)
	local d = Core.Profiles[player]; if not d then return end
	d.coins += amt
	if amt > 0 then d.stats.earned += amt end
	Core.Push(player)
end
function Core.SpendCoins(player, amt)
	local d = Core.Profiles[player]
	if not d or d.coins < amt then return false end
	d.coins -= amt; Core.Push(player); return true
end
function Core.AddGems(player, amt)
	local d = Core.Profiles[player]; if not d then return end
	d.gems += amt; Core.Push(player)
end
function Core.SpendGems(player, amt)
	local d = Core.Profiles[player]
	if not d or d.gems < amt then return false end
	d.gems -= amt; Core.Push(player); return true
end
function Core.AddXP(player, amt)
	local d = Core.Profiles[player]; if not d then return end
	d.xp += amt
	local old = d.level
	d.level = Data.LevelFromXP(d.xp)
	if d.level > old then
		Core.Notify(player, "level", d.level)
		Core.Emit("LevelUp", player, d.level)
	end
	Core.Push(player)
end

function Core.GrantAnimal(player, id)
	local d = Core.Profiles[player]; if not d then return end
	local a = Data.AnimalById[id]; if not a then return end
	local uid = d.nextUid; d.nextUid += 1
	table.insert(d.animals, { u = uid, id = id, s = 0 })
	d.index.animals[id] = true
	d.stats.hunted += 1
	if Data.RarityIndex[a.rarity] >= 3 then d.stats.rareHunted += 1 end
	local gems = math.floor((Data.GemsDrop[a.rarity] or 0) * Core.GemMult(d))
	if gems > 0 then d.gems += gems; Core.Toast(player, "+" .. gems .. " 💎 Gems!", true) end
	Core.AddXP(player, Data.XPBase[a.rarity])
	Core.Push(player); Core.Sync(player)
	return uid
end

-- ---------- weapon tool handling
function Core.GiveTool(player)
	local d = Core.Profiles[player]; if not d then return end
	local w = Data.WeaponById[d.equipped]; if not w then return end
	local function clear(container)
		if not container then return end
		for _, t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") and t:FindFirstChild("WeaponId") then t:Destroy() end
		end
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	clear(backpack); clear(player.Character)
	local tmpl = ServerStorage:WaitForChild("Tools"):FindFirstChild(w.name)
	if not tmpl or not backpack then return end
	local tool = tmpl:Clone()
	local st = Core.Stats(d, w)
	Core.ToolStates[tool] = { ammo = st.ammo, reloading = false, last = 0, token = 0 }
	tool:SetAttribute("Ammo", st.ammo); tool:SetAttribute("MaxAmmo", st.ammo)
	tool:SetAttribute("FireRate", st.fireRate); tool:SetAttribute("ReloadTime", st.reload)
	tool:SetAttribute("Range", st.range); tool:SetAttribute("Reloading", false)
	tool.Parent = backpack
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then task.defer(function() if tool.Parent == backpack then hum:EquipTool(tool) end end) end
end

function Core.RefreshTool(player)
	local d = Core.Profiles[player]; if not d then return end
	local w = Data.WeaponById[d.equipped]
	local function find(container)
		if not container then return nil end
		for _, t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") and t:FindFirstChild("WeaponId") then return t end
		end
	end
	local tool = find(player.Character) or find(player:FindFirstChildOfClass("Backpack"))
	if not tool then return end
	local st = Core.Stats(d, w)
	local ts = Core.ToolStates[tool]
	if ts then ts.ammo = math.min(ts.ammo, st.ammo) end
	tool:SetAttribute("MaxAmmo", st.ammo); tool:SetAttribute("FireRate", st.fireRate)
	tool:SetAttribute("ReloadTime", st.reload); tool:SetAttribute("Range", st.range)
	if ts then tool:SetAttribute("Ammo", ts.ammo) end
end

function Core.ApplyWalk(player)
	local d = Core.Profiles[player]
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if d and hum then hum.WalkSpeed = Core.WalkSpeed(d) end
end

function Core.Teleport(player, cf)
	local char = player.Character
	if not char then return end
	pcall(function() player:RequestStreamAroundAsync(cf.Position) end)
	if player.Character == char then char:PivotTo(cf) end
end

return Core
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0015608"><Properties>
<string name="Name">DataService</string>
<ProtectedString name="Source"><![CDATA[-- DataService: safe persistence (retry + backoff, UpdateAsync, session lock, autosave handled by PlayerService)
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local STORE_NAME = "AnimalHuntingSim_v1"
local VERSION = 1
local LOCK_TIMEOUT = 120

local store = DataStoreService:GetDataStore(STORE_NAME)
local DataService = {}
local sessions = {} -- [player] = {key=, data=, temp=}

local function defaults()
	return {
		version = VERSION,
		coins = 0, gems = 0, pending = 0, xp = 0, level = 1,
		weapons = { W1 = true }, equipped = "W1",
		animals = {}, nextUid = 1, slots = 4, extraCap = 0,
		upgrades = { Damage = 0, FireRate = 0, Ammo = 0, Reload = 0, Range = 0, Crit = 0, Walk = 0 },
		rebirths = 0, rp = 0,
		index = { animals = {}, weapons = { W1 = true } },
		questsClaimed = {}, zones = { Forest = true },
		daily = { last = 0, streak = 0 }, boosts = {},
		stats = { hunted = 0, earned = 0, upgrades = 0, rareHunted = 0 },
		settings = { music = true, sfx = true, auto = false, low = false },
		codesUsed = {},
	}
end

local function reconcile(data, def)
	for k, v in pairs(def) do
		if data[k] == nil then
			data[k] = (type(v) == "table") and table.clone(v) or v
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			-- only fill keyed sub-tables (not arrays)
			if v[1] == nil then reconcile(data[k], v) end
		end
	end
	return data
end

local function deepCopy(t)
	if type(t) ~= "table" then return t end
	local c = {}
	for k, v in pairs(t) do c[k] = deepCopy(v) end
	return c
end

local function retry(fn, attempts)
	local lastErr
	for i = 1, attempts do
		local ok, res = pcall(fn)
		if ok then return true, res end
		lastErr = res
		warn(("[DataService] attempt %d/%d failed: %s"):format(i, attempts, tostring(res)))
		if i < attempts then task.wait(math.min(2 ^ i, 12)) end
	end
	return false, lastErr
end

function DataService.Load(player)
	local key = "P_" .. player.UserId
	local locked = false
	local ok, stored = retry(function()
		locked = false
		return store:UpdateAsync(key, function(old)
			old = old or {}
			local lock = old._lock
			if lock and lock.job ~= game.JobId and os.time() - lock.t < LOCK_TIMEOUT then
				locked = true
				return nil
			end
			old._lock = { job = game.JobId, t = os.time() }
			return old
		end)
	end, 4)

	if ok and locked then
		-- someone else still holds the session: wait a bit and retry once
		task.wait(6)
		return DataService.Load(player)
	end

	if not ok then
		if RunService:IsStudio() then
			warn("[DataService] DataStore unavailable (enable Studio API access). Using temporary data.")
			local data = defaults()
			sessions[player] = { key = key, data = data, temp = true }
			return data
		end
		player:Kick("Could not load your data. Please rejoin in a moment.")
		return nil
	end

	local data = type(stored) == "table" and stored or {}
	data._lock = nil
	data = reconcile(data, defaults())
	data.version = VERSION
	sessions[player] = { key = key, data = data, temp = false }
	return data
end

function DataService.Save(player, release)
	local s = sessions[player]
	if not s or s.temp then return true end
	local snapshot = deepCopy(s.data)
	local ok = retry(function()
		store:UpdateAsync(s.key, function(old)
			if old and old._lock and old._lock.job ~= game.JobId and os.time() - old._lock.t < LOCK_TIMEOUT then
				return nil
			end
			if release then
				snapshot._lock = nil
			else
				snapshot._lock = { job = game.JobId, t = os.time() }
			end
			return snapshot
		end)
	end, 4)
	if release then sessions[player] = nil end
	return ok
end

return DataService
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Script" referent="RBX0015609"><Properties>
<string name="Name">PlayerService</string>
<ProtectedString name="Source"><![CDATA[-- PlayerService: join/leave, character lifecycle, autosave, request router
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Core = require(ServerScriptService.Modules.Core)
local DataService = require(ServerScriptService.Modules.DataService)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

Players.CharacterAutoLoads = false

local lastCall = {}
Remotes.Request.OnServerInvoke = function(player, action, ...)
	if type(action) ~= "string" then return { ok = false } end
	local h = Core.Handlers[action]
	if not h or not Core.Profiles[player] then return { ok = false, msg = "Not ready" } end
	local key = tostring(player.UserId) .. action
	local now = os.clock()
	if lastCall[key] and now - lastCall[key] < 0.12 then return { ok = false } end
	lastCall[key] = now
	local ok, res = pcall(h, player, ...)
	if not ok then warn("[Request " .. action .. "] " .. tostring(res)); return { ok = false, msg = "Error" } end
	return res or { ok = true }
end

local function onCharacter(player, char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	Core.ApplyWalk(player)
	Core.GiveTool(player)
	hum.Died:Connect(function()
		task.delay(Players.RespawnTime, function()
			if player.Parent and player.Character == char then player:LoadCharacter() end
		end)
	end)
end

local function onJoin(player)
	local data = DataService.Load(player)
	if not data or not player.Parent then return end
	Core.Profiles[player] = data
	data.level = Core.Data.LevelFromXP(data.xp)
	while not Core.AssignPlot do task.wait() end
	Core.AssignPlot(player)
	Core.Push(player)
	Core.Emit("PlayerLoaded", player)
	player.CharacterAdded:Connect(function(char) onCharacter(player, char) end)
	player:LoadCharacter()
	Core.Sync(player)
	task.spawn(function()
		task.wait(math.random(10, 40))
		while player.Parent and Core.Profiles[player] do
			DataService.Save(player, false)
			task.wait(60)
		end
	end)
end

Players.PlayerAdded:Connect(function(p) task.spawn(onJoin, p) end)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onJoin, p) end

Players.PlayerRemoving:Connect(function(player)
	Core.Emit("PlayerLeaving", player)
	if Core.Profiles[player] then
		DataService.Save(player, true)
		Core.Profiles[player] = nil
	end
end)

game:BindToClose(function()
	local pending = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if Core.Profiles[p] then
			pending += 1
			task.spawn(function() DataService.Save(p, true); pending -= 1 end)
		end
	end
	local t = os.clock()
	while pending > 0 and os.clock() - t < 25 do task.wait(0.2) end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX0015610"><Properties>
<string name="Name">AnimalService</string>
<ProtectedString name="Source"><![CDATA[-- AnimalService: spawn/respawn, wandering, fleeing, damage and capture
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Core = require(ServerScriptService.Modules.Core)
local Data = Core.Data
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Templates = ReplicatedStorage:WaitForChild("Animals")
local ZonesFolder = workspace:WaitForChild("Zones")

local active = Instance.new("Folder"); active.Name = "ActiveAnimals"; active.Parent = workspace
local rng = Random.new()
local recs = {}
local zoneStates = {}
local MAXPOP = 14
local RADIUS = Data.ZoneRadius

for _, z in ipairs(Data.Zones) do
	local folder = ZonesFolder:FindFirstChild(z.name)
	if folder then
		local center = folder.ZoneCenter.Position
		local markers = {}
		for _, m in ipairs(folder.AnimalSpawns:GetChildren()) do table.insert(markers, m.Position) end
		local list, total = {}, 0
		for _, a in ipairs(Data.Animals) do
			if a.zone == z.name then table.insert(list, a); total += a.weight end
		end
		zoneStates[z.name] = { name = z.name, center = center, markers = markers, list = list, total = total, count = 0, max = MAXPOP }
	end
end

local function pick(zs)
	local r = rng:NextNumber(0, zs.total)
	for _, a in ipairs(zs.list) do
		r -= a.weight
		if r <= 0 then return a end
	end
	return zs.list[1]
end

local function groundY(zs, a, foot)
	local gy = zs.center.Y + 0.3
	if a.move == "fly" then return gy + rng:NextNumber(12, 26) end
	if a.move == "swim" then return math.max(gy + foot + 0.5, gy + 4.5) end
	return gy + foot
end

local function spawnAnimal(zs)
	if zs.count >= zs.max or #zs.markers == 0 then return end
	local a = pick(zs)
	local tmpl = Templates:FindFirstChild(a.id)
	if not tmpl then return end
	local m = tmpl:Clone()
	local root = m.PrimaryPart or m:FindFirstChild("Body")
	local foot = m:FindFirstChild("FootOffset") and m.FootOffset.Value or 2
	local mk = zs.markers[rng:NextInteger(1, #zs.markers)]
	local y = groundY(zs, a, foot)
	root.CFrame = CFrame.new(mk.X, y, mk.Z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local hp = Data.HPBase[a.rarity] * a.hpMul
	m:SetAttribute("AnimalId", a.id); m:SetAttribute("Zone", zs.name); m:SetAttribute("Rarity", a.rarity)
	m:SetAttribute("HP", hp); m:SetAttribute("MaxHP", hp); m:SetAttribute("State", "Idle")
	CollectionService:AddTag(m, "Animal")
	m.Parent = active
	zs.count += 1
	recs[m] = { model = m, root = root, a = a, zone = zs, hp = hp, state = "Idle", stateUntil = 0, y = y, home = Vector3.new(mk.X, y, mk.Z),
		target = nil, idleUntil = 0, fleeUntil = 0, calmUntil = 0, dead = false, phase = rng:NextNumber(0, 6.28) }
end

local function clampTarget(rec, p)
	local c = rec.zone.center
	local off = Vector3.new(p.X - c.X, 0, p.Z - c.Z)
	if off.Magnitude > RADIUS then off = off.Unit * RADIUS end
	return Vector3.new(c.X + off.X, rec.y, c.Z + off.Z)
end

local function setState(rec, s)
	if rec.state ~= s then rec.state = s; rec.model:SetAttribute("State", s) end
end

local function simulate(rec, dt, now, nd, nearest)
	local pos = rec.root.Position
	if rec.state == "Hurt" and now > rec.stateUntil then setState(rec, "Idle") end
	if rec.state == "Alert" and now < rec.stateUntil then
		local flat = Vector3.new(nearest.X - pos.X, 0, nearest.Z - pos.Z)
		if flat.Magnitude > 0.1 then rec.root.CFrame = CFrame.new(pos) * CFrame.lookAt(Vector3.zero, flat.Unit).Rotation end
		return
	end
	local speed = rec.a.speed
	local moving = false
	if now < rec.fleeUntil and rec.target then
		moving = true; speed *= 2.1; setState(rec, "Run")
	elseif nd < 32 and now > rec.calmUntil and rec.state ~= "Hurt" then
		setState(rec, "Alert"); rec.stateUntil = now + 0.9; rec.calmUntil = now + 9
		local away = Vector3.new(pos.X - nearest.X, 0, pos.Z - nearest.Z)
		away = (away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)) * rng:NextNumber(40, 70)
		rec.target = clampTarget(rec, pos + away); rec.fleeUntil = now + 5
		return
	else
		if rec.target and rec.state ~= "Idle" then
			moving = true; setState(rec, "Walk")
		elseif now > rec.idleUntil then
			local ang = rng:NextNumber(0, math.pi * 2)
			rec.target = clampTarget(rec, rec.home + Vector3.new(math.cos(ang), 0, math.sin(ang)) * rng:NextNumber(15, 55))
			setState(rec, "Walk"); moving = true
		else
			setState(rec, "Idle")
		end
	end
	if moving and rec.target then
		local flat = Vector3.new(rec.target.X - pos.X, 0, rec.target.Z - pos.Z)
		local dist = flat.Magnitude
		if dist < 1.5 then
			rec.target = nil; rec.idleUntil = now + rng:NextNumber(1.5, 5); setState(rec, "Idle")
		else
			local step = math.min(speed * dt, dist)
			local dir = flat.Unit
			local np = pos + dir * step
			local y = rec.y
			if rec.a.move == "fly" then y += math.sin(now * 1.6 + rec.phase) * 1.4
			elseif rec.a.move == "swim" then y += math.sin(now * 1.2 + rec.phase) * 0.6 end
			local rot = rec.root.CFrame.Rotation:Lerp(CFrame.lookAt(Vector3.zero, dir).Rotation, 0.3)
			rec.root.CFrame = CFrame.new(np.X, y, np.Z) * rot
		end
	end
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.05 then return end
	local step = acc; acc = 0
	local plist = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local r = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
		if r then table.insert(plist, r.Position) end
	end
	if #plist == 0 then return end
	local now = os.clock()
	for _, rec in pairs(recs) do
		if not rec.dead and rec.root.Parent then
			local nd, np = math.huge, nil
			local p0 = rec.root.Position
			for _, pp in ipairs(plist) do
				local dd = (pp - p0).Magnitude
				if dd < nd then nd = dd; np = pp end
			end
			if nd < 260 then simulate(rec, step, now, nd, np) end
		end
	end
end)

local function refill(zs, delayT)
	task.delay(delayT, function() spawnAnimal(zs) end)
end

local function capture(rec, player)
	rec.dead = true
	local m = rec.model
	local pos = rec.root.Position
	m:SetAttribute("State", "Captured")
	Core.GrantAnimal(player, rec.a.id)
	Core.Notify(player, "capture", rec.a.id, rec.a.rarity)
	Remotes.Fx:FireAllClients("capture", pos, rec.a.rarity)
	task.delay(0.3, function() recs[m] = nil; m:Destroy() end)
	rec.zone.count -= 1
	refill(rec.zone, Data.Respawn[rec.a.rarity] + rng:NextNumber(0, 6))
end

local lastFull = {}
function Core.DamageAnimal(model, amount, player, crit, hitPos)
	local rec = recs[model]
	if not rec or rec.dead then return end
	local d = Core.Profiles[player]
	if not d then return end
	if Core.InventoryCount(d) >= Core.Capacity(d) then
		if os.clock() - (lastFull[player] or 0) > 3 then
			lastFull[player] = os.clock()
			Core.Toast(player, "Inventory full! Place animals in your base.", false)
		end
		return
	end
	rec.hp -= amount
	model:SetAttribute("HP", math.max(0, rec.hp))
	Remotes.Fx:FireClient(player, "dmg", hitPos or rec.root.Position, amount, crit == true)
	if rec.hp <= 0 then
		capture(rec, player)
		return
	end
	local now = os.clock()
	setState(rec, "Hurt"); rec.stateUntil = now + 0.35
	local pr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if pr then
		local pos = rec.root.Position
		local away = Vector3.new(pos.X - pr.Position.X, 0, pos.Z - pr.Position.Z)
		away = (away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)) * rng:NextNumber(35, 60)
		rec.target = clampTarget(rec, pos + away); rec.fleeUntil = now + 4; rec.calmUntil = now + 8
	end
end

for _, zs in pairs(zoneStates) do
	task.spawn(function()
		for _ = 1, zs.max do spawnAnimal(zs); task.wait(0.06) end
	end)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX0015611"><Properties>
<string name="Name">WeaponService</string>
<ProtectedString name="Source"><![CDATA[-- WeaponService: server-authoritative shooting, ammo, reload, damage
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Core = require(ServerScriptService.Modules.Core)
local Data = Core.Data
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local function equippedTool(player)
	local char = player.Character
	if not char then return nil end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") and t:FindFirstChild("WeaponId") then return t end
	end
end

local function startReload(player, tool)
	local st = Core.ToolStates[tool]
	local d = Core.Profiles[player]
	if not st or not d or st.reloading then return end
	local w = Data.WeaponById[tool.WeaponId.Value]
	local stats = Core.Stats(d, w)
	if st.ammo >= stats.ammo then return end
	st.reloading = true; st.token += 1
	local token = st.token
	tool:SetAttribute("Reloading", true)
	task.delay(stats.reload, function()
		if st.token ~= token then return end
		st.ammo = stats.ammo; st.reloading = false
		if tool.Parent then
			tool:SetAttribute("Ammo", st.ammo); tool:SetAttribute("MaxAmmo", stats.ammo); tool:SetAttribute("Reloading", false)
		end
	end)
end

Remotes.Reload.OnServerEvent:Connect(function(player)
	local tool = equippedTool(player)
	if tool then startReload(player, tool) end
end)

local function finite(v) return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6 end

Remotes.Fire.OnServerEvent:Connect(function(player, aim)
	if typeof(aim) ~= "Vector3" or not finite(aim) then return end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	local tool = equippedTool(player)
	local d = Core.Profiles[player]
	if not tool or not d then return end
	local w = Data.WeaponById[tool.WeaponId.Value]
	if not w or not d.weapons[w.id] then return end
	local st = Core.ToolStates[tool]
	if not st or st.reloading then return end
	local stats = Core.Stats(d, w)
	local now = os.clock()
	if now - st.last < (1 / stats.fireRate) * 0.8 then return end
	if st.ammo <= 0 then startReload(player, tool); return end

	local handle = tool:FindFirstChild("Handle")
	local head = char:FindFirstChild("Head")
	if not handle or not head then return end
	local muzzle = handle:FindFirstChild("Muzzle")
	local origin = muzzle and muzzle.WorldPosition or head.Position
	if (origin - head.Position).Magnitude > 14 then origin = head.Position end
	local dirv = aim - origin
	if dirv.Magnitude < 1 then return end
	local dir = dirv.Unit

	st.last = now; st.ammo -= 1
	tool:SetAttribute("Ammo", st.ammo)
	if st.ammo <= 0 then task.delay(0.12, function() if tool.Parent then startReload(player, tool) end end) end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ex = {}
	for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(ex, p.Character) end end
	params.FilterDescendantsInstances = ex
	local res = workspace:Raycast(origin, dir * stats.range, params)
	local endPos = res and res.Position or (origin + dir * stats.range)
	local hitAnimal = false
	if res then
		local active = workspace:FindFirstChild("ActiveAnimals")
		local m = res.Instance
		while m and m.Parent ~= active do m = m.Parent end
		if m and active and Core.DamageAnimal then
			hitAnimal = true
			local dmg = stats.damage
			local crit = math.random() < stats.crit
			if crit then dmg *= 2 end
			Core.DamageAnimal(m, dmg, player, crit, res.Position)
		end
	end
	Remotes.ShotFx:FireAllClients(player, origin, endPos, w.id, hitAnimal)
end)

Players.PlayerRemoving:Connect(function() end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX0015612"><Properties>
<string name="Name">BaseService</string>
<ProtectedString name="Source"><![CDATA[-- BaseService: player plots, slots, animal display, passive income, collect
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local CollectionService = game:GetService("CollectionService")

local Core = require(ServerScriptService.Modules.Core)
local Data = Core.Data
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Templates = ReplicatedStorage:WaitForChild("Animals")
local BasesFolder = workspace:WaitForChild("Bases")

local function fmt(n)
	n = math.floor(n)
	if n < 1000 then return tostring(n) end
	local suf = { "", "K", "M", "B", "T", "Qa", "Qi" }
	local i = math.min(math.floor(math.log10(n) / 3), #suf - 1)
	local s = string.format("%.2f", n / 10 ^ (i * 3)):gsub("%.?0+$", "")
	return s .. suf[i + 1]
end

local plots = {}
local playerPlot = {}
for i = 1, 6 do
	local m = BasesFolder:FindFirstChild("Base_" .. i)
	if m then
		local plot = { model = m, owner = nil, slots = {}, displays = {} }
		for k = 1, 12 do
			local sm = m.Slots:FindFirstChild("Slot_" .. k)
			if sm then plot.slots[k] = { model = sm, anchor = sm.Anchor, lock = sm.Lock, tag = sm.Lock.Tag.T, prompt = sm.Pad.SlotPrompt } end
		end
		plot.board = m.Board.SG.Label; plot.nameLabel = m.NameSign.SG.Label
		plot.nameLabel.Text = "Free Base"
		plots[i] = plot
	end
end

local function bestUnplaced(d)
	local best
	for _, a in ipairs(d.animals) do
		if a.s == 0 then
			local def = Data.AnimalById[a.id]
			if not best or def.income > best.inc then best = { a = a, inc = def.income } end
		end
	end
	return best and best.a
end

local function refresh(player)
	local plot, d = playerPlot[player], Core.Profiles[player]
	if not plot or not d then return end
	local bySlot = {}
	for _, a in ipairs(d.animals) do if a.s > 0 then bySlot[a.s] = a end end
	local cm = Core.CoinMult(d)
	for k = 1, 12 do
		local slot = plot.slots[k]
		if slot then
			local unlocked = k <= d.slots
			slot.lock.Transparency = unlocked and 1 or 0.35
			local anim = bySlot[k]
			local cur = plot.displays[k]
			if cur and (not anim or cur:GetAttribute("Uid") ~= anim.u) then cur:Destroy(); plot.displays[k] = nil; cur = nil end
			if anim and not cur then
				local tmpl = Templates:FindFirstChild(anim.id)
				if tmpl then
					local m = tmpl:Clone()
					m:SetAttribute("Uid", anim.u); m:SetAttribute("Placed", true); m:SetAttribute("State", "Idle")
					local ext = m:GetExtentsSize()
					local sc = math.min(1, 6.5 / math.max(ext.X, ext.Y, ext.Z))
					if sc < 1 then m:ScaleTo(sc) end
					local root = m.PrimaryPart
					local foot = m.FootOffset.Value * sc
					local def = Data.AnimalById[anim.id]
					local info = root:FindFirstChild("Info")
					if info then
						info.BarBack.Visible = false
						info.Label.Text = anim.id .. "  🪙" .. fmt(def.income * cm) .. "/s"
						info.StudsOffset = Vector3.new(0, m.TopOffset.Value * sc + 1.4, 0)
						info.Size = UDim2.new(0, 190, 0, 34)
					end
					root.CFrame = CFrame.new(slot.anchor.Position + Vector3.new(0, foot, 0))
					CollectionService:AddTag(m, "Animal")
					m.Parent = plot.model.Display
					plot.displays[k] = m
				end
			end
			if not unlocked then
				slot.tag.Text = (k == d.slots + 1) and ("🔒 Unlock " .. fmt(Core.SlotCost(k))) or "🔒 Locked"
				slot.prompt.ActionText = (k == d.slots + 1) and "Unlock" or "Locked"
				slot.prompt.ObjectText = "Slot " .. k
			elseif anim then
				slot.tag.Text = ""
				slot.prompt.ActionText = "Remove"; slot.prompt.ObjectText = anim.id
			else
				slot.tag.Text = "Empty Slot " .. k
				slot.prompt.ActionText = "Place best animal"; slot.prompt.ObjectText = "Slot " .. k
			end
		end
	end
end
Core.RefreshBase = refresh

function Core.AssignPlot(player)
	for _, plot in ipairs(plots) do
		if not plot.owner then
			plot.owner = player; playerPlot[player] = plot
			plot.nameLabel.Text = player.DisplayName .. "'s Base"
			player.RespawnLocation = plot.model.Spawn
			refresh(player)
			return
		end
	end
end

Core.On("PlayerLeaving", function(player)
	local plot = playerPlot[player]
	if plot then
		for _, m in pairs(plot.displays) do m:Destroy() end
		plot.displays = {}; plot.owner = nil; plot.nameLabel.Text = "Free Base"; plot.board.Text = "💰 0 / s"
		for k = 1, 12 do if plot.slots[k] then plot.slots[k].lock.Transparency = 0.35 end end
		playerPlot[player] = nil
	end
end)

-- passive income loop
task.spawn(function()
	while true do
		task.wait(1)
		for player, d in pairs(Core.Profiles) do
			local inc = Core.Income(d)
			d.pending += inc
			player:SetAttribute("Pending", d.pending); player:SetAttribute("Income", inc)
			local plot = playerPlot[player]
			if plot then plot.board.Text = "💰 " .. fmt(inc) .. " / s     📦 " .. fmt(d.pending) end
		end
	end
end)

local function place(player, uid)
	local d = Core.Profiles[player]
	local anim
	if uid then
		for _, a in ipairs(d.animals) do if a.u == uid and a.s == 0 then anim = a end end
	else anim = bestUnplaced(d) end
	if not anim then return { ok = false, msg = "No animal to place" } end
	local used = {}
	for _, a in ipairs(d.animals) do if a.s > 0 then used[a.s] = true end end
	for k = 1, d.slots do
		if not used[k] then
			anim.s = k
			refresh(player); Core.Sync(player)
			return { ok = true, msg = anim.id .. " placed! It now earns coins." }
		end
	end
	return { ok = false, msg = "No free slot! Unlock more slots." }
end

local function remove(player, uid)
	local d = Core.Profiles[player]
	if Core.InventoryCount(d) >= Core.Capacity(d) then return { ok = false, msg = "Inventory full" } end
	for _, a in ipairs(d.animals) do
		if a.u == uid and a.s > 0 then
			a.s = 0; refresh(player); Core.Sync(player)
			return { ok = true, msg = a.id .. " removed" }
		end
	end
	return { ok = false }
end

local function unlock(player)
	local d = Core.Profiles[player]
	if d.slots >= 12 then return { ok = false, msg = "All slots unlocked" } end
	local cost = Core.SlotCost(d.slots + 1)
	if not Core.SpendCoins(player, cost) then return { ok = false, msg = "Need " .. fmt(cost) .. " coins" } end
	d.slots += 1
	refresh(player); Core.Sync(player); Core.Push(player)
	Remotes.Fx:FireClient(player, "upgrade")
	return { ok = true, msg = "Slot unlocked!" }
end

local function collect(player)
	local d = Core.Profiles[player]
	local amt = math.floor(d.pending)
	if amt <= 0 then return { ok = false, msg = "Nothing to collect yet" } end
	d.pending -= amt
	Core.AddCoins(player, amt)
	player:SetAttribute("Pending", d.pending)
	Remotes.Fx:FireClient(player, "coins")
	Core.Sync(player)
	return { ok = true, msg = "Collected 🪙 " .. fmt(amt) }
end

Core.Handlers.PlaceAnimal = function(player, uid) return place(player, uid) end
Core.Handlers.PlaceBest = function(player) return place(player, nil) end
Core.Handlers.RemoveAnimal = function(player, uid) return remove(player, uid) end
Core.Handlers.UnlockSlot = unlock
Core.Handlers.Collect = collect
Core.Handlers.GoBase = function(player)
	local plot = playerPlot[player]
	if plot then Core.Teleport(player, plot.model.Spawn.CFrame + Vector3.new(0, 4, 0)) end
	return { ok = true }
end

for i, plot in pairs(plots) do
	for k, slot in pairs(plot.slots) do
		slot.prompt.Triggered:Connect(function(player)
			local d = Core.Profiles[player]
			if not d then return end
			if plot.owner ~= player then Core.Toast(player, "This is not your base!", false); return end
			if k > d.slots then
				if k == d.slots + 1 then
					local r = unlock(player); if r.msg then Core.Toast(player, r.msg, r.ok) end
				else Core.Toast(player, "Unlock the previous slot first", false) end
				return
			end
			local occupant
			for _, a in ipairs(d.animals) do if a.s == k then occupant = a end end
			local r
			if occupant then r = remove(player, occupant.u) else r = place(player, nil) end
			if r.msg then Core.Toast(player, r.msg, r.ok) end
		end)
	end
	plot.model.Collector.Collect.Triggered:Connect(function(player)
		if plot.owner ~= player then Core.Toast(player, "This is not your base!", false); return end
		local r = collect(player); if r.msg then Core.Toast(player, r.msg, r.ok) end
	end)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX0015613"><Properties>
<string name="Name">ShopService</string>
<ProtectedString name="Source"><![CDATA[-- ShopService: weapons, upgrades, shop items, boosts, codes, settings, receipts
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local MarketplaceService = game:GetService("MarketplaceService")

local Core = require(ServerScriptService.Modules.Core)
local Data = Core.Data
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local function fmt(n)
	n = math.floor(n)
	if n < 1000 then return tostring(n) end
	local suf = { "", "K", "M", "B", "T", "Qa", "Qi" }
	local i = math.min(math.floor(math.log10(n) / 3), #suf - 1)
	local s = string.format("%.2f", n / 10 ^ (i * 3)):gsub("%.?0+$", "")
	return s .. suf[i + 1]
end

local function buyWeapon(player, id)
	local d = Core.Profiles[player]
	local w = Data.WeaponById[id]
	if not w then return { ok = false } end
	if d.weapons[id] then
		d.equipped = id
		Core.GiveTool(player); Core.Sync(player)
		return { ok = true, msg = w.name .. " equipped" }
	end
	local okPay
	if w.currency == "Coins" then okPay = Core.SpendCoins(player, w.price) else okPay = Core.SpendGems(player, w.price) end
	if not okPay then return { ok = false, msg = "Not enough " .. w.currency .. " (" .. fmt(w.price) .. ")" } end
	d.weapons[id] = true; d.index.weapons[id] = true; d.equipped = id
	Core.GiveTool(player); Core.Sync(player)
	Remotes.Fx:FireClient(player, "upgrade")
	return { ok = true, msg = "Purchased " .. w.name .. "!" }
end
Core.Handlers.BuyWeapon = buyWeapon
Core.Handlers.EquipWeapon = function(player, id)
	local d = Core.Profiles[player]
	if not d.weapons[id] then return { ok = false, msg = "Weapon not owned" } end
	return buyWeapon(player, id)
end

Core.Handlers.BuyUpgrade = function(player, id)
	local d = Core.Profiles[player]
	local u = Data.UpgradeById[id]
	if not u then return { ok = false } end
	local lvl = d.upgrades[id] or 0
	if lvl >= u.max then return { ok = false, msg = "Max level" } end
	local cost = math.floor(u.base * 1.3 ^ lvl)
	if not Core.SpendCoins(player, cost) then return { ok = false, msg = "Need " .. fmt(cost) .. " coins" } end
	d.upgrades[id] = lvl + 1; d.stats.upgrades += 1
	if id == "Walk" then Core.ApplyWalk(player) end
	Core.RefreshTool(player)
	Core.Sync(player)
	Remotes.Fx:FireClient(player, "upgrade")
	return { ok = true, msg = u.name .. " → Lv." .. (lvl + 1) }
end

local function openProduct(player, kind, id)
	if kind == "pass" then
		if id > 0 then MarketplaceService:PromptGamePassPurchase(player, id); return { ok = true } end
	else
		if id > 0 then MarketplaceService:PromptProductPurchase(player, id); return { ok = true } end
	end
	return { ok = false, msg = "Set this product's ID in GameData.Shop" }
end

Core.Handlers.BuyShop = function(player, tab, itemId)
	local d = Core.Profiles[player]
	local list = Data.Shop[tab]
	if type(tab) ~= "string" or not list then return { ok = false } end
	local item
	for _, it in ipairs(list) do if it.id == itemId then item = it end end
	if not item then return { ok = false } end
	if tab == "Coins" then
		if not Core.SpendGems(player, item.gems) then return { ok = false, msg = "Need " .. item.gems .. " 💎 Gems" } end
		local amt = math.max(item.min, Core.Income(d) * item.seconds)
		Core.AddCoins(player, math.floor(amt)); Core.Sync(player)
		Remotes.Fx:FireClient(player, "coins")
		return { ok = true, msg = "+" .. fmt(amt) .. " 🪙 Coins" }
	elseif tab == "Boosts" then
		if not Core.SpendGems(player, item.gems) then return { ok = false, msg = "Need " .. item.gems .. " 💎 Gems" } end
		d.boosts[item.key] = math.max(os.time(), d.boosts[item.key] or 0) + item.duration
		Core.ApplyWalk(player); Core.RefreshTool(player); Core.Sync(player)
		return { ok = true, msg = item.title .. " activated!" }
	elseif tab == "Special" then
		if item.id == "slot" and d.slots >= 12 then return { ok = false, msg = "All slots unlocked" } end
		if not Core.SpendGems(player, item.gems) then return { ok = false, msg = "Need " .. item.gems .. " 💎 Gems" } end
		if item.id == "slot" then d.slots += 1; if Core.RefreshBase then Core.RefreshBase(player) end
		elseif item.id == "cap" then d.extraCap = (d.extraCap or 0) + 25
		elseif item.id == "ammo" then Core.GiveTool(player) end
		Core.Sync(player)
		return { ok = true, msg = item.title .. " purchased!" }
	elseif tab == "Gems" then return openProduct(player, "product", item.product)
	elseif tab == "Passes" then return openProduct(player, "pass", item.pass) end
	return { ok = false }
end

Core.Handlers.Redeem = function(player, code)
	local d = Core.Profiles[player]
	if type(code) ~= "string" then return { ok = false } end
	code = string.upper(string.gsub(code, "%s", ""))
	local c = Data.Codes[code]
	if not c then return { ok = false, msg = "Invalid code" } end
	if d.codesUsed[code] then return { ok = false, msg = "Code already used" } end
	d.codesUsed[code] = true
	if c.kind == "Gems" then Core.AddGems(player, c.amount) else Core.AddCoins(player, c.amount) end
	Core.Sync(player)
	return { ok = true, msg = "Code redeemed: +" .. fmt(c.amount) .. " " .. c.kind }
end

Core.Handlers.SetSetting = function(player, key, value)
	local d = Core.Profiles[player]
	if (key == "music" or key == "sfx" or key == "auto" or key == "low") and type(value) == "boolean" then
		d.settings[key] = value
		Core.Sync(player)
		return { ok = true }
	end
	return { ok = false }
end

-- weapon pedestals in the armory
local function hookPrompts()
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("ProximityPrompt") then
			local id = string.match(inst.Name, "^BuyWeapon_(W%d+)$")
			if id then
				inst.Triggered:Connect(function(player)
					if not Core.Profiles[player] then return end
					local r = buyWeapon(player, id)
					if r.msg then Core.Toast(player, r.msg, r.ok) end
				end)
			end
		end
	end
end
hookPrompts()

-- Robux products (set ids in GameData.Shop.Gems)
MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player or not Core.Profiles[player] then return Enum.ProductPurchaseDecision.NotProcessedYet end
	for _, it in ipairs(Data.Shop.Gems) do
		if it.product == info.ProductId and it.product > 0 then
			Core.AddGems(player, it.amount); Core.Sync(player)
			Core.Toast(player, "+" .. it.amount .. " 💎 Gems!", true)
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX0015614"><Properties>
<string name="Name">ProgressService</string>
<ProtectedString name="Source"><![CDATA[-- ProgressService: zones, portals, rebirth, quests, daily rewards
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Core = require(ServerScriptService.Modules.Core)
local Data = Core.Data
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local function fmt(n)
	n = math.floor(n)
	if n < 1000 then return tostring(n) end
	local suf = { "", "K", "M", "B", "T", "Qa", "Qi" }
	local i = math.min(math.floor(math.log10(n) / 3), #suf - 1)
	local s = string.format("%.2f", n / 10 ^ (i * 3)):gsub("%.?0+$", "")
	return s .. suf[i + 1]
end

local function hubCF() return workspace.Hub.HubSpawn.CFrame + Vector3.new(0, 4, 0) end

local function checkZones(player)
	local d = Core.Profiles[player]
	if not d then return end
	for _, z in ipairs(Data.Zones) do
		if d.level >= z.level and not d.zones[z.name] then
			d.zones[z.name] = true
			Core.Notify(player, "zone", z.name)
			Remotes.Fx:FireClient(player, "unlock")
		end
	end
	Core.Sync(player)
end
Core.On("LevelUp", checkZones)
Core.On("PlayerLoaded", function(p) checkZones(p) end)

local function travel(player, zoneName)
	local d = Core.Profiles[player]
	local z = Data.ZoneByName[zoneName]
	if not z then return { ok = false } end
	if not d.zones[zoneName] then
		Core.Notify(player, "zone_locked", zoneName, z.level)
		return { ok = false, msg = zoneName .. " unlocks at Level " .. z.level }
	end
	local folder = workspace.Zones:FindFirstChild(zoneName)
	if not folder then return { ok = false } end
	Core.Teleport(player, folder.ZoneSpawn.CFrame * CFrame.Angles(0, math.pi, 0) + Vector3.new(0, 4, 0))
	return { ok = true }
end
Core.Handlers.TravelZone = function(player, name) return travel(player, name) end
Core.Handlers.GoHub = function(player) Core.Teleport(player, hubCF()); return { ok = true } end

-- portals (touch)
local debounce = {}
local function hookPortal(part, fn)
	part.Touched:Connect(function(hit)
		local char = hit.Parent
		local player = char and Players:GetPlayerFromCharacter(char)
		if not player or not Core.Profiles[player] then return end
		if hit.Name ~= "HumanoidRootPart" then return end
		if debounce[player] and os.clock() - debounce[player] < 2 then return end
		debounce[player] = os.clock()
		local r = fn(player)
		if r and r.msg and not r.ok then Core.Toast(player, r.msg, false) end
	end)
end
for _, inst in ipairs(workspace:GetDescendants()) do
	if inst:IsA("BasePart") then
		local zn = string.match(inst.Name, "^Portal_(%a+)$")
		if zn == "Base" then hookPortal(inst, Core.Handlers.GoBase)
		elseif zn == "Hub" then hookPortal(inst, Core.Handlers.GoHub)
		elseif zn then hookPortal(inst, function(p) return travel(p, zn) end)
		elseif inst.Name == "ReturnPortal" then hookPortal(inst, Core.Handlers.GoHub) end
	end
end
Players.PlayerRemoving:Connect(function(p) debounce[p] = nil end)

-- rebirth
Core.Handlers.Rebirth = function(player)
	local d = Core.Profiles[player]
	local req = Core.RebirthReq(d)
	if d.level < req.level then return { ok = false, msg = "Reach level " .. req.level } end
	if d.coins < req.coins then return { ok = false, msg = "Need " .. fmt(req.coins) .. " coins" } end
	d.rebirths += 1; d.rp += d.rebirths
	d.coins = 0; d.pending = 0
	d.upgrades = { Damage = 0, FireRate = 0, Ammo = 0, Reload = 0, Range = 0, Crit = 0, Walk = 0 }
	d.slots = math.min(12, d.slots + 1)
	if Core.RefreshBase then Core.RefreshBase(player) end
	Core.ApplyWalk(player); Core.RefreshTool(player)
	Core.Push(player); Core.Sync(player)
	Remotes.Fx:FireClient(player, "rebirth")
	return { ok = true, msg = "REBIRTH " .. d.rebirths .. "! Permanent bonuses unlocked." }
end

-- quests
Core.Handlers.ClaimQuest = function(player, id)
	local d = Core.Profiles[player]
	for _, q in ipairs(Data.Quests) do
		if q.id == id then
			if d.questsClaimed[id] then return { ok = false, msg = "Already claimed" } end
			if Core.QuestValue(d, q.kind) < q.target then return { ok = false, msg = "Quest not complete" } end
			d.questsClaimed[id] = true
			Core.AddCoins(player, q.coins); Core.AddGems(player, q.gems)
			Core.Sync(player)
			Remotes.Fx:FireClient(player, "coins")
			return { ok = true, msg = "Reward: " .. fmt(q.coins) .. " 🪙  " .. q.gems .. " 💎" }
		end
	end
	return { ok = false }
end

-- daily rewards
Core.Handlers.ClaimDaily = function(player)
	local d = Core.Profiles[player]
	local now = os.time()
	local since = now - d.daily.last
	if d.daily.last > 0 and since < 86400 then
		return { ok = false, msg = "Come back in " .. math.ceil((86400 - since) / 3600) .. "h" }
	end
	if d.daily.last > 0 and since > 172800 then d.daily.streak = 0 end
	local r = Data.Daily[(d.daily.streak % 7) + 1]
	local amt = r.amount * (1 + d.rebirths)
	if r.kind == "Coins" then Core.AddCoins(player, amt) else Core.AddGems(player, amt) end
	d.daily.streak += 1; d.daily.last = now
	Core.Sync(player)
	Remotes.Fx:FireClient(player, "coins")
	return { ok = true, msg = "Daily reward: +" .. fmt(amt) .. " " .. r.kind }
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
