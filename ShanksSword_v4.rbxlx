<Item class="Script" referent="RBX3"><Properties><string name="Name">SwordServer</string><ProtectedString name="Source">-- كل شيء يشتغل من السيرفر: أنميشن + ضرب + أفكتات
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local tool = script.Parent
local handle = tool:WaitForChild("Hilt")
local remote = tool:WaitForChild("Action")
handle.Massless = true
local SLASH_DAMAGE = {18, 18, 32}
local HAKI_DAMAGE, HAKI_RADIUS, STUN = 35, 45, 2.5
local WAVE_DAMAGE, COOLDOWN = 55, 12
local RED, BLACK, WHITE = Color3.fromRGB(220, 0, 30), Color3.new(0, 0, 0), Color3.new(1, 1, 1)
local rng = Random.new()
-- بناء السيف
local function piece(size, offset, color, material, class)
	local p = Instance.new(class or "Part")
	p.Name, p.Size, p.Color, p.Material = "Blade", size, color, material
	p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
	p.CFrame = handle.CFrame * offset
	local w = Instance.new("WeldConstraint")
	p.Parent = tool
	w.Part0, w.Part1, w.Parent = handle, p, p
	return p
end
if not tool:FindFirstChild("Blade") then
	local gold, dark = Color3.fromRGB(224, 176, 52), Color3.fromRGB(150, 105, 30)
	local steel, red = Color3.fromRGB(200, 208, 220), Color3.fromRGB(120, 14, 22)
	local metal, V = Enum.Material.Metal, Vector3.new
	local upright = CFrame.Angles(0, 0, math.pi / 2)
	local function disc(y, h, d, color)
		piece(V(h, d, d), CFrame.new(0, y, 0) * upright, color, metal).Shape = Enum.PartType.Cylinder
	end
	local function ball(pos, d, color, material)
		piece(V(d, d, d), CFrame.new(pos), color, material or metal).Shape = Enum.PartType.Ball
	end
	local function curve(a, b, c, thick)
		local last = a
		for i = 1, 10 do
			local t = i / 10
			local nxt = a:Lerp(b, t):Lerp(b:Lerp(c, t), t)
			piece(V(thick, thick, (nxt - last).Magnitude + .04), CFrame.lookAt((last + nxt) / 2, nxt), gold, metal)
			last = nxt
		end
		ball(c, thick * 1.7, gold)
	end
	-- المقبض
	disc(0, 1.1, .3, red)
	for i = -2, 2 do disc(i * .21, .05, .35, dark) end
	disc(-.58, .14, .44, gold)
	ball(V(0, -.76, 0), .4, gold)
	ball(V(0, -.98, 0), .17, Color3.fromRGB(255, 20, 40), Enum.Material.Neon)
	-- واقي اليد
	disc(.6, .16, .52, gold)
	for _, x in {-.2, .2} do ball(V(x, .66, 0), .22, Color3.fromRGB(255, 20, 40), Enum.Material.Neon) end
	curve(V(0, .62, 0), V(0, .5, -.75), V(0, .92, -.95), .16)
	curve(V(0, .62, 0), V(0, .62, .75), V(0, .3, .92), .16)
	curve(V(0, .58, -.55), V(0, -.15, -1.15), V(0, -.7, -.15), .1)
	piece(V(.2, .45, .46), CFrame.new(0, .9, 0), gold, metal)
	-- النصل المنحني الطويل
	local cf = CFrame.new(0, 1.1, 0)
	for i = 1, 12 do
		local width = .52 - i * .015
		cf *= CFrame.Angles(math.rad(1.3), 0, 0)
		local mid = cf * CFrame.new(0, .23, 0)
		piece(V(.09, .49, width), mid, steel, metal).Name = "Steel"
		piece(V(.105, .49, .08), mid * CFrame.new(0, 0, -width / 2), Color3.new(1, 1, 1), metal).Name = "Steel"
		piece(V(.13, .49, .08), mid * CFrame.new(0, 0, width / 2 - .03), Color3.fromRGB(120, 125, 140), metal).Name = "Steel"
		if i &lt; 10 then
			piece(V(.115, .49, .06), mid * CFrame.new(0, 0, width * .12), Color3.fromRGB(55, 58, 70), metal).Name = "Steel"
		end
		cf *= CFrame.new(0, .46, 0)
	end
	piece(V(.09, .95, .38), cf * CFrame.new(0, .475, 0), steel, metal, "WedgePart").Name = "Steel"
end

local function damage(char, victim, hum, amount)
	hum:TakeDamage(amount)
	local hl = Instance.new("Highlight")
	hl.FillColor, hl.OutlineColor, hl.Parent = Color3.fromRGB(200, 0, 20), Color3.new(0, 0, 0), victim
	Debris:AddItem(hl, .25)
	local head = victim:FindFirstChild("Head")
	if head then
		local sfx = Instance.new("Sound")
		sfx.SoundId, sfx.Volume, sfx.PlaybackSpeed = "rbxasset://sounds/swordslash.wav", 1.5, .55
		sfx.Parent = head
		sfx:Play()
		Debris:AddItem(sfx, 2)
		local gui = Instance.new("BillboardGui")
		gui.Size, gui.AlwaysOnTop = UDim2.fromOffset(90, 40), true
		gui.StudsOffset = Vector3.new(math.random(-2, 2), 2, 0)
		local t = Instance.new("TextLabel", gui)
		t.Size, t.BackgroundTransparency, t.Text = UDim2.fromScale(1, 1), 1, "-" .. amount
		t.Font, t.TextScaled, t.TextStrokeTransparency = Enum.Font.Bangers, true, 0
		t.TextColor3 = Color3.fromRGB(255, 60, 60)
		gui.Parent = head
		Debris:AddItem(gui, .8)
	end
end

local function hitParts(char, parts, done, fn)
	local owner = Players:GetPlayerFromCharacter(char)
	for _, p in parts do
		local m = p:FindFirstAncestorOfClass("Model")
		local h = m and m:FindFirstChildOfClass("Humanoid")
		if h and m ~= char and h.Health &gt; 0 and not done[m] then
			done[m] = true
			local other = Players:GetPlayerFromCharacter(m)
			if not (owner and other and not owner.Neutral and owner.Team == other.Team) and not m:FindFirstChildOfClass("ForceField") then
				fn(m, h)
			end
		end
	end
end

local function freeze(hum, time)
	if hum:GetAttribute("Frozen") then return end
	hum:SetAttribute("Frozen", true)
	local a, b, c = hum.WalkSpeed, hum.JumpPower, hum.JumpHeight
	hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = 0, 0, 0
	task.delay(time, function()
		hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = a, b, c
		hum.PlatformStand = false
		hum:SetAttribute("Frozen", nil)
	end)
end

local function knock(m, from, power)
	local root = m:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local dir = (root.Position - from) * Vector3.new(1, 0, 1)
	dir = dir.Magnitude &gt; .1 and dir.Unit or Vector3.zAxis
	local att = Instance.new("Attachment", root)
	local v = Instance.new("LinearVelocity")
	v.Attachment0, v.MaxForce = att, 1e6
	v.VectorVelocity = dir * power + Vector3.new(0, power * .5, 0)
	v.Parent = att
	Debris:AddItem(att, .2)
end

local function R(x, y, z) return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z)) end
local function Y6(y, out) return R(0, y, 0) * R(-out, 0, 0) end
local P15 = {
	idle = {Root = CFrame.new(), Waist = R(0,-15,0), Neck = R(-8,12,0), RightShoulder = R(15,0,28), RightElbow = R(20,0,0), RightWrist = R(-24,0,0),
		LeftShoulder = R(-8,0,-12), LeftElbow = R(15,0,0), RightHip = R(10,-10,10), LeftHip = R(-8,0,-10), RightKnee = R(-6,0,0), LeftKnee = R(-4,0,0)},
	w1 = {Waist = R(0,-45,0), Neck = R(0,35,0), RightShoulder = R(0,-15,90), RightElbow = R(15,0,0), RightWrist = R(-65,0,0)},
	s1 = {Waist = R(-8,45,0), Neck = R(0,-35,0), RightShoulder = R(0,135,85), RightElbow = R(5,0,0), RightWrist = R(-70,0,0)},
	w3 = {Waist = R(18,0,0), RightShoulder = R(175,0,10), RightElbow = R(35,0,0), RightWrist = R(-20,0,0), LeftShoulder = R(40,0,-30)},
	s3 = {Root = CFrame.new(0,-.4,0), Waist = R(-35,10,0), RightShoulder = R(40,0,5), RightWrist = R(-75,0,0), LeftShoulder = R(-40,0,-35),
		RightHip = R(50,0,8), RightKnee = R(-55,0,0), LeftHip = R(-10,0,-10), LeftKnee = R(-30,0,0)},
	glare = {Root = CFrame.new(0,-.2,0), Waist = R(-12,-10,0), Neck = R(-22,10,0), RightShoulder = R(-5,0,35), RightWrist = R(-55,0,0), LeftShoulder = R(-10,0,-22)},
	roar = {Waist = R(14,0,0), Neck = R(15,0,0), RightShoulder = R(-15,0,60), RightWrist = R(-50,0,0), LeftShoulder = R(-15,0,-55)},
}
P15.w2, P15.s2 = P15.s1, P15.w1
local P6 = {
	idle = {RootJoint = R(0,0,-15), Neck = R(8,0,12), ["Right Shoulder"] = R(-28,0,15), ["Left Shoulder"] = R(-10,0,8), ["Right Hip"] = R(-9,0,8), ["Left Hip"] = R(-9,0,8)},
	w1 = {RootJoint = R(0,0,-45), Neck = R(0,0,35), ["Right Shoulder"] = Y6(-15,90)},
	s1 = {RootJoint = R(8,0,45), Neck = R(0,0,-35), ["Right Shoulder"] = Y6(135,85)},
	w3 = {RootJoint = R(-18,0,0), ["Right Shoulder"] = R(-10,0,175)},
	s3 = {RootJoint = R(35,0,10), ["Right Shoulder"] = R(-5,0,40)},
	glare = {RootJoint = R(12,0,-10), Neck = R(22,0,10), ["Right Shoulder"] = R(-35,0,-5)},
	roar = {RootJoint = R(-14,0,0), Neck = R(-15,0,0), ["Right Shoulder"] = R(-60,0,-15), ["Left Shoulder"] = R(-55,0,15)},
}
P6.w2, P6.s2 = P6.s1, P6.w1
P15.run = {Waist = R(-15,0,0), Neck = R(10,0,0), RightShoulder = R(-40,0,25), RightElbow = R(15,0,0), RightWrist = R(-55,0,0)}
P15.jump = {Waist = R(-8,0,0), RightShoulder = R(120,0,30), RightWrist = R(-40,0,0), LeftShoulder = R(20,0,-50),
	RightHip = R(45,0,5), RightKnee = R(-80,0,0), LeftHip = R(-5,0,0), LeftKnee = R(-35,0,0)}
P15.draw1 = {Waist = R(-10,40,0), Neck = R(0,-30,0), RightShoulder = R(40,0,-40), RightElbow = R(75,0,0), RightWrist = R(-20,0,0), LeftShoulder = R(20,0,-5)}
P15.draw2 = {Waist = R(5,-35,0), Neck = R(0,25,0), RightShoulder = R(70,0,80), RightWrist = R(-65,0,0), LeftShoulder = R(-20,0,-30)}
P6.run = {RootJoint = R(15,0,0), Neck = R(-10,0,0), ["Right Shoulder"] = R(-20,0,-45)}
P6.jump = {["Right Shoulder"] = R(-20,0,130), ["Left Shoulder"] = R(-60,0,-10), ["Right Hip"] = R(0,0,30), ["Left Hip"] = R(0,0,20)}
P6.draw1 = {RootJoint = R(8,0,40), Neck = R(0,0,-30), ["Right Shoulder"] = R(35,0,50)}
P6.draw2 = {RootJoint = R(-5,0,-35), Neck = R(0,0,25), ["Right Shoulder"] = Y6(40,100)}
local DRAW = {{0,"idle"},{.2,"draw1"},{.42,"draw2"},{.62,"draw2"},{.95,"idle"}}
local function slashKeys(n) return {{0,"idle"},{.12,"w"..n},{.26,"s"..n},{.45,"s"..n},{.7,"idle"}} end
local HAKI = {{0,"idle"},{.35,"glare"},{.9,"glare"},{1.05,"roar"},{1.6,"roar"},{1.95,"w3"},{2.15,"s3"},{2.65,"s3"},{2.95,"idle"}}

local HURT = {
	[Enum.HumanoidRigType.R15] = {
		hurt = {Root = CFrame.new(0, 0, .5), Waist = R(30,18,0), Neck = R(35,-20,0), RightShoulder = R(-25,0,50), LeftShoulder = R(-25,0,-50), RightKnee = R(-25,0,0)},
		kneel = {Root = CFrame.new(0,-1.15,0), Waist = R(-28,0,0), Neck = R(-30,0,0), RightShoulder = R(25,0,12), LeftShoulder = R(25,0,-12),
			RightHip = R(85,0,5), RightKnee = R(-90,0,0), LeftHip = R(-5,0,-5), LeftKnee = R(-100,0,0)},
	},
	[Enum.HumanoidRigType.R6] = {
		hurt = {RootJoint = R(-25,0,20), Neck = R(-30,0,-15), ["Right Shoulder"] = R(-50,0,-25), ["Left Shoulder"] = R(-50,0,25)},
		kneel = {RootJoint = CFrame.new(0,0,-1) * R(30,0,0), Neck = R(25,0,0), ["Right Hip"] = R(0,0,55), ["Left Hip"] = R(0,0,55)},
	},
}

local function tween(o, t, props)
	TweenService:Create(o, TweenInfo.new(math.max(t, .03), Enum.EasingStyle.Quad), props):Play()
end

local rigs = setmetatable({}, {__mode = "k"})
local function pose(char, name, time)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local rig = rigs[char]
	if not rig then
		rig = {}
		for _, j in char:GetDescendants() do
			if j:IsA("Motor6D") and not j:FindFirstAncestorOfClass("Tool") then
				rig[j.Name] = {j, "C0", j.C0}
			elseif j:IsA("AnimationConstraint") and j.Attachment0 then
				rig[j.Name] = {j.Attachment0, "CFrame", j.Attachment0.CFrame}
			end
		end
		rigs[char] = rig
	end
	local r15 = hum.RigType == Enum.HumanoidRigType.R15
	local set = r15 and P15 or P6
	local p = HURT[hum.RigType][name] or set[name] or {}
	local plain = name == "run" or name == "none" or name == "hurt" or name == "kneel"
	for joint in set.idle do
		local d = rig[joint]
		if d then
			local offset = p[joint] or (not plain and set.idle[joint]) or CFrame.identity
			tween(d[1], time, {[d[2]] = d[3] * offset})
		end
	end
end

local function part(size, cf, color, transparency, life, material)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material, p.Size, p.CFrame, p.Color, p.Transparency = material or Enum.Material.Neon, size, cf, color, transparency
	p.Parent = workspace
	Debris:AddItem(p, life)
	return p
end
local function sound(where, id, volume, speed)
	local s = Instance.new("Sound")
	s.SoundId, s.Volume, s.PlaybackSpeed, s.RollOffMaxDistance = "rbxasset://sounds/" .. id, volume, speed, 160
	s.Parent = where
	s:Play()
	Debris:AddItem(s, 5)
end
local function bolt(a, b, thick, jag)
	local last = a
	for i = 1, 5 do
		local nxt = a:Lerp(b, i / 5) + (i &lt; 5 and rng:NextUnitVector() * jag or Vector3.zero)
		local cf, len = CFrame.lookAt((last + nxt) / 2, nxt), (nxt - last).Magnitude
		part(Vector3.new(thick, thick, len), cf, BLACK, 0, .14)
		part(Vector3.new(thick * 2.6, thick * 2.6, len), cf, RED, .6, .14)
		last = nxt
	end
end
local function dome(pos, radius, time, color)
	local p = part(Vector3.one * 4, CFrame.new(pos), color, 0, time, Enum.Material.ForceField)
	p.Shape = Enum.PartType.Ball
	tween(p, time, {Size = Vector3.one * radius * 2, Transparency = 1})
end
local function ring(pos, radius, color)
	local a = Instance.new("CylinderHandleAdornment")
	a.Adornee, a.CFrame = workspace.Terrain, CFrame.new(pos) * CFrame.Angles(math.pi / 2, 0, 0)
	a.Height, a.Radius, a.InnerRadius, a.Color3 = .3, 3, 1, color
	a.Parent = workspace
	tween(a, .8, {Radius = radius, InnerRadius = radius - .7, Transparency = 1})
	Debris:AddItem(a, .8)
end
local function shards(pos, count, reach)
	for i = 1, count do
		local dir = rng:NextUnitVector()
		local p = part(Vector3.new(.15, .15, 1.6), CFrame.lookAt(pos, pos + dir), i % 2 == 0 and RED or WHITE, 0, .3)
		tween(p, .3, {CFrame = p.CFrame * CFrame.new(0, 0, -reach), Size = Vector3.new(.02, .02, .3), Transparency = 1})
	end
end
local function quake(pos, power, time)
	for _, plr in Players:GetPlayers() do
		local c = plr.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if h and (c:GetPivot().Position - pos).Magnitude &lt; 90 then
			task.spawn(function()
				for i = 1, math.floor(time / .05) do
					h.CameraOffset = rng:NextUnitVector() * power * (1 - i * .05 / time)
					task.wait(.05)
				end
				h.CameraOffset = Vector3.zero
			end)
		end
	end
end
local function tint(time)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Parent = Lighting
	tween(cc, .3, {TintColor = Color3.fromRGB(255, 140, 140), Contrast = .35, Saturation = -.7})
	task.delay(time, tween, cc, .4, {TintColor = WHITE, Contrast = 0, Saturation = 0})
	Debris:AddItem(cc, time + .5)
end
local function title(char, text)
	local head = char:FindFirstChild("Head")
	if not head then return end
	local g = Instance.new("BillboardGui")
	g.Size, g.StudsOffset, g.AlwaysOnTop = UDim2.fromScale(12, 3), Vector3.new(0, 4.5, 0), true
	local t = Instance.new("TextLabel", g)
	t.Size, t.BackgroundTransparency, t.Text, t.Font, t.TextScaled = UDim2.fromScale(1, 1), 1, text, Enum.Font.Bangers, true
	t.TextColor3, t.TextStrokeColor3, t.TextStrokeTransparency = BLACK, RED, 0
	g.Parent = head
	Debris:AddItem(g, 1.2)
end

-- ردة فعل الشخص المضروب
local function react(m, kneel)
	local root = m:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local pos = root.Position
	shards(pos, 12, 7)
	dome(pos, 5, .3, RED)
	for _, a in {45, -45} do
		local p = part(Vector3.new(6, .18, .18), root.CFrame * CFrame.new(0, 0, -.8) * CFrame.Angles(0, 0, math.rad(a)), WHITE, 0, .35)
		tween(p, .35, {Size = Vector3.new(9, .02, .02), Color = RED, Transparency = 1})
	end
	sound(root, "impact_water.mp3", 1.5, 1.3)
	pose(m, kneel and "kneel" or "hurt", kneel and .25 or .07)
	local mark = (m:GetAttribute("Reaction") or 0) + 1
	m:SetAttribute("Reaction", mark)
	task.delay(kneel and STUN or .35, function()
		if m.Parent and m:GetAttribute("Reaction") == mark then pose(m, "none", .25) end
	end)
end

local char, hum, root, grip, trail, prompt, tip
local token, combo, lastEnd, readyAt, busy, hasButton = 0, 0, 0, 0, false, false

local function play(keys)
	token += 1
	local mine, c = token, char
	task.spawn(function()
		for i = 2, #keys do
			if token ~= mine or char ~= c then return end
			local dt = keys[i][1] - keys[i - 1][1]
			pose(c, keys[i][2], dt)
			task.wait(dt)
		end
	end)
end

local function arc(n)
	local center = root.CFrame * CFrame.Angles(0, 0, n == 3 and math.pi / 2 or (n == 2 and .3 or -.3))
	for i = -7, 7 do
		local cf = center * CFrame.Angles(0, math.rad(i * 9), 0) * CFrame.new(0, 0, -7)
		local p = part(Vector3.new(1.3, .15, (1 - math.abs(i) / 8) * 2.6), cf, i % 2 == 0 and RED or WHITE, .15, .25)
		tween(p, .25, {CFrame = cf * CFrame.new(0, 0, -2.5), Transparency = 1})
	end
end

local function slash()
	local c = char
	combo = (os.clock() - lastEnd &lt; 1.2) and combo % 3 + 1 or 1
	play(slashKeys(combo))
	trail.Enabled = true
	task.wait(.18)
	if char ~= c then return end
	sound(handle, combo == 3 and "swordlunge.wav" or "swordslash.wav", 1.5, combo == 3 and .7 or 1.1)
	arc(combo)
	local box = workspace:GetPartBoundsInBox(root.CFrame * CFrame.new(0, 0, -6), Vector3.new(12, 8, 12))
	hitParts(c, box, {}, function(m, h)
		damage(c, m, h, SLASH_DAMAGE[combo])
		react(m)
		freeze(h, .35)
		quake(root.Position, .5, .2)
		if combo == 3 then knock(m, root.Position, 60) end
	end)
	if combo == 3 then
		local front = (root.CFrame * CFrame.new(0, -2.8, -6)).Position
		ring(front, 15, RED)
		shards(front, 16, 10)
		quake(front, .8, .3)
	end
	task.wait(combo == 3 and .52 or .4)
	trail.Enabled = false
	lastEnd = os.clock()
end

local function haki()
	local c = char
	readyAt = os.clock() + COOLDOWN
	prompt.Enabled = false
	freeze(hum, 3)
	play(HAKI)
	local old = {}
	for _, p in tool:GetChildren() do
		if p.Name == "Steel" then
			old[p] = p.Color
			tween(p, .5, {Color = Color3.fromRGB(30, 4, 10)})
		end
	end
	task.delay(3.1, function()
		for p, color in old do tween(p, .5, {Color = color}) end
	end)
	tint(2.6)
	sound(root, "action_falling.ogg", 3, .35)
	quake(root.Position, .35, 1)
	for i = 1, 10 do
		if char ~= c then return end
		for _ = 1, 2 do bolt(root.Position + rng:NextUnitVector() * 2, root.Position + rng:NextUnitVector() * (3 + i * .7), .12, .9) end
		if i % 3 == 0 then
			dome(root.Position, 5 + i, .35, BLACK)
			sound(root, "swordslash.wav", 1, rng:NextNumber(.4, .7))
		end
		task.wait(.1)
	end
	if char ~= c then return end
	local pos = root.Position
	local floor = pos - Vector3.new(0, 2.8, 0)
	title(c, "HAOSHOKU HAKI")
	sound(root, "impact_water.mp3", 4, .3)
	sound(root, "swordlunge.wav", 3, .3)
	quake(pos, 1.8, .8)
	for i = 0, 3 do
		task.delay(i * .14, function()
			dome(pos, HAKI_RADIUS - i * 4, .9, i % 2 == 0 and RED or BLACK)
			ring(floor, HAKI_RADIUS + 4, i % 2 == 0 and BLACK or RED)
		end)
	end
	for i = 1, 20 do
		local dir = CFrame.Angles(0, i / 20 * math.pi * 2, 0).LookVector
		bolt(pos, pos + dir * rng:NextNumber(18, 42) + Vector3.new(0, rng:NextNumber(-2, 14), 0), .22, 2.5)
		local len = rng:NextNumber(6, 20)
		local crack = part(Vector3.new(.25, .1, len), CFrame.lookAt(floor + dir * (len / 2 + 2), floor + dir * 40), BLACK, 0, 3)
		tween(crack, 3, {Transparency = 1})
		local rock = part(Vector3.one * rng:NextNumber(.4, 1.4), CFrame.new(floor + dir * rng:NextNumber(4, 14)), Color3.fromRGB(90, 75, 60), 0, 1.3, Enum.Material.Slate)
		tween(rock, 1.3, {CFrame = rock.CFrame * CFrame.new(0, rng:NextNumber(5, 13), 0) * CFrame.Angles(i, i * 2, 0), Transparency = 1})
	end
	hitParts(c, workspace:GetPartBoundsInRadius(pos, HAKI_RADIUS), {}, function(m, h)
		damage(c, m, h, HAKI_DAMAGE)
		freeze(h, STUN)
		react(m, true)
	end)
	task.wait(1.15)
	if char ~= c then return end
	local start = root.CFrame
	title(c, "KAMUSARI")
	sound(root, "swordlunge.wav", 4, .5)
	sound(root, "impact_water.mp3", 3, .45)
	quake(start.Position, 1.4, .6)
	for i = -9, 9 do
		local k = 1 - math.abs(i) / 10
		local cf = start * CFrame.Angles(0, 0, math.rad(55)) * CFrame.new(i, 0, -4 + i * i * .06) * CFrame.Angles(0, math.rad(-i * 5), 0)
		for layer, color in {RED, BLACK} do
			local p = part(Vector3.new(1.4, .5 * k * (3 - layer), 3.5 * k + .3), cf * CFrame.new(0, 0, layer * 1.2), color, layer == 1 and .15 or 0, .8)
			tween(p, .8, {CFrame = p.CFrame + start.LookVector * 85, Transparency = 1})
		end
	end
	local done = {}
	for i = 1, 14 do
		local at = (start * CFrame.new(0, 0, -i * 6)).Position
		bolt(at, at + rng:NextUnitVector() * 10, .15, 1.5)
		hitParts(c, workspace:GetPartBoundsInBox(start * CFrame.new(0, 0, -i * 6), Vector3.new(18, 12, 8)), done, function(m, h)
			damage(c, m, h, WAVE_DAMAGE)
			react(m)
			knock(m, start.Position, 85)
		end)
		task.wait(.05)
	end
	task.wait(.2)
end

local function act(player, action)
	if busy or not char or player.Character ~= char or hum.Health &lt;= 0 then return end
	if action == "Haki" and os.clock() &lt; readyAt then return end
	if action ~= "Haki" and action ~= "Slash" then return end
	busy = true
	local ok, err = pcall(action == "Haki" and haki or slash)
	busy = false
	if trail then trail.Enabled = false end
	if not ok then warn("[Shanks] " .. tostring(err)) end
end

local function unequip()
	local c = char
	if not c then return end
	char = nil
	token += 1
	if c.Parent then pose(c, "none", .2) end
	for _, o in {grip, trail, prompt, tip} do o:Destroy() end
	trail = nil
end

local function equip()
	local c = tool.Parent
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if not h or c == char then return end
	char, hum, root = c, h, c:WaitForChild("HumanoidRootPart")
	local r15 = h.RigType == Enum.HumanoidRigType.R15
	local hand = c:WaitForChild(r15 and "RightHand" or "Right Arm")
	grip = Instance.new("Motor6D")
	grip.Name, grip.Part0, grip.Part1 = "SwordGrip", hand, handle
	grip.C0 = CFrame.new(0, r15 and -.1 or -1, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
	grip.Parent = handle
	local a0 = Instance.new("Attachment", handle)
	tip = Instance.new("Attachment", handle)
	a0.Position, tip.Position = Vector3.new(0, 1.1, 0), Vector3.new(0, 6.8, .75)
	trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1, trail.Lifetime, trail.Enabled = a0, tip, .25, false
	trail.Color, trail.LightEmission, trail.Transparency = ColorSequence.new(WHITE, RED), .8, NumberSequence.new(.1, 1)
	trail.Parent = handle
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture, smoke.Color = "rbxasset://textures/particles/smoke_main.dds", ColorSequence.new(RED, BLACK)
	smoke.Size, smoke.Transparency = NumberSequence.new(.8, 0), NumberSequence.new(.4, 1)
	smoke.Rate, smoke.Lifetime, smoke.Speed = 25, NumberRange.new(.4, .8), NumberRange.new(.5, 1.5)
	smoke.Parent = tip
	-- زر الهاكي الاحتياطي (يظهر إذا زر الشاشة ما اشتغل)
	prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.KeyboardKeyCode, prompt.RequiresLineOfSight = "HAKI", Enum.KeyCode.Q, false
	prompt.UIOffset, prompt.Enabled = Vector2.new(220, 0), not hasButton
	prompt.Parent = root
	prompt.Triggered:Connect(function(plr) act(plr, "Haki") end)
	-- أنميشن سحب السيف
	sound(handle, "unsheath.wav", 2, .9)
	trail.Enabled = true
	play(DRAW)
	ring(root.Position - Vector3.new(0, 2.8, 0), 15, RED)
	for _ = 1, 8 do bolt(root.Position, root.Position + rng:NextUnitVector() * 7, .1, .8) end
	task.spawn(function()
		task.wait(1)
		local state, nextBolt = "", 0
		while char == c and h.Health &gt; 0 do
			if busy then
				state = ""
			else
				trail.Enabled = false
				local v = root.AssemblyLinearVelocity
				local new = math.abs(v.Y) &gt; 6 and "jump" or ((v * Vector3.new(1, 0, 1)).Magnitude &gt; 2 and "run" or "idle")
				if new ~= state then
					state = new
					pose(c, new, .18)
				end
				prompt.Enabled = not hasButton and os.clock() &gt;= readyAt
			end
			if os.clock() &gt; nextBolt then
				nextBolt = os.clock() + rng:NextNumber(.4, 1.2)
				local at = handle.CFrame:PointToWorldSpace(Vector3.new(0, rng:NextNumber(1.2, 6.5), .3))
				bolt(at, at + rng:NextUnitVector() * 1.8, .04, .4)
				sound(handle, "swordslash.wav", .08, rng:NextNumber(2.2, 3))
			end
			task.wait(.1)
		end
	end)
end

tool.Equipped:Connect(equip)
tool.Unequipped:Connect(unequip)
tool.Activated:Connect(function()
	local plr = Players:GetPlayerFromCharacter(tool.Parent)
	if plr then act(plr, "Slash") end
end)
remote.OnServerEvent:Connect(function(plr, action)
	if plr.Character ~= tool.Parent then return end
	if action == "Button" then
		hasButton = true
		if prompt then prompt.Enabled = false end
	else
		act(plr, action)
	end
end)
equip()
print("[Shanks] v4 ready")
</ProtectedString></Properties></Item>
