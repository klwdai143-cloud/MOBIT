<Item class="StarterGui" referent="RBX219"><Properties><string name="Name">StarterGui</string></Properties><Item class="ScreenGui" referent="RBX218"><Properties><string name="Name">Gear5Gui</string><bool name="ResetOnSpawn">false</bool></Properties><Item class="LocalScript" referent="RBX217"><Properties><string name="Name">Gear5Button</string><ProtectedString name="Source">local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local remote = game:GetService("ReplicatedStorage"):WaitForChild("Gear5")
local p = Players.LocalPlayer
local b = Instance.new("TextButton")
b.AnchorPoint, b.Position, b.Size = Vector2.new(1, .5), UDim2.new(1, -18, .5, 0), UDim2.new(0, 94, 0, 94)
b.BackgroundColor3, b.TextColor3, b.TextStrokeTransparency = Color3.new(1, 1, 1), Color3.new(1, 1, 1), 0
b.Font, b.TextSize, b.Text, b.AutoButtonColor = Enum.Font.Bangers, 30, "GEAR 5", false
Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
local g = Instance.new("UIGradient", b)
g.Rotation, g.Color = 90, ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 80, 220))
local st = Instance.new("UIStroke", b)
st.ApplyStrokeMode, st.Color = Enum.ApplyStrokeMode.Border, Color3.new(1, 1, 1)
TweenService:Create(st, TweenInfo.new(.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Thickness = 7}):Play()
b.Parent = script.Parent
b.MouseButton1Click:Connect(function() remote:FireServer("toggle") end)

-- كاميرا الكاتسين: {بداية، نهاية، موقع أول، موقع ثاني، ينظر للقمر؟}
local V = Vector3.new
local SHOTS = {
	{0, 3.1, V(3, -1, -11), V(-1, .8, -6)},
	{3.1, 5.4, V(-9, -3, -12), V(11, 3, -11)},
	{5.4, 6.7, V(0, 3, -14), V(0, 9, -34)},
	{6.7, 9.6, V(-6, 0, -10), V(5, 1, -9)},
	{9.6, 11.3, V(14, 1, -17), V(-14, 4, -17)},
	{11.3, 13.4, V(7, -6, 17), V(10, -3, 22), true},
	{13.4, 17.2, V(48, 18, 6), V(42, 24, -62), false, V(0, 6, -22)},
	{17.2, 30, V(-4, 0, -13), V(3, 1, -9)},
}
local run, shake = 0, 0
remote.OnClientEvent:Connect(function(kind, base, moon)
	local cam = workspace.CurrentCamera
	if kind == "shake" then shake = base return end
	run += 1
	if kind == "end" then cam.CameraType = Enum.CameraType.Custom return end
	local mine, t0 = run, os.clock()
	local root = p.Character.HumanoidRootPart
	cam.CameraType = Enum.CameraType.Scriptable
	while run == mine and root.Parent do
		local t = os.clock() - t0
		local shot = SHOTS[#SHOTS]
		for _, s in SHOTS do
			if t &lt; s[2] then shot = s break end
		end
		local a = math.clamp((t - shot[1]) / (shot[2] - shot[1]), 0, 1)
		local eye = root.Position + base:VectorToWorldSpace(shot[3]:Lerp(shot[4], a))
		local look = shot[5] and root.Position:Lerp(moon, .35) or root.Position + (shot[6] and base:VectorToWorldSpace(shot[6]) or V(0, .8, 0))
		local jit = V(math.random() - .5, math.random() - .5, math.random() - .5) * shake
		cam.CFrame = CFrame.lookAt(eye, look) + jit
		RunService.RenderStepped:Wait()
		if t &gt; 25 then break end
	end
	if run == mine then cam.CameraType = Enum.CameraType.Custom end
end)
RunService.RenderStepped:Connect(function(dt) shake *= math.exp(-5 * dt) end)
local function refresh()
	b.Text = p:GetAttribute("Busy") and "..." or (p:GetAttribute("On") and "OFF" or "GEAR 5")
end
remote:FireServer("ready")
while task.wait(.2) do refresh() end
</ProtectedString></Properties></Item>
