<Item class="ServerScriptService" referent="RBX221"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX220"><Properties><string name="Name">Gear5Server</string><ProtectedString name="Source">local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local rng, rgb = Random.new(), Color3.fromRGB
local remote = game:GetService("ReplicatedStorage"):WaitForChild("Gear5")
local WHITE, SKY, PURPLE = Color3.new(1, 1, 1), rgb(170, 215, 255), rgb(110, 60, 160)
-- بدل الأصوات بـ "rbxassetid://ID" من التولبوكس إذا تبغى (طبول، ضحكة، برق)
local SFX = {drum = "impact_water.mp3", boing = "action_jump.mp3", zap = "swordslash.wav", whoosh = "swordlunge.wav", wind = "action_falling.ogg"}
local function short(n)
	if n &gt;= 1e9 then return string.format("%.1fB", n / 1e9) end
	if n &gt;= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n &gt;= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end
local function tween(o, t, props) TweenService:Create(o, TweenInfo.new(t), props):Play() end
local function part(size, cf, color, transparency, life, material)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
	p.Material, p.Size, p.CFrame, p.Color, p.Transparency = material or Enum.Material.Neon, size, cf, color, transparency or 0
	p.Parent = workspace
	if life then Debris:AddItem(p, life) end
	return p
end
local function label(parent, text, color, y, w, h)
	local g = Instance.new("BillboardGui")
	g.Size, g.StudsOffset, g.MaxDistance = UDim2.fromScale(w or 10, h or 2.5), Vector3.new(0, y, 0), 220
	local t = Instance.new("TextLabel", g)
	t.Size, t.BackgroundTransparency, t.Font, t.TextScaled = UDim2.fromScale(1, 1), 1, Enum.Font.GothamBlack, true
	t.Text, t.TextColor3, t.TextStrokeTransparency = text, color, 0
	g.Parent = parent
	return t, g
end
local function popup(at, text, color)
	local p = part(Vector3.one, CFrame.new(at + rng:NextUnitVector() * 1.5), color, 1, .8)
	label(p, text, color, 1, 5, 1.4)
	tween(p, .8, {Position = p.Position + Vector3.new(0, 4, 0)})
end
local function burst(pos, color, radius)
	local b = part(Vector3.one, CFrame.new(pos), color, .2, .4, Enum.Material.ForceField)
	b.Shape = Enum.PartType.Ball
	tween(b, .4, {Size = Vector3.one * radius * 2, Transparency = 1})
	for _ = 1, 8 do
		local d = rng:NextUnitVector()
		local s = part(Vector3.new(.2, .2, 1.5), CFrame.lookAt(pos, pos + d), color, 0, .3)
		tween(s, .3, {CFrame = s.CFrame * CFrame.new(0, 0, -radius), Transparency = 1})
	end
end
local function sound(where, id, volume, speed)
	local s = Instance.new("Sound")
	s.SoundId, s.Volume, s.PlaybackSpeed, s.Parent = "rbxasset://sounds/" .. id, volume, speed, where
	s:Play()
	Debris:AddItem(s, 3)
end

local function R(x, y, z) return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z)) end
local function joints(p, r15)
	local pi, ya, rf, ro, re, lf, lo, le, rh, rk, lh, lk, dy = table.unpack(p)
	if r15 then
		return {Root = CFrame.new(0,dy,0), Waist = R(-pi,ya,0), Neck = R(pi*.5,-ya*.6,0), RightShoulder = R(rf,0,ro), LeftShoulder = R(lf,0,-lo),
			RightElbow = R(re,0,0), LeftElbow = R(le,0,0), RightHip = R(rh,0,6), LeftHip = R(lh,0,-6), RightKnee = R(-rk,0,0), LeftKnee = R(-lk,0,0)}
	end
	return {RootJoint = CFrame.new(0,0,dy*.5) * R(pi,0,ya), Neck = R(-pi*.5,0,-ya*.6), ["Right Shoulder"] = R(-ro,0,rf), ["Left Shoulder"] = R(-lo,0,-lf),
		["Right Hip"] = R(0,0,rh), ["Left Hip"] = R(0,0,-lh)}
end
local function tw(o, t, props, style) TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad), props):Play() end
local S, active, nightFx, savedTime = {}, 0, {}, 14

-- الوضعيات: ميل، لف، يد يمين (قدام، برا، كوع)، يد يسار، رجل يمين (قدام، ركبة)، رجل يسار، ارتفاع
local ANIM = {
	kneel = function(t) local b = math.max(0, math.sin(t * 11)) ^ 4
		return {38 - b * 14,0, 15,12,25, 15,12,25, 85,115, -5,105, -1.35 + b * .25} end,
	rise = function(t) local j = math.sin(t * 40) * 4
		return {-14 + j,j, -15,45 + j,15, -15,45 - j,15, 20,40, -10,25, 0} end,
	burst = function() return {-32,0, 30,125,5, 30,125,5, 35,30, -25,45, .3} end,
	laugh = function(t) local b = math.sin(t * 19)
		return {-26 + b * 9,math.sin(t * 5) * 14, 52 + b * 7,-18,112, 52 - b * 7,-18,112, 40 + math.sin(t * 8) * 25,55, -8,15, math.abs(b) * .45} end,
	dance = function(t) local w, c = math.sin(t * 15), math.cos(t * 15)
		return {12,w * 28, 90 * w,90 + 55 * c,30, -90 * w,90 - 55 * c,30, 70 * w,80 * math.max(0, w), -70 * w,80 * math.max(0, -w), math.abs(w) * .9} end,
	grab = function(t) return {-22,18, 178,6 + math.sin(t * 30) * 5,0, 25,55,25, 30,45, -18,20, .5} end,
	windup = function() return {-35,-55, 185,45,75, 90,25,10, 70,95, -25,30, .4} end,
	throw = function() return {42,50, 50,-5,0, -65,40,25, 70,90, -45,35, -1} end,
	punch = function(t) return {18,25, 165 - math.min(t * 190, 100),8,0, -40,45,60, 40,55, -30,30, -.5} end,
	victory = function(t) return {-6,18, 15,40,100, 155,35,20, 12,10, -12,10, math.sin(t * 7) * .12} end,
}
local function play(s, name, speed) s.anim, s.t0, s.speed = ANIM[name], os.clock(), speed or 18 end

RunService.Heartbeat:Connect(function(dt)
	for c, s in S do
		if s.anim then
			local goal = joints(s.anim(os.clock() - s.t0), s.hum.RigType == Enum.HumanoidRigType.R15)
			for name, d in s.rig do
				if goal[name] then d[1][d[2]] = d[1][d[2]]:Lerp(d[3] * goal[name], 1 - math.exp(-dt * s.speed)) end
			end
		end
		-- وشاح الغيوم المتحرك
		for i, w in s.scarf do
			local a = (i - 1) / (#s.scarf - 1) * math.pi * 1.5 - math.pi * .25
			local t = os.clock() * 3 + i * .7
			w.C0 = CFrame.new(math.cos(a) * 2.5, .5 + math.sin(a) * 1.7 + math.sin(t) * .3, .9 + math.cos(t) * .25)
		end
	end
end)

local function ring(pos, radius, color, time)
	local a = Instance.new("CylinderHandleAdornment")
	a.Adornee, a.CFrame = workspace.Terrain, CFrame.new(pos) * R(90, 0, 0)
	a.Height, a.Radius, a.InnerRadius, a.Color3, a.Parent = .3, 2, .5, color, workspace
	tw(a, time or .7, {Radius = radius, InnerRadius = radius - .7, Transparency = 1})
	Debris:AddItem(a, time or .7)
end
local function bolt(a, b, thick, jag, color, life)
	local last = a
	for i = 1, 8 do
		local n = a:Lerp(b, i / 8) + (i &lt; 8 and rng:NextUnitVector() * jag or Vector3.zero)
		local cf, len = CFrame.lookAt((last + n) / 2, n), (n - last).Magnitude
		part(Vector3.new(thick, thick, len), cf, WHITE, 0, life or .12)
		part(Vector3.new(thick * 2.4, thick * 2.4, len), cf, color or SKY, .65, life or .12)
		last = n
	end
end
local function ball(size, pos, color, transparency, life, material)
	local p = part(Vector3.one * size, CFrame.new(pos), color, transparency, life, material)
	p.Shape = Enum.PartType.Ball
	return p
end
local function boom(pos, radius)
	for i = 0, 3 do
		task.delay(i * .1, function()
			local d = ball(4, pos, i % 2 == 0 and WHITE or SKY, .1, .8, Enum.Material.ForceField)
			tw(d, .8, {Size = Vector3.one * (radius * 2 - i * 6), Transparency = 1})
			ring(pos - Vector3.new(0, 2.5, 0), radius + i * 7, i % 2 == 0 and WHITE or PURPLE)
		end)
	end
	for i = 1, 22 do
		local dir = CFrame.Angles(0, i / 22 * math.pi * 2, 0).LookVector
		local puff = ball(rng:NextNumber(2, 5), pos + dir * 3 - Vector3.new(0, 2, 0), WHITE, .2, 1.1, Enum.Material.SmoothPlastic)
		tw(puff, 1.1, {Position = puff.Position + dir * radius * .8 + Vector3.new(0, rng:NextNumber(1, 7), 0), Size = Vector3.one * .3, Transparency = 1})
	end
	sound(workspace.Stage, SFX.drum, 3, .4)
end
local function cam(s, ...) if s.player then remote:FireClient(s.player, ...) end end

local function night(root)
	active += 1
	if active &gt; 1 then return nightFx[1].Position end
	savedTime = Lighting.ClockTime
	tw(Lighting, 2.5, {ClockTime = 24})
	local pos = (root.CFrame * CFrame.new(0, 0, -240)).Position + Vector3.new(0, 125, 0)
	local moon = ball(10, pos - Vector3.new(0, 110, 0), rgb(255, 250, 220), 0)
	tw(moon, 3, {Size = Vector3.one * 85, Position = pos}, Enum.EasingStyle.Sine)
	nightFx = {moon}
	for i, size in {100, 122, 150} do
		local halo = ball(5, moon.Position, rgb(210, 225, 255), .8 + i * .05)
		tw(halo, 3, {Size = Vector3.one * size, Position = pos}, Enum.EasingStyle.Sine)
		table.insert(nightFx, halo)
	end
	local back = (root.Position - pos).Unit
	for i = 1, 9 do
		local off = (back + rng:NextUnitVector() * .6).Unit * 41
		local crater = ball(rng:NextNumber(5, 14), pos + off, rgb(215, 205, 175), 1)
		task.delay(3, tw, crater, .5, {Transparency = 0})
		table.insert(nightFx, crater)
	end
	local cc = Instance.new("ColorCorrectionEffect", Lighting)
	tw(cc, 2, {TintColor = rgb(190, 205, 255), Contrast = .2})
	table.insert(nightFx, cc)
	return pos
end
local function day()
	active = math.max(0, active - 1)
	if active &gt; 0 then return end
	for _, o in nightFx do o:Destroy() end
	nightFx = {}
	tw(Lighting, 2, {ClockTime = savedTime})
end

local function weld(s, to, size, offset, color, material, ballShape)
	local p = Instance.new("Part")
	p.Size, p.Color, p.Material, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = size, color, material or Enum.Material.SmoothPlastic, false, false, false, true
	if ballShape then p.Shape = Enum.PartType.Ball end
	p.CFrame = to.CFrame * offset
	local w = Instance.new("Weld")
	w.Part0, w.Part1, w.C0 = to, p, offset
	p.Parent, w.Parent = s.folder, p
	return w, p
end
local function dress(c, s)
	for _, o in c:GetChildren() do
		if o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then
			table.insert(s.clothes, o)
			o.Parent = nil
		elseif o:IsA("BasePart") and (o.Name:find("Torso") or o.Name:find("Leg") or o.Name:find("Foot")) then
			s.colors[o] = o.Color
			o.Color = o.Name == "LowerTorso" and PURPLE or WHITE
		elseif o:IsA("Accessory") and o.AccessoryType == Enum.AccessoryType.Hair then
			local h = o:FindFirstChild("Handle")
			if h then s.hidden[h] = h.Transparency; h.Transparency = 1 end
		end
	end
	local head, torso = c.Head, c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
	-- شعر أبيض منفوش
	for i = 1, 26 do
		local a, up = i * 2.4, .25 + (i % 5) * .13
		local dir = Vector3.new(math.cos(a) * (1 - up * .6), up, math.sin(a) * (1 - up * .6))
		if dir.Z &gt; -.35 or up &gt; .6 then
			local size = .45 + (i % 3) * .14
			weld(s, head, Vector3.one * size, CFrame.new(dir * .72), WHITE, Enum.Material.Neon, true)
			weld(s, head, Vector3.new(size * .35, size * 1.5, size * .35), CFrame.lookAt(dir * 1.05, dir * 2) * R(-90, 0, 0), WHITE, Enum.Material.Neon)
		end
	end
	for _, x in {-.22, .22} do
		weld(s, head, Vector3.new(.14, .2, .06), CFrame.new(x, .12, -.62), rgb(255, 30, 60), Enum.Material.Neon)
	end
	for i = 1, 22 do
		local w = weld(s, torso, Vector3.one * (.75 + math.sin(i / 22 * math.pi) * .55), CFrame.new(), WHITE, Enum.Material.Neon, true)
		w.Part1.Transparency = .12
		table.insert(s.scarf, w)
	end
	local root = c.HumanoidRootPart
	local e = Instance.new("ParticleEmitter")
	e.Texture, e.Color, e.LightEmission = "rbxasset://textures/particles/smoke_main.dds", ColorSequence.new(WHITE), .8
	e.Size, e.Transparency = NumberSequence.new(1.8, 0), NumberSequence.new(.65, 1)
	e.Rate, e.Lifetime, e.Speed, e.Parent = 22, NumberRange.new(.6, 1.2), NumberRange.new(2, 5), root
	local light = Instance.new("PointLight", root)
	light.Range, light.Brightness = 22, 2.5
	table.insert(s.extra, e)
	table.insert(s.extra, light)
end

local function revert(c)
	local s = S[c]
	if not s or not s.on then return end
	s.on, s.anim, s.scarf = false, nil, {}
	for _, d in s.rig do d[1][d[2]] = d[3] end
	for p, color in s.colors do p.Color = color end
	for h, t in s.hidden do h.Transparency = t end
	for _, o in s.clothes do if c.Parent then o.Parent = c end end
	for _, o in s.extra do o:Destroy() end
	s.colors, s.hidden, s.clothes, s.extra = {}, {}, {}, {}
	s.folder:ClearAllChildren()
	if c.Parent and c:FindFirstChild("HumanoidRootPart") then
		c.HumanoidRootPart.Anchored = false
		boom(c.HumanoidRootPart.Position, 12)
	end
	s.hum.WalkSpeed, s.hum.JumpPower = 16, 50
	day()
end

local function transform(c, s)
	local root, hum = c.HumanoidRootPart, s.hum
	local function ok() return s.on and c.Parent and hum.Health &gt; 0 end
	local function wait(t) task.wait(t) if not ok() then error("stop", 0) end end
	local base = root.CFrame
	local floor = base.Position - Vector3.new(0, 2.8, 0)
	root.Anchored = true
	local ff = Instance.new("ForceField", c)
	ff.Visible = false
	table.insert(s.extra, ff)
	local moon = night(root)
	cam(s, "cinema", base, moon)
	-- 1) طبول التحرر
	play(s, "kneel", 14)
	for i = 1, 6 do
		sound(root, SFX.drum, 3, .35)
		task.delay(.14, sound, root, SFX.drum, 2, .5)
		ring(floor, 8 + i * 3, i % 2 == 0 and PURPLE or WHITE)
		popup(root.Position + Vector3.new(0, 3, 0), "دُم دَ دَ دُم!", WHITE)
		cam(s, "shake", .15 + i * .05)
		wait(.57 - i * .025)
	end
	-- 2) الارتفاع
	play(s, "rise")
	sound(root, SFX.wind, 3, .6)
	tw(root, 2, {CFrame = base + Vector3.new(0, 9, 0)}, Enum.EasingStyle.Sine)
	for i = 1, 34 do
		for k = 0, 1 do
			local a = i * .55 + k * math.pi
			local puff = ball(1.6, floor + Vector3.new(math.cos(a) * 6, i * .35, math.sin(a) * 6), WHITE, .15, .7)
			tw(puff, .7, {Size = Vector3.one * .1, Position = puff.Position + Vector3.new(0, 5, 0), Transparency = 1})
		end
		if i % 4 == 0 then
			bolt(root.Position, root.Position + rng:NextUnitVector() * 13, .15, 1.4)
			sound(root, SFX.zap, 1, rng:NextNumber(.5, 1.2))
		end
		wait(.06)
	end
	-- 3) الانفجار الأبيض
	local gui = s.player and s.player:FindFirstChild("PlayerGui")
	if gui then
		local g = Instance.new("ScreenGui")
		g.IgnoreGuiInset = true
		local f = Instance.new("Frame", g)
		f.Size, f.BackgroundColor3, f.BorderSizePixel = UDim2.fromScale(1, 1), WHITE, 0
		g.Parent = gui
		tw(f, 1.1, {BackgroundTransparency = 1})
		Debris:AddItem(g, 1.2)
	end
	dress(c, s)
	play(s, "burst", 30)
	boom(root.Position, 42)
	sound(root, SFX.whoosh, 4, .35)
	cam(s, "shake", 2)
	local _, title = label(root, "☀ GEAR 5 ☀", rgb(255, 250, 230), 6.5, 22, 6)
	Debris:AddItem(title, 2.6)
	for i = 1, 12 do bolt(root.Position, root.Position + CFrame.Angles(0, i * .52, 0).LookVector * 30 + Vector3.new(0, rng:NextNumber(-8, 18), 0), .3, 2.5, SKY, .35) end
	wait(1.2)
	-- 4) ضحكة لوفي
	play(s, "laugh", 22)
	for i = 1, 9 do
		popup(root.Position + Vector3.new(rng:NextNumber(-5, 5), 3, 0), i % 2 == 0 and "هاهاها!" or "AHAHA!", i % 2 == 0 and WHITE or rgb(255, 220, 90))
		sound(root, SFX.boing, 1.5, i % 2 == 0 and 1.5 or 1.2)
		ring(floor, 12 + (i % 3) * 5, WHITE, .5)
		wait(.32)
	end
	-- 5) الرقصة الكرتونية
	play(s, "dance", 25)
	for i = 1, 10 do
		tw(root, .14, {CFrame = base * CFrame.new(math.sin(i * 1.3) * 3, 9 + (i % 2) * 2.5, 0) * R(0, math.sin(i) * 35, 0)}, Enum.EasingStyle.Back)
		boom(root.Position - Vector3.new(0, 3, 0), 7)
		sound(root, SFX.boing, 1.5, .8 + i * .09)
		wait(.16)
	end
	-- 6) مسك البرق ورميه
	tw(root, .3, {CFrame = base + Vector3.new(0, 12, 0)}, Enum.EasingStyle.Back)
	play(s, "grab")
	local hand = c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")
	for i = 1, 12 do
		bolt(moon, hand.Position, .9, 7)
		bolt(hand.Position + Vector3.new(-6, 0, 0), hand.Position + Vector3.new(6, 0, 0), .45, 1)
		sound(root, SFX.zap, 2, .35 + i * .04)
		cam(s, "shake", .5)
		wait(.1)
	end
	play(s, "windup", 14)
	for _ = 1, 5 do bolt(hand.Position - Vector3.new(0, 1, 0), hand.Position + Vector3.new(0, 11, 0), .6, 1.2) wait(.1) end
	play(s, "throw", 35)
	sound(root, SFX.whoosh, 4, .6)
	local target = (base * CFrame.new(0, -2.5, -38)).Position
	for _ = 1, 5 do bolt(hand.Position, target, 1.3, 3.5) wait(.07) end
	boom(target, 35)
	for _ = 1, 14 do bolt(target, target + rng:NextUnitVector() * 28, .35, 2) end
	cam(s, "shake", 2.2)
	wait(.7)
	-- 7) القبضة العملاقة
	play(s, "punch", 20)
	local _, name = label(root, "BAJRANG GUN!", rgb(255, 90, 60), 6.5, 20, 5)
	Debris:AddItem(name, 1.6)
	local from = (base * CFrame.new(0, 42, -12)).Position
	local fist = ball(3, from, rgb(25, 15, 30), 0, 1.5, Enum.Material.Metal)
	local arm = part(Vector3.new(2, 2, 2), CFrame.lookAt((hand.Position + from) / 2, from), rgb(25, 15, 30), 0, 1.5, Enum.Material.Metal)
	tw(arm, .6, {Size = Vector3.new(5, 5, (from - hand.Position).Magnitude)})
	tw(fist, .6, {Size = Vector3.one * 26}, Enum.EasingStyle.Back)
	for _ = 1, 6 do bolt(fist.Position, fist.Position + rng:NextUnitVector() * 22, .35, 2, PURPLE) wait(.1) end
	local hit = target + Vector3.new(0, 8, 0)
	tw(fist, .25, {Position = hit}, Enum.EasingStyle.Quart)
	tw(arm, .25, {Size = Vector3.new(5, 5, (hit - hand.Position).Magnitude), CFrame = CFrame.lookAt((hand.Position + hit) / 2, hit)}, Enum.EasingStyle.Quart)
	wait(.27)
	boom(target, 60)
	cam(s, "shake", 3)
	for i = 1, 40 do
		local dir = CFrame.Angles(0, i * .5, 0).LookVector
		local rock = part(Vector3.one * rng:NextNumber(1, 3.5), CFrame.new(target + dir * rng:NextNumber(5, 25)), rgb(85, 75, 80), 0, 1.5, Enum.Material.Slate)
		tw(rock, 1.5, {CFrame = rock.CFrame * CFrame.new(0, rng:NextNumber(8, 24), 0) * R(i * 40, i * 25, 0), Transparency = 1})
	end
	wait(.35)
	tw(fist, .4, {Transparency = 1})
	tw(arm, .4, {Transparency = 1})
	-- 8) الهبوط ووقفة النصر
	tw(root, .5, {CFrame = base}, Enum.EasingStyle.Bounce)
	play(s, "victory", 14)
	wait(.5)
	boom(root.Position, 20)
	wait(1.3)
end

local function toggle(player)
	local c = player.Character
	local s = c and S[c]
	if not s or s.busy or s.hum.Health &lt;= 0 then return end
	s.busy = true
	player:SetAttribute("Busy", true)
	if s.on then
		revert(c)
		task.wait(1)
	else
		s.on = true
		local good, err = pcall(transform, c, s)
		cam(s, "end")
		if good then
			s.anim = nil
			for _, d in s.rig do d[1][d[2]] = d[3] end
			c.HumanoidRootPart.Anchored = false
			for _, o in s.extra do if o:IsA("ForceField") then o:Destroy() end end
			s.hum.WalkSpeed, s.hum.JumpPower = 32, 95
		else
			if err ~= "stop" then warn("[Gear5] " .. tostring(err)) end
			revert(c)
		end
	end
	s.busy = false
	player:SetAttribute("Busy", false)
	player:SetAttribute("On", s.on)
end

local function setup(player)
	local function spawned(c)
		local hum = c:WaitForChild("Humanoid")
		c:WaitForChild("HumanoidRootPart")
		task.wait(.5)
		local s = {player = player, hum = hum, rig = {}, scarf = {}, colors = {}, hidden = {}, clothes = {}, extra = {}}
		for _, j in c:GetDescendants() do
			if j:IsA("Motor6D") then s.rig[j.Name] = {j, "C0", j.C0}
			elseif j:IsA("AnimationConstraint") and j.Attachment0 then s.rig[j.Name] = {j.Attachment0, "CFrame", j.Attachment0.CFrame} end
		end
		s.folder = Instance.new("Folder", c)
		hum.UseJumpPower = true
		S[c] = s
		player:SetAttribute("On", false)
		player:SetAttribute("Busy", false)
		hum.Died:Connect(function() revert(c) S[c] = nil end)
		-- أداة احتياطية إذا زر الشاشة ما اشتغل
		task.wait(4)
		if not player:GetAttribute("Ready") and c.Parent then
			local t = Instance.new("Tool")
			t.Name, t.RequiresHandle = "GEAR 5", false
			t.Activated:Connect(function() toggle(player) end)
			t.Parent = player.Backpack
		end
	end
	player.CharacterAdded:Connect(spawned)
	player.CharacterRemoving:Connect(function(c) revert(c) S[c] = nil end)
	if player.Character then task.spawn(spawned, player.Character) end
end
Players.PlayerAdded:Connect(setup)
for _, p in Players:GetPlayers() do task.spawn(setup, p) end
remote.OnServerEvent:Connect(function(p, what)
	if what == "ready" then p:SetAttribute("Ready", true)
	elseif what == "toggle" then toggle(p) end
end)
print("[Gear5] ready")
</ProtectedString></Properties></Item>
</Item>
</roblox>
