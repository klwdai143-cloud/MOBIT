<Item class="ServerScriptService" referent="RBX3676"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX3675"><Properties><string name="Name">GonVsPitou</string><ProtectedString name="Source">local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local rng, rgb = Random.new(), Color3.fromRGB
local remote = game:GetService("ReplicatedStorage"):WaitForChild("HxH")
local WHITE, SKY, PURPLE = Color3.new(1, 1, 1), rgb(170, 215, 255), rgb(110, 60, 160)
local function R(x, y, z) return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z)) end
local function tw(o, t, props, style) TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad), props):Play() end
local S = {}
local function short(n)
	if n &gt;= 1e9 then return string.format("%.1fB", n / 1e9) end
	if n &gt;= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n &gt;= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end
local function tween(o, t, props) TweenService:Create(o, TweenInfo.new(t), props):Play() end
local function part(size, cf, color, transparency, life, material)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
	p.Material, p.Size, p.CFrame, p.Color, p.Transparency = material or Enum.Material.Neon, size, cf, color, transparency or 0
	p.Parent = workspace
	if life then Debris:AddItem(p, life) end
	return p
end
local function label(parent, text, color, y, w, h)
	local g = Instance.new("BillboardGui")
	g.Size, g.StudsOffset, g.MaxDistance = UDim2.fromScale(w or 10, h or 2.5), Vector3.new(0, y, 0), 220
	local t = Instance.new("TextLabel", g)
	t.Size, t.BackgroundTransparency, t.Font, t.TextScaled = UDim2.fromScale(1, 1), 1, Enum.Font.GothamBlack, true
	t.Text, t.TextColor3, t.TextStrokeTransparency = text, color, 0
	g.Parent = parent
	return t, g
end
local function popup(at, text, color)
	local p = part(Vector3.one, CFrame.new(at + rng:NextUnitVector() * 1.5), color, 1, .8)
	label(p, text, color, 1, 5, 1.4)
	tween(p, .8, {Position = p.Position + Vector3.new(0, 4, 0)})
end
local function burst(pos, color, radius)
	local b = part(Vector3.one, CFrame.new(pos), color, .2, .4, Enum.Material.ForceField)
	b.Shape = Enum.PartType.Ball
	tween(b, .4, {Size = Vector3.one * radius * 2, Transparency = 1})
	for _ = 1, 8 do
		local d = rng:NextUnitVector()
		local s = part(Vector3.new(.2, .2, 1.5), CFrame.lookAt(pos, pos + d), color, 0, .3)
		tween(s, .3, {CFrame = s.CFrame * CFrame.new(0, 0, -radius), Transparency = 1})
	end
end
local function sound() end -- بدون أصوات
local function ring(pos, radius, color, time)
	local a = Instance.new("CylinderHandleAdornment")
	a.Adornee, a.CFrame = workspace.Terrain, CFrame.new(pos) * R(90, 0, 0)
	a.Height, a.Radius, a.InnerRadius, a.Color3, a.Parent = .3, 2, .5, color, workspace
	tw(a, time or .7, {Radius = radius, InnerRadius = radius - .7, Transparency = 1})
	Debris:AddItem(a, time or .7)
end
local function bolt(a, b, thick, jag, color, life)
	local last = a
	for i = 1, 8 do
		local n = a:Lerp(b, i / 8) + (i &lt; 8 and rng:NextUnitVector() * jag or Vector3.zero)
		local cf, len = CFrame.lookAt((last + n) / 2, n), (n - last).Magnitude
		part(Vector3.new(thick, thick, len), cf, WHITE, 0, life or .12)
		part(Vector3.new(thick * 2.4, thick * 2.4, len), cf, color or SKY, .65, life or .12)
		last = n
	end
end
local function ball(size, pos, color, transparency, life, material)
	local p = part(Vector3.one * size, CFrame.new(pos), color, transparency, life, material)
	p.Shape = Enum.PartType.Ball
	return p
end
local function boom(pos, radius)
	for i = 0, 3 do
		task.delay(i * .1, function()
			local d = ball(4, pos, i % 2 == 0 and WHITE or SKY, .1, .8, Enum.Material.ForceField)
			tw(d, .8, {Size = Vector3.one * (radius * 2 - i * 6), Transparency = 1})
			ring(pos - Vector3.new(0, 2.5, 0), radius + i * 7, i % 2 == 0 and WHITE or PURPLE)
		end)
	end
	for i = 1, 22 do
		local dir = CFrame.Angles(0, i / 22 * math.pi * 2, 0).LookVector
		local puff = ball(rng:NextNumber(2, 5), pos + dir * 3 - Vector3.new(0, 2, 0), WHITE, .2, 1.1, Enum.Material.SmoothPlastic)
		tw(puff, 1.1, {Position = puff.Position + dir * radius * .8 + Vector3.new(0, rng:NextNumber(1, 7), 0), Size = Vector3.one * .3, Transparency = 1})
	end
end
local function cam(s, ...) if s.player then remote:FireClient(s.player, ...) end end

-- هاكي: برق أسود بحواف حمراء
local function haki(pos, radius, count)
	for i = 1, count do
		local last = pos
		local goal = pos + rng:NextUnitVector() * radius
		for j = 1, 5 do
			local n = pos:Lerp(goal, j / 5) + rng:NextUnitVector() * radius * .09
			local cf, len = CFrame.lookAt((last + n) / 2, n), (n - last).Magnitude
			local w = .12 + radius * .008
			part(Vector3.new(w, w, len), cf, rgb(8, 0, 6), 0, .16)
			part(Vector3.new(w * 2.6, w * 2.6, len), cf, rgb(235, 0, 45), .6, .16)
			last = n
		end
	end
end
local actors = {}
local V = Vector3.new
-- وضعية R6: ميل، لف، انحناء جانبي، ارتفاع، رأس(ميل،لف)، يمين(قدام،لف،برا)، يسار(...)، رجل يمين(قدام،برا)، يسار
local P = {
	stand = {2,0,0,0, 0,0, 4,0,7, -3,0,7, 2,4, -2,4},
	crouch = {38,0,0,-1.25, -22,0, 35,0,18, 45,0,15, 78,12, -12,18},
	slump = {55,12,14,-1.9, 25,25, 12,0,22, 5,0,30, 82,20, 70,28},
	despair = {48,0,0,-1.35, 42,0, 62,-25,-12, 62,25,-12, 80,14, -18,14},
	broken = {30,10,0,-1.2, 12,-30, 45,0,10, -8,35,34, 75,12, -12,18},
	heal = {22,-18,0,-1.15, 28,35, 40,0,15, 88,0,-8, 75,12, -12,18},
	flex = {-4,-12,0,0, 6,28, 5,0,10, 105,90,15, 4,8, -4,8},
	shout = {-22,0,0,-.2, -32,0, -28,0,48, -28,0,48, 14,16, -14,16},
	hang = {-14,0,0,.5, -26,0, -12,0,30, -12,0,30, -6,10, 8,8},
	calm = {4,0,0,0, 14,0, 2,0,9, 2,0,9, 3,5, -3,5},
	kickW = {-6,-45,0,-.3, 0,40, 40,0,35, -35,0,45, -50,8, 10,10},
	kick = {-28,35,8,.35, 12,-30, -55,0,55, 60,0,45, 128,6, -18,8},
	clawW = {42,-30,0,-1, -30,25, -60,0,60, 40,0,55, 70,20, -45,16},
	claw = {35,40,-8,-.4, -20,-30, 130,0,-20, -50,0,50, -30,10, 60,14},
	jan = {24,-55,-6,-1.05, 0,50, -48,-20,28, 62,30,-20, -42,22, 52,20},
	guu = {32,58,8,-.85, -10,-45, 96,0,-6, -62,0,35, 68,12, -52,16},
	flyP = {-46,0,12,0, -30,10, 120,0,50, 70,0,80, 55,12, 12,20},
	lie = {-86,0,6,-2.4, 6,22, 20,0,75, -12,0,66, 4,18, -6,12},
	push = {28,25,-10,-.5, -12,0, 85,0,12, 82,0,10, 45,10, -42,12},
	kneel = {20,0,0,-1.4, 18,-10, 32,0,6, 40,0,4, 86,6, -4,6},
}
local LOOP = {
	run = function(t) local w = math.sin(t * 17) return {34,w * 8,0,math.abs(w) * .35 - .2, -22,-w * 6, -70,0,18, -70,0,18, w * 62,3, -w * 62,3} end,
	walk = function(t) local w = math.sin(t * 5) return {7,w * 7,0,math.abs(w) * .12, 6,-w * 5, -w * 24,0,8, w * 24,0,8, w * 30,3, -w * 30,3} end,
	rage = function(t) local j = math.sin(t * 45) * 2.5 return {-20 + j,j,0,-.2, -30 + j,j, -28 + j,0,48, -28 - j,0,48, 14,16, -14,16} end,
	sob = function(t) local j = math.sin(t * 9) * 3 return {48 + j,0,j * .4,-1.35, 42 + j,j, 62,-25,-12, 62,25,-12, 80,14, -18,14} end,
}
local function pose(a, name, dur, style)
	a.loop, a.from, a.to, a.t0, a.dur, a.style = nil, table.clone(a.cur), P[name], os.clock(), dur or .3, style
end
local function loop(a, name) a.loop, a.t0 = LOOP[name], os.clock() end
local function ease(x, style)
	if style == "back" then return 1 + 2.9 * (x - 1) ^ 3 + 1.9 * (x - 1) ^ 2 end
	if style == "snap" then return 1 - (1 - x) ^ 4 end
	return x * x * x * (x * (x * 6 - 15) + 10)
end
RunService.Heartbeat:Connect(function(dt)
	for m, a in actors do
		local now = os.clock()
		if a.loop then
			local g = a.loop(now - a.t0)
			for i = 1, 16 do a.cur[i] += (g[i] - a.cur[i]) * (1 - math.exp(-dt * 20)) end
		else
			local e = ease(math.clamp((now - a.t0) / a.dur, 0, 1), a.style)
			for i = 1, 16 do a.cur[i] = a.from[i] + (a.to[i] - a.from[i]) * e end
		end
		local c, br = a.cur, math.sin(now * 2.3 + a.k * 5) * 1.4
		local function set(n, x, y, z, lift)
			local d = a.rig[n]
			if d then d[1].C0 = CFrame.new(d[2].Position + V(0, lift or 0, 0)) * R(x, y, z) * d[2].Rotation end
		end
		set("RootJoint", -c[1] - br * .5, c[2], c[3], c[4] * a.k)
		set("Neck", -c[5] + br, c[6], 0)
		set("Right Shoulder", c[7] + br, c[8], c[9] + br * .6)
		set("Left Shoulder", c[10] + br, -c[11], -c[12] - br * .6)
		set("Right Hip", c[13] + c[1], 0, c[14] - c[3])
		set("Left Hip", c[15] + c[1], 0, -c[16] - c[3])
	end
end)

-- تركيب التفاصيل
local function add(a, limb, size, cf, color, material, class)
	local to, k = a.m[limb], a.k
	local p = Instance.new(class or "Part")
	p.Size, p.Color, p.Material = size * k, color, material or Enum.Material.SmoothPlastic
	p.CanCollide, p.CanTouch, p.CanQuery, p.Massless, p.CastShadow = false, false, false, true, false
	local off = CFrame.new(cf.Position * k) * cf.Rotation
	p.CFrame = to.CFrame * off
	local w = Instance.new("Weld")
	w.Part0, w.Part1, w.C0, w.Parent = to, p, off, p
	p.Parent = a.m
	return p
end
local function box(a, limb, x, y, z, sx, sy, sz, color, rz, material)
	return add(a, limb, V(sx, sy, sz), CFrame.new(x, y, z) * R(0, 0, rz or 0), color, material)
end
local function orb(a, limb, x, y, z, d, color, material)
	local p = box(a, limb, x, y, z, d, d, d, color, 0, material)
	p.Shape = Enum.PartType.Ball
	return p
end
local function spike(a, limb, from, to, width, color)
	local h, cf = (to - from).Magnitude, CFrame.lookAt(from, to) * R(-90, 0, 0)
	for _, side in {-1, 1} do
		add(a, limb, V(width * .55, h, width / 2), cf * CFrame.new(0, h / 2, side * width / 4) * R(0, side == 1 and 180 or 0, 0), color, nil, "WedgePart")
	end
end
local function face(a, iris, brow, anger, mouth)
	for _, x in {-1, 1} do
		box(a, "Head", x * .24, .08, -.61, .24, .2, .03, WHITE)
		box(a, "Head", x * .22, .07, -.625, .13, .17, .03, iris)
		box(a, "Head", x * .22, .07, -.64, .06, .09, .02, rgb(5, 5, 8))
		orb(a, "Head", x * .22 + .035, .12, -.65, .045, WHITE, Enum.Material.Neon)
		box(a, "Head", x * .24, .19, -.63, .29, .035, .03, rgb(10, 8, 10), x * anger * .6)
		box(a, "Head", x * .24, .29 + anger * .002, -.63, .3, .05, .03, brow, x * anger)
	end
	box(a, "Head", 0, -.07, -.63, .04, .08, .03, a.m.Head.Color:Lerp(Color3.new(), .25))
	box(a, "Head", 0, -.27, -.625, mouth or .22, .035, .03, rgb(90, 30, 30))
end
local function shell(a, limb, y, h, color, grow, material)
	local s = a.m[limb].Size / a.k
	return box(a, limb, 0, y, 0, s.X + (grow or .08), h, s.Z + (grow or .08), color, 0, material)
end
local function actor(s, cf, skin, torso, legs, k)
	local d = Instance.new("HumanoidDescription")
	d.HeadColor, d.LeftArmColor, d.RightArmColor, d.TorsoColor, d.LeftLegColor, d.RightLegColor = skin, skin, skin, torso, legs, legs
	local m = Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R6)
	for _, o in m:GetDescendants() do
		if o:IsA("Decal") or o:IsA("Accessory") or o:IsA("Shirt") or o:IsA("Pants") or o:IsA("LocalScript") then o:Destroy() end
	end
	pcall(function() m:ScaleTo(k) end)
	m:PivotTo(cf + V(0, (k - 1) * 3, 0))
	m.HumanoidRootPart.Anchored = true
	m.Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	m.Parent = workspace
	local a = {m = m, k = k, rig = {}, cur = table.clone(P.stand), from = P.stand, to = P.stand, t0 = 0, dur = 1}
	for _, j in m:GetDescendants() do
		if j:IsA("Motor6D") then a.rig[j.Name] = {j, j.C0} end
	end
	actors[m] = a
	table.insert(s.props, m)
	return a, m.HumanoidRootPart
end

local function gon(s, cf, adult)
	local skin, green, dark = rgb(240, 195, 160), rgb(55, 140, 60), rgb(28, 75, 36)
	local a, r = actor(s, cf, skin, adult and skin or green, adult and dark or green, adult and 1.35 or .82)
	local black = rgb(12, 14, 12)
	face(a, rgb(150, 85, 35), black, adult and 20 or 4, adult and .3)
	box(a, "Head", 0, .42, .1, 1.3, .55, 1.28, black)
	for i = 1, 30 do
		local an, up = i * 2.4, .3 + (i / 30) * .7
		local d = V(math.cos(an) * (1 - up * .6), up, math.abs(math.sin(an)) * (1 - up * .4) - (up &gt; .75 and .35 or 0)).Unit
		spike(a, "Head", d * .5, d * (1.25 + (i % 4) * .17) + V(0, .25, 0), .5, i % 5 == 0 and dark or black)
	end
	for i = -3, 3 do spike(a, "Head", V(i * .17, .55, -.55), V(i * .22, .27 - (i % 2) * .06, -.68), .2, black) end
	for _, side in {"Right", "Left"} do
		local arm, leg = side .. " Arm", side .. " Leg"
		shell(a, leg, .55, .9, adult and dark or green, .1)
		shell(a, leg, -.7, .62, rgb(45, 90, 40), .14)
		shell(a, leg, -.98, .1, rgb(210, 100, 30), .2)
		for i = 0, 2 do box(a, leg, 0, -.5 - i * .15, -.59, .7, .04, .03, rgb(240, 150, 40), i % 2 == 0 and 12 or -12) end
		if adult then
			box(a, arm, 0, -.1, -.52, .75, .5, .08, skin:Lerp(Color3.new(), .06))
			box(a, arm, .1, -.6, -.52, .5, .05, .03, rgb(170, 120, 100), 35)
		else
			shell(a, arm, .62, .8, green, .1)
			shell(a, arm, .2, .12, rgb(235, 130, 30), .16)
		end
	end
	shell(a, "Torso", -.88, .26, rgb(235, 130, 30), .16)
	for _, x in {-1, 1} do
		if adult then
			box(a, "Torso", x * .47, .45, -.52, .88, .62, .1, skin:Lerp(Color3.new(), .05))
			box(a, "Torso", x * .47, .12, -.56, .86, .05, .04, rgb(165, 115, 95), x * 8)
			for j = 0, 2 do box(a, "Torso", x * .22, -.1 - j * .24, -.53, .38, .19, .06, skin:Lerp(Color3.new(), .08)) end
			box(a, "Torso", x * .86, .35, -.57, .24, 1.35, .05, dark, x * 8)
		else
			box(a, "Torso", x * .5, .75, -.54, .2, .75, .07, dark, x * 38)
			box(a, "Torso", x * .18, 0, -.53, .09, 1.7, .05, rgb(240, 150, 40))
		end
	end
	return a, r
end
local function longHair(a)
	for i = 1, 26 do
		local an = i * 2.4
		local p = V(math.cos(an) * .55, .55, math.abs(math.sin(an)) * .55)
		for j = 1, 7 do
			local n = p + V(p.X * .08 + math.sin(i + j * .8) * .22, 1.35 - (i % 4) * .13, .12 + j * .06)
			spike(a, "Head", p - V(0, .25, 0), n + V(0, .15, 0), math.max(.18, .8 - j * .09), rgb(10, 12, 10))
			p = n
		end
		if i % 2 == 0 then task.wait(.1) bolt(a.m.Head.Position, a.m.Head.Position + rng:NextUnitVector() * (6 + i * .5), .2, 1.5, rgb(90, 255, 120)) end
	end
end
local function pitou(s, cf)
	local skin, coat, pants, hair = rgb(248, 222, 205), rgb(40, 58, 135), rgb(48, 42, 62), rgb(232, 232, 242)
	local a, r = actor(s, cf, skin, coat, pants, 1.02)
	face(a, rgb(200, 15, 45), rgb(185, 185, 198), 10)
	for i = 1, 55 do
		local an, up = i * 2.4, (i % 9) / 9
		local d = V(math.cos(an) * (1 - up * .5), up * .9 - .12, math.sin(an) * (1 - up * .5))
		if d.Z &gt; -.35 or up &gt; .6 then orb(a, "Head", d.X * .66, d.Y * .66 + .06, d.Z * .66, .42, hair) end
	end
	for i = -3, 3 do spike(a, "Head", V(i * .17, .6, -.55), V(i * .2 + .1, .3, -.66), .24, hair) end
	for _, x in {-1, 1} do
		spike(a, "Head", V(x * .45, .6, 0), V(x * .85, 1.55, 0), .6, hair)
		spike(a, "Head", V(x * .48, .7, -.16), V(x * .76, 1.28, -.14), .26, rgb(240, 150, 170))
		box(a, "Torso", x * .42, .72, -.55, .2, .8, .07, WHITE, -x * 36)
		box(a, "Torso", x * .88, -.2, -.53, .12, 1.5, .05, rgb(230, 190, 70))
		for j = 0, 3 do orb(a, "Torso", x * .24, .35 - j * .32, -.55, .13, rgb(230, 190, 70), Enum.Material.Metal) end
	end
	for _, side in {"Right", "Left"} do
		shell(a, side .. " Arm", .45, 1.15, coat, .12)
		shell(a, side .. " Arm", -.12, .13, rgb(230, 190, 70), .18)
		for j = 0, 1 do shell(a, side .. " Arm", -.4 - j * .35, .05, rgb(60, 45, 55), .04) end
		shell(a, side .. " Leg", .5, 1, pants, .12)
		shell(a, side .. " Leg", -.12, .1, skin, .06)
		shell(a, side .. " Leg", -.75, .5, rgb(235, 235, 240), .1)
		shell(a, side .. " Leg", -.98, .12, rgb(40, 35, 50), .18)
	end
	shell(a, "Torso", -.9, .22, rgb(25, 22, 30), .14)
	local p = V(0, -.75, .55)
	for i = 1, 22 do
		local n = p + V(math.sin(i * .35) * .17, -.17 + i * .022, .22)
		orb(a, "Torso", n.X, n.Y, n.Z, .42 - i * .009, hair)
		p = n
	end
	return a, r
end
local function kite(s, cf)
	local hair = rgb(208, 208, 218)
	local a, r = actor(s, cf, rgb(212, 198, 194), rgb(42, 46, 64), rgb(28, 32, 48), 1.12)
	face(a, rgb(110, 110, 120), rgb(160, 160, 170), -10, .16)
	box(a, "Head", 0, .55, 0, 1.4, .45, 1.4, rgb(52, 62, 95))
	box(a, "Head", 0, .38, -.82, 1.05, .1, .6, rgb(36, 42, 68))
	for i = 1, 22 do
		local x = (i - 11.5) * .075
		spike(a, "Head", V(x, -1.6, .75), V(x * 1.2, .5, .6), .22, hair)
		spike(a, "Head", V(x * 1.4, -1.3, .75), V(x * 2.4, -3.5 - (i % 3) * .3, .9), .24, hair)
	end
	for _, x in {-1, 1} do
		box(a, "Torso", x * .5, .6, -.54, .2, 1, .06, rgb(90, 95, 120), -x * 28)
		shell(a, x &gt; 0 and "Right Arm" or "Left Arm", -.35, .18, rgb(90, 95, 120), .12)
	end
	return a, r
end
local function killua(s, cf)
	local white = rgb(228, 232, 246)
	local a, r = actor(s, cf, rgb(250, 224, 208), rgb(48, 52, 100), rgb(32, 32, 44), .82)
	face(a, rgb(45, 120, 235), rgb(185, 190, 205), 14)
	for i = 1, 46 do
		local an, up = i * 2.4, (i / 46)
		local d = V(math.cos(an) * (1 - up * .55), up * .95, math.sin(an) * (1 - up * .55))
		if d.Z &gt; -.4 or up &gt; .5 then spike(a, "Head", d * .45, d * (1.05 + (i % 3) * .13), .46, white) end
	end
	shell(a, "Torso", .92, .3, white, .12)
	shell(a, "Torso", -.9, .2, white, .12)
	for _, side in {"Right", "Left"} do
		shell(a, side .. " Arm", .55, .95, rgb(48, 52, 100), .1)
		shell(a, side .. " Leg", .35, 1.2, rgb(70, 75, 120), .12)
		shell(a, side .. " Leg", -.82, .38, rgb(235, 235, 240), .14)
	end
	return a, r
end
-- دكتور بلايث: دمية تخيط الذراع
local function blythe(s, root)
	local a = {m = root.Parent, k = 1}
	local n = "HumanoidRootPart"
	local before = #root.Parent:GetChildren()
	local pink, dress = rgb(255, 205, 215), rgb(235, 240, 250)
	orb(a, n, -3.4, 5.2, .5, 2.6, pink)
	spike(a, n, V(-3.4, 1.2, .5), V(-3.4, 4.4, .5), 3.4, dress)
	box(a, n, -3.4, 6.6, .4, 1.8, .8, 1.4, WHITE)
	box(a, n, -3.4, 6.7, -.35, .6, .16, .06, rgb(230, 30, 50))
	box(a, n, -3.4, 6.7, -.35, .16, .6, .06, rgb(230, 30, 50))
	for _, x in {-1, 1} do
		orb(a, n, -3.4 + x * .45, 5.35, -.75, .45, rgb(30, 10, 30), Enum.Material.Neon)
		box(a, n, -3.4 + x * 1.9, 3.6, -.2, 2, .28, .28, pink, x * -30)
	end
	box(a, n, -1.3, 2.2, -1, 2.6, .35, .35, rgb(190, 240, 255), -35, Enum.Material.Glass)
	box(a, n, .1, 1.2, -1, 1.2, .06, .06, rgb(220, 225, 235), -35, Enum.Material.Metal)
	local list = root.Parent:GetChildren()
	local parts = {}
	for i = before + 1, #list do table.insert(parts, list[i]) end
	return parts
end
local function terpsichora(s, root)
	local a, n = {m = root.Parent, k = 1}, "HumanoidRootPart"
	local dark, glow = rgb(38, 20, 62), rgb(215, 120, 255)
	local function limb(p, q, w) spike(a, n, p, q, w, dark) end
	limb(V(0, 4, 3), V(0, 11, 3), 2.4)
	limb(V(0, 11, 3), V(0, 7, 3), 3)
	orb(a, n, 0, 12.4, 3, 2.8, dark)
	box(a, n, 0, 14.2, 3, 4.2, .35, 2, rgb(80, 35, 115))
	for _, x in {-1, 1} do
		orb(a, n, x * .6, 12.6, 1.65, .55, rgb(255, 50, 130), Enum.Material.Neon)
		limb(V(x, 10, 3), V(x * 6.5, 12.5, .5), 1)
		limb(V(x * 6.5, 12.5, .5), V(x * 5.5, 5.5, -3), .7)
		limb(V(x * 1.5, 5, 3), V(x * 5, 2, 4), .9)
		for j = 1, 4 do
			orb(a, n, x * 5.5, 5.5 - j * .1, -3 + j * .3, .45, glow, Enum.Material.Neon)
			local p, q = V(x * (4.6 + j * .35), 5.3, -3), V(x * j * .4, 2 - j * .75, -.3)
			add(a, n, V(.04, .04, (q - p).Magnitude), CFrame.lookAt((p + q) / 2, q), glow, Enum.Material.Neon)
		end
	end
end

local function lights(s)
	local old = {}
	for _, n in {"ClockTime", "Ambient", "OutdoorAmbient", "Brightness", "ExposureCompensation"} do old[n] = Lighting[n] end
	s.light = old
	Lighting.ClockTime, Lighting.Brightness, Lighting.ExposureCompensation = 0, 3, .3
	Lighting.Ambient, Lighting.OutdoorAmbient = rgb(105, 110, 150), rgb(135, 145, 190)
	for i, d in {{26, rgb(255, 250, 225), 0}, {34, rgb(180, 200, 255), .88}} do
		local moon = ball(d[1] * 2, V(-90, 130, -330), d[2], d[3])
		table.insert(s.props, moon)
	end
end
local function transform(s)
	local function wait(t) task.wait(t) if not s.on then error("stop", 0) end end
	local base, forest = CFrame.new(0, 4, 20), CFrame.new(0, 4, -170)
	local function at(x, y, z) return base:PointToWorldSpace(V(x, y, z)) end
	local function ft(x, y, z) return forest:PointToWorldSpace(V(x, y, z)) end
	local function shot(a, b, d, look) cam(s, "shot", a, b, d, look) end
	local function move(r, cf, t, style) tw(r, t, {CFrame = cf}, style) end
	local function say(who, text, color, t)
		local _, g = label(who, text, color or WHITE, 5.5, 18, 3)
		Debris:AddItem(g, t or 2)
	end
	local function path(r, dur, fn)
		local t0 = os.clock()
		repeat
			local x = math.min((os.clock() - t0) / dur, 1)
			r.CFrame = fn(x)
			wait(0)
		until x &gt;= 1
	end
	local function grade(t, props)
		local cc = Instance.new("ColorCorrectionEffect", Lighting)
		table.insert(s.props, cc)
		tw(cc, t, props)
		return cc
	end
	lights(s)
	local g, root = gon(s, base)
	local pa, pr = pitou(s, base * CFrame.new(5, 0, -11) * R(0, 160, 0))
	local ka, kr = kite(s, base * CFrame.new(-5, 0, -9) * R(0, 200, 0))
	-- 1) الحقيقة: كايت ميت
	pose(g, "calm", 0.40, nil) pose(pa, "crouch", 0.40, nil) pose(ka, "slump", 0.40, nil)
	shot(at(14, 5, 8), at(8, 3, 3), 3, at(-1, 0, -9))
	wait(1.5)
	say(pr, "كايت مات... ما أقدر أرجعه", rgb(255, 170, 190), 2.6)
	shot(at(9, 1, -5), at(8, 1, -7), 2.6, pr.Position + V(0, 1, 0))
	wait(2.7)
	shot(at(-1, 1, -6), at(-2.5, .5, -7), 2, ka.m.Head.Position)
	wait(2)
	-- بيتو يعالج ذراعه بدكتور بلايث
	pose(pa, "broken", .5)
	shot(pr.CFrame:PointToWorldSpace(V(-7, 3, -9)), pr.CFrame:PointToWorldSpace(V(-4, 2, -8)), 2, pr.Position + V(0, 1, 0))
	wait(1.6)
	say(pr, "دكتور بلايث", rgb(255, 170, 215), 2)
	local doll = blythe(s, pr)
	pose(pa, "heal", .8, "back")
	shot(pr.CFrame:PointToWorldSpace(V(5, 4, -10)), pr.CFrame:PointToWorldSpace(V(-9, 5, -7)), 4, pr.Position + V(0, 1.5, 0))
	for i = 1, 18 do
		local hand = pa.m["Left Arm"].CFrame:PointToWorldSpace(V(0, -.8 + (i % 6) * .25, -.55))
		bolt(pr.CFrame:PointToWorldSpace(V(.1, 1.2, -1)), hand, .05, .25, rgb(255, 120, 210))
		ball(.35, hand, rgb(160, 255, 220), .2, .4, Enum.Material.Neon)
		wait(.2)
	end
	for _, p in doll do p:Destroy() end
	pose(pa, "flex", .5, "back")
	shot(pr.CFrame:PointToWorldSpace(V(-5, 2, -7)), pr.CFrame:PointToWorldSpace(V(-3, 1.5, -6)), 2, pr.Position + V(0, .8, 0))
	say(pr, "رجعت ذراعي... لازم أقتلك عشان الملك", rgb(255, 170, 190), 2.4)
	for _ = 1, 4 do pose(pa, "flex", .25) wait(.3) pose(pa, "heal", .25) wait(.3) end
	pose(pa, "crouch", .5)
	-- 2) انهيار قون
	local grey = grade(1, {Saturation = -1, Contrast = .25})
	loop(g, "sob")
	shot(at(2, 0, -7), at(1, -.5, -4), 4, at(0, -.5, 0))
	say(root, "...كذب", WHITE, 1.2)
	for i = 1, 8 do
		for _, x in {-.2, .2} do
			local tear = ball(.18, g.m.Head.CFrame:PointToWorldSpace(V(x, 0, -.6)), rgb(150, 210, 255), .2, .6)
			tw(tear, .6, {Position = tear.Position - V(0, 2.2, 0)})
		end
		wait(.4)
	end
	say(root, "ما يهمني... هذي آخر مرة. آخذ كل قوتي", rgb(255, 90, 90), 2.6)
	for i = 1, 12 do haki(root.Position, 3 + i, 3) cam(s, "shake", i * .08) wait(.2) end
	-- 3) التحول للبالغ
	pose(g, "shout", 0.70, nil)
	shot(at(-12, -1, -12), at(10, 2, -17), 3.5, at(0, 6, 0))
	local pillar = part(V(3, 200, 3), CFrame.new(at(0, 95, 1.5)), rgb(10, 0, 15), .35, 5)
	tw(pillar, 1, {Size = V(13, 200, 13)})
	task.delay(2.5, tw, pillar, 2, {Transparency = 1, Size = V(1, 200, 1)})
	pose(pa, "flyP", 0.70, nil)
	move(pr, pr.CFrame * CFrame.new(0, 0, 7), .6)
	for i = 1, 24 do
		local dir = CFrame.Angles(0, i * .7, 0).LookVector
		local rock = part(Vector3.one * rng:NextNumber(.5, 2), CFrame.new(at(0, -3, 0) + dir * rng:NextNumber(3, 13)), rgb(110, 100, 95), 0, 3, Enum.Material.Slate)
		tw(rock, 3, {CFrame = rock.CFrame * CFrame.new(0, rng:NextNumber(5, 14), 0) * R(i * 30, i * 50, 0), Transparency = 1}, Enum.EasingStyle.Sine)
	end
	local old = g.m
	actors[old] = nil
	g, root = gon(s, base + V(0, 0, 0), true)
	old:Destroy()
	pose(g, "shout", .1)
	loop(g, "rage")
	longHair(g)
	boom(root.Position, 28)
	wait(1.5)
	shot(at(2, 4, -9), at(1, 3.5, -6), 2, at(0, 3.5, 0))
	pose(g, "calm", 0.70, nil)
	wait(2)
	-- 4) تربسيكورا والهجوم ثم الركلة
	say(pr, "دكتور بلايث... تربسيكورا!", rgb(230, 130, 255), 1.8)
	terpsichora(s, pr)
	pose(pa, "crouch", 0.40, nil)
	shot(at(18, 5, -2), at(14, 8, 3), 1.6, pr.Position + V(0, 5, 0))
	wait(1.7)
	shot(at(15, 3, 2), at(13, 2, -2), 1, at(0, 1, -3))
	pose(pa, "clawW", .16) task.wait(.16) pose(pa, "claw", 0.20, "back")
	move(pr, base * CFrame.new(0, 1, -4) * R(0, 180, 0), .35, Enum.EasingStyle.Quart)
	wait(.28)
	pose(g, "kickW", .12) task.wait(.12) pose(g, "kick", 0.15, "back")
	wait(.15)
	boom(pr.Position, 15)
	cam(s, "shake", 3)
	pose(pa, "flyP", 0.24, nil)
	path(pr, .8, function(x) return base * CFrame.new(0, 1 + x * 5, -4 - x * 36) * R(x * 540, 180, 0) end)
	boom(pr.Position, 12)
	grey:Destroy()
	-- 5) يمشي للخارج ويبعد القتال عن كايت
	say(root, "مو هنا. ما أبي أخرب مكان كايت", WHITE, 2.4)
	loop(g, "walk")
	shot(at(7, 3, -34), at(5, 2, -28), 2.8, at(0, 2, -12))
	path(root, 2.8, function(x) return base * CFrame.new(0, 1.1, -x * 30) end)
	move(pr, base * CFrame.new(0, 1, -42) * R(0, 180, 0), .3)
	pose(g, "kickW", .12) task.wait(.12) pose(g, "kick", 0.15, "back")
	move(root, base * CFrame.new(0, 2, -38), .25)
	wait(.25)
	boom(pr.Position, 20)
	cam(s, "shake", 3)
	shot(V(60, 40, -50), V(55, 30, -130), 2, V(0, 20, -100))
	pose(pa, "flyP", 0.24, nil)
	path(pr, 1.8, function(x) return CFrame.new(V(0, 5, -22):Lerp(ft(0, 0, -16), x) + V(0, math.sin(x * math.pi) * 55, 0)) * R(x * 720, 180, 0) end)
	boom(ft(0, 0, -16), 24)
	-- 6) الغابة: وقفة جاجنكن
	loop(g, "run")
	path(root, .9, function(x) return CFrame.new(V(0, 5, -18):Lerp(ft(0, 1.1, 8), x) + V(0, math.sin(x * math.pi) * 22, 0)) end)
	boom(root.Position - V(0, 1, 0), 14)
	pose(pa, "clawW", .16) task.wait(.16) pose(pa, "claw", 0.50, "back")
	move(pr, CFrame.new(ft(0, 22, -22)) * R(0, 180, 0), .8)
	pose(g, "jan", 0.50, "back")
	shot(ft(-11, 0, -2), ft(-8, 3, 15), 3.6, ft(0, 3, 4))
	local hand = g.m["Right Arm"]
	for _, word in {"سايشو وا قو...", "جان...", "كن..."} do
		say(root, word, rgb(255, 210, 80), 1.1)
		for i = 1, 6 do
			local orb = ball(1 + i * .45, hand.Position, rgb(255, 170, 30), .25, .2)
			haki(orb.Position, 3 + i, 3)
			cam(s, "shake", .5)
			wait(.17)
		end
	end
	say(root, "قوووو!!!", rgb(255, 130, 20), 1.4)
	shot(ft(20, 7, 4), ft(24, 9, -6), 1.6, ft(0, 3, -8))
	pose(g, "guu", 0.14, "back")
	move(pr, forest * CFrame.new(0, 3, -4) * R(0, 180, 0), .22, Enum.EasingStyle.Quart)
	wait(.2)
	boom(ft(0, 1, -5), 55)
	haki(ft(0, 2, -6), 45, 24)
	cam(s, "shake", 4)
	pose(pa, "slump", 0.30, nil)
	move(pr, forest * CFrame.new(0, -1, -12) * R(85, 180, 0), .3)
	wait(1.4)
	-- 7) ضربات متتالية، وكيلوا يجري بالغابة
	local ua, ur = killua(s, forest * CFrame.new(55, 0, 45))
	move(root, forest * CFrame.new(0, 0, -7), .3)
	loop(ua, "run")
	shot(ft(52, 6, 58), ft(34, 4, 38), 2.4, ft(30, 2, 24))
	for i = 1, 12 do
		pose(g, i % 2 == 0 and "jan" or "guu", .16, "back")
		if i % 2 == 1 then boom(ft(0, -1, -12), 10 + i) cam(s, "shake", 1.2) end
		move(ur, CFrame.lookAt(ft(55, 0, 45):Lerp(ft(13, 0, 10), i / 12), ft(0, 0, -7)), .2, Enum.EasingStyle.Linear)
		haki(ur.Position, 5, 2)
		wait(.2)
	end
	pose(ua, "calm", 0.40, nil)
	pose(g, "calm", 0.70, nil)
	shot(ft(8, 3, -2), ft(6, 2, -17), 2.6, ft(0, 2, -8))
	say(root, "خلصت يا كايت", WHITE, 2)
	wait(2.6)
	-- 8) تربسيكورا بعد الموت: أبيض وأسود
	local bw = grade(.2, {Saturation = -1, Contrast = .6})
	terpsichora(s, pr)
	say(root, "!!", rgb(255, 60, 60), .8)
	shot(ft(-15, 4, -10), ft(-12, 3, -3), 1.8, ft(0, 2, -9))
	pose(pa, "clawW", .16) task.wait(.16) pose(pa, "claw", 0.24, "back")
	path(pr, .8, function(x) return forest * CFrame.new(0, -1 + math.sin(x * math.pi) * 9, -14 + x * 7) * R(85 - x * 85, 180, 0) end)
	say(ur, "قون!!", rgb(120, 180, 255), 1.2)
	loop(ua, "run")
	move(ur, CFrame.lookAt(ft(3, 0, -5), ft(-6, 0, -5)), .15)
	move(root, forest * CFrame.new(-4, 0, -4), .15)
	local arm = g.m["Right Arm"]
	for _, w in g.m:GetChildren() do
		local j2 = w:FindFirstChildOfClass("Weld")
		if w == arm or j2 and j2.Part0 == arm then w.Transparency = 1 end
	end
	local flash = grade(.05, {Brightness = 1})
	tw(flash, .6, {Brightness = 0})
	cam(s, "shake", 3)
	wait(1.2)
	say(root, "ما يعورني... صرت مثل كايت", WHITE, 2.2)
	shot(ft(-9, 3, -13), ft(-7, 2, -11), 2.2, root.Position + V(0, 2, 0))
	wait(2.3)
	-- 9) الجاجنكن الأخير
	bw:Destroy()
	move(root, forest * CFrame.new(0, 0, -5), .25)
	move(ur, CFrame.lookAt(ft(18, 0, 12), ft(0, 0, -9)), .4)
	move(pr, forest * CFrame.new(0, -1, -10) * R(80, 180, 0), .25)
	pose(pa, "slump", 0.40, nil)
	pose(g, "jan", 0.40, "back")
	shot(ft(-20, 6, 8), ft(-34, 18, 28), 4, ft(0, 8, -6))
	local sun = ball(1, ft(-1, 3, -8), rgb(255, 215, 120), .15)
	table.insert(s.props, sun)
	for i = 1, 16 do
		tw(sun, .18, {Size = Vector3.one * (1 + i * .8)})
		haki(sun.Position, 8 + i * 3, 6)
		ring(ft(0, -3, -8), 10 + i * 4, i % 2 == 0 and rgb(10, 0, 10) or rgb(255, 180, 40))
		cam(s, "shake", .2 + i * .12)
		wait(.18)
		if i == 8 then say(ur, "قوووون! وقّف!", rgb(120, 180, 255), 1.5) end
	end
	-- انفجار الغابة
	pose(g, "guu", 0.17, "back")
	shot(V(90, 70, -80), V(130, 100, -40), 3, ft(0, 10, -8))
	wait(.25)
	local white = grade(.15, {Brightness = 1})
	tw(sun, 1.6, {Size = Vector3.one * 190, Transparency = 1})
	for i = 1, 4 do boom(ft(0, 2, -8), 30 + i * 22) cam(s, "shake", 4) wait(.15) end
	for _, p in workspace:GetChildren() do
		local off = p.Name == "Tree" and p.Position - ft(0, 0, -8)
		if off and off.Magnitude &lt; 85 then
			table.insert(s.trees, p)
			p.Transparency = 1
		end
	end
	local crater = part(V(.4, 90, 90), CFrame.new(ft(0, -3.8, -8)) * R(0, 0, 90), rgb(45, 35, 30), 0, nil, Enum.Material.Slate)
	crater.Shape = Enum.PartType.Cylinder
	table.insert(s.props, crater)
	wait(.8)
	tw(white, 2.5, {Brightness = 0, Saturation = -.5})
	-- 10) بعد الانفجار
	for _, p in g.m:GetChildren() do
		if p:IsA("BasePart") and p.Transparency &lt; 1 then tw(p, 2.5, {Color = rgb(108, 98, 94)}) end
	end
	pose(g, "slump", 0.70, nil)
	pose(ua, "despair", 0.70, nil)
	move(ur, CFrame.lookAt(ft(5, 0, -3), ft(0, 0, -5)), 1.5)
	shot(ft(12, 5, 10), ft(7, 2, 2), 4, ft(1, -1, -4))
	wait(4.5)
end
local function run(player)
	local c = player.Character
	local s = c and S[c]
	if not s or s.on then return end
	local root = c.HumanoidRootPart
	local home, hidden = root.CFrame, {}
	s.on, s.props, s.trees = true, {}, {}
	player:SetAttribute("Busy", true)
	root.Anchored = true
	for _, p in c:GetDescendants() do
		if p:IsA("BasePart") or p:IsA("Decal") then hidden[p] = p.Transparency p.Transparency = 1 end
	end
	local good, err = pcall(transform, s)
	if not good and err ~= "stop" then warn("[HxH] " .. tostring(err)) end
	cam(s, "end")
	for _, o in s.props do actors[o] = nil o:Destroy() end
	for _, p in s.trees do p.Transparency = 0 end
	if s.light then for n, v in s.light do Lighting[n] = v end end
	if c.Parent then
		for p, t in hidden do p.Transparency = t end
		root.CFrame, root.Anchored = home, false
	end
	s.on = false
	player:SetAttribute("Busy", false)
end
local function setup(player)
	local function spawned(c)
		local hum = c:WaitForChild("Humanoid")
		c:WaitForChild("HumanoidRootPart")
		S[c] = {player = player, on = false}
		player:SetAttribute("Busy", false)
		hum.Died:Connect(function() if S[c] then S[c].on = false end end)
		task.wait(4)
		if not player:GetAttribute("Ready") and c.Parent then
			local t = Instance.new("Tool")
			t.Name, t.RequiresHandle = "GON", false
			t.Activated:Connect(function() run(player) end)
			t.Parent = player.Backpack
		end
	end
	player.CharacterAdded:Connect(spawned)
	if player.Character then task.spawn(spawned, player.Character) end
end
Players.PlayerAdded:Connect(setup)
for _, p in Players:GetPlayers() do task.spawn(setup, p) end
remote.OnServerEvent:Connect(function(p, what)
	if what == "ready" then p:SetAttribute("Ready", true)
	elseif what == "toggle" then run(p) end
end)
for _, p in workspace:GetChildren() do
	if p.Name == "Lamp" then
		local l = Instance.new("PointLight", p)
		l.Color, l.Range, l.Brightness = p.Color, 26, 1.6
	end
end
Lighting.OutdoorAmbient, Lighting.Ambient = rgb(140, 140, 160), rgb(100, 100, 120)
print("[HxH] v2 ready")
</ProtectedString></Properties></Item>
</Item>
</roblox>
