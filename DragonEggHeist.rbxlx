<Item class="ServerScriptService" referent="RBX2561"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX2560"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local C = require(RS:WaitForChild("Config"))

local map = workspace:WaitForChild("Map")
local actors = Instance.new("Folder") actors.Name = "Actors" actors.Parent = workspace
local remotes = Instance.new("Folder") remotes.Name = "Remotes"
local Action = Instance.new("RemoteEvent") Action.Name = "Action" Action.Parent = remotes
local Fx = Instance.new("RemoteEvent") Fx.Name = "Fx" Fx.Parent = remotes
remotes.Parent = RS

local store
pcall(function() store = DataStoreService:GetDataStore("DragonEggHeist_v1") end)

local data, plots, carry, status, mounts = {}, {}, {}, {}, {}
local nests, guards = {}, {}
local king = nil
local kingAt = 0
for i = 1, #C.PLOTS do plots[i] = {actors = {}, lockUntil = 0, lockReady = 0, traps = {}} end

local function now() return workspace:GetServerTimeNow() end
local function notify(p, text, color) Fx:FireClient(p, "toast", {text = text, color = color}) end
local function hrp(p)
	local ch = p.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	local r = ch and ch:FindFirstChild("HumanoidRootPart")
	if r and h and h.Health > 0 then return r, h end
	return nil
end

local function newActor(kind, cf, attrs)
	local p = Instance.new("Part")
	p.Name = kind
	p.Size = Vector3.new(1, 1, 1)
	p.Transparency = 1
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
	p.CFrame = cf
	p:SetAttribute("Type", kind)
	for k, v in pairs(attrs) do p:SetAttribute(k, v) end
	p.Parent = actors
	return p
end
local function weldTo(actor, root, offset)
	actor.Anchored = false
	actor.Massless = true
	actor.CFrame = root.CFrame * offset
	local w = Instance.new("Weld")
	w.Part0, w.Part1, w.C0 = root, actor, offset
	w.Parent = actor
end
local function addPrompt(part, action, hold, fn)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = action
	pr.ObjectText = ""
	pr.HoldDuration = hold
	pr.MaxActivationDistance = 9
	pr.RequiresLineOfSight = false
	pr.Parent = part
	pr.Triggered:Connect(fn)
	return pr
end

---------------------------------------------------------------- البيانات
local function defaults()
	return {money = 0, speed = C.START_SPEED, tread = 1, slots = C.START_SLOTS, bat = 1, lock = 1, traps = 1, rebirth = 0, items = {}}
end
local function sync(p)
	local d = data[p]
	if not d then return end
	for _, k in ipairs({"money", "speed", "tread", "slots", "bat", "lock", "traps", "rebirth"}) do
		p:SetAttribute(k, d[k])
	end
	local inc = 0
	for _, it in pairs(d.items) do
		if it.kind == "pet" and not it.away then inc = inc + C.income(it, d.rebirth) end
	end
	p:SetAttribute("income", inc)
	local ls = p:FindFirstChild("leaderstats")
	if ls then
		ls["فلوس"].Value = C.fmt(d.money)
		ls["سرعة"].Value = math.floor(d.speed)
	end
	return inc
end
local function save(p)
	local d = data[p]
	if not d or not store or not d.loaded then return end
	local out = {}
	for k, v in pairs(d) do if k ~= "items" and k ~= "loaded" then out[k] = v end end
	out.items = {}
	for s, it in pairs(d.items) do
		out.items[tostring(s)] = {kind = it.kind, zone = it.zone, king = it.king, rar = it.rar, mut = it.mut,
			left = it.readyAt and math.max(0, it.readyAt - now()) or nil}
	end
	pcall(function() store:SetAsync("p" .. p.UserId, out) end)
end

---------------------------------------------------------------- خانات القاعدة
local startCarry, dropCarry, spawnSlot

local function removeSlotActor(i, s)
	local a = plots[i].actors[s]
	if a then a:Destroy() plots[i].actors[s] = nil end
end

local function hatch(p, i, s)
	local d = data[p]
	local it = d.items[s]
	if not it or it.kind ~= "egg" or it.away then return end
	if now() < it.readyAt then notify(p, "البيضة لسا ما جهزت ⏳") return end
	local chances = C.CHANCES[it.king and 5 or it.zone]
	local roll, acc, rar = math.random() * 100, 0, 1
	for r, w in ipairs(chances) do
		acc = acc + w
		if w > 0 and roll <= acc then rar = r break end
	end
	local mroll, macc, mut = math.random() * 100, 0, 1
	for m, info in ipairs(C.MUT) do
		macc = macc + info.w
		if mroll <= macc then mut = m break end
	end
	d.items[s] = {kind = "pet", zone = it.zone, king = it.king, rar = rar, mut = mut}
	spawnSlot(p, s)
	local a = plots[i].actors[s]
	Fx:FireClient(p, "hatch", {actor = a, cf = C.slotCF(i, s), element = C.element(it.zone, it.king), rar = rar, mut = mut, income = C.income(d.items[s], d.rebirth)})
	if rar >= 5 then
		Fx:FireAllClients("toast", {text = "🌟 " .. p.DisplayName .. " فقّس تنين خرافي!", color = C.RARITY[5].color})
	end
	sync(p)
end

local function slotTriggered(who, owner, i, s)
	local d = data[owner]
	local it = d and d.items[s]
	local r = hrp(who)
	if not it or it.away or not r then return end
	if who == owner then
		if it.kind == "egg" then
			hatch(owner, i, s)
		else
			local value = C.income(it, d.rebirth) * 60
			d.money = d.money + value
			d.items[s] = nil
			removeSlotActor(i, s)
			notify(owner, "بعت التنين بـ $" .. C.fmt(value), Color3.fromRGB(100, 255, 130))
			sync(owner)
		end
	else
		if carry[who] then notify(who, "إيدك مشغولة!") return end
		if plots[i].lockUntil > now() then notify(who, "القاعدة مقفلة 🔒") return end
		it.away = true
		removeSlotActor(i, s)
		startCarry(who, {origin = "steal", owner = owner, plot = i, slot = s, item = it, zone = it.zone, king = it.king})
		notify(owner, "🚨 " .. who.DisplayName .. " يسرق منك! اضربه بالمضرب", Color3.fromRGB(255, 80, 80))
		Fx:FireClient(owner, "alarm", {})
		sync(owner)
	end
end

spawnSlot = function(p, s)
	local i = p:GetAttribute("plot")
	local d = data[p]
	if not i or not d then return end
	removeSlotActor(i, s)
	local it = d.items[s]
	if not it or it.away then return end
	local attrs = {Element = C.element(it.zone, it.king), OwnerId = p.UserId, Slot = s}
	local a
	if it.kind == "egg" then
		attrs.Scale, attrs.State, attrs.ReadyAt, attrs.King = 0.75, "incubating", it.readyAt, it.king == true
		a = newActor("Egg", C.slotCF(i, s), attrs)
	else
		attrs.Scale, attrs.State = C.RARITY[it.rar].scale, "idle"
		attrs.Rarity, attrs.Mut, attrs.Income = it.rar, it.mut, C.income(it, d.rebirth)
		a = newActor("Dragon", C.slotCF(i, s), attrs)
	end
	plots[i].actors[s] = a
	addPrompt(a, "تفاعل", it.kind == "egg" and 0.5 or 1.5, function(who) slotTriggered(who, p, i, s) end)
end

local function freeSlot(d)
	for s = 1, d.slots do if not d.items[s] then return s end end
	return nil
end

---------------------------------------------------------------- الحمل
local function dismount(p)
	if mounts[p] then mounts[p]:Destroy() mounts[p] = nil end
	p:SetAttribute("mounted", false)
end

startCarry = function(p, info)
	local r = hrp(p)
	if not r then return end
	dismount(p)
	local a
	if info.item and info.item.kind == "pet" then
		a = newActor("Dragon", r.CFrame, {Element = C.element(info.zone, info.king), Scale = 0.22, State = "idle", Rarity = info.item.rar, Mut = info.item.mut, Carried = true})
		weldTo(a, r, CFrame.new(0, 2.8, 0))
	else
		a = newActor("Egg", r.CFrame, {Element = C.element(info.zone, info.king), Scale = 0.7, State = "carried", King = info.king == true, Carried = true})
		weldTo(a, r, CFrame.new(0, 2.6, 0))
	end
	info.actor = a
	carry[p] = info
	p:SetAttribute("carrying", info.origin)
	p:SetAttribute("carryZone", info.zone)
	Fx:FireClient(p, "sound", {id = "pickup"})
end

local function clearCarry(p)
	local c = carry[p]
	if not c then return nil end
	if c.actor then c.actor:Destroy() end
	carry[p] = nil
	p:SetAttribute("carrying", nil)
	return c
end

local function fillNest(n)
	if n.actor then return end
	local a = newActor("Egg", CFrame.new(n.pos + Vector3.new(0, 1.2, 0)), {Element = C.ZONES[n.zone].key, Scale = 1, State = "nest"})
	n.actor = a
	addPrompt(a, "اسرق البيضة 🥚", 0.6, function(who)
		if carry[who] or not hrp(who) or n.actor ~= a or not who:GetAttribute("plot") then return end
		a:Destroy()
		n.actor = nil
		n.respawn = now() + 18
		startCarry(who, {origin = "nest", zone = n.zone})
		local g = guards[n.zone]
		if g.state == "sleep" or g.state == "return" then
			g.state, g.target, g.timer = "wake", who, now() + 3.1
			Fx:FireClient(who, "wake", {zone = n.zone, actor = g.actor})
		end
	end)
end

local function placeKing(pos)
	local a = newActor("Egg", CFrame.new(pos + Vector3.new(0, 0.5, 0)), {Element = "King", Scale = 1.5, State = "nest", King = true})
	king = {actor = a, expire = now() + 90}
	addPrompt(a, "خذ بيضة الملك 👑", 1.2, function(who)
		if carry[who] or not hrp(who) or not king or king.actor ~= a or not who:GetAttribute("plot") then return end
		a:Destroy()
		king = nil
		startCarry(who, {origin = "king", zone = 4, king = true})
		Fx:FireAllClients("toast", {text = "👑 " .. who.DisplayName .. " أخذ بيضة الملك! لاحقوه!", color = C.RARITY[4].color})
	end)
end

dropCarry = function(p)
	local c = carry[p]
	if not c then return end
	local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	local pos = r and r.Position or C.KING_POS
	clearCarry(p)
	if c.origin == "steal" then
		c.item.away = nil
		if data[c.owner] then
			spawnSlot(c.owner, c.slot)
			sync(c.owner)
			notify(c.owner, "رجعت أغراضك ✅", Color3.fromRGB(100, 255, 130))
		end
	elseif c.origin == "king" then
		local drop = Vector3.new(math.clamp(pos.X, -95, 95), 0, math.clamp(pos.Z, -230, 840))
		if not king then placeKing(drop) end
	end
end

local function deliver(p, c)
	local d = data[p]
	local s = freeSlot(d)
	if not s then
		if now() > (c.warn or 0) then c.warn = now() + 4 notify(p, "قاعدتك مليانة! بيع تنين أو وسّع القاعدة") end
		return
	end
	if c.origin == "steal" then
		if c.owner == p then return end
		local od = data[c.owner]
		if od then od.items[c.slot] = nil sync(c.owner) end
		local it = c.item
		it.away = nil
		d.items[s] = it
	else
		local hatchTime = c.king and 60 or C.ZONES[c.zone].hatch
		d.items[s] = {kind = "egg", zone = c.zone, king = c.king, readyAt = now() + hatchTime}
	end
	clearCarry(p)
	spawnSlot(p, s)
	sync(p)
	Fx:FireClient(p, "delivered", {cf = C.slotCF(p:GetAttribute("plot"), s)})
end

---------------------------------------------------------------- المضرب
local function knock(victim, dir, power)
	Fx:FireClient(victim, "knock", {velocity = dir * power + Vector3.new(0, power * 0.6, 0)})
end
local function giveBat(p)
	local pack = p:WaitForChild("Backpack", 5)
	if not pack then return end
	local tool = Instance.new("Tool")
	tool.Name = "المضرب"
	tool.CanBeDropped = false
	tool.Grip = CFrame.new(0, -1.3, 0)
	local h = Instance.new("Part")
	h.Name = "Handle" h.Size = Vector3.new(0.45, 3.6, 0.45) h.Color = Color3.fromRGB(150, 95, 50)
	h.Material = Enum.Material.Wood h.CanCollide = false h.Massless = true h.Parent = tool
	local head = Instance.new("Part")
	head.Size = Vector3.new(0.75, 1.7, 0.75) head.Color = Color3.fromRGB(190, 130, 70)
	head.Material = Enum.Material.WoodPlanks head.CanCollide = false head.Massless = true head.Parent = tool
	local w = Instance.new("Weld") w.Part0, w.Part1, w.C0 = h, head, CFrame.new(0, 1.2, 0) w.Parent = head
	local a0 = Instance.new("Attachment", head) a0.Position = Vector3.new(0, 0.8, 0)
	local a1 = Instance.new("Attachment", head) a1.Position = Vector3.new(0, -0.8, 0)
	local trail = Instance.new("Trail", head)
	trail.Attachment0, trail.Attachment1, trail.Lifetime, trail.Enabled = a0, a1, 0.18, false
	trail.Transparency = NumberSequence.new(0.3, 1)
	local last = 0
	tool.Activated:Connect(function()
		if now() - last < 0.8 or carry[p] then return end
		last = now()
		local anim = Instance.new("StringValue") anim.Name = "toolanim" anim.Value = "Slash" anim.Parent = tool
		trail.Enabled = true
		task.delay(0.3, function() trail.Enabled = false end)
		Fx:FireClient(p, "sound", {id = "swing"})
		local r = hrp(p)
		if not r then return end
		for _, other in ipairs(Players:GetPlayers()) do
			local o = other ~= p and hrp(other)
			if o then
				local delta = o.Position - r.Position
				if delta.Magnitude < 9 and delta.Magnitude > 0.1 and r.CFrame.LookVector:Dot(delta.Unit) > 0.1 then
					dismount(other)
					dropCarry(other)
					knock(other, delta.Unit, 35 + 12 * (data[p] and data[p].bat or 1))
					Fx:FireAllClients("hit", {pos = o.Position})
				end
			end
		end
	end)
	tool.Parent = pack
end

---------------------------------------------------------------- اللاعبين
local function homeCF(i)
	local p, dir = C.plotPoint(i, 14, -8, 4)
	return CFrame.lookAt(p, p + Vector3.new(-dir, 0, 0.4))
end
local function setSign(i, text)
	local sign = map.Plots["Plot" .. i]:FindFirstChild("Sign")
	if not sign then return end
	local g = sign:FindFirstChild("Board")
	if not g then
		g = Instance.new("BillboardGui") g.Name = "Board" g.Size = UDim2.fromScale(16, 3)
		g.StudsOffset = Vector3.new(0, 4, 0) g.MaxDistance = 220 g.Parent = sign
		local l = Instance.new("TextLabel") l.Name = "L" l.Size = UDim2.fromScale(1, 1) l.BackgroundTransparency = 1
		l.TextScaled = true l.Font = Enum.Font.GothamBlack l.TextColor3 = Color3.new(1, 1, 1) l.TextStrokeTransparency = 0 l.Parent = g
	end
	g.L.Text = text
end
for i = 1, #C.PLOTS do setSign(i, "قاعدة فاضية") end

local function onCharacter(p, ch)
	status[p] = {slow = 0, stun = 0}
	local h = ch:WaitForChild("Humanoid", 10)
	local r = ch:WaitForChild("HumanoidRootPart", 10)
	if not h or not r then return end
	h.Died:Connect(function() dropCarry(p) dismount(p) end)
	task.wait(0.3)
	local i = p:GetAttribute("plot")
	if i and ch.Parent then ch:PivotTo(homeCF(i)) end
	giveBat(p)
end

local function onPlayer(p)
	local ls = Instance.new("Folder") ls.Name = "leaderstats"
	for _, n in ipairs({"فلوس", "سرعة"}) do
		local v = Instance.new(n == "فلوس" and "StringValue" or "IntValue") v.Name = n v.Parent = ls
	end
	ls.Parent = p
	local d = defaults()
	d.loaded = false
	if store then
		local ok, saved = pcall(function() return store:GetAsync("p" .. p.UserId) end)
		if ok then
			d.loaded = true
			if saved then
				for k, v in pairs(saved) do if k ~= "items" then d[k] = v end end
				d.loaded = true
				for key, it in pairs(saved.items or {}) do
					if it.left then it.readyAt = now() + it.left it.left = nil end
					d.items[tonumber(key)] = it
				end
			end
		end
	end
	if not p.Parent then return end
	data[p] = d
	for i, plot in ipairs(plots) do
		if not plot.owner then
			plot.owner = p
			p:SetAttribute("plot", i)
			setSign(i, "🏰 قاعدة " .. p.DisplayName)
			break
		end
	end
	if not p:GetAttribute("plot") then notify(p, "السيرفر مليان، ما في قاعدة فاضية") end
	for s in pairs(d.items) do spawnSlot(p, s) end
	sync(p)
	p.CharacterAdded:Connect(function(ch) onCharacter(p, ch) end)
	if p.Character then task.spawn(onCharacter, p, p.Character) end
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, p) end

Players.PlayerRemoving:Connect(function(p)
	dropCarry(p)
	dismount(p)
	for thief, c in pairs(carry) do
		if c.owner == p then c.item.away = nil clearCarry(thief) end
	end
	save(p)
	local i = p:GetAttribute("plot")
	if i then
		for s = 1, C.MAX_SLOTS do removeSlotActor(i, s) end
		for _, t in ipairs(plots[i].traps) do t:Destroy() end
		if plots[i].barrier then plots[i].barrier:Destroy() end
		plots[i] = {actors = {}, lockUntil = 0, lockReady = 0, traps = {}}
		setSign(i, "قاعدة فاضية")
	end
	data[p], status[p] = nil, nil
end)
game:BindToClose(function() for _, p in ipairs(Players:GetPlayers()) do save(p) end end)

---------------------------------------------------------------- أوامر اللاعب
local lastAction = {}
Action.OnServerEvent:Connect(function(p, name, arg)
	local d = data[p]
	local i = p:GetAttribute("plot")
	if not d or not i or type(name) ~= "string" then return end
	if os.clock() - (lastAction[p] or 0) < 0.2 then return end
	lastAction[p] = os.clock()
	local plot = plots[i]
	local r = hrp(p)
	if name == "buy" then
		local u = type(arg) == "string" and C.UPGRADES[arg]
		if not u then return end
		if d[arg] >= u.max then notify(p, "وصلت للحد الأقصى") return end
		local cost = u.cost(d[arg])
		if d.money < cost then notify(p, "فلوسك ما تكفي 💸") return end
		d.money = d.money - cost
		d[arg] = d[arg] + 1
		Fx:FireClient(p, "sound", {id = "buy"})
		notify(p, "تم شراء: " .. u.name, Color3.fromRGB(100, 255, 130))
	elseif name == "rebirth" then
		local cost = C.rebirthCost(d.rebirth)
		if d.money < cost then notify(p, "تحتاج $" .. C.fmt(cost)) return end
		if carry[p] then return end
		d.money, d.speed, d.rebirth = 0, C.START_SPEED, d.rebirth + 1
		for s, it in pairs(d.items) do if it.kind == "pet" then spawnSlot(p, s) end end
		Fx:FireClient(p, "rebirth", {})
	elseif name == "home" then
		if carry[p] then notify(p, "ما تقدر تنتقل وأنت حامل شي!") return end
		if r then dismount(p) p.Character:PivotTo(homeCF(i)) end
	elseif name == "lock" then
		if now() < plot.lockReady then notify(p, "القفل يشحن: " .. math.ceil(plot.lockReady - now()) .. " ث") return end
		local dur = 20 + 10 * d.lock
		plot.lockUntil, plot.lockReady = now() + dur, now() + dur + 45
		p:SetAttribute("lockUntil", plot.lockUntil)
		local pos = C.plotPoint(i, 0, 0, 7)
		local b = Instance.new("Part")
		b.Name = "Barrier" b.Anchored = true b.CanCollide = false b.CanQuery = false
		b.Size = Vector3.new(C.PLOT_SIZE, 14, C.PLOT_SIZE) b.Position = pos
		b.Material = Enum.Material.ForceField b.Color = Color3.fromRGB(255, 60, 90) b.Parent = workspace
		plot.barrier = b
		task.delay(dur, function() b:Destroy() end)
		notify(p, "🔒 قاعدتك مقفلة " .. dur .. " ثانية", Color3.fromRGB(255, 120, 140))
	elseif name == "trap" then
		if not r or not C.inPlot(i, r.Position) then notify(p, "حط الفخ داخل قاعدتك") return end
		if d.traps < 1 then notify(p, "ما عندك فخاخ، اشتري من المتجر") return end
		if #plot.traps >= 3 then notify(p, "الحد 3 فخاخ") return end
		d.traps = d.traps - 1
		local t = Instance.new("Part")
		t.Name = "Trap" t.Anchored = true t.CanCollide = false t.Shape = Enum.PartType.Cylinder
		t.Size = Vector3.new(0.35, 5, 5) t.Material = Enum.Material.DiamondPlate t.Color = Color3.fromRGB(80, 80, 95)
		t.CFrame = CFrame.new(r.Position.X, 0.8, r.Position.Z) * CFrame.Angles(0, 0, math.pi / 2)
		t.Parent = workspace
		table.insert(plot.traps, t)
	elseif name == "mount" then
		if mounts[p] then dismount(p) return end
		if carry[p] or not r then return end
		local best
		for _, it in pairs(d.items) do
			if it.kind == "pet" and not it.away and it.rar >= 4 and (not best or it.rar > best.rar) then best = it end
		end
		if not best then notify(p, "تحتاج تنين أسطوري أو خرافي عشان تطير 🐉") return end
		local a = newActor("Dragon", r.CFrame, {Element = C.element(best.zone, best.king), Scale = 0.75, State = "fly", Rarity = best.rar, Mut = best.mut, Mount = true})
		weldTo(a, r, CFrame.new(0, -6.2, 0.6))
		mounts[p] = a
		p:SetAttribute("mounted", true)
	end
	sync(p)
end)

---------------------------------------------------------------- الأعشاش والحراس
for z = 1, #C.ZONES do
	for n = 1, 3 do
		local nest = {zone = z, pos = C.nestPos(z, n), respawn = 0}
		table.insert(nests, nest)
		fillNest(nest)
	end
	local home = C.guardPos(z)
	local a = newActor("Dragon", CFrame.lookAt(home, home - Vector3.zAxis), {Element = C.ZONES[z].key, Scale = 1.35 + z * 0.15, State = "sleep", Guard = z})
	guards[z] = {zone = z, home = home, pos = home, actor = a, state = "sleep", timer = 0, breath = 0}
end

local function carrierFor(z)
	for p, c in pairs(carry) do
		local r = hrp(p)
		if c.origin == "nest" and c.zone == z and r and r.Position.Z > C.SAFE_Z then return p end
	end
	return nil
end
local function chasing(g, p)
	local c = p and carry[p]
	local r = p and hrp(p)
	return c and c.origin == "nest" and c.zone == g.zone and r and r.Position.Z > C.SAFE_Z and r
end

RunService.Heartbeat:Connect(function(dt)
	local t = now()
	for z, g in ipairs(guards) do
		local face
		if g.state == "wake" then
			local r = chasing(g, g.target)
			if r then face = r.Position end
			if t >= g.timer then g.state = "chase" end
		elseif g.state == "chase" then
			local r = chasing(g, g.target)
			if not r then
				g.target = carrierFor(z)
				if not g.target then g.state = "return" end
			else
				local goal = Vector3.new(r.Position.X, 0, r.Position.Z)
				local delta = goal - g.pos
				face = goal
				if delta.Magnitude < 8 and r.Position.Y < 22 then
					local victim = g.target
					dropCarry(victim)
					knock(victim, delta.Magnitude > 0.1 and delta.Unit or Vector3.zAxis, 75)
					notify(victim, "🔥 الحارس مسكك! زيد سرعتك", Color3.fromRGB(255, 90, 60))
					g.state, g.timer = "attack", t + 1.6
				else
					g.pos = g.pos + delta.Unit * math.min(C.ZONES[z].guard * dt, delta.Magnitude)
					if t > g.breath and delta.Magnitude < 28 then
						g.breath = t + 7
						status[g.target].slow = t + 0.8
						Fx:FireAllClients("breath", {actor = g.actor})
					end
				end
			end
		elseif g.state == "attack" then
			if t >= g.timer then g.state = "return" end
		elseif g.state == "return" then
			local other = carrierFor(z)
			if other then
				g.state, g.target = "chase", other
			else
				local delta = g.home - g.pos
				if delta.Magnitude < 1.5 then
					g.pos, g.state = g.home, "sleep"
					face = g.home - Vector3.zAxis
				else
					face = g.home
					g.pos = g.pos + delta.Unit * math.min(C.ZONES[z].guard * 1.3 * dt, delta.Magnitude)
				end
			end
		end
		local look = g.actor.CFrame.LookVector
		if face and (face - g.pos).Magnitude > 0.5 then look = (face - g.pos).Unit end
		g.actor.CFrame = CFrame.lookAt(g.pos, g.pos + Vector3.new(look.X, 0, look.Z))
		if g.actor:GetAttribute("State") ~= g.state then g.actor:SetAttribute("State", g.state) end
	end
end)

---------------------------------------------------------------- الحلقات
task.spawn(function()
	while true do
		task.wait(0.15)
		local t = now()
		for _, p in ipairs(Players:GetPlayers()) do
			local d, st = data[p], status[p]
			local r, h = hrp(p)
			local i = p:GetAttribute("plot")
			if d and st and r then
				local c = carry[p]
				local ws = math.min(d.speed, C.MAX_SPEED)
				if c then ws = ws * (c.king and 0.85 or 0.93) end
				if t < st.slow then ws = ws * 0.7 end
				if t < st.stun then ws = 0 end
				h.WalkSpeed = ws
				h.UseJumpPower = true
				h.JumpPower = t < st.stun and 0 or 52
				if c and i and C.inPlot(i, r.Position) then deliver(p, c) end
				for j, plot in ipairs(plots) do
					if plot.owner and plot.owner ~= p then
						if t < plot.lockUntil and C.inPlot(j, r.Position) then
							local out = C.plotPoint(j, C.PLOT_SIZE / 2 + 5, 0, 4)
							dismount(p)
							p.Character:PivotTo(CFrame.new(out))
							notify(p, "القاعدة مقفلة 🔒")
						end
						for k = #plot.traps, 1, -1 do
							local trap = plot.traps[k]
							if (trap.Position - r.Position).Magnitude < 4.5 then
								trap:Destroy()
								table.remove(plot.traps, k)
								st.stun = t + 3
								dropCarry(p)
								Fx:FireAllClients("hit", {pos = r.Position})
								notify(p, "🪤 وقعت بالفخ!", Color3.fromRGB(255, 90, 60))
								notify(plot.owner, "🪤 فخك مسك " .. p.DisplayName)
							end
						end
					end
				end
			end
		end
		for _, n in ipairs(nests) do
			if not n.actor and t >= n.respawn then fillNest(n) end
		end
		if king and t > king.expire then king.actor:Destroy() king = nil end
	end
end)

task.spawn(function()
	local tick = 0
	while true do
		task.wait(1)
		tick = tick + 1
		for p, d in pairs(data) do
			local i = p:GetAttribute("plot")
			local r = hrp(p)
			local training = false
			if i and r and not carry[p] then
				local tm = C.plotPoint(i, -14, -13, r.Position.Y)
				if math.abs(r.Position.X - tm.X) < 5 and math.abs(r.Position.Z - tm.Z) < 6 and r.Position.Y < 10 then
					training = true
					d.speed = math.min(C.MAX_SPEED, d.speed + 0.6 * d.tread * (1 + 0.25 * d.rebirth))
				end
			end
			p:SetAttribute("training", training)
			local inc = sync(p) or 0
			d.money = d.money + inc
			p:SetAttribute("money", d.money)
		end
		if tick % 120 == 0 then for p in pairs(data) do task.spawn(save, p) end end
	end
end)

task.spawn(function()
	kingAt = now() + C.KING_FIRST
	workspace:SetAttribute("KingAt", kingAt)
	while true do
		task.wait(1)
		local busy = king ~= nil
		for _, c in pairs(carry) do if c.king then busy = true end end
		if now() >= kingAt then
			kingAt = now() + C.KING_EVERY
			workspace:SetAttribute("KingAt", kingAt)
			if not busy then
				Fx:FireAllClients("king", {pos = C.KING_POS})
				task.wait(4.5)
				if not king then placeKing(C.KING_POS) end
			end
		end
	end
end)
