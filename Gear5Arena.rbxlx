se</bool><bool name="CanTouch">false</bool><Vector3 name="size"><X>1.0</X><Y>3.0</Y><Z>1.0</Z></Vector3><CoordinateFrame name="CFrame"><X>23.5611875746211</X><Y>3.5</Y><Z>-19.12846456430791</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4284106290</Color3uint8><token name="Material">272</token><token name="shape">1</token><token name="Shape">1</token><float name="Transparency">0.0</float></Properties></Item><Item class="Humanoid" referent="RBX257"><Properties><string name="Name">Humanoid</string><float name="MaxHealth">400.0</float><float name="Health">400.0</float></Properties></Item></Item></Item></Item><Item class="Lighting" referent="RBX258"><Properties><string name="Name">Lighting</string><float name="ClockTime">0.0</float><float name="Brightness">0.5</float><Color3 name="Ambient"><R>0.17647058823529413</R><G>0.1568627450980392</G><B>0.3137254901960784</B></Color3><Color3 name="OutdoorAmbient"><R>0.23529411764705882</R><G>0.19607843137254902</G><B>0.43137254901960786</B></Color3></Properties><Item class="BloomEffect" referent="RBX259"><Properties><string name="Name">Bloom</string><float name="Intensity">1.2</float><float name="Size">40.0</float><float name="Threshold">0.8</float></Properties></Item><Item class="ColorCorrectionEffect" referent="RBX260"><Properties><string name="Name">CC</string><float name="Contrast">0.15</float><float name="Saturation">0.25</float></Properties></Item><Item class="Atmosphere" referent="RBX261"><Properties><string name="Name">Atmosphere</string><float name="Density">0.25</float><Color3 name="Color"><R>0.47058823529411764</R><G>0.35294117647058826</G><B>0.7843137254901961</B></Color3><Color3 name="Decay"><R>0.1568627450980392</R><G>0.0784313725490196</G><B>0.3137254901960784</B></Color3><float name="Haze">1.0</float></Properties></Item><Item class="Sky" referent="RBX262"><Properties><string name="Name">Sky</string><int name="StarCount">3000</int></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX277"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="RemoteEvent" referent="RBX278"><Properties><string name="Name">TransformEvent</string></Properties></Item><Item class="RemoteEvent" referent="RBX279"><Properties><string name="Name">TransformFX</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX280"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX281"><Properties><string name="Name">Gear5Server</string><ProtectedString name="Source"><![CDATA[-- سكربت ربط فقط: كل الأشكال والمؤثرات موجودة كعناصر جاهزة في ServerStorage داخل الملف
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local SS = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Event = RS:WaitForChild("TransformEvent")
local FX = RS:WaitForChild("TransformFX")
local Kit = SS:WaitForChild("Gear5Kit")
local ChargeFX = SS:WaitForChild("ChargeFX")
local PunchKit = SS:WaitForChild("PunchArm")
local Cheer = SS:FindFirstChild("CheerKeyframes")

local COOLDOWN, PUNCH_COOLDOWN = 4, 1.2
local states, last, lastPunch = {}, {}, {}

local function burst(container)
	for _, e in ipairs(container:GetDescendants()) do
		if e:IsA("ParticleEmitter") and e.Name:find("Burst") then
			e:Emit(tonumber(e.Name:match("%d+")) or 20)
		end
	end
end

local function damageAt(char, pos, radius, dmg, dir, force)
	local seen = {}
	for _, part in ipairs(workspace:GetPartBoundsInRadius(pos, radius)) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and model ~= char and not seen[model] then
			local h = model:FindFirstChildOfClass("Humanoid")
			if h and h.Health > 0 then
				seen[model] = true
				h:TakeDamage(dmg)
				local r = model:FindFirstChild("HumanoidRootPart")
				if r and not r.Anchored then
					r.AssemblyLinearVelocity = dir * force + Vector3.new(0, force * 0.45, 0)
				end
			end
		end
	end
end

local function playCheer(hum, s)
	if not Cheer or hum.RigType ~= Enum.HumanoidRigType.R6 then return end
	pcall(function()
		local id = game:GetService("KeyframeSequenceProvider"):RegisterKeyframeSequence(Cheer)
		local a = Instance.new("Animation")
		a.AnimationId = id
		local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
		local track = animator:LoadAnimation(a)
		track.Looped = true
		track.Priority = Enum.AnimationPriority.Action
		track:Play()
		s.track = track
		task.delay(2.5, function() if track then track:Stop() end end)
	end)
end

local function applyKit(char, hum, s)
	local head = char:FindFirstChild("Head")
	local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	if not head or not torso then return end
	local kit = Kit:Clone()
	local map = {Head = head, Torso = torso}
	for _, d in ipairs(kit:GetDescendants()) do
		if d:IsA("Weld") and d.Part0 and map[d.Part0.Name] then
			d.Part0 = map[d.Part0.Name]
		end
	end
	local hinge = kit:FindFirstChild("SunHinge0", true)
	if hinge then hinge.Parent = torso end
	local sun = kit:FindFirstChild("SunDisc")
	if sun then sun.CFrame = torso.CFrame * CFrame.new(0, 0.6, 1.6) * CFrame.Angles(0, math.pi / 2, 0) end
	kit.Head:Destroy()
	kit.Torso:Destroy()
	s.items = kit:GetChildren()
	for _, c in ipairs(s.items) do c.Parent = char end
	kit:Destroy()

	for _, acc in ipairs(char:GetChildren()) do
		if acc:IsA("Accessory") and acc:FindFirstChild("Handle") then
			s.hidden[acc.Handle] = acc.Handle.Transparency
			acc.Handle.Transparency = 1
		end
	end
	local face = head:FindFirstChildOfClass("Decal")
	if face then s.hidden[face] = face.Transparency; face.Transparency = 1 end

	hum.UseJumpPower = true
	hum.MaxHealth = 400
	hum.Health = 400
	hum.WalkSpeed = 30
	hum.JumpPower = 85
end

local function removeKit(char, hum, s)
	for _, i in ipairs(s.items or {}) do
		if i.Parent then i:Destroy() end
	end
	s.items = {}
	for inst, t in pairs(s.hidden) do
		if inst.Parent then inst.Transparency = t end
	end
	s.hidden = {}
	if s.track then s.track:Stop(); s.track = nil end
	hum.MaxHealth = s.stats.MaxHealth
	hum.Health = math.min(hum.Health, s.stats.MaxHealth)
	hum.WalkSpeed = s.stats.WalkSpeed
	hum.JumpPower = s.stats.JumpPower
end

local function doTransform(player, char, hum, hrp, s)
	local base = hrp.CFrame
	hrp.Anchored = true
	FX:FireClient(player, "charge")
	local fx = ChargeFX:Clone()
	fx.CFrame = base
	fx.Parent = char
	local beat = fx:FindFirstChild("BeatBurst40")
	for i = 1, 3 do
		task.delay((i - 1) * 0.55, function()
			if fx.Parent then
				fx.Beat:Play()
				if beat then beat:Emit(40) end
				FX:FireClient(player, "beat", i)
			end
		end)
	end
	local t0 = os.clock()
	while hrp.Parent do
		local a = (os.clock() - t0) / 1.7
		if a >= 1 then break end
		local j = 0.2 * a
		hrp.CFrame = CFrame.new(base.Position + Vector3.new((math.random() - 0.5) * j, a * 4 + (math.random() - 0.5) * j, (math.random() - 0.5) * j)) * base.Rotation
		fx.CFrame = hrp.CFrame
		task.wait()
	end
	if not hrp.Parent then fx:Destroy() return end

	FX:FireClient(player, "boom")
	for _, e in ipairs(fx:GetDescendants()) do
		if e:IsA("ParticleEmitter") and not e.Name:find("Burst") then e.Enabled = false end
	end
	fx.Boom:Play()
	burst(fx)
	TweenService:Create(fx, TweenInfo.new(0.5), {Transparency = 1, Size = Vector3.new(30, 30, 30)}):Play()
	Debris:AddItem(fx, 4)
	applyKit(char, hum, s)
	s.form = true
	FX:FireClient(player, "state", true)
	damageAt(char, hrp.Position, 28, 20, Vector3.yAxis, 70)
	playCheer(hum, s)
	task.wait(0.3)

	local startPos = hrp.Position
	local target = base.Position
	local rot = base.Rotation
	local t1 = os.clock()
	while hrp.Parent do
		local a = (os.clock() - t1) / 0.4
		if a >= 1 then break end
		hrp.CFrame = CFrame.new(startPos:Lerp(target, a * a)) * rot
		task.wait()
	end
	if hrp.Parent then hrp.CFrame = CFrame.new(target) * rot end
end

local function doRevert(player, char, hum, hrp, s)
	FX:FireClient(player, "boom")
	FX:FireClient(player, "state", false)
	local fx = ChargeFX:Clone()
	fx.CFrame = hrp.CFrame
	fx.Parent = workspace
	for _, e in ipairs(fx:GetDescendants()) do
		if e:IsA("ParticleEmitter") and not e.Name:find("Burst") then e.Enabled = false end
	end
	fx.Boom:Play()
	burst(fx)
	TweenService:Create(fx, TweenInfo.new(0.4), {Transparency = 1}):Play()
	Debris:AddItem(fx, 4)
	removeKit(char, hum, s)
	s.form = false
end

local function doPunch(player, char, hum, hrp, target)
	local origin = hrp.Position + Vector3.new(0, 1, 0)
	local dir = hrp.CFrame.LookVector
	if typeof(target) == "Vector3" and target == target then
		local d = target - origin
		if d.Magnitude > 1 then dir = d.Unit end
	end
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude > 0.01 then hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat) end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local res = workspace:Raycast(origin, dir * 70, params)
	local dist = res and res.Distance or 70

	local kit = PunchKit:Clone()
	kit.Parent = workspace
	local arm, fist, impact = kit.Arm, kit.Fist, kit.Impact
	for i = 1, 8 do
		local len = math.max(dist * i / 8, 1)
		local mid = origin + dir * len / 2
		arm.Size = Vector3.new(len, 2.2, 2.2)
		arm.CFrame = CFrame.lookAt(mid, mid + dir) * CFrame.Angles(0, math.pi / 2, 0)
		fist.Position = origin + dir * len
		task.wait(0.02)
	end
	local e = origin + dir * dist
	impact.Position = e
	impact.Boom:Play()
	burst(impact)
	damageAt(char, e, 14, 60, dir, 140)
	FX:FireClient(player, "impact")
	TweenService:Create(arm, TweenInfo.new(0.3), {Transparency = 1}):Play()
	TweenService:Create(fist, TweenInfo.new(0.3), {Transparency = 1}):Play()
	Debris:AddItem(kit, 4)
end

Event.OnServerEvent:Connect(function(player, action, arg)
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then return end
	local s = states[player]
	if not s then
		s = {stats = {WalkSpeed = hum.WalkSpeed, JumpPower = hum.JumpPower, MaxHealth = hum.MaxHealth}, hidden = {}, items = {}, busy = false, form = false}
		states[player] = s
	end
	if action == "toggle" then
		if s.busy or os.clock() - (last[player] or 0) < COOLDOWN then return end
		last[player] = os.clock()
		s.busy = true
		pcall(function()
			if s.form then doRevert(player, char, hum, hrp, s) else doTransform(player, char, hum, hrp, s) end
		end)
		if hrp.Parent then hrp.Anchored = false end
		s.busy = false
	elseif action == "punch" then
		if not s.form or s.busy or os.clock() - (lastPunch[player] or 0) < PUNCH_COOLDOWN then return end
		lastPunch[player] = os.clock()
		pcall(doPunch, player, char, hum, hrp, arg)
	end
end)

local function hook(pl)
	pl.CharacterAdded:Connect(function()
		states[pl] = nil
		FX:FireClient(pl, "state", false)
	end)
end
Players.PlayerAdded:Connect(hook)
for _, pl in ipairs(Players:GetPlayers()) do hook(pl) end
Players.PlayerRemoving:Connect(function(pl) states[pl] = nil; last[pl] = nil; lastPunch[pl] = nil end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX282"><Properties><string name="Name">DummyRefill</string><ProtectedString name="Source"><![CDATA[for _, m in ipairs(workspace.Arena:GetChildren()) do
	local h = m:FindFirstChildOfClass("Humanoid")
	if h then
		h.HealthChanged:Connect(function(hp)
			if hp <= 100 then
				task.wait(0.1)
				h.Health = h.MaxHealth
			end
		end)
	end
end
