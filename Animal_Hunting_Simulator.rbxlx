<Item class="ModuleScript" referent="RBX0015615"><Properties>
<string name="Name">UIKit</string>
<ProtectedString name="Source"><![CDATA[-- UIKit: shared UI helpers, state sync, panels, toasts, viewports
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Data = require(ReplicatedStorage.Shared.GameData)
local gui = script.Parent

local UIKit = { Gui = gui, Data = Data, Remotes = Remotes, State = nil, TimeOffset = 0 }
UIKit.Changed = Instance.new("BindableEvent")
UIKit.Opened = Instance.new("BindableEvent")

local GREEN, RED = Color3.fromRGB(70, 210, 90), Color3.fromRGB(235, 70, 70)

-- ---------- fonts for every text object (including cloned templates)
local function style(d)
	if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then d.Font = Enum.Font.FredokaOne end
end
for _, d in ipairs(gui:GetDescendants()) do style(d) end
gui.DescendantAdded:Connect(style)

-- ---------- formatting
local suf = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc" }
function UIKit.Fmt(n)
	n = math.floor(tonumber(n) or 0)
	if n < 1000 then return tostring(n) end
	local i = math.min(math.floor(math.log10(n) / 3), #suf - 1)
	local s = string.format("%.2f", n / 10 ^ (i * 3)):gsub("%.?0+$", "")
	return s .. suf[i + 1]
end
function UIKit.RarityColor(r) return Data.RarityColor[r] or Color3.new(1, 1, 1) end

-- ---------- sound (ids are configured in ReplicatedStorage.Sounds)
function UIKit.Sfx(name)
	local s = ReplicatedStorage:FindFirstChild("Sounds") and ReplicatedStorage.Sounds:FindFirstChild(name)
	if s and s.SoundId ~= "" and (not UIKit.State or UIKit.State.settings.sfx) then s:Play() end
end

-- ---------- state sync
function UIKit.ApplySettings()
	local S = UIKit.State
	if not S then return end
	player:SetAttribute("AutoShoot", S.settings.auto)
	player:SetAttribute("LowGfx", S.settings.low)
	Lighting.GlobalShadows = not S.settings.low
	local music = ReplicatedStorage:FindFirstChild("Sounds") and ReplicatedStorage.Sounds:FindFirstChild("Music")
	if music and music.SoundId ~= "" then
		music.Looped = true
		if S.settings.music then if not music.IsPlaying then music:Play() end else music:Stop() end
	end
end

Remotes.Sync.OnClientEvent:Connect(function(s)
	UIKit.State = s
	UIKit.TimeOffset = s.serverTime - os.time()
	UIKit.ApplySettings()
	UIKit.Changed:Fire()
end)
function UIKit.ServerNow() return os.time() + UIKit.TimeOffset end

-- ---------- requests / toasts
local function toast(text, good)
	local t = gui.Templates.Toast:Clone()
	t.Visible = true
	t.Text.Text = text
	t:FindFirstChildOfClass("UIStroke").Color = (good == false) and RED or Color3.fromRGB(255, 205, 60)
	t.BackgroundTransparency = 1
	t.Parent = gui.Toasts
	TweenService:Create(t, TweenInfo.new(0.18), { BackgroundTransparency = 0.05 }):Play()
	task.delay(2.4, function()
		TweenService:Create(t, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(t.Text, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.32); t:Destroy()
	end)
end
UIKit.Toast = toast

function UIKit.Request(action, ...)
	local args = table.pack(...)
	local ok, res = pcall(function() return Remotes.Request:InvokeServer(action, table.unpack(args, 1, args.n)) end)
	if ok and type(res) == "table" then
		if res.msg then toast(res.msg, res.ok) end
		return res
	end
	return { ok = false }
end

-- ---------- button press animation
function UIKit.Click(btn, fn)
	btn.Activated:Connect(function()
		local sc = btn:FindFirstChildOfClass("UIScale")
		if not sc then sc = Instance.new("UIScale"); sc.Parent = btn end
		sc.Scale = 0.9
		TweenService:Create(sc, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		UIKit.Sfx("Click")
		if fn then fn() end
	end)
end

-- ---------- panels
local panelFrames, tokens = {}, {}
for _, p in ipairs(gui.Panels:GetChildren()) do
	local key = p.Name:sub(3)
	panelFrames[key] = p
	UIKit.Click(p.Header.Close, function() UIKit.Close(key) end)
end

function UIKit.Close(key)
	local p = panelFrames[key]
	if not p or not p.Visible then return end
	tokens[key] = (tokens[key] or 0) + 1
	local tok = tokens[key]
	TweenService:Create(p.Scale, TweenInfo.new(0.12), { Scale = 0.8 }):Play()
	task.delay(0.12, function() if tokens[key] == tok then p.Visible = false end end)
end

function UIKit.CloseAll() for k in pairs(panelFrames) do UIKit.Close(k) end end

function UIKit.Open(key)
	local p = panelFrames[key]
	if not p then return end
	for k, f in pairs(panelFrames) do if k ~= key and f.Visible then UIKit.Close(k) end end
	tokens[key] = (tokens[key] or 0) + 1
	if not p.Visible then
		p.Visible = true
		p.Scale.Scale = 0.75
		TweenService:Create(p.Scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	UIKit.Opened:Fire(key)
end

function UIKit.Toggle(key)
	local p = panelFrames[key]
	if p and p.Visible then UIKit.Close(key) else UIKit.Open(key) end
end
function UIKit.IsOpen(key) return panelFrames[key] and panelFrames[key].Visible end

-- ---------- viewports
local function strip(inst)
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Sound") or d:IsA("Attachment") then d:Destroy() end
	end
end

function UIKit.Viewport(vp, kind, id)
	for _, c in ipairs(vp:GetChildren()) do c:Destroy() end
	local m
	if kind == "animal" then
		local src = ReplicatedStorage.Animals:FindFirstChild(id)
		if not src then return end
		m = src:Clone()
	else
		local src = ReplicatedStorage.Weapons:FindFirstChild(id)
		if not src then return end
		local t = src:Clone()
		m = Instance.new("Model")
		for _, c in ipairs(t:GetChildren()) do c.Parent = m end
		t:Destroy()
	end
	strip(m)
	m.Parent = vp
	local cf, size = m:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	local dist = size.Magnitude * 1.2
	local dir = (kind == "animal") and Vector3.new(-0.75, 0.35, -1) or Vector3.new(1, 0.25, 0.2)
	cam.CFrame = CFrame.lookAt(cf.Position + dir.Unit * dist, cf.Position)
	cam.Parent = vp
	vp.CurrentCamera = cam
end

return UIKit
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0015616"><Properties>
<string name="Name">UI_Main</string>
<ProtectedString name="Source"><![CDATA[-- UI_Main: HUD, menu buttons, notifications, capture popup, zone banner
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local gui = script.Parent
local UIKit = require(gui:WaitForChild("UIKit"))
local Data = UIKit.Data
local player = Players.LocalPlayer
local hud = gui:WaitForChild("Hud")

local function upd()
	hud.Currency.Coins.Value.Text = UIKit.Fmt(player:GetAttribute("Coins") or 0)
	hud.Currency.Gems.Value.Text = UIKit.Fmt(player:GetAttribute("Gems") or 0)
	hud.Currency.Animals.Value.Text = tostring(player:GetAttribute("Animals") or 0)
	hud.Currency.Pending.Value.Text = UIKit.Fmt(player:GetAttribute("Pending") or 0)
	hud.Level.Lv.Text = "Lv. " .. (player:GetAttribute("Level") or 1)
	local xp, lo, hi = player:GetAttribute("XP") or 0, player:GetAttribute("XPLo") or 0, player:GetAttribute("XPHi") or 1
	hud.Level.XP.Fill.Size = UDim2.fromScale(math.clamp((xp - lo) / math.max(1, hi - lo), 0, 1), 1)
end
for _, a in ipairs({ "Coins", "Gems", "Animals", "Pending", "Level", "XP", "XPLo", "XPHi" }) do player:GetAttributeChangedSignal(a):Connect(upd) end
upd()

for btn, panel in pairs({ Btn_Shop = "Shop", Btn_Upgrades = "Upgrades", Btn_Index = "Index", Btn_Rewards = "Daily", Btn_Rebirth = "Rebirth", Btn_Settings = "Settings" }) do
	UIKit.Click(hud.Menu[btn], function() UIKit.Toggle(panel) end)
end
for btn, panel in pairs({ Btn_Weapons = "Weapons", Btn_Animals = "Animals", Btn_Quests = "Quests", Btn_Zones = "Zones", Btn_Base = "Base" }) do
	UIKit.Click(hud.Side[btn], function() UIKit.Toggle(panel) end)
end
UIKit.Click(hud.Currency.Coins.Plus, function() gui:SetAttribute("ShopTab", "Coins"); UIKit.Open("Shop") end)
UIKit.Click(hud.Currency.Gems.Plus, function() gui:SetAttribute("ShopTab", "Gems"); UIKit.Open("Shop") end)

-- prompts that open panels (hub stations)
game:GetService("ProximityPromptService").PromptTriggered:Connect(function(prompt, who)
	if who ~= player then return end
	local key = string.match(prompt.Name, "^UI_(%a+)$")
	if key then UIKit.Open(key) end
end)

local function popup(id, rarity)
	local cp = gui.CapturePopup
	UIKit.Viewport(cp.VP, "animal", id)
	cp.CName.Text = id
	cp.CRarity.Text = rarity
	cp.CRarity.TextColor3 = UIKit.RarityColor(rarity)
	cp:FindFirstChildOfClass("UIStroke").Color = UIKit.RarityColor(rarity)
	cp.Visible = true
	cp.Scale.Scale = 0.5
	TweenService:Create(cp.Scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	UIKit.Sfx("Capture")
	local token = os.clock(); cp:SetAttribute("tok", token)
	task.delay(2.3, function()
		if cp:GetAttribute("tok") == token then
			TweenService:Create(cp.Scale, TweenInfo.new(0.2), { Scale = 0.1 }):Play()
			task.wait(0.2)
			if cp:GetAttribute("tok") == token then cp.Visible = false end
		end
	end)
end

local function banner(name)
	local zb = gui.ZoneBanner
	zb.Zone.Text = name .. " Zone"
	zb.Visible = true
	zb.Scale.Scale = 0.3
	TweenService:Create(zb.Scale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	UIKit.Sfx("Unlock")
	task.delay(3, function()
		TweenService:Create(zb.Scale, TweenInfo.new(0.25), { Scale = 0.1 }):Play()
		task.wait(0.25); zb.Visible = false
	end)
end

UIKit.Remotes.Notify.OnClientEvent:Connect(function(kind, a, b)
	if kind == "toast" then UIKit.Toast(a, b)
	elseif kind == "capture" then popup(a, b)
	elseif kind == "level" then UIKit.Toast("⭐ Level Up! You are now Lv. " .. a, true); UIKit.Sfx("LevelUp")
	elseif kind == "zone" then banner(a)
	elseif kind == "zone_locked" then UIKit.Toast("🔒 " .. a .. " Zone unlocks at Level " .. b, false); UIKit.Open("Zones") end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0015617"><Properties>
<string name="Name">UI_Weapons</string>
<ProtectedString name="Source"><![CDATA[-- UI_Weapons: weapon inventory / information / buy / equip
local gui = script.Parent
local UIKit = require(gui:WaitForChild("UIKit"))
local Data = UIKit.Data
local p = gui.Panels.P_Weapons
local grid, info = p.Body.Grid, p.Body.Info
local cells, selected, built = {}, "W1", false

local function refresh()
	local S = UIKit.State
	if not S or not built then return end
	local owned = 0
	for id, c in pairs(cells) do
		local has = S.weapons[id] == true
		if has then owned += 1 end
		c.Lock.Visible = not has
		c.Badge.Text = (S.equipped == id) and "EQ" or ""
		c.VP.ImageColor3 = has and Color3.new(1, 1, 1) or Color3.fromRGB(70, 70, 80)
		c.Stroke.Color = (selected == id) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(20, 24, 50)
	end
	local w = Data.WeaponById[selected]
	info.WName.Text = w.name
	info.WRarity.Text = w.rarity
	info.WRarity.TextColor3 = UIKit.RarityColor(w.rarity)
	info.WStats.Text = string.format("Damage: %s\nFire rate: %.1f/s\nAmmo: %d\nReload: %.1fs\nRange: %d\nCrit: %d%%", UIKit.Fmt(w.damage), w.rate, w.ammo, w.reload, w.range, w.crit)
	local b = info.Btn_Equip
	if S.equipped == selected then b.Text = "Equipped ✔"
	elseif S.weapons[selected] then b.Text = "Equip"
	else b.Text = "Buy " .. UIKit.Fmt(w.price) .. (w.currency == "Gems" and " 💎" or " 🪙") end
	p.Body.Cap.Text = "Owned " .. owned .. "/" .. #Data.Weapons .. "  •  Upgrades apply to every weapon"
end

local function build()
	if built then return end
	built = true
	for i, w in ipairs(Data.Weapons) do
		local c = gui.Templates.WeaponCell:Clone()
		c.Name = w.id; c.Visible = true; c.LayoutOrder = i
		c.BackgroundColor3 = UIKit.RarityColor(w.rarity)
		c.Tag.Text = w.name
		UIKit.Viewport(c.VP, "weapon", w.name)
		c.Parent = grid
		UIKit.Click(c, function() selected = w.id; refresh() end)
		cells[w.id] = c
	end
	selected = (UIKit.State and UIKit.State.equipped) or "W1"
end

UIKit.Click(info.Btn_Equip, function()
	local S = UIKit.State
	if S and S.equipped ~= selected then UIKit.Request("BuyWeapon", selected) end
end)
UIKit.Opened.Event:Connect(function(key) if key == "Weapons" then build(); refresh() end end)
UIKit.Changed.Event:Connect(refresh)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0015618"><Properties>
<string name="Name">UI_Animals</string>
<ProtectedString name="Source"><![CDATA[-- UI_Animals: animal collection, animal information, place / remove
local gui = script.Parent
local UIKit = require(gui:WaitForChild("UIKit"))
local Data = UIKit.Data
local p = gui.Panels.P_Animals
local grid, info = p.Body.Grid, p.Body.Info
local selected = nil

local function find(uid)
	local S = UIKit.State
	if not S then return nil end
	for _, a in ipairs(S.animals) do if a.u == uid then return a end end
end

local function updateInfo()
	local S = UIKit.State
	local a = selected and find(selected)
	if not a then
		info.AName.Text = "Select an animal"; info.ARarity.Text = ""; info.AStats.Text = ""
		info.Btn_Place.Visible = false; info.Btn_Remove.Visible = false
		return
	end
	local def = Data.AnimalById[a.id]
	local mult = 1 + S.rebirths + S.rp * 0.05
	info.AName.Text = a.id
	info.ARarity.Text = def.rarity
	info.ARarity.TextColor3 = UIKit.RarityColor(def.rarity)
	info.AStats.Text = string.format("Zone: %s\nIncome: 🪙 %s/s\nHealth: %s\nStatus: %s", def.zone, UIKit.Fmt(def.income * mult), UIKit.Fmt(Data.HPBase[def.rarity] * def.hpMul), a.s > 0 and ("Base slot " .. a.s) or "In inventory")
	info.Btn_Place.Visible = a.s == 0
	info.Btn_Remove.Visible = a.s > 0
end

local function rebuild()
	local S = UIKit.State
	if not S then return end
	for _, c in ipairs(grid:GetChildren()) do if c:IsA("GuiButton") then c:Destroy() end end
	local list = table.clone(S.animals)
	table.sort(list, function(x, y)
		local ix, iy = Data.AnimalById[x.id].income, Data.AnimalById[y.id].income
		if ix ~= iy then return ix > iy end
		return x.u < y.u
	end)
	for i, a in ipairs(list) do
		local def = Data.AnimalById[a.id]
		local c = gui.Templates.AnimalCell:Clone()
		c.Name = "A" .. a.u; c.Visible = true; c.LayoutOrder = i
		c.BackgroundColor3 = UIKit.RarityColor(def.rarity)
		c.Tag.Text = a.id; c.Lock.Visible = false
		c.Badge.Text = a.s > 0 and "🏠" or ""
		UIKit.Viewport(c.VP, "animal", a.id)
		c.Parent = grid
		UIKit.Click(c, function() selected = a.u; updateInfo() end)
	end
	if selected and not find(selected) then selected = nil end
	updateInfo()
	p.Body.Cap.Text = string.format("Inventory %d/%d  •  Placed %d/%d slots", S.invCount, S.capacity, #S.animals - S.invCount, S.slots)
end

UIKit.Click(info.Btn_Place, function() if selected then UIKit.Request("PlaceAnimal", selected) end end)
UIKit.Click(info.Btn_Remove, function() if selected then UIKit.Request("RemoveAnimal", selected) end end)
UIKit.Opened.Event:Connect(function(key) if key == "Animals" then rebuild() end end)
UIKit.Changed.Event:Connect(function() if UIKit.IsOpen("Animals") then rebuild() end end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0015619"><Properties>
<string name="Name">UI_Index</string>
<ProtectedString name="Source"><![CDATA[-- UI_Index: Animal Index + Weapon Index with collection progress
local gui = script.Parent
local UIKit = require(gui:WaitForChild("UIKit"))
local Data = UIKit.Data
local p = gui.Panels.P_Index
local scroll = p.Body.Scroll
local tab, built = "Animals", { Animals = false, Weapons = false }
local cells = { Animals = {}, Weapons = {} }
local sections = { Animals = {}, Weapons = {} }

local function header(text, order)
	local h = gui.Templates.SectionHeader:Clone(); h.Visible = true; h.Text.Text = text; h.LayoutOrder = order; return h
end

local function build(which)
	if built[which] then return end
	built[which] = true
	local order = 0
	if which == "Animals" then
		for _, z in ipairs(Data.Zones) do
			order += 1
			local h = header(z.name .. " Zone", order); h.Parent = scroll; table.insert(sections.Animals, h)
			order += 1
			local g = gui.Templates.IndexGrid:Clone(); g.Visible = true; g.LayoutOrder = order; g.Parent = scroll; table.insert(sections.Animals, g)
			for _, a in ipairs(Data.Animals) do
				if a.zone == z.name then
					local c = gui.Templates.IndexCell:Clone(); c.Visible = true; c.Name = a.id
					c.BackgroundColor3 = UIKit.RarityColor(a.rarity)
					UIKit.Viewport(c.VP, "animal", a.id)
					c.Tag.Text = a.id; c.Lock.Visible = false
					c.Parent = g; cells.Animals[a.id] = c
				end
			end
		end
	else
		order += 1
		local h = header("Weapons", order); h.Parent = scroll; table.insert(sections.Weapons, h)
		order += 1
		local g = gui.Templates.IndexGrid:Clone(); g.Visible = true; g.LayoutOrder = order; g.Parent = scroll; table.insert(sections.Weapons, g)
		for _, w in ipairs(Data.Weapons) do
			local c = gui.Templates.IndexCell:Clone(); c.Visible = true; c.Name = w.id
			c.BackgroundColor3 = UIKit.RarityColor(w.rarity)
			UIKit.Viewport(c.VP, "weapon", w.name)
			c.Tag.Text = w.name; c.Lock.Visible = false
			c.Parent = g; cells.Weapons[w.id] = c
		end
	end
end

local function refresh()
	local S = UIKit.State
	if not S then return end
	build(tab)
	for k, list in pairs(sections) do for _, s in ipairs(list) do s.Visible = (k == tab) end end
	local got, total = 0, 0
	for id, c in pairs(cells[tab]) do
		total += 1
		local has = (tab == "Animals") and S.index.animals[id] or S.index.weapons[id]
		if has then got += 1 end
		c.VP.ImageColor3 = has and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
		c.Tag.Text = has and id or "???"
		if tab == "Weapons" and has then c.Tag.Text = Data.WeaponById[id].name end
	end
	p.Body.Count.Text = ("Collected %d/%d"):format(got, total)
	p.Body.Progress.Fill.Size = UDim2.fromScale(total > 0 and got / total or 0, 1)
	p.Body.Tabs.Tab_Animals.BackgroundColor3 = (tab == "Animals") and Color3.fromRGB(50, 150, 255) or Color3.fromRGB(70, 78, 120)
	p.Body.Tabs.Tab_Weapons.BackgroundColor3 = (tab == "Weapons") and Color3.fromRGB(50, 150, 255) or Color3.fromRGB(70, 78, 120)
end

UIKit.Click(p.Body.Tabs.Tab_Animals, function() tab = "Animals"; refresh() end)
UIKit.Click(p.Body.Tabs.Tab_Weapons, function() tab = "Weapons"; refresh() end)
UIKit.Opened.Event:Connect(function(key) if key == "Index" then refresh() end end)
UIKit.Changed.Event:Connect(function() if UIKit.IsOpen("Index") then refresh() end end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0015620"><Properties>
<string name="Name">UI_Shop</string>
<ProtectedString name="Source"><![CDATA[-- UI_Shop: coins / gems / boosts / special items / passes
local gui = script.Parent
local UIKit = require(gui:WaitForChild("UIKit"))
local Data = UIKit.Data
local p = gui.Panels.P_Shop
local grid, tabs = p.Body.Grid, p.Body.Tabs
local current = "Coins"
local colors = { Coins = Color3.fromRGB(255, 200, 40), Gems = Color3.fromRGB(150, 80, 235), Boosts = Color3.fromRGB(255, 150, 40), Special = Color3.fromRGB(64, 200, 74), Passes = Color3.fromRGB(225, 60, 60) }

local function show(tab)
	current = tab
	for _, c in ipairs(grid:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	for name, col in pairs(colors) do tabs["Tab_" .. name].BackgroundTransparency = (name == tab) and 0 or 0.45 end
	for i, it in ipairs(Data.Shop[tab]) do
		local c = gui.Templates.ShopCard:Clone(); c.Visible = true; c.LayoutOrder = i
		c.Icon.Text = it.icon; c.Title.Text = it.title; c.Desc.Text = it.desc
		if it.gems then c.Btn.Text = "💎 " .. UIKit.Fmt(it.gems) else c.Btn.Text = "R$ " .. it.robux end
		c.Parent = grid
		UIKit.Click(c.Btn, function() UIKit.Request("BuyShop", tab, it.id) end)
	end
end

for name in pairs(colors) do UIKit.Click(tabs["Tab_" .. name], function() show(name) end) end
UIKit.Opened.Event:Connect(function(key)
	if key == "Shop" then
		local t = gui:GetAttribute("ShopTab")
		if t and Data.Shop[t] then show(t) else show(current) end
		gui:SetAttribute("ShopTab", nil)
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0015621"><Properties>
<string name="Name">UI_Upgrades</string>
<ProtectedString name="Source"><![CDATA[-- UI_Upgrades: damage / fire rate / ammo / reload / range / crit / speed
local gui = script.Parent
local UIKit = require(gui:WaitForChild("UIKit"))
local Data = UIKit.Data
local p = gui.Panels.P_Upgrades
local list = p.Body.List
local rows = {}

for i, u in ipairs(Data.Upgrades) do
	local r = gui.Templates.UpgradeRow:Clone(); r.Visible = true; r.LayoutOrder = i
	r.Icon.Text = u.icon; r.Title.Text = u.name; r.Desc.Text = u.desc
	r.Parent = list; rows[u.id] = r
	UIKit.Click(r.Btn, function() UIKit.Request("BuyUpgrade", u.id) end)
end

local function refresh()
	local S = UIKit.State
	if not S then return end
	for _, u in ipairs(Data.Upgrades) do
		local lvl = S.upgrades[u.id] or 0
		local r = rows[u.id]
		r.Lv.Text = "Lv. " .. lvl .. "/" .. u.max
		r.LvBar.Fill.Size = UDim2.fromScale(lvl / u.max, 1)
		r.Btn.Text = (lvl >= u.max) and "MAX" or ("🪙 " .. UIKit.Fmt(math.floor(u.base * 1.3 ^ lvl)))
	end
end
UIKit.Opened.Event:Connect(function(key) if key == "Upgrades" then refresh() end end)
UIKit.Changed.Event:Connect(refresh)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0015622"><Properties>
<string name="Name">UI_Misc</string>
<ProtectedString name="Source"><![CDATA[-- UI_Misc: Rebirth, Base, Quests, Daily Rewards, Settings, Zones panels
local gui = script.Parent
local UIKit = require(gui:WaitForChild("UIKit"))
local Data = UIKit.Data
local Panels = gui.Panels
local GREEN, GRAY = Color3.fromRGB(64, 200, 74), Color3.fromRGB(110, 116, 150)
local function tick(ok) return ok and "✅ " or "❌ " end

-- ================= Rebirth
do
	local b = Panels.P_Rebirth.Body
	local function refresh()
		local S = UIKit.State
		if not S then return end
		local plr = game.Players.LocalPlayer
		local level, coins = plr:GetAttribute("Level") or 1, plr:GetAttribute("Coins") or 0
		local req = S.rebirthReq
		b.Req.Text = ("Requirements:\n%sLevel %d  (you: %d)\n%sCoins %s  (you: %s)"):format(tick(level >= req.level), req.level, level, tick(coins >= req.coins), UIKit.Fmt(req.coins), UIKit.Fmt(coins))
		b.Rew.Text = ("Rewards (Rebirth #%d):\n+100%% Coins (permanent)\n+50%% Gems\n+1 Base Slot  •  +%d Rebirth Points\nResets: coins & upgrades"):format(S.rebirths + 1, S.rebirths + 1)
		b.Btn_Rebirth.Text = (level >= req.level and coins >= req.coins) and "Rebirth!" or "Locked"
	end
	UIKit.Click(b.Btn_Rebirth, function()
		b.Confirm.Text.Text = "Reset coins & upgrades for permanent bonuses?\nYour animals, weapons and Index are kept."
		b.Confirm.Visible = true
	end)
	UIKit.Click(b.Confirm.Btn_No, function() b.Confirm.Visible = false end)
	UIKit.Click(b.Confirm.Btn_Yes, function() b.Confirm.Visible = false; UIKit.Request("Rebirth") end)
	UIKit.Opened.Event:Connect(function(k) if k == "Rebirth" then b.Confirm.Visible = false; refresh() end end)
	UIKit.Changed.Event:Connect(refresh)
	game.Players.LocalPlayer:GetAttributeChangedSignal("Coins"):Connect(function() if UIKit.IsOpen("Rebirth") then refresh() end end)
end

-- ================= Base
do
	local b = Panels.P_Base.Body
	local function refresh()
		local S = UIKit.State
		if not S then return end
		local plr = game.Players.LocalPlayer
		b.Income.Text = "💰 Income: " .. UIKit.Fmt(plr:GetAttribute("Income") or S.income) .. " / s"
		b.Pending.Text = "📦 Waiting to collect: " .. UIKit.Fmt(plr:GetAttribute("Pending") or 0)
		b.Slots.Text = ("Slots unlocked: %d/12  •  Placed: %d"):format(S.slots, #S.animals - S.invCount)
		b.Btn_UnlockSlot.Text = (S.slots >= 12) and "All slots unlocked" or ("🔓 Unlock Slot  🪙 " .. UIKit.Fmt(S.nextSlotCost))
	end
	UIKit.Click(b.Btn_Collect, function() UIKit.Request("Collect") end)
	UIKit.Click(b.Btn_PlaceBest, function() UIKit.Request("PlaceBest") end)
	UIKit.Click(b.Btn_UnlockSlot, function() UIKit.Request("UnlockSlot") end)
	UIKit.Click(b.Btn_GoBase, function() UIKit.Request("GoBase"); UIKit.Close("Base") end)
	UIKit.Click(b.Btn_GoHub, function() UIKit.Request("GoHub"); UIKit.Close("Base") end)
	UIKit.Opened.Event:Connect(function(k) if k == "Base" then refresh() end end)
	UIKit.Changed.Event:Connect(refresh)
	game.Players.LocalPlayer:GetAttributeChangedSignal("Pending"):Connect(function() if UIKit.IsOpen("Base") then refresh() end end)
end

-- ================= Quests
do
	local list = Panels.P_Quests.Body.List
	local rows = {}
	for i, q in ipairs(Data.Quests) do
		local r = gui.Templates.QuestRow:Clone(); r.Visible = true; r.LayoutOrder = i; r.Text.Text = q.text
		r.Reward.Text = UIKit.Fmt(q.coins) .. " 🪙\n" .. q.gems .. " 💎"
		r.Parent = list; rows[q.id] = r
		UIKit.Click(r.Btn, function() UIKit.Request("ClaimQuest", q.id) end)
	end
	local function refresh()
		local S = UIKit.State
		if not S then return end
		for _, q in ipairs(Data.Quests) do
			local r = rows[q.id]
			local v = math.min(S.quests.progress[q.id] or 0, q.target)
			r.Bar.Fill.Size = UDim2.fromScale(v / q.target, 1)
			r.Prog.Text = UIKit.Fmt(v) .. "/" .. UIKit.Fmt(q.target)
			if S.quests.claimed[q.id] then r.Btn.Text = "Done ✔"; r.Btn.BackgroundColor3 = GRAY
			elseif v >= q.target then r.Btn.Text = "Claim"; r.Btn.BackgroundColor3 = GREEN
			else r.Btn.Text = "In progress"; r.Btn.BackgroundColor3 = GRAY end
		end
	end
	UIKit.Opened.Event:Connect(function(k) if k == "Quests" then refresh() end end)
	UIKit.Changed.Event:Connect(refresh)
end

-- ================= Daily rewards
do
	local b = Panels.P_Daily.Body
	for i, r in ipairs(Data.Daily) do
		local c = gui.Templates.DailyCell:Clone(); c.Visible = true; c.Name = "Day" .. i; c.LayoutOrder = i
		c.Day.Text = "Day " .. i; c.Icon.Text = (r.kind == "Gems") and "💎" or "🪙"; c.Amt.Text = "x" .. UIKit.Fmt(r.amount)
		c.Parent = b.Days
	end
	local function refresh()
		local S = UIKit.State
		if not S then return end
		local nextIdx = (S.daily.streak % 7) + 1
		for i = 1, 7 do
			local c = b.Days["Day" .. i]
			c.BackgroundTransparency = (i == nextIdx) and 0 or 0.35
			c.Day.Text = (i <= (S.daily.streak % 7) and S.daily.last > 0) and ("Day " .. i .. " ✔") or ("Day " .. i)
		end
		local left = S.daily.last + 86400 - UIKit.ServerNow()
		if S.daily.last == 0 or left <= 0 then
			b.Btn_Claim.Text = "Claim"; b.Btn_Claim.BackgroundColor3 = GREEN; b.Next.Text = "Reward ready!"
		else
			b.Btn_Claim.Text = "Wait..."; b.Btn_Claim.BackgroundColor3 = GRAY
			b.Next.Text = ("Next reward in %02d:%02d:%02d"):format(left // 3600, (left % 3600) // 60, left % 60)
		end
	end
	UIKit.Click(b.Btn_Claim, function() UIKit.Request("ClaimDaily") end)
	UIKit.Opened.Event:Connect(function(k) if k == "Daily" then refresh() end end)
	UIKit.Changed.Event:Connect(refresh)
	task.spawn(function() while true do task.wait(1); if UIKit.IsOpen("Daily") then refresh() end end end)
end

-- ================= Settings
do
	local b = Panels.P_Settings.Body
	local map = { Music = "music", SFX = "sfx", AutoShoot = "auto", LowGfx = "low" }
	local function refresh()
		local S = UIKit.State
		if not S then return end
		for name, key in pairs(map) do
			local t = b.Rows["Row_" .. name]["Toggle_" .. name]
			t.Text = S.settings[key] and "ON" or "OFF"
			t.BackgroundColor3 = S.settings[key] and GREEN or Color3.fromRGB(200, 60, 60)
		end
	end
	for name, key in pairs(map) do
		UIKit.Click(b.Rows["Row_" .. name]["Toggle_" .. name], function()
			local S = UIKit.State
			if S then UIKit.Request("SetSetting", key, not S.settings[key]) end
		end)
	end
	UIKit.Click(b.Btn_Redeem, function()
		local code = b.CodeBox.Text
		if code ~= "" then UIKit.Request("Redeem", code); b.CodeBox.Text = "" end
	end)
	UIKit.Opened.Event:Connect(function(k) if k == "Settings" then refresh() end end)
	UIKit.Changed.Event:Connect(refresh)
end

-- ================= Zones
do
	local grid = Panels.P_Zones.Body.Grid
	local cards = {}
	for i, z in ipairs(Data.Zones) do
		local c = gui.Templates.ZoneCard:Clone(); c.Visible = true; c.LayoutOrder = i
		c.Title.Text = z.name; c.Lv.Text = "Lv. " .. z.level .. "+"
		c:FindFirstChildOfClass("UIStroke").Color = z.color
		c.Parent = grid; cards[z.name] = c
		UIKit.Click(c.Btn, function()
			local r = UIKit.Request("TravelZone", z.name)
			if r.ok then UIKit.Close("Zones") end
		end)
	end
	local function refresh()
		local S = UIKit.State
		if not S then return end
		for _, z in ipairs(Data.Zones) do
			local c = cards[z.name]
			local open = S.zones[z.name] == true
			c.Status.Text = open and "Unlocked" or ("🔒 Reach Lv. " .. z.level)
			c.Btn.Text = open and "Teleport" or "Locked"
			c.Btn.BackgroundColor3 = open and GREEN or GRAY
		end
	end
	UIKit.Opened.Event:Connect(function(k) if k == "Zones" then refresh() end end)
	UIKit.Changed.Event:Connect(refresh)
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
