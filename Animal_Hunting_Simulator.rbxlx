<Item class="ModuleScript" referent="RBX0016340"><Properties>
<string name="Name">FxLib</string>
<ProtectedString name="Source"><![CDATA[-- FxLib: client-side effects helpers (tracers, bursts, damage numbers)
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Effects = ReplicatedStorage:WaitForChild("Effects")
local Data = require(ReplicatedStorage.Shared.GameData)
local player = Players.LocalPlayer
local Fx = {}

local function low() return player:GetAttribute("LowGfx") == true end

function Fx.Burst(name, pos, count, color, life)
	local t = Effects:FindFirstChild(name)
	if not t then return end
	local p = t:Clone()
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace
	for _, e in ipairs(p:GetDescendants()) do
		if e:IsA("ParticleEmitter") then
			if color then e.Color = ColorSequence.new(color) end
			e:Emit(low() and math.ceil((count or 12) / 2) or (count or 12))
		end
	end
	Debris:AddItem(p, life or 2)
	return p
end

function Fx.Tracer(a, b, color)
	local t = Effects:FindFirstChild("Tracer")
	if not t then return end
	local dist = (b - a).Magnitude
	if dist < 1 then return end
	local p = t:Clone()
	p.Size = Vector3.new(0.18, 0.18, dist)
	p.CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -dist / 2)
	p.Color = color or Color3.new(1, 0.9, 0.5)
	p.Transparency = 0.1
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.14), { Transparency = 1, Size = Vector3.new(0.03, 0.03, dist) }):Play()
	Debris:AddItem(p, 0.25)
end

function Fx.Flash(pos, color)
	Fx.Burst("MuzzleFlash", pos, 6, color, 0.6)
end

local function fmt(n)
	n = math.floor(n)
	if n < 1000 then return tostring(n) end
	local suf = { "", "K", "M", "B", "T", "Qa", "Qi" }
	local i = math.min(math.floor(math.log10(n) / 3), #suf - 1)
	local s = string.format("%.1f", n / 10 ^ (i * 3)):gsub("%.0$", "")
	return s .. suf[i + 1]
end

function Fx.Damage(pos, amount, crit)
	local anchor = Instance.new("Part")
	anchor.Anchored = true; anchor.CanCollide = false; anchor.CanQuery = false; anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = pos + Vector3.new(math.random(-10, 10) / 10, 1.5, math.random(-10, 10) / 10)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(crit and 120 or 90, crit and 44 or 32)
	bb.StudsOffset = Vector3.new(0, 0, 0); bb.AlwaysOnTop = true; bb.Parent = anchor
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1); l.BackgroundTransparency = 1; l.TextScaled = true
	l.Font = Enum.Font.FredokaOne
	l.Text = (crit and "💥 " or "") .. fmt(amount)
	l.TextColor3 = crit and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 255, 255)
	l.TextStrokeTransparency = 0; l.TextStrokeColor3 = Color3.fromRGB(20, 20, 30)
	l.Parent = bb
	anchor.Parent = workspace
	TweenService:Create(bb, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(0.7), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 0.8)
end

function Fx.RarityColor(r) return Data.RarityColor[r] or Color3.new(1, 1, 1) end
return Fx
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0016341"><Properties>
<string name="Name">EffectsClient</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Data = require(ReplicatedStorage.Shared.GameData)
local Fx = require(script.Parent:WaitForChild("FxLib"))
local player = Players.LocalPlayer

local function charPos()
	local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	return r and r.Position or Vector3.zero
end

Remotes.Fx.OnClientEvent:Connect(function(kind, a, b, c)
	if kind == "capture" then
		Fx.Burst("CaptureBurst", a, 26, Fx.RarityColor(b), 2.5)
	elseif kind == "dmg" then
		Fx.Damage(a, b, c)
	elseif kind == "coins" then
		Fx.Burst("CoinPop", charPos() + Vector3.new(0, 3, 0), 20, nil, 2)
	elseif kind == "upgrade" then
		Fx.Burst("UpgradeFx", charPos(), 30, nil, 2.5)
	elseif kind == "unlock" then
		Fx.Burst("UpgradeFx", charPos(), 50, Color3.fromRGB(255, 200, 60), 3)
	elseif kind == "rebirth" then
		Fx.Burst("RebirthFx", charPos(), 90, nil, 3.5)
	end
end)

Remotes.ShotFx.OnClientEvent:Connect(function(shooter, origin, endPos, weaponId, hit)
	local w = Data.WeaponById[weaponId]
	local col = w and Data.RarityColor[w.rarity]
	if shooter ~= player then
		Fx.Tracer(origin, endPos, col)
		Fx.Flash(origin, col)
	end
	if hit then Fx.Burst("HitSpark", endPos, 8, nil, 1) end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0016342"><Properties>
<string name="Name">WeaponClient</string>
<ProtectedString name="Source"><![CDATA[-- WeaponClient: aiming, firing, reload, ammo HUD, auto-shoot
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Data = require(ReplicatedStorage.Shared.GameData)
local Fx = require(script.Parent:WaitForChild("FxLib"))
local gui = player:WaitForChild("PlayerGui"):WaitForChild("MainGui")
local ammoFrame = gui:WaitForChild("Hud"):WaitForChild("Ammo")

local tool, conns = nil, {}
local lastFire = 0

local function weaponColor()
	local id = tool and tool:FindFirstChild("WeaponId")
	local w = id and Data.WeaponById[id.Value]
	return w and Data.RarityColor[w.rarity] or Color3.new(1, 1, 0.6)
end

local function updateAmmo()
	if not tool then ammoFrame.Visible = false; return end
	ammoFrame.Visible = true
	ammoFrame.WName.Text = tool.Name
	ammoFrame.AmmoText.Text = (tool:GetAttribute("Ammo") or 0) .. "/" .. (tool:GetAttribute("MaxAmmo") or 0)
end

local function updateReload()
	local fill = ammoFrame.ReloadBar.Fill
	if tool and tool:GetAttribute("Reloading") then
		fill.Size = UDim2.fromScale(0, 1)
		TweenService:Create(fill, TweenInfo.new(tool:GetAttribute("ReloadTime") or 1.5, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) }):Play()
	else
		fill.Size = UDim2.fromScale(1, 1)
	end
end

local function fire()
	if not tool or tool:GetAttribute("Reloading") then return end
	if (tool:GetAttribute("Ammo") or 0) <= 0 then Remotes.Reload:FireServer(); return end
	local rate = tool:GetAttribute("FireRate") or 2
	if os.clock() - lastFire < (1 / rate) * 0.9 then return end
	lastFire = os.clock()
	local aim = mouse.Hit.Position
	Remotes.Fire:FireServer(aim)
	local handle = tool:FindFirstChild("Handle")
	if not handle then return end
	local muzzle = handle:FindFirstChild("Muzzle")
	local origin = muzzle and muzzle.WorldPosition or handle.Position
	local dirv = aim - origin
	if dirv.Magnitude < 1 then return end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { player.Character }
	local range = tool:GetAttribute("Range") or 200
	local res = workspace:Raycast(origin, dirv.Unit * range, rp)
	local endPos = res and res.Position or origin + dirv.Unit * range
	Fx.Tracer(origin, endPos, weaponColor())
	Fx.Flash(origin, weaponColor())
end

local function unequip()
	for _, c in ipairs(conns) do c:Disconnect() end
	conns = {}
	tool = nil
	updateAmmo()
end

local function equip(t)
	unequip()
	tool = t
	table.insert(conns, t.Activated:Connect(fire))
	for _, a in ipairs({ "Ammo", "MaxAmmo" }) do table.insert(conns, t:GetAttributeChangedSignal(a):Connect(updateAmmo)) end
	table.insert(conns, t:GetAttributeChangedSignal("Reloading"):Connect(updateReload))
	updateAmmo(); updateReload()
end

local function watch(char)
	char.ChildAdded:Connect(function(c) if c:IsA("Tool") and c:FindFirstChild("WeaponId") then equip(c) end end)
	char.ChildRemoved:Connect(function(c) if c == tool then unequip() end end)
	for _, c in ipairs(char:GetChildren()) do if c:IsA("Tool") and c:FindFirstChild("WeaponId") then equip(c) end end
end
if player.Character then watch(player.Character) end
player.CharacterAdded:Connect(watch)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.R and tool then Remotes.Reload:FireServer() end
end)
ammoFrame.Btn_Reload.Activated:Connect(function() if tool then Remotes.Reload:FireServer() end end)

-- auto shoot: fires only while the crosshair/cursor is over an animal
RunService.Heartbeat:Connect(function()
	if not tool or player:GetAttribute("AutoShoot") ~= true then return end
	local active = workspace:FindFirstChild("ActiveAnimals")
	local t = mouse.Target
	if not (t and active) then return end
	local m = t
	while m and m.Parent ~= active do m = m.Parent end
	if m then fire() end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0016343"><Properties>
<string name="Name">AnimalAnimator</string>
<ProtectedString name="Source"><![CDATA[-- AnimalAnimator: procedural animations (Motor6D) + health bars, with distance LOD
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Data = require(ReplicatedStorage.Shared.GameData)
local camera = workspace.CurrentCamera
local player = Players.LocalPlayer
local tracked = {}
local frame = 0

local function classify(name)
	local n = name
	if n:match("^Leg") then
		local side = n:sub(-1)
		local ph = 0
		if n == "LegFR" or n == "LegBL" or n == "LegML" or n == "LegR" then ph = math.pi end
		return "leg", ph
	elseif n == "ArmL" then return "arm", math.pi
	elseif n == "ArmR" then return "arm", 0
	elseif n == "WingL" then return "wing", 1
	elseif n == "WingR" then return "wing", -1
	elseif n == "FinL" then return "fin", 1
	elseif n == "FinR" then return "fin", -1
	elseif n == "Head" then return "head", 0
	elseif n == "Tail" or n == "TailFin" then return "tail", 0
	elseif n:match("^S%d+$") then return "seg", tonumber(n:sub(2))
	elseif n:match("^T%d+$") then return "tent", tonumber(n:sub(2))
	end
	return nil
end

local function setupModel(model)
	if tracked[model] then return end
	local info = { model = model, joints = {}, phase = (model:GetAttribute("Uid") or math.random(1, 1000)) * 0.37, built = false }
	local def = Data.AnimalById[model:GetAttribute("AnimalId") or ""]
	info.fly = def and def.move == "fly"
	info.swim = def and def.move == "swim"
	tracked[model] = info
	model.Destroying:Connect(function() tracked[model] = nil end)
	local function hpbar()
		local root = model.PrimaryPart or model:FindFirstChild("Body")
		local bi = root and root:FindFirstChild("Info")
		local bar = bi and bi:FindFirstChild("BarBack") and bi.BarBack:FindFirstChild("Bar")
		if not bar or model:GetAttribute("Placed") then return end
		local hp, mx = model:GetAttribute("HP") or 1, model:GetAttribute("MaxHP") or 1
		local r = math.clamp(hp / mx, 0, 1)
		bar.Size = UDim2.fromScale(r, 1)
		bar.BackgroundColor3 = Color3.fromHSV(0.33 * r, 0.75, 0.92)
	end
	model:GetAttributeChangedSignal("HP"):Connect(hpbar)
	task.defer(hpbar)
end

local function build(info)
	info.joints = {}
	for _, d in ipairs(info.model:GetDescendants()) do
		if d:IsA("Motor6D") then
			local cat, extra = classify(d.Name)
			if cat then table.insert(info.joints, { m = d, cat = cat, x = extra }) end
		end
	end
	info.built = #info.joints > 0
end

local function animate(info, t)
	local model = info.model
	local state = model:GetAttribute("State") or "Idle"
	local f = (state == "Walk" and 1) or (state == "Run" and 1.8) or 0
	local amp = f == 0 and 0 or (0.3 + 0.28 * f)
	local tt = t + info.phase
	for _, j in ipairs(info.joints) do
		local c = j.cat
		local cf
		if c == "leg" then
			cf = CFrame.Angles(math.sin(tt * 6 * f + j.x) * amp, 0, 0)
		elseif c == "arm" then
			local a = f == 0 and math.sin(tt * 1.5) * 0.05 or math.sin(tt * 6 * f + j.x) * amp * 0.8
			cf = CFrame.Angles(a, 0, 0)
		elseif c == "head" then
			local p = math.sin(tt * 1.6) * 0.05 + (f > 0 and math.sin(tt * 6 * f) * 0.05 or 0)
			if state == "Alert" then p = -0.35 elseif state == "Hurt" then p = -0.5 end
			local roll = state == "Hurt" and math.sin(tt * 40) * 0.12 or 0
			cf = CFrame.Angles(p, 0, roll)
		elseif c == "tail" then
			local fr = (f > 0 and 6 * f) or 2.5
			if info.swim then fr = 5 end
			cf = CFrame.Angles(0, math.sin(tt * fr) * 0.45, 0)
		elseif c == "wing" then
			local fr, am
			if info.fly then fr = (f > 0) and 9 or 5; am = 0.7 else fr = (f > 0) and 8 or 1.5; am = (f > 0) and 0.5 or 0.12 end
			cf = CFrame.Angles(0, 0, j.x * math.sin(tt * fr) * am)
		elseif c == "fin" then
			cf = CFrame.Angles(0, 0, j.x * math.sin(tt * 3) * 0.3)
		elseif c == "seg" then
			local amt = (f > 0 or info.swim) and 0.4 or 0.18
			cf = CFrame.Angles(0, math.sin(tt * 4 - j.x * 0.75) * amt, 0)
		elseif c == "tent" then
			cf = CFrame.Angles(math.sin(tt * 2 + j.x) * 0.3, 0, math.cos(tt * 2 + j.x * 1.3) * 0.3)
		end
		if cf then j.m.Transform = cf end
	end
end

local function add(model) if model:IsA("Model") then setupModel(model) end end
CollectionService:GetInstanceAddedSignal("Animal"):Connect(add)
for _, m in ipairs(CollectionService:GetTagged("Animal")) do add(m) end

RunService.RenderStepped:Connect(function()
	frame += 1
	local t = os.clock()
	local campos = camera.CFrame.Position
	local lowMul = player:GetAttribute("LowGfx") and 0.55 or 1
	for model, info in pairs(tracked) do
		local root = model.PrimaryPart or model:FindFirstChild("Body")
		if root then
			local d = (root.Position - campos).Magnitude
			if d < 140 * lowMul then
				if not info.built or (frame % 60 == 0 and #info.joints == 0) then build(info) end
				if info.built and (d < 70 * lowMul or frame % 3 == 0) then animate(info, t) end
			end
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
