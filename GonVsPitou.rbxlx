<Item class="ServerScriptService" referent="RBX1042"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX1041"><Properties><string name="Name">GonVsPitou</string><ProtectedString name="Source">local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local rng, rgb = Random.new(), Color3.fromRGB
local remote = game:GetService("ReplicatedStorage"):WaitForChild("HxH")
local WHITE, SKY, PURPLE = Color3.new(1, 1, 1), rgb(170, 215, 255), rgb(110, 60, 160)
-- بدل الأصوات بـ "rbxassetid://ID" من التولبوكس إذا تبغى (طبول، ضحكة، برق)
local SFX = {drum = "impact_water.mp3", boing = "action_jump.mp3", zap = "swordslash.wav", whoosh = "swordlunge.wav", wind = "action_falling.ogg"}
local function short(n)
	if n &gt;= 1e9 then return string.format("%.1fB", n / 1e9) end
	if n &gt;= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n &gt;= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end
local function tween(o, t, props) TweenService:Create(o, TweenInfo.new(t), props):Play() end
local function part(size, cf, color, transparency, life, material)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
	p.Material, p.Size, p.CFrame, p.Color, p.Transparency = material or Enum.Material.Neon, size, cf, color, transparency or 0
	p.Parent = workspace
	if life then Debris:AddItem(p, life) end
	return p
end
local function label(parent, text, color, y, w, h)
	local g = Instance.new("BillboardGui")
	g.Size, g.StudsOffset, g.MaxDistance = UDim2.fromScale(w or 10, h or 2.5), Vector3.new(0, y, 0), 220
	local t = Instance.new("TextLabel", g)
	t.Size, t.BackgroundTransparency, t.Font, t.TextScaled = UDim2.fromScale(1, 1), 1, Enum.Font.GothamBlack, true
	t.Text, t.TextColor3, t.TextStrokeTransparency = text, color, 0
	g.Parent = parent
	return t, g
end
local function popup(at, text, color)
	local p = part(Vector3.one, CFrame.new(at + rng:NextUnitVector() * 1.5), color, 1, .8)
	label(p, text, color, 1, 5, 1.4)
	tween(p, .8, {Position = p.Position + Vector3.new(0, 4, 0)})
end
local function burst(pos, color, radius)
	local b = part(Vector3.one, CFrame.new(pos), color, .2, .4, Enum.Material.ForceField)
	b.Shape = Enum.PartType.Ball
	tween(b, .4, {Size = Vector3.one * radius * 2, Transparency = 1})
	for _ = 1, 8 do
		local d = rng:NextUnitVector()
		local s = part(Vector3.new(.2, .2, 1.5), CFrame.lookAt(pos, pos + d), color, 0, .3)
		tween(s, .3, {CFrame = s.CFrame * CFrame.new(0, 0, -radius), Transparency = 1})
	end
end
local function sound(where, id, volume, speed)
	local s = Instance.new("Sound")
	s.SoundId, s.Volume, s.PlaybackSpeed, s.Parent = "rbxasset://sounds/" .. id, volume, speed, where
	s:Play()
	Debris:AddItem(s, 3)
end

local function R(x, y, z) return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z)) end
local function joints(p, r15)
	local pi, ya, rf, ro, re, lf, lo, le, rh, rk, lh, lk, dy = table.unpack(p)
	if r15 then
		return {Root = CFrame.new(0,dy,0), Waist = R(-pi,ya,0), Neck = R(pi*.5,-ya*.6,0), RightShoulder = R(rf,0,ro), LeftShoulder = R(lf,0,-lo),
			RightElbow = R(re,0,0), LeftElbow = R(le,0,0), RightHip = R(rh,0,6), LeftHip = R(lh,0,-6), RightKnee = R(-rk,0,0), LeftKnee = R(-lk,0,0)}
	end
	return {RootJoint = CFrame.new(0,0,dy*.5) * R(pi,0,ya), Neck = R(-pi*.5,0,-ya*.6), ["Right Shoulder"] = R(-ro,0,rf), ["Left Shoulder"] = R(-lo,0,-lf),
		["Right Hip"] = R(0,0,rh), ["Left Hip"] = R(0,0,-lh)}
end
local function tw(o, t, props, style) TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad), props):Play() end
local S, active, nightFx, savedTime = {}, 0, {}, 14

-- الوضعيات: ميل، لف، يد يمين (قدام، برا، كوع)، يد يسار، رجل يمين (قدام، ركبة)، رجل يسار، ارتفاع
local ANIM = {
	kneel = function(t) local b = math.max(0, math.sin(t * 11)) ^ 4
		return {38 - b * 14,0, 15,12,25, 15,12,25, 85,115, -5,105, -1.35 + b * .25} end,
	rise = function(t) local j = math.sin(t * 40) * 4
		return {-14 + j,j, -15,45 + j,15, -15,45 - j,15, 20,40, -10,25, 0} end,
	ready = function(t) return {12,-15, 25,30,70, 55,20,90, -20,35, 30,40, -.5} end,
	lie = function(t) return {-4,0, 25,65,5, 25,65,5, 8,0, -6,12, 0} end,
	cover = function(t) local b = math.sin(t * 19)
		return {-24 + b * 8,math.sin(t * 4) * 10, 125,-22,128, 35 + b * 8,-20,115, 25 + math.sin(t * 8) * 20,40, -6,12, math.abs(b) * .4} end,
	slam = function() return {50,0, 55,10,0, 55,10,0, 80,115, -15,100, -1.4} end,
	run = function(t) local a = (t * 1300) % 360
		return {30,0, -70,25,10, -70,25,10, a,70, (a + 180) % 360,70, .3} end,
	rope = function(t) local b = math.sin(t * 10)
		return {8,0, 40 + b * 30,70,25, 40 + b * 30,70,25, 30,60, 10,50, 0} end,
	flail = function(t) local a, b = math.sin(t * 17), math.cos(t * 13)
		return {-25,0, 80 + a * 50,70,20, 60 + b * 50,80,30, 35 + b * 35,50, 10 + a * 35,40, 0} end,
	burst = function() return {-32,0, 30,125,5, 30,125,5, 35,30, -25,45, .3} end,
	laugh = function(t) local b = math.sin(t * 19)
		return {-26 + b * 9,math.sin(t * 5) * 14, 52 + b * 7,-18,112, 52 - b * 7,-18,112, 40 + math.sin(t * 8) * 25,55, -8,15, math.abs(b) * .45} end,
	dance = function(t) local w, c = math.sin(t * 15), math.cos(t * 15)
		return {12,w * 28, 90 * w,90 + 55 * c,30, -90 * w,90 - 55 * c,30, 70 * w,80 * math.max(0, w), -70 * w,80 * math.max(0, -w), math.abs(w) * .9} end,
	grab = function(t) return {-22,18, 178,6 + math.sin(t * 30) * 5,0, 25,55,25, 30,45, -18,20, .5} end,
	windup = function() return {-35,-55, 185,45,75, 90,25,10, 70,95, -25,30, .4} end,
	throw = function() return {42,50, 50,-5,0, -65,40,25, 70,90, -45,35, -1} end,
	punch = function(t) return {18,25, 165 - math.min(t * 190, 100),8,0, -40,45,60, 40,55, -30,30, -.5} end,
	victory = function(t) return {-6,18, 15,40,100, 155,35,20, 12,10, -12,10, math.sin(t * 7) * .12} end,
}
local function play(s, name, speed) s.anim, s.t0, s.speed = ANIM[name], os.clock(), speed or 18 end

RunService.Heartbeat:Connect(function(dt)
	for c, s in S do
		if s.anim then
			local goal = joints(s.anim(os.clock() - s.t0), s.hum.RigType == Enum.HumanoidRigType.R15)
			for name, d in s.rig do
				if goal[name] then d[1][d[2]] = d[1][d[2]]:Lerp(d[3] * goal[name], 1 - math.exp(-dt * s.speed)) end
			end
		end
		-- وشاح الغيوم المتحرك
		for i, w in s.scarf do
			local a = (i - 1) / (#s.scarf - 1) * math.pi * 1.5 - math.pi * .25
			local t = os.clock() * 3 + i * .22
			w.C0 = CFrame.new(Vector3.new(math.cos(a) * 2.5, .5 + math.sin(a) * 1.7 + math.sin(t) * .3, .9 + math.cos(t) * .25) * (s.scale or 1))
		end
	end
end)

local function ring(pos, radius, color, time)
	local a = Instance.new("CylinderHandleAdornment")
	a.Adornee, a.CFrame = workspace.Terrain, CFrame.new(pos) * R(90, 0, 0)
	a.Height, a.Radius, a.InnerRadius, a.Color3, a.Parent = .3, 2, .5, color, workspace
	tw(a, time or .7, {Radius = radius, InnerRadius = radius - .7, Transparency = 1})
	Debris:AddItem(a, time or .7)
end
local function bolt(a, b, thick, jag, color, life)
	local last = a
	for i = 1, 8 do
		local n = a:Lerp(b, i / 8) + (i &lt; 8 and rng:NextUnitVector() * jag or Vector3.zero)
		local cf, len = CFrame.lookAt((last + n) / 2, n), (n - last).Magnitude
		part(Vector3.new(thick, thick, len), cf, WHITE, 0, life or .12)
		part(Vector3.new(thick * 2.4, thick * 2.4, len), cf, color or SKY, .65, life or .12)
		last = n
	end
end
local function ball(size, pos, color, transparency, life, material)
	local p = part(Vector3.one * size, CFrame.new(pos), color, transparency, life, material)
	p.Shape = Enum.PartType.Ball
	return p
end
local function boom(pos, radius)
	for i = 0, 3 do
		task.delay(i * .1, function()
			local d = ball(4, pos, i % 2 == 0 and WHITE or SKY, .1, .8, Enum.Material.ForceField)
			tw(d, .8, {Size = Vector3.one * (radius * 2 - i * 6), Transparency = 1})
			ring(pos - Vector3.new(0, 2.5, 0), radius + i * 7, i % 2 == 0 and WHITE or PURPLE)
		end)
	end
	for i = 1, 22 do
		local dir = CFrame.Angles(0, i / 22 * math.pi * 2, 0).LookVector
		local puff = ball(rng:NextNumber(2, 5), pos + dir * 3 - Vector3.new(0, 2, 0), WHITE, .2, 1.1, Enum.Material.SmoothPlastic)
		tw(puff, 1.1, {Position = puff.Position + dir * radius * .8 + Vector3.new(0, rng:NextNumber(1, 7), 0), Size = Vector3.one * .3, Transparency = 1})
	end
	sound(workspace.Stage, SFX.drum, 3, .4)
end
local function cam(s, ...) if s.player then remote:FireClient(s.player, ...) end end

local function night(root)
	active += 1
	if active &gt; 1 then return nightFx[1].Position end
	savedTime = Lighting.ClockTime
	tw(Lighting, 2.5, {ClockTime = 24})
	local pos = (root.CFrame * CFrame.new(0, 0, -240)).Position + Vector3.new(0, 125, 0)
	local moon = ball(10, pos - Vector3.new(0, 110, 0), rgb(255, 250, 220), 0)
	tw(moon, 3, {Size = Vector3.one * 85, Position = pos}, Enum.EasingStyle.Sine)
	nightFx = {moon}
	for i, size in {100, 122, 150} do
		local halo = ball(5, moon.Position, rgb(210, 225, 255), .8 + i * .05)
		tw(halo, 3, {Size = Vector3.one * size, Position = pos}, Enum.EasingStyle.Sine)
		table.insert(nightFx, halo)
	end
	local back = (root.Position - pos).Unit
	for i = 1, 9 do
		local off = (back + rng:NextUnitVector() * .6).Unit * 41
		local crater = ball(rng:NextNumber(5, 14), pos + off, rgb(215, 205, 175), 1)
		task.delay(3, tw, crater, .5, {Transparency = 0})
		table.insert(nightFx, crater)
	end
	local cc = Instance.new("ColorCorrectionEffect", Lighting)
	tw(cc, 2, {TintColor = rgb(190, 205, 255), Contrast = .2})
	table.insert(nightFx, cc)
	return pos
end
local function day()
	active = math.max(0, active - 1)
	if active &gt; 0 then return end
	for _, o in nightFx do o:Destroy() end
	nightFx = {}
	tw(Lighting, 2, {ClockTime = savedTime})
end

local function weld(s, to, size, offset, color, material, ballShape)
	local p = Instance.new("Part")
	p.Size, p.Color, p.Material, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = size, color, material or Enum.Material.SmoothPlastic, false, false, false, true
	if ballShape then p.Shape = Enum.PartType.Ball end
	p.CFrame = to.CFrame * offset
	local w = Instance.new("Weld")
	w.Part0, w.Part1, w.C0 = to, p, offset
	p.Parent, w.Parent = s.folder, p
	return w, p
end
local function paint(s, p, color) s.colors[p] = s.colors[p] or p.Color; p.Color = color end
local function outfit(c, s, torsoC, shortsC, sashC)
	for _, o in c:GetChildren() do
		if o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then
			table.insert(s.clothes, o)
			o.Parent = nil
		elseif o:IsA("BasePart") then
			local n = o.Name
			if n == "LowerTorso" then paint(s, o, sashC)
			elseif n:find("Torso") then paint(s, o, torsoC)
			elseif n:find("UpperLeg") or n:find(" Leg") then paint(s, o, shortsC) end
		elseif o:IsA("Accessory") then
			local h = o:FindFirstChild("Handle")
			if h then s.hidden[h] = s.hidden[h] or h.Transparency; h.Transparency = 1 end
		end
	end
end
local function hair(s, head, color, material, flame)
	for i = 1, 30 do
		local a, up = i * 2.4, .15 + (i % 6) * .14
		local dir = Vector3.new(math.cos(a) * (1 - up * .6), up, math.sin(a) * (1 - up * .6))
		if dir.Z &gt; -.3 or up &gt; .6 then
			weld(s, head, Vector3.one * .48, CFrame.new(dir * .68), color, material, true)
			local tip = (dir + Vector3.new(0, flame, flame * .4)).Unit
			weld(s, head, Vector3.new(.17, .7 + (i % 3) * .3 + flame * .3, .17), CFrame.lookAt(dir * .8 + tip * .35, dir * .8 + tip * 2) * R(-90, 0, 0), color, material)
		end
	end
end
local function hideFace(s, head)
	for _, d in head:GetDescendants() do
		if d:IsA("Decal") then
			if s.decals then s.decals[d] = s.decals[d] or d.Transparency end
			d.Transparency = 1
		end
	end
end
local function seg(s, to, a, b, d, color, material)
	weld(s, to, Vector3.new(d, d, (b - a).Magnitude + d * .5), CFrame.lookAt((a + b) / 2, b), color, material)
end
-- تكبير لوفي العملاق مع ضبط المفاصل
local function setScale(c, s, target, time)
	local from, steps = s.scale or 1, time and 12 or 1
	for i = 1, steps do
		local prev = s.scale or 1
		local f = from + (target - from) * i / steps
		local good = pcall(function() c:ScaleTo(f) end)
		if good then
			for _, d in s.rig do d[3] = d[3].Rotation + d[3].Position * (f / prev) end
			s.scale = f
			local root = c:FindFirstChild("HumanoidRootPart")
			if root then root.CFrame += Vector3.new(0, (f - prev) * 2.8, 0) end
		end
		if time then task.wait(time / steps) end
	end
end
-- وجه مفصل: عين بيضاء، قزحية، حاجب، فم
local function face(a, head, k, iris, brow, anger)
	local V3 = Vector3.new
	hideFace(a, head)
	for _, x in {-1, 1} do
		weld(a, head, V3(.22, .15, .03) * k, CFrame.new(V3(x * .23, .1, -.605) * k), WHITE)
		weld(a, head, V3(.09, .11, .03) * k, CFrame.new(V3(x * .21, .09, -.625) * k), iris, Enum.Material.Neon)
		seg(a, head, V3(x * .08, .24 - anger, -.63) * k, V3(x * .4, .27 + anger, -.6) * k, .055 * k, brow)
		weld(a, head, V3(.1, .22, .14) * k, CFrame.new(V3(x * .64, .02, 0) * k), head.Color)
	end
	seg(a, head, V3(0, .06, -.62) * k, V3(0, -.08, -.66) * k, .05 * k, head.Color)
	seg(a, head, V3(-.18, -.27 - anger, -.61) * k, V3(0, -.24, -.63) * k, .045 * k, rgb(80, 25, 25))
	seg(a, head, V3(0, -.24, -.63) * k, V3(.18, -.27 - anger, -.61) * k, .045 * k, rgb(80, 25, 25))
end
-- هاكي: برق أسود بحواف حمراء
local function haki(pos, radius, count)
	for i = 1, count do
		local last = pos
		local goal = pos + rng:NextUnitVector() * radius
		for j = 1, 5 do
			local n = pos:Lerp(goal, j / 5) + rng:NextUnitVector() * radius * .09
			local cf, len = CFrame.lookAt((last + n) / 2, n), (n - last).Magnitude
			local w = .12 + radius * .008
			part(Vector3.new(w, w, len), cf, rgb(8, 0, 6), 0, .16)
			part(Vector3.new(w * 2.6, w * 2.6, len), cf, rgb(235, 0, 45), .6, .16)
			last = n
		end
	end
end
local function actor(s, cf, skin, torso, legs, scale)
	local d = Instance.new("HumanoidDescription")
	d.HeadColor, d.LeftArmColor, d.RightArmColor, d.TorsoColor, d.LeftLegColor, d.RightLegColor = skin, skin, skin, torso, legs, legs
	local m = Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R15)
	if scale ~= 1 then pcall(function() m:ScaleTo(scale) end) end
	m:PivotTo(cf + Vector3.new(0, (scale - 1) * 2.8, 0))
	m.Parent = workspace
	local hum = m.Humanoid
	m.HumanoidRootPart.Anchored = true
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local a = {hum = hum, rig = {}, scarf = {}, folder = Instance.new("Folder", m)}
	for _, j in m:GetDescendants() do
		if j:IsA("Motor6D") then a.rig[j.Name] = {j, "C0", j.C0}
		elseif j:IsA("AnimationConstraint") and j.Attachment0 then a.rig[j.Name] = {j.Attachment0, "CFrame", j.Attachment0.CFrame} end
	end
	S[m] = a
	table.insert(s.cast, m)
	return m, a
end
local function cleanup(s)
	for _, d in s.dragons do d.folder:Destroy() end
	for _, m in s.cast do S[m] = nil m:Destroy() end
	for _, f in s.props do f:Destroy() end
	s.dragons, s.cast, s.props = {}, {}, {}
end

local function revert(c)
	local s = S[c]
	if not s or not s.on then return end
	s.on, s.anim, s.scarf = false, nil, {}
	for _, d in s.rig do d[1][d[2]] = d[3] end
	setScale(c, s, 1)
	for d, t in s.decals do d.Transparency = t end
	for p, color in s.colors do p.Color = color end
	for h, t in s.hidden do h.Transparency = t end
	for _, o in s.clothes do if c.Parent then o.Parent = c end end
	for _, o in s.extra do o:Destroy() end
	s.colors, s.hidden, s.clothes, s.extra = {}, {}, {}, {}
	s.folder:ClearAllChildren()
	if c.Parent and c:FindFirstChild("HumanoidRootPart") then
		c.HumanoidRootPart.Anchored = false
		boom(c.HumanoidRootPart.Position, 12)
	end
	s.hum.WalkSpeed, s.hum.JumpPower = 16, 50
	day()
end

local V = Vector3.new
-- وضعيات إضافية: ميل، لف، يمين(قدام،برا،كوع)، يسار، رجل يمين(قدام،ركبة)، يسار، ارتفاع
ANIM.despair = function(t) local j = math.sin(t * 22) * 2
	return {40 + j,0, 35,-10,40, 35,-10,40, 85,115, -5,105, -1.35} end
ANIM.slump = function(t) return {48,18, 8,8,5, 5,10,5, 90,90, 80,95, -1.9} end
ANIM.crouch = function(t) return {45 + math.sin(t * 4) * 3,0, 30,25,40, 30,25,40, 70,110, 55,100, -1.2} end
ANIM.calm = function(t) return {6 + math.sin(t * 2),0, 4,9,8, 4,9,8, 4,4, -4,4, 0} end
ANIM.walk = function(t) local w = math.sin(t * 5)
	return {8,w * 5, -22 * w,8,12, 22 * w,8,12, 28 * w,40 * math.max(0, w), -28 * w,40 * math.max(0, -w), 0} end
ANIM.kick = function() return {-25,35, -40,50,30, 55,40,50, 125,5, -25,25, .4} end
ANIM.claw = function(t) local w = math.sin(t * 16)
	return {45,w * 25, 110 + w * 45,30,35, 110 - w * 45,30,35, 65,90, -35,40, -.4} end
ANIM.jan = function(t) local j = math.sin(t * 35) * 2
	return {30 + j,-50, -45,35,115, 55,-10,80, -35,45, 50,70, -1} end
ANIM.guu = function() return {35,55, 105,0,0, -55,30,40, 70,75, -45,30, -.9} end
ANIM.run = function(t) local w = math.sin(t * 20)
	return {38,0, -75,15,20, -75,15,20, 60 * w,80 * math.max(0, w), -60 * w,80 * math.max(0, -w), math.abs(w) * .3} end
ANIM.fly = function(t) local w = math.sin(t * 15)
	return {-35,0, 100 + w * 30,60,30, 80 - w * 30,70,30, 45,50, 15,30, 0} end
ANIM.shout = function() return {18,0, -20,35,20, -20,35,20, 20,30, -25,20, -.2} end

local function spikes(a, head, color, count, len, tip)
	weld(a, head, V(1.28, .85, 1.28), CFrame.new(0, .38, .12), color, nil, true)
	for i = 1, count do
		local an, up = i * 2.4, .35 + (i / count) * .65
		local dir = V(math.cos(an) * (1 - up * .55), up, math.abs(math.sin(an)) * (1 - up * .4) - (up &gt; .8 and .25 or 0)).Unit
		local p = dir * .55
		local mid, e = p + dir * len * .6, p + dir * len + V(0, len * .3, 0)
		seg(a, head, p, mid, .3, color)
		seg(a, head, mid, e, .14, tip or color)
	end
end
local function gonChild(c, s)
	setScale(c, s, .8)
	outfit(c, s, rgb(50, 140, 60), rgb(50, 130, 55), rgb(235, 130, 30))
	local head, torso = c.Head, c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
	spikes(s, head, rgb(15, 20, 15), 22, .75, rgb(35, 90, 45))
	face(s, head, 1, rgb(150, 85, 30), rgb(15, 15, 15), 0)
	for _, x in {-1, 1} do
		seg(s, torso, V(x * .35, .8, -.55), V(x * .1, -.7, -.55), .16, rgb(245, 140, 30))
		seg(s, torso, V(x * .75, .85, -.45), V(x * .25, .95, -.55), .2, rgb(25, 80, 40))
	end
end
local function gonAdult(c, s)
	s.folder:ClearAllChildren()
	local skin = c.Head.Color
	outfit(c, s, skin, rgb(35, 90, 40), rgb(25, 60, 30))
	setScale(c, s, 1.4, 1)
	local head, torso, k = c.Head, c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso"), 1.4
	face(s, head, k, rgb(5, 5, 5), rgb(8, 8, 8), .09)
	for _, x in {-1, 1} do
		seg(s, torso, V(x * .9, .55, -.58) * k, V(x * .08, .3, -.62) * k, .12, rgb(150, 100, 80))
		for j = 0, 2 do seg(s, torso, V(x * .08, -.05 - j * .27, -.58) * k, V(x * .42, -.05 - j * .27, -.56) * k, .08, rgb(160, 110, 90)) end
		seg(s, torso, V(x * .8, .9, -.4) * k, V(x * .35, -.9, -.6) * k, .12, rgb(35, 90, 40))
	end
	-- الشعر يطول للأعلى
	spikes(s, head, rgb(8, 10, 8), 14, 1.4)
	local tips = {}
	for i = 1, 24 do
		local an = i * 2.4
		tips[i] = V(math.cos(an) * .55, .6, math.abs(math.sin(an)) * .55) * k
	end
	for j = 1, 11 do
		for i, p in tips do
			local n = p + V(p.X * .06 + math.sin(i + j * .7) * .25, 1.15 - j * .02 - (i % 3) * .15, .1 + j * .045 + math.cos(i * 2 + j) * .15)
			seg(s, head, p, n, math.max(.09, .55 - j * .042), rgb(8, 10, 8))
			tips[i] = n
		end
		haki(head.Position, 6 + j * 2, 4)
		task.wait(.12)
	end
end
local function makePitou(s, cf)
	local P, a = actor(s, cf, rgb(245, 220, 205), rgb(45, 60, 130), rgb(40, 35, 55), 1.05)
	local hair, head, torso = rgb(235, 235, 245), P.Head, P.UpperTorso
	face(a, head, 1.05, rgb(200, 10, 40), rgb(180, 180, 190), .05)
	for i = 1, 38 do
		local an, up = i * 2.4, (i % 7) / 7
		local d = V(math.cos(an) * (1 - up * .5), up * .85 - .05, math.sin(an) * (1 - up * .5))
		if d.Z &gt; -.35 or up &gt; .55 then weld(a, head, Vector3.one * .46, CFrame.new(d * .68), hair, nil, true) end
	end
	for _, x in {-1, 1} do
		seg(a, head, V(x * .4, .75, 0), V(x * .72, 1.4, 0), .38, hair)
		seg(a, head, V(x * .72, 1.4, 0), V(x * .85, 1.7, 0), .13, hair)
		seg(a, head, V(x * .46, .85, -.18), V(x * .7, 1.35, -.16), .12, rgb(240, 150, 170))
		weld(a, torso, V(.18, .18, .12), CFrame.new(x * .25, .35, -.58), rgb(230, 190, 70), Enum.Material.Metal, true)
		seg(a, torso, V(x * .55, .85, -.55), V(0, .45, -.6), .2, WHITE)
		for _, n in {"UpperArm", "LowerArm", "UpperLeg"} do
			local limb = P[(x &lt; 0 and "Left" or "Right") .. n]
			weld(a, limb, V(1.08, .08, 1.08), CFrame.new(0, -.3, 0), rgb(35, 30, 45))
		end
	end
	local p = V(0, -.7, .6)
	for i = 1, 14 do
		local n = p + V(math.sin(i * .45) * .22, -.18 + i * .035, .32)
		seg(a, P.LowerTorso, p, n, .34 - i * .012, hair)
		p = n
	end
	return P, a
end
local function makeKite(s, cf)
	local K, a = actor(s, cf, rgb(215, 200, 195), rgb(40, 45, 60), rgb(25, 30, 45), 1.1)
	local hair = rgb(205, 205, 215)
	face(a, K.Head, 1.1, rgb(90, 90, 100), rgb(160, 160, 170), -.03)
	weld(a, K.Head, V(1.45, .55, 1.45), CFrame.new(0, .65, 0), rgb(50, 60, 90))
	weld(a, K.Head, V(1.1, .14, .8), CFrame.new(0, .48, -.7), rgb(35, 40, 65))
	for i = 1, 18 do
		local x = (i - 9.5) * .09
		seg(a, K.Head, V(x, .35, .55), V(x * 2.2, -1.4, .8), .2, hair)
		seg(a, K.Head, V(x * 2.2, -1.4, .8), V(x * 2.8, -3.4 - (i % 3) * .3, 1), .13, hair)
	end
	return K, a
end
local function makeKillua(s, cf)
	local K, a = actor(s, cf, rgb(250, 225, 210), rgb(60, 65, 110), rgb(30, 30, 40), .85)
	spikes(a, K.Head, rgb(225, 230, 245), 30, .5)
	face(a, K.Head, .85, rgb(40, 110, 230), rgb(180, 185, 200), .05)
	seg(a, K.UpperTorso, V(-.45, .65, -.45), V(.45, .65, -.45), .25, rgb(240, 240, 245))
	return K, a
end
local function terpsichora(a, root)
	local dark = rgb(25, 15, 40)
	seg(a, root, V(0, 4, 2), V(0, 10, 3), 1.2, dark, Enum.Material.Neon)
	weld(a, root, V(2.4, 3, 2.2), CFrame.new(0, 12, 3), rgb(60, 25, 90), Enum.Material.ForceField, true)
	for _, x in {-1, 1} do
		weld(a, root, V(.35, .6, .2), CFrame.new(x * .5, 12.2, 1.8), rgb(255, 60, 120), Enum.Material.Neon, true)
		seg(a, root, V(x, 9, 3), V(x * 6, 11, 0), .5, dark, Enum.Material.Neon)
		seg(a, root, V(x * 6, 11, 0), V(x * 5, 6, -3), .3, dark, Enum.Material.Neon)
		for j = 1, 3 do seg(a, root, V(x * 5, 6, -3), V(x * j * .45, 1.5 - j * .6, 0), .05, rgb(220, 150, 255), Enum.Material.Neon) end
	end
end

local function transform(c, s)
	local root, hum = c.HumanoidRootPart, s.hum
	local function ok() return s.on and c.Parent and hum.Health &gt; 0 end
	local function wait(t) task.wait(t) if not ok() then error("stop", 0) end end
	local base, forest = CFrame.new(0, 4, 20), CFrame.new(0, 4, -170)
	local function at(x, y, z) return base:PointToWorldSpace(V(x, y, z)) end
	local function ft(x, y, z) return forest:PointToWorldSpace(V(x, y, z)) end
	local function shot(a, b, d, look) cam(s, "shot", a, b, d, look) end
	local function move(r, cf, t, style) tw(r, t, {CFrame = cf}, style) end
	local function say(who, text, color, t)
		local _, g = label(who, text, color or WHITE, 5.5, 20, 3.5)
		Debris:AddItem(g, t or 2)
	end
	local function path(r, dur, fn)
		local t0 = os.clock()
		repeat
			local x = math.min((os.clock() - t0) / dur, 1)
			r.CFrame = fn(x)
			wait(0)
		until x &gt;= 1
	end
	local function grade(t, props)
		local cc = Instance.new("ColorCorrectionEffect", Lighting)
		table.insert(s.extra, cc)
		tw(cc, t, props)
		return cc
	end
	root.Anchored = true
	local ff = Instance.new("ForceField", c)
	ff.Visible = false
	table.insert(s.extra, ff)
	root.CFrame = base
	gonChild(c, s)
	night(root)
	local P, pa = makePitou(s, base * CFrame.new(5, 0, -11) * R(0, 160, 0))
	local K, ka = makeKite(s, base * CFrame.new(-5, 0, -9) * R(0, 200, 0))
	local pr = P.HumanoidRootPart
	-- 1) الحقيقة: كايت ميت
	play(s, "calm") play(pa, "crouch") play(ka, "slump")
	shot(at(14, 5, 8), at(8, 3, 3), 3, at(-1, 0, -9))
	wait(1.5)
	say(pr, "كايت مات... ما أقدر أرجعه", rgb(255, 170, 190), 2.6)
	shot(at(9, 1, -5), at(8, 1, -7), 2.6, pr.Position + V(0, 1, 0))
	wait(2.7)
	shot(at(-1, 1, -6), at(-2.5, .5, -7), 2, K.Head.Position)
	wait(2)
	-- 2) انهيار قون
	local grey = grade(1, {Saturation = -1, Contrast = .25})
	play(s, "despair")
	shot(at(2, 0, -7), at(1, -.5, -4), 4, at(0, -.5, 0))
	say(root, "...كذب", WHITE, 1.2)
	for i = 1, 8 do
		for _, x in {-.2, .2} do
			local tear = ball(.18, c.Head.CFrame:PointToWorldSpace(V(x, 0, -.6)), rgb(150, 210, 255), .2, .6)
			tw(tear, .6, {Position = tear.Position - V(0, 2.2, 0)})
		end
		sound(root, SFX.drum, 1 + i * .2, .3)
		wait(.4)
	end
	say(root, "ما يهمني... هذي آخر مرة. آخذ كل قوتي", rgb(255, 90, 90), 2.6)
	for i = 1, 12 do haki(root.Position, 3 + i, 3) cam(s, "shake", i * .08) sound(root, SFX.zap, 1.5, .25) wait(.2) end
	-- 3) التحول للبالغ
	play(s, "shout", 6)
	shot(at(-12, -1, -12), at(10, 2, -17), 3.5, at(0, 6, 0))
	local pillar = part(V(3, 200, 3), CFrame.new(at(0, 95, 1.5)), rgb(10, 0, 15), .35, 5)
	tw(pillar, 1, {Size = V(13, 200, 13)})
	task.delay(2.5, tw, pillar, 2, {Transparency = 1, Size = V(1, 200, 1)})
	sound(root, SFX.wind, 4, .3)
	play(pa, "fly", 8)
	move(pr, pr.CFrame * CFrame.new(0, 0, 7), .6)
	for i = 1, 24 do
		local dir = CFrame.Angles(0, i * .7, 0).LookVector
		local rock = part(Vector3.one * rng:NextNumber(.5, 2), CFrame.new(at(0, -3, 0) + dir * rng:NextNumber(3, 13)), rgb(110, 100, 95), 0, 3, Enum.Material.Slate)
		tw(rock, 3, {CFrame = rock.CFrame * CFrame.new(0, rng:NextNumber(5, 14), 0) * R(i * 30, i * 50, 0), Transparency = 1}, Enum.EasingStyle.Sine)
	end
	gonAdult(c, s)
	move(root, base + V(0, 1.1, 0), .2)
	boom(root.Position, 28)
	wait(1.5)
	shot(at(2, 4, -9), at(1, 3.5, -6), 2, at(0, 3.5, 0))
	play(s, "calm", 6)
	wait(2)
	-- 4) تربسيكورا والهجوم ثم الركلة
	say(pr, "دكتور بلايث... تربسيكورا!", rgb(230, 130, 255), 1.8)
	terpsichora(pa, pr)
	play(pa, "crouch")
	shot(at(18, 5, -2), at(14, 8, 3), 1.6, pr.Position + V(0, 5, 0))
	wait(1.7)
	shot(at(15, 3, 2), at(13, 2, -2), 1, at(0, 1, -3))
	play(pa, "claw", 30)
	move(pr, base * CFrame.new(0, 1, -4) * R(0, 180, 0), .35, Enum.EasingStyle.Quart)
	wait(.28)
	play(s, "kick", 40)
	wait(.15)
	boom(pr.Position, 15)
	cam(s, "shake", 3)
	play(pa, "fly", 25)
	path(pr, .8, function(x) return base * CFrame.new(0, 1 + x * 5, -4 - x * 36) * R(x * 540, 180, 0) end)
	boom(pr.Position, 12)
	grey:Destroy()
	-- 5) يمشي للخارج ويبعد القتال عن كايت
	say(root, "مو هنا. ما أبي أخرب مكان كايت", WHITE, 2.4)
	play(s, "walk")
	shot(at(7, 3, -34), at(5, 2, -28), 2.8, at(0, 2, -12))
	path(root, 2.8, function(x) return base * CFrame.new(0, 1.1, -x * 30) end)
	move(pr, base * CFrame.new(0, 1, -42) * R(0, 180, 0), .3)
	play(s, "kick", 40)
	move(root, base * CFrame.new(0, 2, -38), .25)
	wait(.25)
	boom(pr.Position, 20)
	cam(s, "shake", 3)
	shot(V(60, 40, -50), V(55, 30, -130), 2, V(0, 20, -100))
	play(pa, "fly", 25)
	path(pr, 1.8, function(x) return CFrame.new(V(0, 5, -22):Lerp(ft(0, 0, -16), x) + V(0, math.sin(x * math.pi) * 55, 0)) * R(x * 720, 180, 0) end)
	boom(ft(0, 0, -16), 24)
	-- 6) الغابة: وقفة جاجنكن
	play(s, "run", 30)
	path(root, .9, function(x) return CFrame.new(V(0, 5, -18):Lerp(ft(0, 1.1, 8), x) + V(0, math.sin(x * math.pi) * 22, 0)) end)
	boom(root.Position - V(0, 1, 0), 14)
	play(pa, "claw", 12)
	move(pr, CFrame.new(ft(0, 22, -22)) * R(0, 180, 0), .8)
	play(s, "jan", 12)
	shot(ft(-11, 0, -2), ft(-8, 3, 15), 3.6, ft(0, 3, 4))
	local hand = c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")
	for _, word in {"سايشو وا قو...", "جان...", "كن..."} do
		say(root, word, rgb(255, 210, 80), 1.1)
		for i = 1, 6 do
			local orb = ball(1 + i * .45, hand.Position, rgb(255, 170, 30), .25, .2)
			haki(orb.Position, 3 + i, 3)
			sound(root, SFX.zap, 1.5, .5 + i * .08)
			cam(s, "shake", .5)
			wait(.17)
		end
	end
	say(root, "قوووو!!!", rgb(255, 130, 20), 1.4)
	shot(ft(20, 7, 4), ft(24, 9, -6), 1.6, ft(0, 3, -8))
	play(s, "guu", 45)
	move(pr, forest * CFrame.new(0, 3, -4) * R(0, 180, 0), .22, Enum.EasingStyle.Quart)
	wait(.2)
	boom(ft(0, 1, -5), 55)
	haki(ft(0, 2, -6), 45, 24)
	cam(s, "shake", 4)
	play(pa, "slump", 20)
	move(pr, forest * CFrame.new(0, -1, -12) * R(85, 180, 0), .3)
	wait(1.4)
	-- 7) ضربات متتالية، وكيلوا يجري بالغابة
	local U, ua = makeKillua(s, forest * CFrame.new(55, 0, 45))
	local ur = U.HumanoidRootPart
	move(root, forest * CFrame.new(0, 1.1, -7), .3)
	play(ua, "run", 30)
	shot(ft(52, 6, 58), ft(34, 4, 38), 2.4, ft(30, 2, 24))
	for i = 1, 12 do
		play(s, i % 2 == 0 and "jan" or "guu", 40)
		if i % 2 == 1 then boom(ft(0, -1, -12), 10 + i) cam(s, "shake", 1.2) end
		move(ur, CFrame.lookAt(ft(55, 0, 45):Lerp(ft(13, 0, 10), i / 12), ft(0, 0, -7)), .2, Enum.EasingStyle.Linear)
		haki(ur.Position, 5, 2)
		wait(.2)
	end
	play(ua, "calm")
	play(s, "calm", 5)
	shot(ft(8, 3, -2), ft(6, 2, -17), 2.6, ft(0, 2, -8))
	say(root, "خلصت يا كايت", WHITE, 2)
	wait(2.6)
	-- 8) تربسيكورا بعد الموت: أبيض وأسود
	local bw = grade(.2, {Saturation = -1, Contrast = .6})
	terpsichora(pa, pr)
	say(root, "!!", rgb(255, 60, 60), .8)
	shot(ft(-15, 4, -10), ft(-12, 3, -3), 1.8, ft(0, 2, -9))
	play(pa, "claw", 25)
	path(pr, .8, function(x) return forest * CFrame.new(0, -1 + math.sin(x * math.pi) * 9, -14 + x * 7) * R(85 - x * 85, 180, 0) end)
	say(ur, "قون!!", rgb(120, 180, 255), 1.2)
	play(ua, "run", 40)
	move(ur, CFrame.lookAt(ft(3, 0, -5), ft(-6, 0, -5)), .15)
	move(root, forest * CFrame.new(-4, 1.1, -4), .15)
	for _, p in c:GetChildren() do
		if p:IsA("BasePart") and (p.Name == "RightUpperArm" or p.Name == "RightLowerArm" or p.Name == "RightHand" or p.Name == "Right Arm") then
			s.hidden[p] = s.hidden[p] or p.Transparency
			p.Transparency = 1
		end
	end
	local flash = grade(.05, {Brightness = 1})
	tw(flash, .6, {Brightness = 0})
	cam(s, "shake", 3)
	wait(1.2)
	say(root, "ما يعورني... صرت مثل كايت", WHITE, 2.2)
	shot(ft(-9, 3, -13), ft(-7, 2, -11), 2.2, root.Position + V(0, 2, 0))
	wait(2.3)
	-- 9) الجاجنكن الأخير
	bw:Destroy()
	move(root, forest * CFrame.new(0, 1.1, -5), .25)
	move(ur, CFrame.lookAt(ft(18, 0, 12), ft(0, 0, -9)), .4)
	move(pr, forest * CFrame.new(0, -1, -10) * R(80, 180, 0), .25)
	play(pa, "slump")
	play(s, "jan", 15)
	shot(ft(-20, 6, 8), ft(-34, 18, 28), 4, ft(0, 8, -6))
	local sun = ball(1, ft(-1, 3, -8), rgb(255, 215, 120), .15)
	table.insert(s.props, sun)
	for i = 1, 16 do
		tw(sun, .18, {Size = Vector3.one * (1 + i * .8)})
		haki(sun.Position, 8 + i * 3, 6)
		ring(ft(0, -3, -8), 10 + i * 4, i % 2 == 0 and rgb(10, 0, 10) or rgb(255, 180, 40))
		sound(root, SFX.zap, 2, .3 + i * .05)
		cam(s, "shake", .2 + i * .12)
		wait(.18)
		if i == 8 then say(ur, "قوووون! وقّف!", rgb(120, 180, 255), 1.5) end
	end
	-- انفجار الغابة
	play(s, "guu", 35)
	shot(V(90, 70, -80), V(130, 100, -40), 3, ft(0, 10, -8))
	wait(.25)
	local white = grade(.15, {Brightness = 1})
	tw(sun, 1.6, {Size = Vector3.one * 190, Transparency = 1})
	for i = 1, 4 do boom(ft(0, 2, -8), 30 + i * 22) cam(s, "shake", 4) wait(.15) end
	for _, p in workspace:GetChildren() do
		local off = p.Name == "Tree" and p.Position - ft(0, 0, -8)
		if off and off.Magnitude &lt; 85 then
			table.insert(s.trees, {p, p.CFrame})
			tw(p, 1.5, {CFrame = p.CFrame + off.Unit * 60 + V(0, 20, 0), Transparency = 1})
		end
	end
	local crater = part(V(.4, 90, 90), CFrame.new(ft(0, -3.8, -8)) * R(0, 0, 90), rgb(45, 35, 30), 0, nil, Enum.Material.Slate)
	crater.Shape = Enum.PartType.Cylinder
	table.insert(s.props, crater)
	wait(.8)
	tw(white, 2.5, {Brightness = 0, Saturation = -.5})
	-- 10) بعد الانفجار
	for _, p in c:GetChildren() do
		if p:IsA("BasePart") and p.Transparency &lt; 1 then paint(s, p, p.Color) tw(p, 2.5, {Color = rgb(105, 95, 90)}) end
	end
	play(s, "slump", 3)
	play(ua, "despair", 4)
	move(ur, CFrame.lookAt(ft(5, 0, -3), ft(0, 0, -5)), 1.5)
	shot(ft(12, 5, 10), ft(7, 2, 2), 4, ft(1, -1, -4))
	wait(4.5)
end

local function toggle(player)
	local c = player.Character
	local s = c and S[c]
	if not s or s.busy or s.hum.Health &lt;= 0 then return end
	s.busy = true
	player:SetAttribute("Busy", true)
	if s.on then
		revert(c)
		task.wait(1)
	else
		s.on = true
		local home = c.HumanoidRootPart.CFrame
		local good, err = pcall(transform, c, s)
		cam(s, "end")
		if not good and err ~= "stop" then warn("[HxH] " .. tostring(err)) end
		cleanup(s)
		for _, t in s.trees do t[1].CFrame, t[1].Transparency = t[2], 0 end
		s.trees = {}
		revert(c)
		if c.Parent and c:FindFirstChild("HumanoidRootPart") then c.HumanoidRootPart.CFrame = home end
	end
	s.busy = false
	player:SetAttribute("Busy", false)
	player:SetAttribute("On", s.on)
end

local function setup(player)
	local function spawned(c)
		local hum = c:WaitForChild("Humanoid")
		c:WaitForChild("HumanoidRootPart")
		task.wait(.5)
		local s = {player = player, hum = hum, rig = {}, scarf = {}, dragons = {}, cast = {}, props = {}, trees = {}, colors = {}, decals = {}, hidden = {}, clothes = {}, extra = {}}
		for _, j in c:GetDescendants() do
			if j:IsA("Motor6D") then s.rig[j.Name] = {j, "C0", j.C0}
			elseif j:IsA("AnimationConstraint") and j.Attachment0 then s.rig[j.Name] = {j.Attachment0, "CFrame", j.Attachment0.CFrame} end
		end
		s.folder = Instance.new("Folder", c)
		hum.UseJumpPower = true
		S[c] = s
		player:SetAttribute("On", false)
		player:SetAttribute("Busy", false)
		hum.Died:Connect(function() revert(c) S[c] = nil end)
		-- أداة احتياطية إذا زر الشاشة ما اشتغل
		task.wait(4)
		if not player:GetAttribute("Ready") and c.Parent then
			local t = Instance.new("Tool")
			t.Name, t.RequiresHandle = "GON", false
			t.Activated:Connect(function() toggle(player) end)
			t.Parent = player.Backpack
		end
	end
	player.CharacterAdded:Connect(spawned)
	player.CharacterRemoving:Connect(function(c) revert(c) S[c] = nil end)
	if player.Character then task.spawn(spawned, player.Character) end
end
Players.PlayerAdded:Connect(setup)
for _, p in Players:GetPlayers() do task.spawn(setup, p) end
remote.OnServerEvent:Connect(function(p, what)
	if what == "ready" then p:SetAttribute("Ready", true)
	elseif what == "toggle" then toggle(p) end
end)
print("[HxH] ready")
</ProtectedString></Properties></Item>
</Item>
</roblox>
