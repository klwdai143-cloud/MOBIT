---------------------------------------------------------------- المؤثرات
local function fxPart(props)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	for k, v in pairs(props) do p[k] = v end
	p.Parent = fxFolder
	return p
end
local function burst(pos, color, n, size)
	local p = fxPart({Transparency = 1, Size = Vector3.one, Position = pos})
	local e = V.emitter(p, color, 0, size or 1.5, 1.2, 28)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Drag = 3
	e:Emit(n or 40)
	Debris:AddItem(p, 2)
end
local function shockwave(pos, color, radius)
	local p = fxPart({Shape = Enum.PartType.Ball, Color = color, Position = pos, Size = Vector3.one, Transparency = 0.25, Material = Enum.Material.ForceField})
	tween(p, 0.7, {Size = Vector3.one * radius, Transparency = 1})
	Debris:AddItem(p, 0.8)
end
local shakePower = 0
local function shake(p) shakePower = math.max(shakePower, p) end
RunService:BindToRenderStep("Shake", Enum.RenderPriority.Camera.Value + 2, function(dt)
	if shakePower > 0.02 then
		camera.CFrame = camera.CFrame * CFrame.new((math.random() - 0.5) * shakePower, (math.random() - 0.5) * shakePower, 0)
		shakePower = shakePower * math.max(0, 1 - dt * 5)
	end
end)

---------------------------------------------------------------- رسم التنانين والبيض
local vis, hidden, forced = {}, {}, {}
local function board(a)
	local b = new("BillboardGui", {Adornee = a, Size = UDim2.fromScale(9, 3), MaxDistance = 90, LightInfluence = 0, Parent = pg})
	local t = label({Size = UDim2.fromScale(1, 0.55), Parent = b})
	local s = label({Size = UDim2.fromScale(1, 0.42), Position = UDim2.fromScale(0, 0.56), Parent = b})
	return b, t, s
end
local function makeVisual(a)
	local el, sc = a:GetAttribute("Element"), a:GetAttribute("Scale")
	if not el or not sc then return nil end
	local rig
	if a.Name == "Egg" then rig = V.newEgg(el, sc, a:GetAttribute("King"))
	else rig = V.newDragon(el, sc, a:GetAttribute("Mut")) end
	rig.model.Parent = fxFolder
	local o = {rig = rig, cf = a.CFrame}
	if not a:GetAttribute("Carried") and not a:GetAttribute("Mount") then
		o.board, o.t, o.s = board(a)
		if a:GetAttribute("Guard") then o.board.MaxDistance, o.board.Size = 220, UDim2.fromScale(16, 4.5) end
	end
	return o
end
local function boardText(a, o)
	local E = C.ELEMENTS[a:GetAttribute("Element")]
	local s = a:GetAttribute("Scale")
	local guard = a:GetAttribute("Guard")
	if guard then
		local st = a:GetAttribute("State")
		o.t.Text = (st == "sleep" and "💤 " or "❗ ") .. "حارس " .. C.ZONES[guard].name
		o.s.Text = "السرعة المطلوبة: " .. C.ZONES[guard].req
		o.t.TextColor3 = E.fx
		o.board.StudsOffsetWorldSpace = Vector3.new(0, 14 * s, 0)
	elseif a.Name == "Egg" then
		local st = a:GetAttribute("State")
		o.t.TextColor3 = E.fx
		o.t.Text = a:GetAttribute("King") and "👑 بيضة الملك" or ("🥚 " .. E.name)
		if st == "incubating" then
			local left = math.ceil((a:GetAttribute("ReadyAt") or 0) - now())
			o.s.Text = left > 0 and ("⏳ " .. left .. " ث") or "✅ جاهزة للفقس!"
		else
			o.s.Text = "خذها واهرب!"
		end
		o.board.StudsOffsetWorldSpace = Vector3.new(0, 6.5 * s, 0)
	else
		local r = a:GetAttribute("Rarity")
		if not r then return end
		local rar = C.RARITY[r]
		o.t.Text = rar.name .. " " .. C.MUT[a:GetAttribute("Mut")].name
		o.t.TextColor3 = rar.color
		o.s.Text = "$" .. C.fmt(a:GetAttribute("Income")) .. "/ث"
		o.s.TextColor3 = Color3.fromRGB(110, 255, 140)
		o.board.StudsOffsetWorldSpace = Vector3.new(0, 13 * s, 0)
		o.board.Size = UDim2.fromScale(7, 2.2)
		o.board.MaxDistance = 55
	end
end
local function promptText(a)
	local owner = a:GetAttribute("OwnerId")
	local pr = owner and a:FindFirstChildOfClass("ProximityPrompt")
	if not pr then return end
	if owner == me.UserId then
		if a.Name == "Egg" then
			pr.ActionText = now() >= (a:GetAttribute("ReadyAt") or 0) and "افقس 🐣" or "تحضين..."
			pr.HoldDuration = 0.3
		else
			pr.ActionText = "بيع $" .. C.fmt((a:GetAttribute("Income") or 0) * 60)
			pr.HoldDuration = 1.5
		end
	else
		pr.ActionText, pr.HoldDuration = "اسرق! 🥷", 2
	end
end
local function removeVisual(a)
	local o = vis[a]
	if not o then return end
	o.rig:destroy()
	if o.board then o.board:Destroy() end
	vis[a], hidden[a], forced[a] = nil, nil, nil
end
actors.ChildRemoved:Connect(removeVisual)

local textClock = 0
RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	textClock = textClock + dt
	local refresh = textClock > 0.2
	if refresh then textClock = 0 end
	local camPos = camera.CFrame.Position
	for _, a in ipairs(actors:GetChildren()) do
		local o = vis[a]
		if not o then
			o = makeVisual(a)
			if o then vis[a] = o boardText(a, o) if not o.board then o.noBoard = true end end
		end
		if o then
			if refresh then
				if o.board then boardText(a, o) end
				promptText(a)
			end
			if a:GetAttribute("Guard") then o.cf = o.cf:Lerp(a.CFrame, math.min(1, dt * 14)) else o.cf = a.CFrame end
			local far = (o.cf.Position - camPos).Magnitude > 420
			local show = not hidden[a] and not far
			o.rig.model.Parent = show and fxFolder or nil
			if show then
				local state = forced[a] or a:GetAttribute("State")
				if a.Name == "Egg" then
					if state == "incubating" and now() >= (a:GetAttribute("ReadyAt") or 0) then state = "ready" end
					V.animateEgg(o.rig, o.cf, state, t, 0)
				else
					V.animateDragon(o.rig, o.cf, state, t)
					if state ~= o.last then
						if state == "wake" and (o.cf.Position - camPos).Magnitude < 200 then
							sound("roar")
							shockwave(o.cf.Position + Vector3.new(0, 8, 0), C.ELEMENTS[a:GetAttribute("Element")].fx, 55)
							shake(1.2)
						end
						o.last = state
					end
					if state == "chase" and t > (o.step or 0) then
						o.step = t + 0.3
						burst(o.cf.Position + Vector3.new(0, 0.5, 0), C.ZONES[a:GetAttribute("Guard") or 1].haze, 8, 2.5)
						if (o.cf.Position - camPos).Magnitude < 60 then shake(0.25) end
					end
				end
			end
		end
	end
end)

---------------------------------------------------------------- الكاتسينات
local barT = new("Frame", {Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 8, Parent = cineGui})
local barB = new("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 8, Parent = cineGui})
local busy, skipped = false, false
local skipB = button({AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -14), Size = UDim2.fromOffset(120, 40), Text = "تخطي ⏭", BackgroundColor3 = Color3.fromRGB(90, 80, 130), Visible = false, ZIndex = 15, Parent = cineGui}, function() skipped = true end)

local function shot(a, b, dur)
	local e = 0
	while e < dur and not skipped do
		local k = TweenService:GetValue(e / dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = a:Lerp(b, k)
		e = e + RunService.RenderStepped:Wait()
	end
end
local function cinematic(fn)
	if busy then return false end
	busy, skipped = true, false
	closePanel()
	gui.Enabled = false
	skipB.Visible = true
	tween(barT, 0.4, {Size = UDim2.fromScale(1, 0.11)})
	tween(barB, 0.4, {Size = UDim2.fromScale(1, 0.11)})
	local ok, err = pcall(fn)
	if not ok then warn(err) end
	tween(barT, 0.3, {Size = UDim2.fromScale(1, 0)})
	tween(barB, 0.3, {Size = UDim2.fromScale(1, 0)})
	camera.CameraType = Enum.CameraType.Custom
	local h = me.Character and me.Character:FindFirstChildOfClass("Humanoid")
	if h then camera.CameraSubject = h end
	skipB.Visible, gui.Enabled, busy = false, true, false
	return true
end
local function look(x, y, z, tx, ty, tz) return CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(tx, ty, tz)) end

local function intro()
	cinematic(function()
		showBanner("🐉 سرقة بيض التنانين 🥚", C.RARITY[4].color)
		shot(look(110, 100, -320, 0, 0, -90), look(35, 55, -235, 0, 0, -60), 3.2)
		for z, info in ipairs(C.ZONES) do
			if not skipped then
				local s = z % 2 == 0 and -1 or 1
				flash(info.color, 0.6)
				showBanner(info.name, info.color)
				local g = info.z0 + 184
				shot(look(65 * s, 42, info.z0 + 15, 0, 6, g - 40), look(18 * s, 17, g - 48, 0, 9, g), 2.6)
			end
		end
		if not skipped then showBanner("اسرق... فقّس... وسيطر! 👑") end
	end)
end

local seenWake = {}
local function wake(data)
	local a = data.actor
	showBanner("⚠️ استيقظ الحارس! اهرب!", Color3.fromRGB(255, 80, 60))
	if seenWake[data.zone] or not a then return end
	seenWake[data.zone] = true
	cinematic(function()
		local p, f = a.Position, a.CFrame.LookVector
		local r = a.CFrame.RightVector
		local target = p + Vector3.new(0, 10, 0)
		shake(0.8)
		shot(CFrame.lookAt(p + f * 42 + r * 20 + Vector3.new(0, 6, 0), target), CFrame.lookAt(p + f * 24 + r * 7 + Vector3.new(0, 13, 0), target), 2.1)
	end)
end

local function resultCard(d)
	local rar = C.RARITY[d.rar]
	local f = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.72), Size = UDim2.fromScale(0, 0), BackgroundColor3 = DARK, ZIndex = 12, Parent = cineGui}, {corner(18), stroke(rar.color, 4)})
	label({Size = UDim2.fromScale(0.94, 0.42), Position = UDim2.fromScale(0.03, 0.05), Text = "✨ " .. rar.name .. " " .. C.MUT[d.mut].name .. " ✨", TextColor3 = rar.color, ZIndex = 13, Parent = f})
	label({Size = UDim2.fromScale(0.94, 0.25), Position = UDim2.fromScale(0.03, 0.48), Text = C.ELEMENTS[d.element].name, ZIndex = 13, Parent = f})
	label({Size = UDim2.fromScale(0.94, 0.2), Position = UDim2.fromScale(0.03, 0.75), Text = "$" .. C.fmt(d.income) .. " بالثانية", TextColor3 = Color3.fromRGB(110, 255, 140), ZIndex = 13, Parent = f})
	tween(f, 0.5, {Size = UDim2.fromScale(0.5, 0.24)}, Enum.EasingStyle.Back)
	task.delay(3.5, function() tween(f, 0.3, {Size = UDim2.fromScale(0, 0)}) task.wait(0.35) f:Destroy() end)
end

local function hatchScene(d)
	local a = d.actor
	local rar, E = C.RARITY[d.rar], C.ELEMENTS[d.element]
	if a then hidden[a] = true end
	local egg
	local function reveal()
		if egg then egg:destroy() egg = nil end
		if a then hidden[a] = nil forced[a] = "wake" task.delay(2.5, function() forced[a] = nil end) end
	end
	local played = cinematic(function()
		local p = d.cf.Position + Vector3.new(0, 2, 0)
		local f = d.cf.LookVector
		local r = d.cf.RightVector
		egg = V.newEgg(d.element, 0.75, d.element == "King")
		egg.model.Parent = fxFolder
		local c1 = CFrame.lookAt(p + f * 15 + r * 8 + Vector3.new(0, 7, 0), p)
		local c2 = CFrame.lookAt(p + f * 8 - r * 2 + Vector3.new(0, 3, 0), p)
		local e, nextCrack = 0, 0.5
		while e < 2.8 and not skipped do
			local dt = RunService.RenderStepped:Wait()
			e = e + dt
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = c1:Lerp(c2, math.min(1, e / 2.8))
			V.animateEgg(egg, d.cf, "shake", os.clock(), (e / 2.8) ^ 2)
			if e > nextCrack then
				nextCrack = nextCrack + 0.42
				sound("crack")
				shake(0.2)
				burst(p, rar.color, 14, 0.7)
				local base = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5).Unit
				local pos = p + base * 1.4
				for _ = 1, 3 do
					local nextPos = pos + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 1.2
					nextPos = p + (nextPos - p).Unit * 1.45
					local seg = fxPart({Color = WHITE, Size = Vector3.new(0.09, 0.09, (nextPos - pos).Magnitude), CFrame = CFrame.lookAt((pos + nextPos) / 2, nextPos)})
					Debris:AddItem(seg, math.max(0.1, 2.8 - e))
					pos = nextPos
				end
			end
		end
		flash(rar.color, 1)
		sound("boom")
		reveal()
		shake(1.3)
		burst(p, rar.color, 120, 2)
		shockwave(p, rar.color, 35)
		for _ = 1, 18 do
			local s = fxPart({Color = E.body, Material = Enum.Material.SmoothPlastic, Size = Vector3.new(0.8, 0.2, 0.7), Position = p})
			s.Anchored = false
			s.AssemblyLinearVelocity = Vector3.new(math.random(-25, 25), math.random(18, 45), math.random(-25, 25))
			s.AssemblyAngularVelocity = Vector3.new(math.random(-9, 9), math.random(-9, 9), 0)
			Debris:AddItem(s, 1.6)
		end
		resultCard(d)
		shot(c2, CFrame.lookAt(p + f * 14 + r * -6 + Vector3.new(0, 5, 0), p), 2.6)
	end)
	reveal()
	if not played then resultCard(d) end
end

local function kingScene(d)
	local pos = d.pos
	showBanner("👑 بيضة الملك تنزل من السماء!", C.RARITY[4].color)
	local gold = C.ELEMENTS.King.fx
	local meteor = fxPart({Shape = Enum.PartType.Ball, Size = Vector3.one * 8, Color = gold, Position = pos + Vector3.new(60, 220, -40)})
	local e = V.emitter(meteor, gold, 90, 7, 1.4, 4, "rbxasset://textures/particles/fire_main.dds")
	e.SpreadAngle = Vector2.new(180, 180)
	tween(meteor, 4.4, {Position = pos + Vector3.new(0, 4, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(4.45, function()
		meteor:Destroy()
		sound("boom")
		shockwave(pos, gold, 110)
		burst(pos + Vector3.new(0, 3, 0), gold, 150, 4)
		if (camera.CFrame.Position - pos).Magnitude < 250 then shake(2) flash(gold, 0.6) end
	end)
	if not A("carrying") then
		cinematic(function()
			local c = pos + Vector3.new(45, 22, -60)
			while meteor.Parent and not skipped do
				camera.CameraType = Enum.CameraType.Scriptable
				camera.CFrame = CFrame.lookAt(c, meteor.Position)
				RunService.RenderStepped:Wait()
			end
			shot(CFrame.lookAt(c, pos), CFrame.lookAt(pos + Vector3.new(16, 10, -22), pos + Vector3.new(0, 4, 0)), 1.5)
		end)
	end
end

---------------------------------------------------------------- أحداث السيرفر
Fx.OnClientEvent:Connect(function(kind, d)
	if kind == "toast" then toast(d.text, d.color)
	elseif kind == "sound" then sound(d.id)
	elseif kind == "wake" then wake(d)
	elseif kind == "hatch" then task.wait(0.15) hatchScene(d)
	elseif kind == "king" then kingScene(d)
	elseif kind == "alarm" then sound("roar") flash(Color3.fromRGB(255, 40, 40), 1) showBanner("🚨 في حرامي بقاعدتك!", Color3.fromRGB(255, 70, 70))
	elseif kind == "delivered" then sound("buy") burst(d.cf.Position + Vector3.new(0, 3, 0), GREEN, 60) showBanner("✅ وصلت بأمان!", GREEN)
	elseif kind == "hit" then sound("hit") burst(d.pos, Color3.fromRGB(255, 220, 80), 30) shockwave(d.pos, WHITE, 12)
	elseif kind == "breath" then
		local o = d.actor and vis[d.actor]
		if o then o.rig.breathUntil = os.clock() + 1.2 end
	elseif kind == "rebirth" then
		flash(C.RARITY[4].color, 1.5)
		showBanner("✨ ولادة جديدة! ✨", C.RARITY[4].color)
		local r = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
		if r then burst(r.Position, C.RARITY[4].color, 150, 2) shockwave(r.Position, C.RARITY[4].color, 40) end
	elseif kind == "knock" then
		local ch = me.Character
		local r = ch and ch:FindFirstChild("HumanoidRootPart")
		local h = ch and ch:FindFirstChildOfClass("Humanoid")
		if r and h then
			h:ChangeState(Enum.HumanoidStateType.FallingDown)
			r.AssemblyLinearVelocity = d.velocity
			shake(1.2) sound("hit")
			task.delay(1, function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		end
	end
end)

---------------------------------------------------------------- الأجواء
local function effect(class, props)
	props.Parent = Lighting
	return new(class, props)
end
local atmos = effect("Atmosphere", {Density = 0.27, Offset = 0.2, Haze = 1.2, Glare = 0.2, Color = Color3.fromRGB(200, 215, 235), Decay = Color3.fromRGB(120, 130, 170)})
effect("BloomEffect", {Intensity = 0.45, Size = 24, Threshold = 1.6})
effect("SunRaysEffect", {Intensity = 0.07, Spread = 0.7})
local grade = effect("ColorCorrectionEffect", {Saturation = 0.18, Contrast = 0.08})
local sky = fxPart({Name = "Weather", Transparency = 1, Size = Vector3.new(90, 1, 90)})
local weather = V.emitter(sky, WHITE, 0, 0.5, 6, 8)
weather.LightEmission = 0.4
local zoneNow = -1
local function setZone(z)
	zoneNow = z
	local info = C.ZONES[z]
	tween(grade, 1.5, {TintColor = info and info.tint or WHITE})
	tween(atmos, 1.5, {Color = info and info.haze or Color3.fromRGB(200, 215, 235), Density = z == 3 and 0.36 or 0.27})
	if info then
		showBanner(info.name .. "  •  سرعة " .. info.req, info.color)
		weather.Color = ColorSequence.new(z == 2 and WHITE or info.color)
		weather.Rate = ({25, 90, 55, 35})[z]
		weather.Size = NumberSequence.new(z == 1 and 0.6 or 0.4)
		weather.EmissionDirection = z == 3 and Enum.NormalId.Top or Enum.NormalId.Bottom
	else
		weather.Rate = 0
	end
end

for z, info in ipairs(C.ZONES) do
	local g = map:WaitForChild("Gates"):WaitForChild("Gate" .. z)
	local b = new("BillboardGui", {Adornee = g, Size = UDim2.fromScale(34, 9), MaxDistance = 320, LightInfluence = 0, Parent = pg})
	label({Size = UDim2.fromScale(1, 0.62), Text = info.name, TextColor3 = info.color, Parent = b})
	label({Size = UDim2.fromScale(1, 0.36), Position = UDim2.fromScale(0, 0.64), Text = "⚡ السرعة المطلوبة " .. info.req, Parent = b})
end
local floats = {}
for _, p in ipairs(map:WaitForChild("Float"):GetChildren()) do table.insert(floats, {p, p.CFrame, math.random() * 6}) end

---------------------------------------------------------------- الطيران والتدريب والسهم
local controls
task.spawn(function()
	local m = me:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10)
	if m then controls = require(m):GetControls() end
end)
local fly, runTrack
local function stopFly()
	if not fly then return end
	fly.lv:Destroy() fly.ao:Destroy() fly.att:Destroy()
	if fly.h.Parent then fly.h.PlatformStand = false end
	fly = nil
	flyUI.Visible = false
end
local function startFly(r, h)
	r.CFrame = r.CFrame + Vector3.new(0, 9, 0)
	local att = new("Attachment", {Parent = r})
	local lv = new("LinearVelocity", {Attachment0 = att, MaxForce = 1e7, RelativeTo = Enum.ActuatorRelativeTo.World, VectorVelocity = Vector3.zero, Parent = r})
	local ao = new("AlignOrientation", {Attachment0 = att, Mode = Enum.OrientationAlignmentMode.OneAttachment, MaxTorque = 1e7, Responsiveness = 18, CFrame = r.CFrame.Rotation, Parent = r})
	h.PlatformStand = true
	fly = {att = att, lv = lv, ao = ao, h = h, r = r}
	flyUI.Visible = true
end

local guideEnd = fxPart({Transparency = 1, Size = Vector3.one})
local endAtt = new("Attachment", {Parent = guideEnd})
local beam = new("Beam", {Attachment1 = endAtt, Width0 = 0.7, Width1 = 2.5, FaceCamera = true, LightEmission = 1, Color = ColorSequence.new(Color3.fromRGB(90, 255, 130)), Transparency = NumberSequence.new(0.2, 0.5), Enabled = false, Parent = guideEnd})
local startAtt

local slow = 0
RunService.Heartbeat:Connect(function(dt)
	local t = os.clock()
	local ch = me.Character
	local r = ch and ch:FindFirstChild("HumanoidRootPart")
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	for _, f in ipairs(floats) do
		f[1].CFrame = (f[2] + Vector3.new(0, math.sin(t + f[3]) * 1.5, 0)) * CFrame.Angles(0, t * 0.3 + f[3], 0)
	end
	local cp = camera.CFrame.Position
	sky.Position = cp + Vector3.new(0, zoneNow == 3 and -14 or 28, 0)

	if A("mounted") and r and h and h.Health > 0 then
		if not fly or fly.r ~= r then stopFly() startFly(r, h) end
		local mv = controls and controls:GetMoveVector() or Vector3.zero
		local cf = camera.CFrame
		local speed = math.clamp(A("speed", 40) * 1.2, 45, 110)
		local vel = (cf.RightVector * mv.X + cf.LookVector * -mv.Z) * speed
		local vertical = 0
		if upDown.up or UIS:IsKeyDown(Enum.KeyCode.Space) then vertical = 35 end
		if upDown.down or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then vertical = -35 end
		local vy = vel.Y + vertical
		if r.Position.Y > 130 then vy = math.min(vy, -5) end
		if r.Position.Y < 9 then vy = math.max(vy, 8) end
		fly.lv.VectorVelocity = Vector3.new(vel.X, vy, vel.Z)
		local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		if flat.Magnitude > 0.1 then fly.ao.CFrame = CFrame.lookAt(Vector3.zero, flat) end
	else
		stopFly()
	end

	if A("training") and h and h.MoveDirection.Magnitude < 0.1 then
		if not runTrack then
			local an = ch:FindFirstChild("Animate")
			local run = an and an:FindFirstChild("run")
			local anim = run and run:FindFirstChildOfClass("Animation")
			local animator = h:FindFirstChildOfClass("Animator")
			if anim and animator then
				runTrack = animator:LoadAnimation(anim)
				runTrack.Priority = Enum.AnimationPriority.Action
				runTrack:Play()
			end
		end
	elseif runTrack then
		runTrack:Stop()
		runTrack = nil
	end

	local carrying = A("carrying")
	local plot = A("plot")
	if carrying and r and plot then
		if not startAtt or startAtt.Parent ~= r then startAtt = new("Attachment", {Parent = r}) end
		guideEnd.Position = C.plotPoint(plot, 0, 0, 2)
		beam.Attachment0, beam.Enabled = startAtt, true
		chase.Visible = true
		if carrying == "nest" and r.Position.Z > C.SAFE_Z then
			local zone = A("carryZone", 1)
			local from = C.nestPos(zone, 2).Z
			local k = math.clamp((from - r.Position.Z) / (from - C.SAFE_Z), 0, 1)
			local dist
			for a in pairs(vis) do if a:GetAttribute("Guard") == zone then dist = math.floor((a.Position - r.Position).Magnitude) end end
			chaseText.Text = "🔥 اهرب! الحارس على بعد " .. (dist or "?")
			bar.Size = UDim2.fromScale(k, 1)
			vignette.Visible = true
			for _, e in ipairs(edges) do e.BackgroundTransparency = 0.2 + math.sin(t * 8) * 0.2 end
		else
			chaseText.Text = "🏠 ارجع لقاعدتك واتبع الخط الأخضر"
			bar.Size = UDim2.fromScale(1, 1)
			vignette.Visible = false
		end
	else
		beam.Enabled, chase.Visible, vignette.Visible = false, false, false
	end

	slow = slow + dt
	if slow < 0.25 then return end
	slow = 0
	moneyL.Text = "💰 $" .. C.fmt(A("money", 0))
	speedL.Text = "⚡ " .. math.floor(A("speed", C.START_SPEED)) .. (A("training") and " 🔺" or "")
	incomeL.Text = "📈 $" .. C.fmt(A("income", 0)) .. "/ث"
	local left = math.max(0, math.floor((workspace:GetAttribute("KingAt") or 0) - now()))
	kingL.Text = string.format("👑 بيضة الملك بعد %d:%02d", math.floor(left / 60), left % 60)
	local lockLeft = math.ceil(A("lockUntil", 0) - now())
	lockB.Text = lockLeft > 0 and ("🔒\n" .. lockLeft .. " ث") or "🔒\nقفل"
	trapB.Text = "🪤\nفخ " .. A("traps", 0)
	mountB.Text = A("mounted") and "🪽\nانزل" or "🪽\nطيران"
	if updater then updater() end
	local z = 0
	for k, info in ipairs(C.ZONES) do if cp.Z >= info.z0 then z = k end end
	if z ~= zoneNow and not busy then setZone(z) end
end)

task.spawn(function()
	if not game:IsLoaded() then game.Loaded:Wait() end
	task.wait(1)
	intro()
	toast("ابدأ بالتدريب على جهاز المشي 🏃", GREEN)
end)
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</roblox>
