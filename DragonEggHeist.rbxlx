<Item class="StarterPlayer" referent="RBX2564"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX2563"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX2562"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")

local C = require(RS:WaitForChild("Config"))
local V = require(RS:WaitForChild("Visuals"))
local remotes = RS:WaitForChild("Remotes")
local Action, Fx = remotes:WaitForChild("Action"), remotes:WaitForChild("Fx")
local actors = workspace:WaitForChild("Actors")
local map = workspace:WaitForChild("Map")
local me = Players.LocalPlayer
local pg = me:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

local fxFolder = Instance.new("Folder") fxFolder.Name = "LocalFx" fxFolder.Parent = workspace
local function A(k, def) local v = me:GetAttribute(k) if v == nil then return def end return v end
local function now() return workspace:GetServerTimeNow() end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local WHITE = Color3.new(1, 1, 1)
local GREEN = Color3.fromRGB(70, 200, 100)
local DARK = Color3.fromRGB(24, 22, 42)

local SOUNDS = {
	click = {"rbxasset://sounds/clickfast.wav", 1, 0.5},
	pickup = {"rbxasset://sounds/electronicpingshort.wav", 1.1, 0.7},
	buy = {"rbxasset://sounds/electronicpingshort.wav", 1.5, 0.7},
	swing = {"rbxasset://sounds/swordslash.wav", 0.8, 0.7},
	hit = {"rbxasset://sounds/action_jump_land.mp3", 0.7, 1},
	roar = {"rbxasset://sounds/action_falling.ogg", 0.35, 2},
	crack = {"rbxasset://sounds/snap.mp3", 0.8, 1},
	boom = {"rbxasset://sounds/impact_water.mp3", 0.45, 1},
}
local function sound(id)
	local d = SOUNDS[id]
	if not d then return end
	local s = Instance.new("Sound")
	s.SoundId, s.PlaybackSpeed, s.Volume = d[1], d[2], d[3]
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 2.5)
end

---------------------------------------------------------------- أدوات الواجهة
local function new(class, props, children)
	local o = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do o[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = o end
	o.Parent = parent
	return o
end
local function corner(r) return new("UICorner", {CornerRadius = UDim.new(0, r or 12)}) end
local function stroke(color, th) return new("UIStroke", {Color = color or WHITE, Thickness = th or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 0.2}) end
local function grad() return new("UIGradient", {Rotation = 90, Color = ColorSequence.new(WHITE, Color3.fromRGB(150, 150, 170))}) end
local function label(props)
	local base = {BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextColor3 = WHITE, TextScaled = true, TextStrokeTransparency = 0.5, Size = UDim2.fromScale(1, 1)}
	for k, v in pairs(props) do base[k] = v end
	return new("TextLabel", base)
end
local gui = new("ScreenGui", {Name = "HUD", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 2, Parent = pg})
local cineGui = new("ScreenGui", {Name = "Cine", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10, IgnoreGuiInset = true, Parent = pg})
local scales = {}
local function autoScale(o) table.insert(scales, new("UIScale", {Parent = o})) end
local function rescale()
	local vp = camera.ViewportSize
	local s = math.clamp(math.min(vp.X / 1100, vp.Y / 650), 0.55, 1.25)
	for _, u in ipairs(scales) do u.Scale = s end
end
local function button(props, fn)
	local base = {BackgroundColor3 = GREEN, Font = Enum.Font.GothamBlack, TextColor3 = WHITE, TextScaled = true, AutoButtonColor = false, TextStrokeTransparency = 0.4}
	for k, v in pairs(props) do base[k] = v end
	local b = new("TextButton", base, {corner(12), stroke(), grad(), new("UIPadding", {PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6)})})
	local sc = new("UIScale", {Parent = b})
	b.MouseEnter:Connect(function() tween(sc, 0.12, {Scale = 1.07}) end)
	b.MouseLeave:Connect(function() tween(sc, 0.12, {Scale = 1}) end)
	b.Activated:Connect(function()
		sound("click")
		sc.Scale = 0.9
		tween(sc, 0.25, {Scale = 1}, Enum.EasingStyle.Back)
		if fn then fn() end
	end)
	return b
end

-- الشريط العلوي
local top = new("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(560, 50), BackgroundTransparency = 1, Parent = gui},
	{new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10)})})
autoScale(top)
local function pill(color)
	local f = new("Frame", {Size = UDim2.fromOffset(175, 46), BackgroundColor3 = color, Parent = top}, {corner(23), stroke(), grad()})
	return label({Size = UDim2.new(1, -20, 1, -14), Position = UDim2.fromOffset(10, 7), Parent = f})
end
local moneyL = pill(Color3.fromRGB(45, 170, 85))
local speedL = pill(Color3.fromRGB(45, 130, 220))
local incomeL = pill(Color3.fromRGB(220, 140, 30))
local kingL = label({AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 56), Size = UDim2.fromOffset(300, 22), TextColor3 = C.RARITY[4].color, Parent = gui})
autoScale(kingL)

-- الإشعارات
local toasts = new("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.18, 0), Size = UDim2.fromOffset(440, 220), BackgroundTransparency = 1, Parent = gui},
	{new("UIListLayout", {Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder})})
autoScale(toasts)
local toastN = 0
local function toast(text, color)
	toastN = toastN + 1
	local f = new("Frame", {Size = UDim2.fromOffset(0, 40), BackgroundColor3 = DARK, BackgroundTransparency = 0.15, ClipsDescendants = true, LayoutOrder = toastN, Parent = toasts}, {corner(10), stroke(color or WHITE)})
	label({Size = UDim2.new(1, -16, 1, -12), Position = UDim2.fromOffset(8, 6), Text = text, TextColor3 = color or WHITE, Parent = f})
	tween(f, 0.3, {Size = UDim2.fromOffset(420, 40)}, Enum.EasingStyle.Back)
	task.delay(3.2, function() tween(f, 0.25, {Size = UDim2.fromOffset(0, 40)}) task.wait(0.27) f:Destroy() end)
	local frames = {}
	for _, c in ipairs(toasts:GetChildren()) do if c:IsA("Frame") then table.insert(frames, c) end end
	if #frames > 4 then
		table.sort(frames, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
		frames[1]:Destroy()
	end
end

local banner = label({AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.33), Size = UDim2.fromScale(0.7, 0.09), TextTransparency = 1, TextStrokeTransparency = 1, Parent = cineGui})
local bannerN = 0
local function showBanner(text, color)
	bannerN = bannerN + 1
	local n = bannerN
	banner.Text, banner.TextColor3 = text, color or WHITE
	banner.Size = UDim2.fromScale(0.4, 0.05)
	tween(banner, 0.45, {TextTransparency = 0, TextStrokeTransparency = 0, Size = UDim2.fromScale(0.75, 0.1)}, Enum.EasingStyle.Back)
	task.delay(2.4, function() if n == bannerN then tween(banner, 0.5, {TextTransparency = 1, TextStrokeTransparency = 1}) end end)
end

local flashF = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 20, Parent = cineGui})
local function flash(color, t)
	flashF.BackgroundColor3, flashF.BackgroundTransparency = color or WHITE, 0.05
	tween(flashF, t or 0.8, {BackgroundTransparency = 1})
end

-- تحذير المطاردة
local vignette = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = cineGui})
local edges = {}
for _, e in ipairs({{0, 0, 1, 0.18, 90}, {0, 0.82, 1, 0.18, 270}, {0, 0, 0.12, 1, 0}, {0.88, 0, 0.12, 1, 180}}) do
	local g = new("UIGradient", {Rotation = e[5], Transparency = NumberSequence.new(0.35, 1)})
	table.insert(edges, new("Frame", {Position = UDim2.fromScale(e[1], e[2]), Size = UDim2.fromScale(e[3], e[4]), BackgroundColor3 = Color3.fromRGB(255, 20, 30), BorderSizePixel = 0, Parent = vignette}, {g}))
end
local chase = new("Frame", {AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -100), Size = UDim2.fromOffset(380, 66), BackgroundColor3 = DARK, BackgroundTransparency = 0.2, Visible = false, Parent = gui}, {corner(14), stroke(Color3.fromRGB(255, 90, 90))})
autoScale(chase)
local chaseText = label({Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 4), Parent = chase})
local barBack = new("Frame", {Size = UDim2.new(1, -24, 0, 16), Position = UDim2.fromOffset(12, 40), BackgroundColor3 = Color3.fromRGB(70, 60, 80), Parent = chase}, {corner(8)})
local bar = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = GREEN, Parent = barBack}, {corner(8)})

---------------------------------------------------------------- النوافذ
local panel = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromOffset(580, 440), BackgroundColor3 = DARK, Visible = false, ZIndex = 5, Parent = gui}, {corner(18), stroke(Color3.fromRGB(180, 140, 255), 3)})
local panelScale = new("UIScale", {Parent = panel})
local header = new("Frame", {Size = UDim2.new(1, -20, 0, 54), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = Color3.fromRGB(120, 80, 220), Parent = panel}, {corner(12), grad()})
local title = label({Size = UDim2.new(1, -130, 1, -14), Position = UDim2.fromOffset(65, 7), Parent = header})
local list = new("ScrollingFrame", {Position = UDim2.fromOffset(10, 74), Size = UDim2.new(1, -20, 1, -84), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = panel},
	{new("UIListLayout", {Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder})})
local updater, current = nil, nil
local function viewScale() return scales[1].Scale end
local function closePanel() panel.Visible, updater, current = false, nil, nil end
button({Size = UDim2.fromOffset(44, 40), Position = UDim2.new(1, -52, 0, 7), BackgroundColor3 = Color3.fromRGB(235, 70, 80), Text = "✕", Parent = header}, closePanel)
local function row(order, h)
	return new("Frame", {Size = UDim2.new(1, -12, 0, h or 72), BackgroundColor3 = Color3.fromRGB(45, 40, 75), LayoutOrder = order, Parent = list}, {corner(12), stroke(Color3.fromRGB(110, 95, 170), 1)})
end
local function textIn(parent, x, y, w, h, text, color)
	return label({Position = UDim2.new(x, 6, y, 0), Size = UDim2.fromScale(w, h), Text = text or "", TextColor3 = color or WHITE, TextXAlignment = Enum.TextXAlignment.Right, Parent = parent})
end

local builders = {}
function builders.shop()
	title.Text = "🛒 المتجر"
	local ups = {}
	for k, key in ipairs(C.ORDER) do
		local u = C.UPGRADES[key]
		local f = row(k)
		label({Size = UDim2.fromOffset(56, 56), Position = UDim2.new(1, -66, 0, 8), Text = u.icon, Parent = f})
		local name = textIn(f, 0.33, 0.1, 0.52, 0.45)
		textIn(f, 0.33, 0.58, 0.52, 0.3, u.desc, Color3.fromRGB(190, 185, 220))
		local b = button({Size = UDim2.new(0.29, 0, 0, 52), Position = UDim2.fromOffset(10, 10), Parent = f}, function() Action:FireServer("buy", key) end)
		ups[key] = {name, b, u}
	end
	return function()
		for key, x in pairs(ups) do
			local lv, u = A(key, 0), x[3]
			x[1].Text = u.name .. (key == "traps" and (" (عندك " .. lv .. ")") or (" • مستوى " .. lv))
			local full = lv >= u.max
			x[2].Text = full and "MAX" or ("$" .. C.fmt(u.cost(lv)))
			x[2].BackgroundColor3 = (full or A("money", 0) < u.cost(lv)) and Color3.fromRGB(110, 105, 125) or GREEN
		end
	end
end
function builders.pets()
	title.Text = "🐉 تنانيني"
	local sig
	return function()
		local mine = {}
		for _, a in ipairs(actors:GetChildren()) do
			if a:GetAttribute("OwnerId") == me.UserId then table.insert(mine, a) end
		end
		table.sort(mine, function(a, b) return a:GetAttribute("Slot") < b:GetAttribute("Slot") end)
		local s = ""
		for _, a in ipairs(mine) do s = s .. tostring(a) .. a:GetAttribute("Slot") .. (a:GetAttribute("Income") or 0) end
		if s == sig then return end
		sig = s
		for _, c in ipairs(list:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
		if #mine == 0 then textIn(row(1, 60), 0, 0.2, 0.96, 0.6, "ما عندك شي لسا، روح اسرق بيضة! 🥚") end
		for k, a in ipairs(mine) do
			local f = row(k, 62)
			local E = C.ELEMENTS[a:GetAttribute("Element")]
			if a.Name == "Egg" then
				textIn(f, 0, 0.18, 0.96, 0.6, "🥚 بيضة " .. E.name .. " (قيد التحضين)", E.fx)
			else
				local rar = C.RARITY[a:GetAttribute("Rarity")]
				textIn(f, 0.35, 0.06, 0.61, 0.5, "🐉 " .. E.name .. " " .. C.MUT[a:GetAttribute("Mut")].name, rar.color)
				textIn(f, 0.35, 0.58, 0.61, 0.34, rar.name)
				textIn(f, 0, 0.25, 0.32, 0.5, "$" .. C.fmt(a:GetAttribute("Income")) .. "/ث", Color3.fromRGB(110, 255, 140))
			end
		end
	end
end
function builders.rebirth()
	title.Text = "✨ ولادة جديدة"
	local f = row(1, 210)
	local a = textIn(f, 0, 0.05, 0.96, 0.18)
	textIn(f, 0, 0.3, 0.96, 0.14, "+50% دخل و +25% تدريب لكل ولادة")
	textIn(f, 0, 0.48, 0.96, 0.13, "تصفّر الفلوس والسرعة، وتنانينك تبقى", Color3.fromRGB(255, 190, 120))
	local b = button({Size = UDim2.new(0.6, 0, 0, 56), Position = UDim2.new(0.2, 0, 1, -66), Parent = f}, function() Action:FireServer("rebirth") end)
	return function()
		local r = A("rebirth", 0)
		a.Text = "عدد الولادات: " .. r
		b.Text = "ولادة جديدة • $" .. C.fmt(C.rebirthCost(r))
		b.BackgroundColor3 = A("money", 0) >= C.rebirthCost(r) and GREEN or Color3.fromRGB(110, 105, 125)
	end
end
function builders.help()
	title.Text = "❔ طريقة اللعب"
	local lines = {"🏃 تدرب على جهاز المشي في قاعدتك", "🥚 اسرق بيضة وارجع قبل ما يمسكك الحارس", "🐣 افقس البيضة والتنين يجيب لك فلوس", "🏏 اضرب الحرامي بالمضرب", "🔒 اقفل قاعدتك أو حط فخاخ", "🐉 التنين الأسطوري تقدر تطير فيه", "👑 لاحق بيضة الملك قبل الكل"}
	for k, t in ipairs(lines) do textIn(row(k, 42), 0, 0.16, 0.96, 0.68, t) end
	return function() end
end
local function openPanel(kind)
	if current == kind then closePanel() return end
	for _, c in ipairs(list:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	current = kind
	updater = builders[kind]()
	updater()
	panel.Visible = true
	panelScale.Scale = viewScale() * 0.5
	tween(panelScale, 0.3, {Scale = viewScale()}, Enum.EasingStyle.Back)
end

local side = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.42, 0), Size = UDim2.fromOffset(168, 330), BackgroundTransparency = 1, Parent = gui},
	{new("UIGridLayout", {CellSize = UDim2.fromOffset(78, 72), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder})})
autoScale(side)
local function sideBtn(order, text, color, fn) return button({Text = text, BackgroundColor3 = color, LayoutOrder = order, Parent = side}, fn) end
