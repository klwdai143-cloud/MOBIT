<Item class="ServerScriptService" referent="RBX11"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX10"><Properties><string name="Name">Dummies</string><ProtectedString name="Source">-- دمى للتجربة (احذف هذا السكربت في لعبتك)
local Players = game:GetService("Players")
local function spawnDummy(pos)
	local d = Instance.new("HumanoidDescription")
	local c = Color3.fromRGB(170, 130, 100)
	d.HeadColor, d.TorsoColor, d.LeftArmColor, d.RightArmColor, d.LeftLegColor, d.RightLegColor = c, c, c, c, c, c
	local m = Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R15)
	m.Name = "Dummy"
	m:PivotTo(CFrame.lookAt(pos, Vector3.new(0, pos.Y, 0)))
	m.Parent = workspace
	m.Humanoid.MaxHealth, m.Humanoid.Health = 200, 200
	m.Humanoid.Died:Connect(function()
		task.wait(4)
		m:Destroy()
		spawnDummy(pos)
	end)
end
for _, x in {-16, -8, 0, 8, 16} do task.spawn(spawnDummy, Vector3.new(x, 4, -24)) end
</ProtectedString></Properties></Item>
