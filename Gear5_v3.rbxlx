<Item class="StarterGui" referent="RBX735"><Properties><string name="Name">StarterGui</string></Properties><Item class="ScreenGui" referent="RBX734"><Properties><string name="Name">Gear5Gui</string><bool name="ResetOnSpawn">false</bool></Properties><Item class="LocalScript" referent="RBX733"><Properties><string name="Name">Gear5Button</string><ProtectedString name="Source">local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local remote = game:GetService("ReplicatedStorage"):WaitForChild("Gear5")
local p = Players.LocalPlayer
local b = Instance.new("TextButton")
b.AnchorPoint, b.Position, b.Size = Vector2.new(1, .5), UDim2.new(1, -18, .5, 0), UDim2.new(0, 94, 0, 94)
b.BackgroundColor3, b.TextColor3, b.TextStrokeTransparency = Color3.new(1, 1, 1), Color3.new(1, 1, 1), 0
b.Font, b.TextSize, b.Text, b.AutoButtonColor = Enum.Font.Bangers, 30, "GEAR 5", false
Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
local g = Instance.new("UIGradient", b)
g.Rotation, g.Color = 90, ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 80, 220))
local st = Instance.new("UIStroke", b)
st.ApplyStrokeMode, st.Color = Enum.ApplyStrokeMode.Border, Color3.new(1, 1, 1)
TweenService:Create(st, TweenInfo.new(.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Thickness = 7}):Play()
b.Parent = script.Parent
b.MouseButton1Click:Connect(function() remote:FireServer("toggle") end)

-- كاميرا الكاتسين: السيرفر يرسل كل لقطة
local run, shake = 0, 0
remote.OnClientEvent:Connect(function(kind, a, b, d, look)
	local cam = workspace.CurrentCamera
	if kind == "shake" then shake = a return end
	run += 1
	if kind == "end" then cam.CameraType = Enum.CameraType.Custom return end
	local mine, t0 = run, os.clock()
	cam.CameraType = Enum.CameraType.Scriptable
	while run == mine and os.clock() - t0 &lt; 12 do
		local x = math.clamp((os.clock() - t0) / d, 0, 1)
		local jit = Vector3.new(math.random() - .5, math.random() - .5, math.random() - .5) * shake
		cam.CFrame = CFrame.lookAt(a:Lerp(b, x * x * (3 - 2 * x)), look) + jit
		RunService.RenderStepped:Wait()
	end
	if run == mine then cam.CameraType = Enum.CameraType.Custom end
end)
RunService.RenderStepped:Connect(function(dt) shake *= math.exp(-5 * dt) end)
local function refresh()
	b.Text = p:GetAttribute("Busy") and "..." or (p:GetAttribute("On") and "OFF" or "GEAR 5")
end
remote:FireServer("ready")
while task.wait(.2) do refresh() end
</ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX737"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX736"><Properties><string name="Name">Gear5Server</string><ProtectedString name="Source">local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local rng, rgb = Random.new(), Color3.fromRGB
local remote = game:GetService("ReplicatedStorage"):WaitForChild("Gear5")
local WHITE, SKY, PURPLE = Color3.new(1, 1, 1), rgb(170, 215, 255), rgb(110, 60, 160)
-- بدل الأصوات بـ "rbxassetid://ID" من التولبوكس إذا تبغى (طبول، ضحكة، برق)
local SFX = {drum = "impact_water.mp3", boing = "action_jump.mp3", zap = "swordslash.wav", whoosh = "swordlunge.wav", wind = "action_falling.ogg"}
local function short(n)
	if n &gt;= 1e9 then return string.format("%.1fB", n / 1e9) end
	if n &gt;= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n &gt;= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end
local function tween(o, t, props) TweenService:Create(o, TweenInfo.new(t), props):Play() end
local function part(size, cf, color, transparency, life, material)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
	p.Material, p.Size, p.CFrame, p.Color, p.Transparency = material or Enum.Material.Neon, size, cf, color, transparency or 0
	p.Parent = workspace
	if life then Debris:AddItem(p, life) end
	return p
end
local function label(parent, text, color, y, w, h)
	local g = Instance.new("BillboardGui")
	g.Size, g.StudsOffset, g.MaxDistance = UDim2.fromScale(w or 10, h or 2.5), Vector3.new(0, y, 0), 220
	local t = Instance.new("TextLabel", g)
	t.Size, t.BackgroundTransparency, t.Font, t.TextScaled = UDim2.fromScale(1, 1), 1, Enum.Font.GothamBlack, true
	t.Text, t.TextColor3, t.TextStrokeTransparency = text, color, 0
	g.Parent = parent
	return t, g
end
local function popup(at, text, color)
	local p = part(Vector3.one, CFrame.new(at + rng:NextUnitVector() * 1.5), color, 1, .8)
	label(p, text, color, 1, 5, 1.4)
	tween(p, .8, {Position = p.Position + Vector3.new(0, 4, 0)})
end
local function burst(pos, color, radius)
	local b = part(Vector3.one, CFrame.new(pos), color, .2, .4, Enum.Material.ForceField)
	b.Shape = Enum.PartType.Ball
	tween(b, .4, {Size = Vector3.one * radius * 2, Transparency = 1})
	for _ = 1, 8 do
		local d = rng:NextUnitVector()
		local s = part(Vector3.new(.2, .2, 1.5), CFrame.lookAt(pos, pos + d), color, 0, .3)
		tween(s, .3, {CFrame = s.CFrame * CFrame.new(0, 0, -radius), Transparency = 1})
	end
end
local function sound(where, id, volume, speed)
	local s = Instance.new("Sound")
	s.SoundId, s.Volume, s.PlaybackSpeed, s.Parent = "rbxasset://sounds/" .. id, volume, speed, where
	s:Play()
	Debris:AddItem(s, 3)
end

local function R(x, y, z) return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z)) end
local function joints(p, r15)
	local pi, ya, rf, ro, re, lf, lo, le, rh, rk, lh, lk, dy = table.unpack(p)
	if r15 then
		return {Root = CFrame.new(0,dy,0), Waist = R(-pi,ya,0), Neck = R(pi*.5,-ya*.6,0), RightShoulder = R(rf,0,ro), LeftShoulder = R(lf,0,-lo),
			RightElbow = R(re,0,0), LeftElbow = R(le,0,0), RightHip = R(rh,0,6), LeftHip = R(lh,0,-6), RightKnee = R(-rk,0,0), LeftKnee = R(-lk,0,0)}
	end
	return {RootJoint = CFrame.new(0,0,dy*.5) * R(pi,0,ya), Neck = R(-pi*.5,0,-ya*.6), ["Right Shoulder"] = R(-ro,0,rf), ["Left Shoulder"] = R(-lo,0,-lf),
		["Right Hip"] = R(0,0,rh), ["Left Hip"] = R(0,0,-lh)}
end
local function tw(o, t, props, style) TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad), props):Play() end
local S, active, nightFx, savedTime = {}, 0, {}, 14

-- الوضعيات: ميل، لف، يد يمين (قدام، برا، كوع)، يد يسار، رجل يمين (قدام، ركبة)، رجل يسار، ارتفاع
local ANIM = {
	kneel = function(t) local b = math.max(0, math.sin(t * 11)) ^ 4
		return {38 - b * 14,0, 15,12,25, 15,12,25, 85,115, -5,105, -1.35 + b * .25} end,
	rise = function(t) local j = math.sin(t * 40) * 4
		return {-14 + j,j, -15,45 + j,15, -15,45 - j,15, 20,40, -10,25, 0} end,
	ready = function(t) return {12,-15, 25,30,70, 55,20,90, -20,35, 30,40, -.5} end,
	lie = function(t) return {-4,0, 25,65,5, 25,65,5, 8,0, -6,12, 0} end,
	cover = function(t) local b = math.sin(t * 19)
		return {-24 + b * 8,math.sin(t * 4) * 10, 125,-22,128, 35 + b * 8,-20,115, 25 + math.sin(t * 8) * 20,40, -6,12, math.abs(b) * .4} end,
	slam = function() return {50,0, 55,10,0, 55,10,0, 80,115, -15,100, -1.4} end,
	run = function(t) local a = (t * 1300) % 360
		return {30,0, -70,25,10, -70,25,10, a,70, (a + 180) % 360,70, .3} end,
	rope = function(t) local b = math.sin(t * 10)
		return {8,0, 40 + b * 30,70,25, 40 + b * 30,70,25, 30,60, 10,50, 0} end,
	flail = function(t) local a, b = math.sin(t * 17), math.cos(t * 13)
		return {-25,0, 80 + a * 50,70,20, 60 + b * 50,80,30, 35 + b * 35,50, 10 + a * 35,40, 0} end,
	burst = function() return {-32,0, 30,125,5, 30,125,5, 35,30, -25,45, .3} end,
	laugh = function(t) local b = math.sin(t * 19)
		return {-26 + b * 9,math.sin(t * 5) * 14, 52 + b * 7,-18,112, 52 - b * 7,-18,112, 40 + math.sin(t * 8) * 25,55, -8,15, math.abs(b) * .45} end,
	dance = function(t) local w, c = math.sin(t * 15), math.cos(t * 15)
		return {12,w * 28, 90 * w,90 + 55 * c,30, -90 * w,90 - 55 * c,30, 70 * w,80 * math.max(0, w), -70 * w,80 * math.max(0, -w), math.abs(w) * .9} end,
	grab = function(t) return {-22,18, 178,6 + math.sin(t * 30) * 5,0, 25,55,25, 30,45, -18,20, .5} end,
	windup = function() return {-35,-55, 185,45,75, 90,25,10, 70,95, -25,30, .4} end,
	throw = function() return {42,50, 50,-5,0, -65,40,25, 70,90, -45,35, -1} end,
	punch = function(t) return {18,25, 165 - math.min(t * 190, 100),8,0, -40,45,60, 40,55, -30,30, -.5} end,
	victory = function(t) return {-6,18, 15,40,100, 155,35,20, 12,10, -12,10, math.sin(t * 7) * .12} end,
}
local function play(s, name, speed) s.anim, s.t0, s.speed = ANIM[name], os.clock(), speed or 18 end

RunService.Heartbeat:Connect(function(dt)
	for c, s in S do
		if s.anim then
			local goal = joints(s.anim(os.clock() - s.t0), s.hum.RigType == Enum.HumanoidRigType.R15)
			for name, d in s.rig do
				if goal[name] then d[1][d[2]] = d[1][d[2]]:Lerp(d[3] * goal[name], 1 - math.exp(-dt * s.speed)) end
			end
		end
		-- وشاح الغيوم المتحرك
		for i, w in s.scarf do
			local a = (i - 1) / (#s.scarf - 1) * math.pi * 1.5 - math.pi * .25
			local t = os.clock() * 3 + i * .22
			w.C0 = CFrame.new(math.cos(a) * 2.5, .5 + math.sin(a) * 1.7 + math.sin(t) * .3, .9 + math.cos(t) * .25)
		end
	end
end)

local function ring(pos, radius, color, time)
	local a = Instance.new("CylinderHandleAdornment")
	a.Adornee, a.CFrame = workspace.Terrain, CFrame.new(pos) * R(90, 0, 0)
	a.Height, a.Radius, a.InnerRadius, a.Color3, a.Parent = .3, 2, .5, color, workspace
	tw(a, time or .7, {Radius = radius, InnerRadius = radius - .7, Transparency = 1})
	Debris:AddItem(a, time or .7)
end
local function bolt(a, b, thick, jag, color, life)
	local last = a
	for i = 1, 8 do
		local n = a:Lerp(b, i / 8) + (i &lt; 8 and rng:NextUnitVector() * jag or Vector3.zero)
		local cf, len = CFrame.lookAt((last + n) / 2, n), (n - last).Magnitude
		part(Vector3.new(thick, thick, len), cf, WHITE, 0, life or .12)
		part(Vector3.new(thick * 2.4, thick * 2.4, len), cf, color or SKY, .65, life or .12)
		last = n
	end
end
local function ball(size, pos, color, transparency, life, material)
	local p = part(Vector3.one * size, CFrame.new(pos), color, transparency, life, material)
	p.Shape = Enum.PartType.Ball
	return p
end
local function boom(pos, radius)
	for i = 0, 3 do
		task.delay(i * .1, function()
			local d = ball(4, pos, i % 2 == 0 and WHITE or SKY, .1, .8, Enum.Material.ForceField)
			tw(d, .8, {Size = Vector3.one * (radius * 2 - i * 6), Transparency = 1})
			ring(pos - Vector3.new(0, 2.5, 0), radius + i * 7, i % 2 == 0 and WHITE or PURPLE)
		end)
	end
	for i = 1, 22 do
		local dir = CFrame.Angles(0, i / 22 * math.pi * 2, 0).LookVector
		local puff = ball(rng:NextNumber(2, 5), pos + dir * 3 - Vector3.new(0, 2, 0), WHITE, .2, 1.1, Enum.Material.SmoothPlastic)
		tw(puff, 1.1, {Position = puff.Position + dir * radius * .8 + Vector3.new(0, rng:NextNumber(1, 7), 0), Size = Vector3.one * .3, Transparency = 1})
	end
	sound(workspace.Stage, SFX.drum, 3, .4)
end
local function cam(s, ...) if s.player then remote:FireClient(s.player, ...) end end

local function night(root)
	active += 1
	if active &gt; 1 then return nightFx[1].Position end
	savedTime = Lighting.ClockTime
	tw(Lighting, 2.5, {ClockTime = 24})
	local pos = (root.CFrame * CFrame.new(0, 0, -240)).Position + Vector3.new(0, 125, 0)
	local moon = ball(10, pos - Vector3.new(0, 110, 0), rgb(255, 250, 220), 0)
	tw(moon, 3, {Size = Vector3.one * 85, Position = pos}, Enum.EasingStyle.Sine)
	nightFx = {moon}
	for i, size in {100, 122, 150} do
		local halo = ball(5, moon.Position, rgb(210, 225, 255), .8 + i * .05)
		tw(halo, 3, {Size = Vector3.one * size, Position = pos}, Enum.EasingStyle.Sine)
		table.insert(nightFx, halo)
	end
	local back = (root.Position - pos).Unit
	for i = 1, 9 do
		local off = (back + rng:NextUnitVector() * .6).Unit * 41
		local crater = ball(rng:NextNumber(5, 14), pos + off, rgb(215, 205, 175), 1)
		task.delay(3, tw, crater, .5, {Transparency = 0})
		table.insert(nightFx, crater)
	end
	local cc = Instance.new("ColorCorrectionEffect", Lighting)
	tw(cc, 2, {TintColor = rgb(190, 205, 255), Contrast = .2})
	table.insert(nightFx, cc)
	return pos
end
local function day()
	active = math.max(0, active - 1)
	if active &gt; 0 then return end
	for _, o in nightFx do o:Destroy() end
	nightFx = {}
	tw(Lighting, 2, {ClockTime = savedTime})
end

local function weld(s, to, size, offset, color, material, ballShape)
	local p = Instance.new("Part")
	p.Size, p.Color, p.Material, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = size, color, material or Enum.Material.SmoothPlastic, false, false, false, true
	if ballShape then p.Shape = Enum.PartType.Ball end
	p.CFrame = to.CFrame * offset
	local w = Instance.new("Weld")
	w.Part0, w.Part1, w.C0 = to, p, offset
	p.Parent, w.Parent = s.folder, p
	return w, p
end
local function paint(s, p, color) s.colors[p] = s.colors[p] or p.Color; p.Color = color end
local function outfit(c, s, torsoC, shortsC, sashC)
	for _, o in c:GetChildren() do
		if o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then
			table.insert(s.clothes, o)
			o.Parent = nil
		elseif o:IsA("BasePart") then
			local n = o.Name
			if n == "LowerTorso" then paint(s, o, sashC)
			elseif n:find("Torso") then paint(s, o, torsoC)
			elseif n:find("UpperLeg") or n:find(" Leg") then paint(s, o, shortsC) end
		elseif o:IsA("Accessory") then
			local h = o:FindFirstChild("Handle")
			if h then s.hidden[h] = s.hidden[h] or h.Transparency; h.Transparency = 1 end
		end
	end
end
local function hair(s, head, color, material, flame)
	for i = 1, 30 do
		local a, up = i * 2.4, .15 + (i % 6) * .14
		local dir = Vector3.new(math.cos(a) * (1 - up * .6), up, math.sin(a) * (1 - up * .6))
		if dir.Z &gt; -.3 or up &gt; .6 then
			weld(s, head, Vector3.one * .48, CFrame.new(dir * .68), color, material, true)
			local tip = (dir + Vector3.new(0, flame, flame * .4)).Unit
			weld(s, head, Vector3.new(.17, .7 + (i % 3) * .3 + flame * .3, .17), CFrame.lookAt(dir * .8 + tip * .35, dir * .8 + tip * 2) * R(-90, 0, 0), color, material)
		end
	end
end
-- لوفي العادي: قميص أحمر، شورت أزرق، قبعة القش
local function luffy(c, s)
	outfit(c, s, rgb(200, 30, 35), rgb(45, 90, 170), rgb(240, 200, 50))
	local head = c.Head
	hair(s, head, rgb(15, 12, 15), Enum.Material.SmoothPlastic, 0)
	for _, d in {{.12, 2.7, .65, rgb(230, 195, 95)}, {.28, 1.55, .82, rgb(200, 25, 30)}, {.5, 1.45, 1.15, rgb(230, 195, 95)}} do
		local _, p = weld(s, head, Vector3.new(d[1], d[2], d[2]), CFrame.new(0, d[3], 0) * R(0, 0, 90), d[4])
		p.Shape = Enum.PartType.Cylinder
	end
	weld(s, head, Vector3.new(.25, .05, .03), CFrame.new(-.24, 0, -.63), rgb(110, 40, 40))
end
local function seg(s, to, a, b, d, color, material)
	weld(s, to, Vector3.new(d, d, (b - a).Magnitude + d * .5), CFrame.lookAt((a + b) / 2, b), color, material)
end
local function dress(c, s)
	s.folder:ClearAllChildren()
	outfit(c, s, WHITE, WHITE, PURPLE)
	local head, torso = c.Head, c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
	local V3 = Vector3.new
	weld(s, head, V3(1.34, 1.1, 1.34), CFrame.new(0, .28, .14), WHITE, nil, true)
	-- خصل شعر كاللهب: كل خصلة تنحني للأعلى وتدق
	for i = 1, 22 do
		local a = i * 2.4
		local up = .2 + (i / 22) * .75
		local dir = V3(math.cos(a) * (1 - up * .55), up, math.abs(math.sin(a)) * (1 - up * .4) - (up &gt; .75 and .3 or 0)).Unit
		local p = dir * .62
		for j = 1, 4 do
			local bend = (dir + V3(math.sin(i) * .25 * j, .32 * j, .16 * j)).Unit
			local n = p + bend * (.34 - j * .025)
			seg(s, head, p, n, .36 - j * .075, WHITE)
			p = n
		end
	end
	for _, x in {-1, 1} do
		local eye = V3(x * .22, .1, -.6)
		for i, d in {{.27, WHITE}, {.21, rgb(220, 15, 40)}, {.13, WHITE}, {.08, rgb(220, 15, 40)}} do
			local _, p = weld(s, head, V3(.025, d[1], d[1]), CFrame.new(eye - V3(0, 0, i * .01)) * R(0, 90, 0), d[2], Enum.Material.Neon)
			p.Shape = Enum.PartType.Cylinder
		end
		local last
		for i = 0, 18 do
			local a, r = i * .6, .17 - i * .008
			local n = V3(x * (.3 + math.cos(a) * r), .38 + math.sin(a) * r, -.64)
			if last then seg(s, head, last, n, .045, WHITE, Enum.Material.Neon) end
			last = n
		end
		seg(s, torso, V3(-x * .45, .45, -.54), V3(x * .45, -.35, -.54), .09, rgb(150, 70, 70))
		seg(s, torso, V3(x * .2, .75, -.55), V3(x * .75, -.8, -.55), .2, rgb(235, 235, 245))
		seg(s, torso, V3(x * .3, -.85, -.55), V3(x * .55, -2.1, -.75), .26, PURPLE)
	end
	-- ابتسامة عريضة
	for i = -6, 6 do
		local x = i * .055
		weld(s, head, V3(.065, .17 - math.abs(i) * .017, .05), CFrame.new(x, -.27 + x * x * 1.1, -.6), WHITE, Enum.Material.Neon)
		weld(s, head, V3(.065, .035, .06), CFrame.new(x, -.37 + x * x * 1.8, -.6), rgb(60, 10, 15))
	end
	for i = 1, 64 do
		local u = i / 64
		local d = .25 + math.sin(u * math.pi) * .7 + math.abs(math.sin(u * 26)) * .22
		local w, p = weld(s, torso, Vector3.one * d, CFrame.new(), WHITE, Enum.Material.Neon, true)
		p.Transparency = .08
		table.insert(s.scarf, w)
	end
	local root = c.HumanoidRootPart
	local e = Instance.new("ParticleEmitter")
	e.Texture, e.Color, e.LightEmission = "rbxasset://textures/particles/smoke_main.dds", ColorSequence.new(WHITE), .8
	e.Size, e.Transparency = NumberSequence.new(1.4, 0), NumberSequence.new(.75, 1)
	e.Rate, e.Lifetime, e.Speed, e.Parent = 16, NumberRange.new(.6, 1.2), NumberRange.new(2, 5), root
	local hl = Instance.new("Highlight", c)
	hl.FillTransparency, hl.OutlineColor, hl.DepthMode = 1, rgb(30, 20, 45), Enum.HighlightDepthMode.Occluded
	table.insert(s.extra, e)
	table.insert(s.extra, hl)
end

-- التنانين (كايدو ومومونوسكي)
local V = Vector3.new
local KMODE = {
	momo = function(i, t) return V(-75 + math.sin(t - i * .35) * 14 + i * 2, 8 + math.sin(t * 1.3 - i * .4) * 7, -65 - i * 2.2) end,
	fly = function(i, t) return V(math.sin(t * 2 - i * .4) * 11, 17 + math.sin(t * 1.6 - i * .5) * 5, -38 - i * 2.8) end,
	strike = function(i) return V(math.sin(i * .5) * 4, 3 + i * .9, -6 - i * 2.4) end,
	rope = function(i, t) local u = i / 30 local r, a = math.sin(u * math.pi) * 15, t * 10
		return V((u - .5) * 40, 7.5 + math.cos(a) * r, math.sin(a) * r) end,
	down = function(i) return V(math.sin(i * .55) * 13, 2.5, -36 - i * 1.4) end,
}
local function dragon(s, base, teal, fire, mode)
	local k = {base = base, mode = mode, pos = {}, parts = {}, folder = Instance.new("Folder", workspace)}
	local function add(i, size, offset, color, ballShape, material)
		local p = part(size, base, color, 0, nil, material or Enum.Material.SmoothPlastic)
		if ballShape then p.Shape = Enum.PartType.Ball end
		p.Parent = k.folder
		table.insert(k.parts, {p, i, offset})
	end
	local gold = rgb(225, 190, 110)
	add(0, V(7, 5, 8), CFrame.new(), teal)
	add(0, V(5, 2, 7), CFrame.new(0, 0, -6), teal)
	add(0, V(4.6, 1, 6), CFrame.new(0, -3, -4.5) * R(-14, 0, 0), gold)
	for _, x in {-1, 1} do
		add(0, V(1.2, .8, .4), CFrame.new(x * 2.2, 1.4, -4.1), rgb(255, 230, 40), false, Enum.Material.Neon)
		add(0, V(1, 8, 1), CFrame.new(x * 3.5, 5, 2) * R(35, 0, -x * 35), gold)
		add(0, V(.35, .35, 12), CFrame.new(x * 5, -1, -3) * R(0, x * 55, 0), gold)
		for j = -2, 2 do add(0, V(.5, 1.3, .5), CFrame.new(x * 1.8, -1.6, -6 + j * 1.3), WHITE) end
	end
	for j = 1, 5 do add(0, V(1.4, 4, 1.4), CFrame.new((j - 3) * 1.5, 2, 4.5) * R(60, 0, (3 - j) * 18), fire, false, Enum.Material.Neon) end
	for i = 1, 30 do
		local d = 6.2 - i * .15
		add(i, Vector3.one * d, CFrame.new(), teal, true)
		add(i, Vector3.one * d * .72, CFrame.new(0, -d * .22, 0), gold, true)
		if i % 2 == 0 then add(i, V(.5, d * .6, 1.2), CFrame.new(0, d * .6, 0) * R(35, 0, 0), fire, false, Enum.Material.Neon) end
	end
	table.insert(s.dragons, k)
	return k
end
RunService.Heartbeat:Connect(function(dt)
	for c, s in S do
		local root = c:FindFirstChild("HumanoidRootPart")
		for _, k in s.dragons or {} do
			if root then
				local t, alpha = os.clock(), 1 - math.exp(-dt * (k.mode == "rope" and 30 or 7))
				for i = 0, 30 do
					local goal = k.base:PointToWorldSpace(KMODE[k.mode](i, t))
					k.pos[i] = (k.pos[i] or goal):Lerp(goal, alpha)
				end
				for _, d in k.parts do
					local i = d[2]
					local ahead = i == 0 and root.Position or k.pos[i - 1]
					d[1].CFrame = CFrame.lookAt(k.pos[i], ahead) * d[3]
				end
			end
		end
	end
end)

local function actor(s, cf, skin, torso, legs, scale)
	local d = Instance.new("HumanoidDescription")
	d.HeadColor, d.LeftArmColor, d.RightArmColor, d.TorsoColor, d.LeftLegColor, d.RightLegColor = skin, skin, skin, torso, legs, legs
	local m = Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R15)
	if scale ~= 1 then pcall(function() m:ScaleTo(scale) end) end
	m:PivotTo(cf + Vector3.new(0, (scale - 1) * 2.8, 0))
	m.Parent = workspace
	local hum = m.Humanoid
	m.HumanoidRootPart.Anchored = true
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local a = {hum = hum, rig = {}, scarf = {}, folder = Instance.new("Folder", m)}
	for _, j in m:GetDescendants() do
		if j:IsA("Motor6D") then a.rig[j.Name] = {j, "C0", j.C0}
		elseif j:IsA("AnimationConstraint") and j.Attachment0 then a.rig[j.Name] = {j.Attachment0, "CFrame", j.Attachment0.CFrame} end
	end
	S[m] = a
	table.insert(s.cast, m)
	return m, a
end
-- كايدو (هيئة هجينة)، غيرنيكا (CP0)، ياماتو
local function makeCast(s, base)
	local V3 = Vector3.new
	local black, gold = rgb(18, 14, 20), rgb(225, 190, 110)
	local K, ka = actor(s, base * CFrame.new(0, 0, -13) * R(0, 180, 0), rgb(205, 150, 120), rgb(90, 35, 60), rgb(35, 30, 45), 2.3)
	local function horns(a, m, k, color, len)
		for _, x in {-1, 1} do
			seg(a, m.Head, V3(x * .45, .45, 0) * k, V3(x * 1.3, .75, 0) * k, .3 * k, color)
			seg(a, m.Head, V3(x * 1.3, .75, 0) * k, V3(x * 1.6, 1.7, -.2) * k, .18 * k, color)
		end
		for i = -5, 5 do
			seg(a, m.Head, V3(i * .12, .55, .35) * k, V3(i * .24, -len, .85) * k, .22 * k, color == gold and rgb(235, 240, 245) or black)
		end
	end
	horns(ka, K, 2.3, rgb(210, 200, 170), 1.8)
	for _, x in {-1, 1} do
		seg(ka, K.Head, V3(x * .1, -.25, -.62) * 2.3, V3(x * 1.3, -.75, -.5) * 2.3, .2, black)
		seg(ka, K.UpperTorso, V3(x * .8, 1.1, .4) * 2.3, V3(x * 1.5, -2.6, .9) * 2.3, 1.1, rgb(45, 30, 70))
	end
	local hand = K.RightHand
	seg(ka, hand, V3(0, 0, 1), V3(0, 0, -9), .9, black, Enum.Material.Metal)
	for i = 1, 24 do
		local an = i * 1.57
		weld(ka, hand, V3(.5, .5, .5), CFrame.new(math.cos(an) * .65, math.sin(an) * .65, -3 - i * .25) * R(45, 45, 0), rgb(120, 115, 125), Enum.Material.Metal)
	end
	local G, ga = actor(s, base * CFrame.new(7, 0, 12), WHITE, rgb(240, 240, 240), rgb(230, 230, 230), 1.05)
	weld(ga, G.Head, V3(1.1, 1.15, .2), CFrame.new(0, 0, -.6), WHITE)
	for _, x in {-.22, .22} do weld(ga, G.Head, V3(.22, .08, .05), CFrame.new(x, .12, -.72), black) end
	weld(ga, G.Head, V3(1.8, .15, 1.8), CFrame.new(0, .62, 0), WHITE)
	weld(ga, G.Head, V3(1.1, .55, 1.1), CFrame.new(0, .95, 0), WHITE)
	local Y, ya = actor(s, base * CFrame.new(-26, 0, -6) * R(0, -110, 0), rgb(240, 200, 175), rgb(235, 235, 240), rgb(170, 30, 45), 1.35)
	horns(ya, Y, 1.35, gold, 2.2)
	seg(ya, Y.RightHand, V3(0, 0, .5), V3(0, 0, -5), .55, rgb(60, 50, 55), Enum.Material.Metal)
	return K, ka, G, ga, Y, ya
end
local function zunesha(s, base)
	local f = Instance.new("Folder", workspace)
	table.insert(s.props, f)
	local skin = rgb(115, 105, 100)
	local function add(size, p, color, ballShape)
		local o = part(size, base * CFrame.new(p + Vector3.new(130, -90, -230)), color or skin, 0, nil, Enum.Material.Slate)
		if ballShape then o.Shape = Enum.PartType.Ball end
		o.Parent = f
		tw(o, 4, {CFrame = o.CFrame + Vector3.new(0, 75, 0)}, Enum.EasingStyle.Sine)
	end
	local V3 = Vector3.new
	add(V3(90, 90, 90), V3(20, 20, -30), nil, true)
	add(V3(55, 55, 55), V3(-18, 38, 10), nil, true)
	for i = 1, 14 do add(Vector3.one * (24 - i), V3(-30 - i * 2.5, 34 - i * 5 + i * i * .12, 28 + i), nil, true) end
	for _, x in {-1, 1} do
		add(V3(8, 48, 38), V3(-14 + x * 34, 42, 0))
		add(V3(18, 90, 18), V3(20 + x * 30, -45, -20))
		add(V3(5, 5, 3), V3(-26 + x * 10, 48, 36), rgb(255, 220, 90))
		add(V3(5, 5, 34), V3(-22 + x * 14, 18, 40), rgb(240, 230, 200))
	end
end
local function cleanup(s)
	for _, d in s.dragons do d.folder:Destroy() end
	for _, m in s.cast do S[m] = nil m:Destroy() end
	for _, f in s.props do f:Destroy() end
	s.dragons, s.cast, s.props = {}, {}, {}
end

local function revert(c)
	local s = S[c]
	if not s or not s.on then return end
	s.on, s.anim, s.scarf = false, nil, {}
	for _, d in s.rig do d[1][d[2]] = d[3] end
	for p, color in s.colors do p.Color = color end
	for h, t in s.hidden do h.Transparency = t end
	for _, o in s.clothes do if c.Parent then o.Parent = c end end
	for _, o in s.extra do o:Destroy() end
	s.colors, s.hidden, s.clothes, s.extra = {}, {}, {}, {}
	s.folder:ClearAllChildren()
	if c.Parent and c:FindFirstChild("HumanoidRootPart") then
		c.HumanoidRootPart.Anchored = false
		boom(c.HumanoidRootPart.Position, 12)
	end
	s.hum.WalkSpeed, s.hum.JumpPower = 16, 50
	day()
end

local function transform(c, s)
	local root, hum = c.HumanoidRootPart, s.hum
	local function ok() return s.on and c.Parent and hum.Health &gt; 0 end
	local function wait(t) task.wait(t) if not ok() then error("stop", 0) end end
	local base = root.CFrame
	local floor = base.Position - Vector3.new(0, 2.8, 0)
	local function at(x, y, z) return base:PointToWorldSpace(Vector3.new(x, y, z)) end
	local function shot(a, b, d, look) cam(s, "shot", a, b, d, look) end
	local function move(cf, t, style) tw(root, t, {CFrame = cf}, style) end
	local function say(text, color, t)
		local _, g = label(root, text, color or WHITE, 6.5, 20, 4.5)
		Debris:AddItem(g, t or 1.6)
	end
	root.Anchored = true
	local ff = Instance.new("ForceField", c)
	ff.Visible = false
	table.insert(s.extra, ff)
	luffy(c, s)
	local moon = night(root)
	-- 1) سطح قبة الجمجمة: لوفي (غير 4) ضد كايدو
	local K, ka, G, ga, Y, ya = makeCast(s, base)
	zunesha(s, base)
	for _, p in c:GetChildren() do
		if p:IsA("BasePart") and (p.Name:find("Arm") or p.Name:find("Hand")) then paint(s, p, rgb(35, 10, 18)) end
	end
	play(s, "ready")
	play(ka, "windup", 5)
	play(ya, "ready")
	play(ga, "slam")
	shot(at(26, 7, 6), at(18, 3, -2), 2.4, at(0, 3, -6))
	for i = 1, 10 do
		local puff = ball(1.5, root.Position + rng:NextUnitVector() * 2, rgb(255, 190, 190), .35, .8)
		tw(puff, .8, {Size = Vector3.one * 4, Position = puff.Position + Vector3.new(0, 5, 0), Transparency = 1})
		bolt(K.RightHand.Position, K.RightHand.Position + rng:NextUnitVector() * 9, .3, 1.5, PURPLE)
		wait(.2)
	end
	-- غيرنيكا يمسك ذراع لوفي
	shot(at(7, 2, 9), at(5, 2, 7), 1.3, at(0, 1, 1))
	play(ga, "grab", 25)
	tw(G.HumanoidRootPart, .35, {CFrame = base * CFrame.new(1.2, 0, 2) * R(0, 20, 0)}, Enum.EasingStyle.Quart)
	popup(root.Position + Vector3.new(0, 4, 0), "!!", rgb(255, 60, 60))
	sound(root, SFX.whoosh, 3, 1.4)
	wait(.9)
	-- رايمي هاكّي
	shot(at(-17, 2, -4), at(-14, 5, 6), 1.2, at(0, 1, -3))
	say("Raimei Hakke!", rgb(170, 130, 255), 1.1)
	for _ = 1, 5 do bolt(K.RightHand.Position, K.RightHand.Position + Vector3.new(0, 18, 0), .8, 2.5, PURPLE) sound(root, SFX.zap, 2, .4) wait(.1) end
	play(ka, "throw", 22)
	tw(K.HumanoidRootPart, .25, {CFrame = K.HumanoidRootPart.CFrame * CFrame.new(0, 0, -7)}, Enum.EasingStyle.Quart)
	wait(.2)
	boom(root.Position, 24)
	cam(s, "shake", 3)
	-- السقوط: طيران ودوران، ارتداد، ثم انزلاق
	play(s, "flail", 20)
	tw(G.HumanoidRootPart, .5, {CFrame = base * CFrame.new(14, 0, 6) * R(0, 70, 0)})
	local function path(dur, fn)
		local t0 = os.clock()
		repeat
			local x = math.min((os.clock() - t0) / dur, 1)
			root.CFrame = base * fn(x)
			wait(0)
		until x &gt;= 1
	end
	local function crash(z, power)
		local p = at(0, -2.7, z)
		ring(p, power * 2, rgb(200, 180, 150))
		for i = 1, 14 do
			local dir = CFrame.Angles(0, i * .45, 0).LookVector
			part(Vector3.new(.2, .08, power * .7), CFrame.lookAt(p + dir * power * .5, p + dir * power), rgb(25, 18, 20), 0, 12, Enum.Material.Slate)
			local dust = ball(1, p + dir * 2, rgb(190, 170, 150), .3, 1)
			tw(dust, 1, {Size = Vector3.one * power * .45, Position = dust.Position + dir * power * .7 + Vector3.new(0, 2, 0), Transparency = 1})
		end
		sound(root, SFX.drum, 3, .7)
		cam(s, "shake", power * .15)
	end
	shot(at(-20, 6, 3), at(-13, 2, 17), 2.1, at(0, 0, 11))
	path(1, function(x) return CFrame.new(0, math.sin(x * math.pi) * 11 - x * 2.1, x * 13) * R(x * 450, 0, math.sin(x * math.pi) * 40) end)
	crash(13, 12)
	path(.55, function(x) return CFrame.new(0, -2.1 + math.sin(x * math.pi) * 3.5, 13 + x * 5) * R(90 - math.sin(x * math.pi) * 35, math.sin(x * math.pi) * 20, 0) end)
	crash(18, 7)
	play(s, "lie", 9)
	path(.5, function(x) return CFrame.new(0, -2.1, 18 + (1 - (1 - x) ^ 3) * 3) * R(90, 0, 0) end)
	for _, p in c:GetChildren() do
		if s.colors[p] and (p.Name:find("Arm") or p.Name:find("Hand")) then p.Color = s.colors[p] end
	end
	sound(root, SFX.wind, 2, 1.6)
	wait(1)
	-- كايدو يغضب على غيرنيكا ثم يتحول تنين
	shot(at(24, 6, -14), at(18, 5, -4), 1.8, at(7, 2, -6))
	play(ga, "flail", 20)
	play(ka, "punch", 14)
	tw(G.HumanoidRootPart, .6, {CFrame = base * CFrame.new(42, 6, -16) * R(200, 70, 0)})
	boom(G.HumanoidRootPart.Position, 10)
	wait(1.2)
	play(ka, "burst", 10)
	play(ya, "slam", 8)
	boom(K.HumanoidRootPart.Position, 26)
	wait(.4)
	S[K] = nil
	K:Destroy()
	local k = dragon(s, base, rgb(45, 105, 125), rgb(255, 120, 30), "fly")
	dragon(s, base, rgb(240, 130, 160), rgb(255, 215, 90), "momo")
	shot(at(8, 2, 20), at(-10, 8, 26), 2, at(0, 18, -40))
	sound(root, SFX.drum, 4, .25)
	wait(2)
	shot(at(-30, 12, 30), at(-20, 14, 24), 2, at(120, 5, -230))
	say("طبول التحرر...", rgb(255, 230, 150), 1.8)
	for _ = 1, 4 do sound(root, SFX.drum, 4, .35) task.delay(.15, sound, root, SFX.drum, 3, .55) wait(.5) end
	-- 2) طبول التحرر وهو على الأرض
	shot(at(6, 5, 15), at(2, 3, 20), 3.6, at(0, -2, 22))
	for i = 1, 7 do
		sound(root, SFX.drum, 3, .35)
		task.delay(.13, sound, root, SFX.drum, 2, .55)
		task.delay(.24, sound, root, SFX.drum, 2, .55)
		ring(floor + base.LookVector * -21, 6 + i * 4, i % 2 == 0 and PURPLE or WHITE)
		popup(root.Position + Vector3.new(0, 2, 0), "دُن دُتّو دُتّو!", WHITE)
		local puff = ball(1, root.Position, WHITE, .2, 1.2)
		tw(puff, 1.2, {Size = Vector3.one * (4 + i), Position = puff.Position + Vector3.new(0, 7, 0), Transparency = 1})
		if i == 4 then say("هيهيهي...", WHITE, 1.4) end
		wait(.55 - i * .03)
	end
	-- 3) التحول والقيام
	dress(c, s)
	boom(root.Position, 38)
	sound(root, SFX.whoosh, 4, .35)
	cam(s, "shake", 2)
	shot(at(0, -1, -4), at(0, 3, -17), 1.4, at(0, 3, 4))
	move(base * CFrame.new(0, 1, 3), .7, Enum.EasingStyle.Elastic)
	play(s, "burst", 20)
	say("☀ GEAR 5 ☀", rgb(255, 250, 225), 2.4)
	wait(1.5)
	-- 4) ضحكة نيكا وهو مغطي عينه
	play(s, "cover", 20)
	shot(at(-7, 2, -9), at(6, 1, -7), 3, at(0, 1.5, 3))
	for i = 1, 9 do
		popup(root.Position + Vector3.new(rng:NextNumber(-5, 5), 3, 0), i % 2 == 0 and "هاهاهاها!" or "AHAHAHA!", WHITE)
		sound(root, SFX.boing, 1.5, i % 2 == 0 and 1.6 or 1.25)
		ring(floor + base.LookVector * -3, 10 + (i % 3) * 6, WHITE, .5)
		wait(.32)
	end
	-- 5) العيون تطلع من مكانها
	play(s, "burst", 30)
	shot(at(11, 2, -3), at(14, 2, -6), 1.5, at(0, 2, -2))
	local eyes = {}
	for _, x in {-.5, .5} do
		local w, p = weld(s, c.Head, Vector3.one * .5, CFrame.new(x * .5, .1, -.5), WHITE, Enum.Material.SmoothPlastic, true)
		local w2, p2 = weld(s, c.Head, Vector3.one * .3, CFrame.new(x * .5, .1, -.7), rgb(230, 20, 45), Enum.Material.Neon, true)
		tw(p, .2, {Size = Vector3.one * 1.9}, Enum.EasingStyle.Back)
		tw(w, .2, {C0 = CFrame.new(x * 2.2, .2, -4)}, Enum.EasingStyle.Back)
		tw(w2, .2, {C0 = CFrame.new(x * 2.2, .2, -5)}, Enum.EasingStyle.Back)
		table.insert(eyes, p)
		table.insert(eyes, p2)
	end
	sound(root, SFX.boing, 3, .6)
	wait(1.2)
	for _, p in eyes do p:Destroy() end
	-- 6) الأرض مطاطية ترد نفَس كايدو
	say("بورو بريث!", rgb(255, 140, 40), 1)
	shot(at(20, 8, 2), at(18, 7, -10), 2.4, at(0, 5, -18))
	local orb = ball(4, k.pos[0], rgb(255, 120, 20), .1)
	tw(orb, .8, {Size = Vector3.one * 12})
	wait(.8)
	play(s, "slam", 25)
	local wall = {}
	for x = -5, 5 do
		local p = part(Vector3.new(3.2, 1, 5), CFrame.new(at(x * 3, -3, -10)), rgb(80, 125, 75), 0, 2.2, Enum.Material.Grass)
		tw(p, .35, {Size = Vector3.new(3.2, 16 - math.abs(x), 1.5), CFrame = base * CFrame.new(x * 3, 4, -10 + x * x * .22)}, Enum.EasingStyle.Elastic)
		table.insert(wall, p)
	end
	tw(orb, .4, {Position = at(0, 4, -12)})
	wait(.45)
	sound(root, SFX.boing, 3, .45)
	for x, p in wall do tw(p, .25, {CFrame = p.CFrame * CFrame.new(0, 0, -5)}, Enum.EasingStyle.Back) end
	tw(orb, .4, {Position = k.pos[0]})
	wait(.4)
	boom(orb.Position, 20)
	orb:Destroy()
	cam(s, "shake", 1.8)
	wait(.5)
	-- 7) رجلين دوّارة ثم نط الحبل بكايدو
	play(s, "run", 60)
	say("هيا!", WHITE, .8)
	for i = 1, 8 do ring(floor + base.LookVector * i, 6, WHITE, .4) sound(root, SFX.boing, 1, 1 + i * .1) wait(.12) end
	k.mode = "rope"
	play(s, "rope", 30)
	move(base, .3)
	shot(at(6, 6, -42), at(-12, 12, -36), 3.4, at(0, 6, 0))
	say("نط الحبل!", WHITE, 2)
	for i = 1, 8 do
		move(base * CFrame.new(0, i % 2 == 0 and 0 or 7, 0), .3)
		if i % 2 == 0 then boom(floor + Vector3.new(0, 2, 0), 14) cam(s, "shake", 1.2) end
		wait(.38)
	end
	k.mode = "down"
	boom(at(0, 0, -38), 30)
	cam(s, "shake", 2)
	-- 8) مسك البرق
	move(base * CFrame.new(0, 14, 0), .35, Enum.EasingStyle.Back)
	play(s, "grab")
	shot(at(4, 4, 18), at(9, 10, 22), 1.8, at(0, 22, -25))
	local hand = c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")
	say("مسكت البرق!", SKY, 1.5)
	for i = 1, 12 do
		bolt(moon, hand.Position, .9, 7)
		bolt(hand.Position + Vector3.new(-7, 0, 0), hand.Position + Vector3.new(7, 0, 0), .5, 1)
		sound(root, SFX.zap, 2, .35 + i * .05)
		wait(.1)
	end
	play(s, "windup", 14)
	wait(.5)
	play(s, "throw", 35)
	local target = at(0, -1, -40)
	for _ = 1, 6 do bolt(hand.Position, target, 1.4, 3.5) wait(.07) end
	boom(target, 30)
	cam(s, "shake", 2.4)
	wait(.8)
	-- 9) باجرانغ غن
	k.mode = "fly"
	move(base * CFrame.new(0, 24, 8), .5)
	play(s, "punch", 8)
	say("Gomu Gomu no BAJRANG GUN!", rgb(255, 90, 60), 2.6)
	shot(at(55, 20, 10), at(62, 26, -40), 3, at(0, 20, -22))
	local from = at(0, 55, -4)
	local black = rgb(25, 12, 30)
	local fist = ball(3, from, black, 0, 4, Enum.Material.Metal)
	local arm = part(Vector3.new(2, 2, 2), CFrame.lookAt((hand.Position + from) / 2, from), black, 0, 4, Enum.Material.Metal)
	tw(arm, 1.4, {Size = Vector3.new(6, 6, (from - hand.Position).Magnitude)})
	tw(fist, 1.4, {Size = Vector3.one * 38}, Enum.EasingStyle.Back)
	for i = 1, 14 do bolt(fist.Position, fist.Position + rng:NextUnitVector() * 32, .4, 2.5, i % 2 == 0 and PURPLE or rgb(220, 20, 40)) wait(.1) end
	local hit = at(0, 10, -40)
	play(s, "throw", 25)
	tw(fist, .35, {Position = hit}, Enum.EasingStyle.Quart)
	tw(arm, .35, {Size = Vector3.new(6, 6, (hit - hand.Position).Magnitude), CFrame = CFrame.lookAt((hand.Position + hit) / 2, hit)}, Enum.EasingStyle.Quart)
	k.mode = "down"
	wait(.38)
	boom(target, 75)
	cam(s, "shake", 3.5)
	for i = 1, 40 do
		local dir = CFrame.Angles(0, i * .5, 0).LookVector
		local rock = part(Vector3.one * rng:NextNumber(1, 4), CFrame.new(target + dir * rng:NextNumber(5, 28)), rgb(85, 75, 80), 0, 1.6, Enum.Material.Slate)
		tw(rock, 1.6, {CFrame = rock.CFrame * CFrame.new(0, rng:NextNumber(8, 28), 0) * R(i * 40, i * 25, 0), Transparency = 1})
	end
	wait(.6)
	tw(fist, .5, {Transparency = 1})
	tw(arm, .5, {Transparency = 1})
	for _, d in k.parts do tw(d[1], 1, {Transparency = 1}) end
	play(ya, "burst", 10)
	-- 10) النصر
	move(base, .6, Enum.EasingStyle.Bounce)
	play(s, "cover", 14)
	shot(at(-6, 1, -12), at(2, 2, -8), 2, at(0, 1, 0))
	wait(2)
end

local function toggle(player)
	local c = player.Character
	local s = c and S[c]
	if not s or s.busy or s.hum.Health &lt;= 0 then return end
	s.busy = true
	player:SetAttribute("Busy", true)
	if s.on then
		revert(c)
		task.wait(1)
	else
		s.on = true
		local good, err = pcall(transform, c, s)
		cleanup(s)
		cam(s, "end")
		if good then
			s.anim = nil
			for _, d in s.rig do d[1][d[2]] = d[3] end
			c.HumanoidRootPart.Anchored = false
			for _, o in s.extra do if o:IsA("ForceField") then o:Destroy() end end
			s.hum.WalkSpeed, s.hum.JumpPower = 32, 95
		else
			if err ~= "stop" then warn("[Gear5] " .. tostring(err)) end
			revert(c)
		end
	end
	s.busy = false
	player:SetAttribute("Busy", false)
	player:SetAttribute("On", s.on)
end

local function setup(player)
	local function spawned(c)
		local hum = c:WaitForChild("Humanoid")
		c:WaitForChild("HumanoidRootPart")
		task.wait(.5)
		local s = {player = player, hum = hum, rig = {}, scarf = {}, dragons = {}, cast = {}, props = {}, colors = {}, hidden = {}, clothes = {}, extra = {}}
		for _, j in c:GetDescendants() do
			if j:IsA("Motor6D") then s.rig[j.Name] = {j, "C0", j.C0}
			elseif j:IsA("AnimationConstraint") and j.Attachment0 then s.rig[j.Name] = {j.Attachment0, "CFrame", j.Attachment0.CFrame} end
		end
		s.folder = Instance.new("Folder", c)
		hum.UseJumpPower = true
		S[c] = s
		player:SetAttribute("On", false)
		player:SetAttribute("Busy", false)
		hum.Died:Connect(function() revert(c) S[c] = nil end)
		-- أداة احتياطية إذا زر الشاشة ما اشتغل
		task.wait(4)
		if not player:GetAttribute("Ready") and c.Parent then
			local t = Instance.new("Tool")
			t.Name, t.RequiresHandle = "GEAR 5", false
			t.Activated:Connect(function() toggle(player) end)
			t.Parent = player.Backpack
		end
	end
	player.CharacterAdded:Connect(spawned)
	player.CharacterRemoving:Connect(function(c) revert(c) S[c] = nil end)
	if player.Character then task.spawn(spawned, player.Character) end
end
Players.PlayerAdded:Connect(setup)
for _, p in Players:GetPlayers() do task.spawn(setup, p) end
remote.OnServerEvent:Connect(function(p, what)
	if what == "ready" then p:SetAttribute("Ready", true)
	elseif what == "toggle" then toggle(p) end
end)
print("[Gear5] ready")
</ProtectedString></Properties></Item>
</Item>
</roblox>
